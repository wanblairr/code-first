+ controls.endpoint.maxLength=64;controls.key.maxLength=256;controls.model.maxLength=128;controls.tokens.min='16';controls.tokens.max='1024';controls.tokens.step='1';controls.temperature.min='0';controls.temperature.max='1';controls.temperature.step='0.1';controls.topP.min='0.01';controls.topP.max='1';controls.topP.step='0.01';
