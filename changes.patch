+++ b/local_app/tests/test_bom_connected_v36.py
@@ -0,0 +1,271 @@
+"""Connected undo, MYR quote snapshots and Gmail draft integration; no network."""
+from copy import deepcopy
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+from cafe_core import CafeError
+from cafe_service import CafeService, SHANGHAI
+
+ACCESS = "ya29.connected-fixture-access-only"
+
+
+class BOMConnectedTests(unittest.TestCase):
+    def setUp(self):
+        self.environment = patch.dict(os.environ, {}, clear=True)
+        self.environment.start()
+        self.addCleanup(self.environment.stop)
+        self.network = patch("urllib.request.OpenerDirector.open",
+                             side_effect=AssertionError("Connected BOM tests must never call external APIs"))
+        self.network.start()
+        self.addCleanup(self.network.stop)
+        self.scratch = Path(tempfile.gettempdir()).resolve()
+        self.temp = tempfile.TemporaryDirectory(prefix="cafe-bom-connected-", dir=self.scratch)
+        self.base = Path(self.temp.name).resolve()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-connected-")
+        self.instant = datetime(2026, 10, 23, 21, tzinfo=SHANGHAI)
+        self.service = self.new_service()
+        self.app = self.service.bom()
+        self.app.set_context({"weather_mode":"rain", "holiday_mode":"ordinary"})
+
+    def tearDown(self):
+        self.service.stop.set()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-connected-")
+        self.temp.cleanup()
+
+    def new_service(self):
+        service = CafeService(self.base, clock=lambda:self.instant)
+        service.bom_enabled = True
+        return service
+
+    def sell36(self, request_id="connected-sale-36"):
+        state = self.app.state()
+        return self.app.sale({
+            "productId":"BV-013", "size":"中杯", "quantity":36,
+            "revision":state["revision"], "request_id":request_id,
+        })
+
+    def prices(self, milk=800, oat=1200):
+        # Facade must supply MYR and explicit quote provenance when omitted.
+        state = self.app.state()
+        return self.app.set_prices({
+            "revision":state["pricing"]["revision"], "request_id":"connected-prices",
+            "entries":[
+                {"ingredient_id":"INV-003", "pack_quantity":1000, "pack_price_cents":milk},
+                {"ingredient_id":"INV-005", "pack_quantity":1000, "pack_price_cents":oat},
+            ],
+        })
+
+    @staticmethod
+    def payload(proposal, quantities=None):
+        return {"proposal_id":proposal["id"], "revision":proposal["revision"],
+                "input_hash":proposal["input_hash"], "quantities":quantities or {},
+                "acknowledged":False}
+
+    def approve_priced(self):
+        self.sell36()
+        self.prices()
+        proposal = self.app.suggest()["proposal"]
+        state = self.app.approve(self.payload(proposal, {"INV-005":3000}))
+        order = next(order for order in state["orders"] if order["id"]==state["active_order_id"])
+        return state, order, order["drafts"][0]
+
+    def fake_gmail(self):
+        cloud = self.service._cloud()
+        cloud.config.update({"gmail_access_token":ACCESS})
+        client = Mock()
+        client.create_draft.return_value = {
+            "gmail_draft_id":"connected-gmail-draft", "gmail_message_id":"connected-gmail-message",
+            "status":"draft", "sent":False,
+        }
+        factory = Mock(return_value=client)
+        cloud.gmail_factory = factory
+        return cloud, client, factory
+
+    def test_original_v36_sale_is_lazily_migrated_and_can_be_undone_through_facade(self):
+        self.sell36("old-v36-sale-36")
+        # Emulate the original release, which had durable sale evidence but no
+        # undo marker or quote tables. Do not alter inventory or audit evidence.
+        with self.service.store.connect() as db:
+            db.execute("DROP TABLE bom_last_transaction")
+            db.execute("DROP TABLE bom_undo_requests")
+            db.execute("DROP TABLE bom_pricebook")
+        restarted = self.new_service()
+        app = restarted.bom()
+        state = app.state()
+        self.assertEqual(state["last_transaction"]["transaction_id"],"old-v36-sale-36")
+        self.assertTrue(state["last_transaction"]["can_undo"])
+        undone = app.undo({"revision":state["revision"], "request_id":"undo-legacy-sale",
+                           "transaction_id":"old-v36-sale-36"})
+        self.assertEqual(undone["stock"]["INV-005"],8000)
+        self.assertEqual(undone["stock"]["INV-001"],12200)
+        self.assertEqual(undone["revision"],2)
