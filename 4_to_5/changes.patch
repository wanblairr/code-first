+    ...(note !== null && note !== '' ? ['Owner note (original language, unchanged):', note, ''] : []),
+    'Check quantities, prices, shelf life and delivery arrangements. This draft has not been sent and does not place an order or make a payment.',
+  ].join('\n');
+}
