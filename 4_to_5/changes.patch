+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import test from 'node:test';
+import {mountBOMAssistant, localizeBOMDraft} from '../dist/demo/bom-assistant.mjs';
+import {initialStock} from '../dist/demo/bom-core.mjs';
+
+const data = JSON.parse(await fs.readFile(new URL('../dist/demo/bom-data.json', import.meta.url), 'utf8'));
+
+class Element {
+  constructor(tag) {
+    this.tagName = tag.toUpperCase();
+    this.children = []; this.dataset = {}; this.events = new Map();
+    this.parentNode = null; this.className = ''; this._text = ''; this._value = '';
+    this.disabled = false; this.checked = false; this.hidden = false; this.id = '';
+    this.classList = {
+      toggle: (name, enabled) => {
+        const classes = new Set(this.className.split(/\s+/).filter(Boolean));
+        const add = enabled === undefined ? !classes.has(name) : enabled;
+        add ? classes.add(name) : classes.delete(name);
+        this.className = [...classes].join(' ');
+      },
+      contains: name => this.className.split(/\s+/).includes(name),
+    };
+  }
+  append(...nodes) {
+    for (const node of nodes) {
+      node.parentNode = this;
+      this.children.push(node);
+    }
+  }
+  replaceChildren(...nodes) {
+    for (const child of this.children) child.parentNode = null;
+    this.children = []; this._text = ''; this.append(...nodes);
+  }
+  set textContent(value) { this.children = []; this._text = String(value); }
+  get textContent() { return this._text + this.children.map(c => c.textContent).join(''); }
+  set value(value) { this._value = String(value); }
+  get value() {
+    if (this.tagName !== 'SELECT') return this._value;
+    return this.children.find(c => c.value === this._value)?.value ?? this.children[0]?.value ?? '';
+  }
+  setAttribute(key, value) { this[key] = String(value); }
+  addEventListener(name, callback) {
+    if (!this.events.has(name)) this.events.set(name, []);
+    this.events.get(name).push(callback);
+  }
+  dispatchEvent(event) {
+    for (const fn of this.events.get(event.type) || []) fn(event);
+    return true;
+  }
+  click() { if (!this.disabled) this.dispatchEvent({type: 'click', target: this}); }
+  querySelector(selector) {
+    return descendants(this).find(node => matches(node, selector)) || null;
+  }
+  querySelectorAll(selector) { return descendants(this).filter(node => matches(node, selector)); }
+  remove() {
+    if (this.parentNode) this.parentNode.children = this.parentNode.children.filter(c => c !== this);
+  }
+}
+function descendants(root) {
+  return root.children.flatMap(child => [child, ...descendants(child)]);
+}
+function matches(node, selector) {
+  if (selector.startsWith('#')) return node.id === selector.slice(1);
+  if (selector.startsWith('.')) return node.className.split(/\s+/).includes(selector.slice(1));
+  return node.tagName.toLowerCase() === selector;
+}
+function storage(values = new Map()) {
+  return {getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, String(value)), values};
+}
+async function setup(options = {}) {
+  const root = new Element('section'); root.id = 'bom-root';
+  const reset = new Element('button'); reset.id = 'reset-confirm';
+  const body = new Element('body'); body.append(root, reset);
+  const workflow = Array.from({length: 4}, () => new Element('li'));
+  const events = new Map();
+  const doc = {
+    documentElement: {dataset: {language: options.language || 'zh'}},
+    body,
+    createElement: tag => new Element(tag),
+    getElementById: id => descendants(body).find(n => n.id === id) || null,
+    querySelectorAll: selector => selector === '.workflow li' ? workflow : body.querySelectorAll(selector),
+    addEventListener: (name, fn) => {
+      if (!events.has(name)) events.set(name, []);
+      events.get(name).push(fn);
+    },
+    dispatchEvent: event => { for (const fn of events.get(event.type) || []) fn(event); },
+  };
+  const store = options.store || storage();
+  globalThis.document = doc;
+  globalThis.sessionStorage = store;
+  globalThis.Option = class extends Element {
+    constructor(text, value) { super('option'); this.textContent = text; this.value = value; }
+  };
+  globalThis.fetch = async url => {
+    assert.equal(url, '/demo/bom-data.json', 'mount only reads bundled CSV data');
+    return {ok: true, json: async () => structuredClone(data)};
+  };
+  let context = {
+    targetDate: '2026-10-24', forecastCups: 100, referenceCups: 100,
+    weather: {temperatureC: 29, precipitationMm: 6},
+    holiday: {isHoliday: false}, signature: 'stable-context',
+  };
+  const adapterCalls = [];
+  const controller = await mountBOMAssistant({
+    getContext: () => context,
+    storeAdapter: options.storeAdapter,
+    createDraftButtons: (draft, order) => {
+      adapterCalls.push({draft, order});
+      const b = new Element('button'); b.id = 'fake-api-draft';
+      return [b];
+    },
+  });
+  const find = id => root.querySelector('#' + id);
+  const fire = (element, name) => element.dispatchEvent({type: name, target: element});
+  const qtyInput = id => descendants(root).find(n =>
+    n.tagName === 'INPUT' && n.dataset.materialId === id);
+  function sale(productId, size, quantity) {
+    find('bom-product').value = productId; fire(find('bom-product'), 'change');
+    find('bom-size').value = size; find('bom-quantity').value = String(quantity);
+    find('bom-sell').click();
+  }
+  const stored = () => JSON.parse(store.getItem('cafe-csv-bom-v35-' + data.version));
+  return {root, doc, controller, store, find, fire, sale, stored, qtyInput, adapterCalls,
+    setContext: value => { context = value; }, context: () => context};
+}
+
+
+const yesterday=()=>{
+  const parts=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{
+    timeZone:'Asia/Kuala_Lumpur',year:'numeric',month:'2-digit',day:'2-digit',
+  }).formatToParts(new Date()).map(part=>[part.type,part.value]));
+  return new Date(Date.parse(parts.year+'-'+parts.month+'-'+parts.day+'T00:00:00Z')-86400000).toISOString().slice(0,10);
+};
+const tick=()=>new Promise(resolve=>setImmediate(resolve));
+function setInput(h,id,value,event='input'){const input=h.find(id);assert.ok(input,id);input.value=String(value);h.fire(input,event);}
+function addOwnItem(h,{name='Reusable cups',quantity=2,price='10.25'}={}){
+  h.find('bom-extras-add').click();
+  setInput(h,'bom-extra-name-0',name);setInput(h,'bom-extra-quantity-0',quantity);setInput(h,'bom-extra-priceText-0',price);
+  h.find('bom-extras-save').click();
+}
+function saveOwnerDay(h,{quantity=70,date=yesterday()}={}){
+  setInput(h,'bom-history-date',date,'change');setInput(h,'bom-history-quantity-0',quantity);
+  h.find('bom-history-save').click();
+}
+test('assistant mounts and saves yesterday when en-CA falls back to en-US in a small-ICU-like environment',async()=>{
+  const NativeDate=globalThis.Date,NativeDateTimeFormat=Intl.DateTimeFormat;
+  // Kuala Lumpur is already Jan 2 while UTC is still Jan 1: preserve the store's timezone.
+  const fixedInstant=NativeDate.parse('2026-01-01T17:30:00Z');
+  globalThis.Date=class extends NativeDate {
+    constructor(...args){super(...(args.length?args:[fixedInstant]));}
+    static now(){return fixedInstant;}
+  };
+  Intl.DateTimeFormat=class extends NativeDateTimeFormat {
+    constructor(locales,options){super(locales==='en-CA'?'en-US':locales,options);}
+  };
+  try{
+    const formatted=new Intl.DateTimeFormat('en-CA',{
+      timeZone:'Asia/Kuala_Lumpur',year:'numeric',month:'2-digit',day:'2-digit',
+    }).format(new Date());
+    assert.equal(formatted,'01/02/2026','the locale fallback must exercise non-ISO formatting');
+    const h=await setup();
+    assert.equal(h.find('bom-history-date').value,'2026-01-01');
+    setInput(h,'bom-history-quantity-0',70);
+    h.find('bom-history-save').click();
+    assert.equal(h.stored().salesHistory.days[0].date,'2026-01-01');
+    assert.equal(h.stored().salesHistory.days[0].rows[0].quantity,70);
+    assert.match(h.find('bom-popularity').textContent,/100.0%/);
+    assert.deepEqual(h.stored().stock,initialStock(data));
+  }finally{
+    globalThis.Date=NativeDate;
+    Intl.DateTimeFormat=NativeDateTimeFormat;
+  }
+});
+test('daily history is local-only for guests, saves whole-day weights and never deducts current stock',async()=>{
+  const h=await setup();
+  const stock=initialStock(data);
+  saveOwnerDay(h);
+  assert.deepEqual(h.stored().stock,stock);
+  assert.equal(h.stored().salesHistory.days.length,1);
+  assert.equal(h.stored().salesHistory.days[0].rows[0].quantity,70);
