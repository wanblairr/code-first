+    value.update(overrides)
+    return value
+
+
+def oat(quantity):
+    return {"productId":"BV-013", "size":"中杯", "quantity":quantity}
+
+
+class BOMCoreTests(unittest.TestCase):
+    def test_exact_csv_counts_and_safety_lines(self):
+        self.assertEqual(len(DATA["products"]),20)
+        self.assertEqual(len(DATA["materials"]),21)
+        self.assertEqual(sum(m["safety"] is not None for m in DATA["materials"].values()),19)
+        self.assertEqual(DATA["materials"]["INV-003"]["safety"],51200)
+        self.assertEqual(DATA["materials"]["INV-005"]["safety"],2800)
+        self.assertEqual(DATA["materials"]["INV-003"]["initial"],60000)
+        self.assertEqual(DATA["materials"]["INV-005"]["initial"],8000)
+        self.assertEqual(set(DATA["products"]),set(RECIPES)|set(BAKERY))
+
+    def test_all_15_beverages_both_sizes_match_original_csv(self):
+        for product_id, recipe in RECIPES.items():
+            for size,index in (("中杯",1),("大杯",2)):
+                with self.subTest(product_id=product_id,size=size):
+                    sale={"productId":product_id,"size":size,"quantity":2}
+                    expected={parts[0]:parts[index]*2 for parts in recipe}
+                    self.assertEqual(usage(DATA,[sale]),expected)
+                    before=initial_stock(DATA)
+                    after=sell(DATA,before,sale)
+                    self.assertEqual(after,{key:n-expected.get(key,0) for key,n in before.items()})
+                    self.assertEqual(before,initial_stock(DATA))
+
+    def test_all_bakery_products_deduct_finished_units_only(self):
+        for product_id in BAKERY:
+            with self.subTest(product_id=product_id):
+                self.assertEqual(usage(DATA,[{"productId":product_id,"size":"份","quantity":3}]),{product_id:3})
+                after=sell(DATA,initial_stock(DATA),{"productId":product_id,"size":"份","quantity":3})
+                self.assertEqual(after[product_id],DATA["materials"][product_id]["initial"]-3)
+                self.assertEqual(after["INV-001"],12200)
+
+    def test_36_oat_sale_warning_and_3200_recommendation(self):
+        stock=sell(DATA,initial_stock(DATA),oat(36))
+        self.assertEqual(stock["INV-005"],2600)
+        self.assertIn("INV-005",low_stock(DATA,stock))
+        rows=replenish(DATA,stock,[oat(20)])
+        self.assertEqual(next(r["quantity"] for r in rows if r["id"]=="INV-005"),3200)
+
