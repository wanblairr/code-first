+#bom-root .bom-sale-card .small-copy{margin:12px 0 0}
+#bom-root .bom-message:empty{display:none}
+#bom-root .bom-message{padding:14px 16px;background:#e9f2e5;border:1px solid #cfdec6;border-radius:8px;margin:14px 0}
+#bom-root .bom-message.bom-error{background:#fff0ec;border-color:#efc6bd;color:#a02924}
+#bom-root .bom-warning{padding:16px 18px;border-radius:10px;background:#fff0ec;border:1px solid #efb7a9;color:#a21d18;margin:14px 0}
+#bom-root .bom-warning strong{color:#a21d18;font-weight:700}
+#bom-root .bom-warning p{margin:5px 0 0;color:#a21d18}
+#bom-root .bom-inventory,#bom-root .bom-demand{border-bottom:1px solid var(--line);padding:15px 0}
+#bom-root summary{font-weight:600;cursor:pointer}
+#bom-root details>.small-copy{margin-top:12px}
+#bom-root .bom-stock-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:16px 0}
+#bom-root .bom-stock-item{display:grid;gap:6px;border:1px solid var(--line);border-radius:9px;padding:14px;background:#fafbf6;min-width:0}
+#bom-root .bom-stock-item.is-low{border-color:#e5a194;background:#fff0ec;color:#a21d18}
+#bom-root .bom-stock-value{font-weight:700;font-size:19px}
+#bom-root .bom-stock-item small{font-size:12px;color:var(--muted)}
+#bom-root .bom-stock-item.is-low small{color:#a21d18}
+#bom-root .bom-demand-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px}
+#bom-root .bom-demand-grid p{font-size:13px;margin:2px 0}
+#bom-root .bom-proposal-area{margin-top:26px}
+#bom-root .bom-proposal-area .section-top{margin-bottom:10px}
+#bom-root h3{margin-bottom:10px}
+#bom-root .bom-proposal-line{display:grid;grid-template-columns:1fr minmax(150px,auto);gap:18px;align-items:center;padding:19px 0;border-top:1px solid var(--line)}
+#bom-root .bom-proposal-line h4{font-size:17px;margin:0 0 5px}
+#bom-root .bom-proposal-line p{margin:0}
+#bom-root .bom-recommended{text-align:right}
+#bom-root .bom-recommended>strong{font-size:21px;white-space:nowrap}
+#bom-root .bom-adjust summary{font-size:12px;font-weight:400;color:var(--muted)}
+#bom-root .bom-adjust label{font-size:12px;max-width:210px;margin-left:auto}
+#bom-root .bom-adjust input{text-align:right}
+#bom-root .bom-approve{display:flex;width:100%;padding:15px 20px;margin:18px 0 10px;background:#167443;border-color:#167443;font-size:16px;white-space:normal}
+#bom-root .bom-approve:hover:not(:disabled){background:#125e37}
+#bom-root .bom-order-section,#bom-root .bom-audit{border-top:1px solid var(--line);margin-top:26px;padding-top:24px}
+#bom-root .bom-draft{border:1px solid #cbd9c3;border-radius:10px;padding:20px;background:#f5f8f0}
+#bom-root .bom-draft-text{white-space:pre-wrap;overflow-wrap:anywhere;margin:18px 0;font-family:inherit;font-size:14px;line-height:1.85}
+#bom-root .bom-draft-actions{display:flex;gap:10px;flex-wrap:wrap}
+#bom-root .bom-draft-actions button{white-space:normal}
+#bom-root .bom-exact-log{font-family:inherit}
+#bom-root .small-copy{font-size:12px}
+#bom-root .empty-state{min-height:100px;font-size:14px}
+#bom-root .audit-log li{grid-template-columns:145px 1fr;font-size:14px}
+#bom-root .audit-log time,#bom-root .audit-log strong,#bom-root .audit-log p{font-size:12px}
+@media(max-width:800px){#bom-root .bom-controls{grid-template-columns:1fr 1fr}#bom-root .bom-controls label:first-child{grid-column:1/-1}#bom-root .bom-controls>.button{grid-column:1/-1}#bom-root .bom-stock-grid{grid-template-columns:1fr 1fr}}
+@media(max-width:520px){#bom-root .section-top{flex-direction:column;align-items:stretch}#bom-root .soft-badge{align-self:flex-start}#bom-root .bom-sale-card{padding:16px}#bom-root .bom-proposal-line{grid-template-columns:1fr}#bom-root .bom-recommended{text-align:left}#bom-root .bom-adjust label{margin-left:0}#bom-root .bom-demand-grid{grid-template-columns:1fr}#bom-root .bom-draft{padding:15px}#bom-root .bom-draft-actions button{width:100%}#bom-root .audit-log li{grid-template-columns:1fr;gap:2px}}
+
+#bom-root .audit-log li.bom-approved-log{display:block;color:#167443}#bom-root .audit-log li.bom-approved-log p{color:inherit;font-weight:600}
