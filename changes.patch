+"""Build the public site and browser-local demonstration. No private runtime is read."""
+import argparse
+import re
+from html import escape
+from html import unescape
+from pathlib import Path
+from urllib.parse import urlsplit
+
+BASE = Path(__file__).resolve().parent
+CONTACT = 'Contact the application owner using the developer support email shown on Google’s authorization screen.'
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--site-origin', default='https://deluxe-chimera-c9f59e.netlify.app', help='Canonical public HTTPS origin, without a path.')
+args = parser.parse_args()
