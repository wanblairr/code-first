+"""Undo-last-sale safety: exact inverse, durable retries, CAS, migration and audit."""
+import copy
+import json
+import tempfile
+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from unittest.mock import patch
+
+from cafe_bom import BOMRepository, MAX_SAFE, initial_stock, load_bom_data
+from cafe_core import CafeError, canonical, fingerprint
+from cafe_service import WorkflowStore
+
+DATA = load_bom_data()
+
+
+def sale(quantity=1):
+    return {"productId": "BV-013", "size": "中杯", "quantity": quantity}
+
+
+def context():
+    return {"targetDate": "2026-10-24", "forecastCups": 200, "referenceCups": 200,
+            "signature": "undo-test-context", "weather": {"temperatureC": 27, "precipitationMm": 24},
+            "holiday": {"isHoliday": False}}
+
+
+class BOMUndoTests(unittest.TestCase):
+    def setUp(self):
+        self.scratch = Path(tempfile.gettempdir()).resolve()
+        self.temporary = tempfile.TemporaryDirectory(prefix="cafe-bom-undo-", dir=self.scratch)
+        self.base = Path(self.temporary.name).resolve()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-undo-")
+        self.store = WorkflowStore(self.base / "workflow.sqlite3")
+        self.repo = BOMRepository(self.store, DATA)
+
+    def tearDown(self):
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-undo-")
+        self.temporary.cleanup()
+
+    def undo(self, revision=1, request_id="undo-1", transaction_id="sale-1"):
+        return self.repo.undo_sale(revision, request_id, transaction_id)
+
+    def restart(self, store=None, data=None):
+        return BOMRepository(store or WorkflowStore(self.base / "workflow.sqlite3"), data or DATA)
+
+    def count_undo_requests(self):
+        with self.store.connect() as db:
+            return db.execute("SELECT COUNT(*) FROM bom_undo_requests").fetchone()[0]
+
+    def remove_feature_tables_to_emulate_original_v36(self, store=None):
+        with (store or self.store).connect() as db:
+            db.execute("DROP TABLE bom_last_transaction")
+            db.execute("DROP TABLE bom_undo_requests")
+
+    def test_exact_36_cup_inverse_restores_both_ingredients_and_clears_marker(self):
+        self.assertIsNone(self.repo.snapshot()["last_transaction"])
+        result = self.repo.simulate_sale(sale(36), 0, "sale-1")
+        last = self.repo.snapshot()["last_transaction"]
+        self.assertEqual(last, {"transaction_id": "sale-1", "sale": sale(36),
+                                "consumed": {"INV-001": 648, "INV-005": 5400},
+                                "stock_revision": 1, "can_undo": True})
+        undone = self.undo()
+        self.assertEqual(undone["restored"], result["consumed"])
+        self.assertEqual(undone["stock"], initial_stock(DATA))
+        self.assertEqual(undone["revision"], 2)
+        self.assertIsNone(self.repo.snapshot()["last_transaction"])
+        self.assertEqual(self.repo.snapshot()["revision"], 2)
+        events = [e for e in self.repo.snapshot()["events"] if e["action"] == "bom_sale_undone"]
+        self.assertEqual(len(events), 1)
+        self.assertEqual(json.loads(events[0]["detail"])["transaction_id"], "sale-1")
+
+    def test_finished_goods_and_water_ice_recipes_restore_every_original_base_unit(self):
+        for index, original_sale in enumerate((
+            {"productId": "BK-01", "size": "份", "quantity": 3},
+            {"productId": "BV-020", "size": "中杯", "quantity": 2},
+        )):
+            with self.subTest(product=original_sale["productId"]):
+                store = WorkflowStore(self.base / ("unit-family-" + str(index) + ".sqlite3"))
+                repo = self.restart(store)
+                before = repo.snapshot()["stock"]
+                sold = repo.simulate_sale(original_sale, 0, "unit-family-sale")
+                restored = repo.undo_sale(1, "unit-family-undo", "unit-family-sale")
+                self.assertEqual(restored["restored"], sold["consumed"])
+                self.assertEqual(restored["stock"], before)
+                if original_sale["productId"] == "BV-020":
+                    self.assertEqual(restored["restored"]["AUX-ICE"], 160)
+                    self.assertEqual(restored["restored"]["AUX-COLD"], 300)
+                    self.assertEqual(restored["restored"]["INV-012"], 10)
+                else:
+                    self.assertEqual(restored["restored"], {"BK-01": 3})
