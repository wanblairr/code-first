+"""Isolated WhatsApp transport/config tests. No provider or private runtime access."""
+from __future__ import annotations
+
+import io
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from urllib import error, parse
+
+from cafe_core import CafeError
+from cafe_integrations_config import IntegrationConfig
+from cafe_whatsapp import WhatsAppAPIError, WhatsAppCloudClient, _NoRedirect
+
+
+TOKEN = "EAA_test_whatsapp_token_1234567890"
+PHONE_ID = "123456789012345"
+WABA_ID = "987654321098765"
+TO = "60123456789"
+PARAMETERS = ["2026-10-23", "demo-order-001", "Fresh milk 18 cartons; Oat milk 8 cartons"]
+
+
+def template(**updates):
+    result = {"id": "333333333333333", "name": "cafe_procurement", "language": "en_US", "status": "APPROVED",
+              "parameter_format": "POSITIONAL", "components": [
+                  {"type": "BODY", "text": "Delivery {{1}}. Order {{2}}. Items: {{3}}"},
+                  {"type": "FOOTER", "text": "Demonstration request only."}]}
+    result.update(updates)
+    return result
+
+
+class Response:
+    def __init__(self, data, status=200, final_url=None):
+        self.raw = data if isinstance(data, bytes) else json.dumps(data).encode()
+        self.status = status
+        self.final_url = final_url
+        self.closed = False
+
+    def getcode(self):
+        return self.status
+
+    def read(self, maximum):
+        return self.raw[:maximum]
+
+    def close(self):
+        self.closed = True
+
+    def geturl(self):
+        return self.final_url
+
+
+class Opener:
+    def __init__(self, *responses):
+        self.responses = list(responses)
+        self.requests = []
+
+    def open(self, req, timeout):
+        self.requests.append((req, timeout))
+        response = self.responses.pop(0)
+        if isinstance(response, Exception):
+            raise response
+        # Model a normal urllib response's original URL unless testing redirect.
+        if isinstance(response, Response) and response.final_url is None:
+            response.final_url = req.full_url
+        return response
+
+
+def client(opener, **kwargs):
+    return WhatsAppCloudClient("v23.0", PHONE_ID, TOKEN, WABA_ID, opener=opener, **kwargs)
+
+
+class WhatsAppTransportTests(unittest.TestCase):
+    def test_connection_is_read_only_metadata_for_exact_sender(self):
+        response = Response({"id": PHONE_ID, "display_phone_number": "+1 555 0123", "verified_name": "Cafe Demo"})
+        opener = Opener(response)
+        result = client(opener).check_connection()
+        self.assertTrue(result["connected"])
+        self.assertEqual(len(opener.requests), 1)
+        req, timeout = opener.requests[0]
+        self.assertEqual(req.get_method(), "GET")
+        self.assertEqual(timeout, 10)
+        self.assertTrue(req.full_url.startswith("https://graph.facebook.com/v23.0/" + PHONE_ID + "?"))
+        self.assertNotIn(TOKEN, req.full_url)
+        self.assertEqual(req.get_header("Authorization"), "Bearer " + TOKEN)
+        self.assertNotIn(TOKEN, json.dumps(result))
+        self.assertTrue(response.closed)
+
+    def test_connection_rejects_different_sender(self):
+        with self.assertRaises(WhatsAppAPIError):
+            client(Opener(Response({"id": "99999"}))).check_connection()
+
+    def test_preview_fetches_approved_template_and_never_sends(self):
+        opener = Opener(Response({"data": [template()]}))
+        result = client(opener).preview_template("+" + TO, "cafe_procurement", "en_US", PARAMETERS)
+        self.assertFalse(result["sent"])
+        self.assertEqual(result["template"]["parameter_count"], 3)
+        self.assertEqual(result["template"]["body"], template()["components"][0]["text"])
+        self.assertIn("18 cartons", result["body"])
+        self.assertTrue(result["body"].endswith("Demonstration request only."))
+        self.assertEqual([req.get_method() for req, unused in opener.requests], ["GET"])
+        query = parse.parse_qs(parse.urlsplit(opener.requests[0][0].full_url).query)
+        self.assertEqual(query["name"], ["cafe_procurement"])
+        self.assertEqual(result["payload"]["to"], TO)
+
+    def test_preview_parameter_text_is_not_recursively_interpolated(self):
+        values = ["2026-10-23 {{2}}", "ORDER_ID", "<script>not HTML</script>"]
+        result = client(Opener(Response({"data": [template()]}))).preview_template(TO, "cafe_procurement", "en_US", values)
+        self.assertIn("2026-10-23 {{2}}", result["body"])
+        self.assertEqual(result["body"].count("ORDER_ID"), 1)
+        self.assertIn("<script>not HTML</script>", result["body"])
+
+    def test_template_must_match_unique_name_language_and_approved_status(self):
+        invalid = [[], [template(status="PENDING")], [template(language="ms")],
+                   [template(name="other_template")], [template(), template()],
+                   [template(parameter_format="NAMED")]]
+        for rows in invalid:
+            with self.subTest(rows=rows), self.assertRaises(CafeError):
+                client(Opener(Response({"data": rows}))).get_template("cafe_procurement", "en_US")
+
+    def test_only_three_ordered_body_parameters_and_optional_static_footer(self):
+        components = [
+            [{"type": "BODY", "text": "{{1}} {{2}}"}],
+            [{"type": "BODY", "text": "{{1}} {{2}} {{3}} {{4}}"}],
+            [{"type": "BODY", "text": "{{1}} {{3}} {{2}}"}],
+            [{"type": "BODY", "text": "{{1}} {{2}} {{3}} {{name}}"}],
+            [{"type": "BODY", "text": "{{1}} {{2}} {{3}}"}, {"type": "FOOTER", "text": "{{1}}"}],
+            [{"type": "BODY", "text": "{{1}} {{2}} {{3}}"}, {"type": "HEADER", "text": "Static header"}],
+            [{"type": "BODY", "text": "{{1}} {{2}} {{3}}"}, {"type": "BUTTONS", "buttons": []}],
+            [{"type": "FOOTER", "text": "No body"}],
+        ]
+        for value in components:
+            with self.subTest(components=value), self.assertRaises(CafeError):
+                client(Opener(Response({"data": [template(components=value)]}))).get_template("cafe_procurement", "en_US")
+
+    def test_sending_is_one_explicit_post_without_hidden_get(self):
+        opener = Opener(Response({"messaging_product": "whatsapp", "messages": [{"id": "wamid.testaccepted123=="}]}))
+        result = client(opener).send_template(TO, "cafe_procurement", "en_US", PARAMETERS)
+        self.assertEqual(result, {"message_id": "wamid.testaccepted123==", "status": "accepted", "delivery_confirmed": False})
+        self.assertEqual(len(opener.requests), 1)
+        req = opener.requests[0][0]
+        self.assertEqual(req.full_url, f"https://graph.facebook.com/v23.0/{PHONE_ID}/messages")
+        self.assertEqual(req.get_method(), "POST")
+        payload = json.loads(req.data)
+        self.assertEqual(payload["type"], "template")
+        self.assertEqual([p["text"] for p in payload["template"]["components"][0]["parameters"]], PARAMETERS)
+        self.assertNotIn("text", payload)
+
+    def test_hello_world_is_separate_explicit_test_template(self):
+        opener = Opener(Response({"messages": [{"id": "wamid.testhello"}]}))
+        client(opener).hello_world_test(TO)
+        payload = json.loads(opener.requests[0][0].data)
+        self.assertEqual(payload["template"], {"name": "hello_world", "language": {"code": "en_US"}})
+
+    def test_no_free_form_send_method(self):
+        self.assertFalse(hasattr(client(Opener()), "send_text"))
+
+    def test_invalid_inputs_never_reach_network(self):
+        opener = Opener()
+        adapter = client(opener)
+        for recipient in ("01234567", "60123", "60123456789?x=1", "+60 123456789", None):
+            with self.subTest(recipient=recipient), self.assertRaises(CafeError):
+                adapter.send_template(recipient, "cafe_procurement", "en_US", PARAMETERS)
+        for params in ([], ["one"], ["a", "b", "c", "d"], ["a", "b", "bad\nnewline"], ["a", "b", "x" * 1025]):
+            with self.subTest(parameters=params), self.assertRaises(CafeError):
+                adapter.send_template(TO, "cafe_procurement", "en_US", params)
+        self.assertEqual(opener.requests, [])
+
+    def test_invalid_client_credentials_urls_and_version_rejected(self):
+        for version in ("latest", "v23.0/../../", "https://evil.example", "23", "v23.0\n"):
+            with self.subTest(version=version), self.assertRaises(CafeError):
+                WhatsAppCloudClient(version, PHONE_ID, TOKEN)
+        for identifier in ("https://evil.example", "123/abc", "", "1?access_token=x"):
+            with self.subTest(identifier=identifier), self.assertRaises(CafeError):
+                WhatsAppCloudClient("v23.0", identifier, TOKEN)
+        for token in ("Bearer " + TOKEN, "short", TOKEN + "\n"):
+            with self.subTest(token=token), self.assertRaises(CafeError):
+                WhatsAppCloudClient("v23.0", PHONE_ID, token)
+        self.assertNotIn(TOKEN, repr(client(Opener())))
+
+    def test_missing_waba_blocks_template_fetch_before_network(self):
+        opener = Opener()
+        adapter = WhatsAppCloudClient("v23.0", PHONE_ID, TOKEN, opener=opener)
+        with self.assertRaises(CafeError):
+            adapter.get_template("cafe_procurement", "en_US")
+        self.assertEqual(opener.requests, [])
+
+    def test_redirects_never_forward_token_and_post_outcome_is_unknown(self):
+        self.assertIsNone(_NoRedirect().redirect_request(None, None, 302, "redirect", {}, "https://evil.example"))
+        opener = Opener(Response({}, status=302))
+        with self.assertRaises(WhatsAppAPIError) as caught:
+            client(opener).send_template(TO, "cafe_procurement", "en_US", PARAMETERS)
+        self.assertTrue(caught.exception.outcome_unknown)
+        self.assertEqual(len(opener.requests), 1)
+        with self.assertRaises(WhatsAppAPIError):
+            client(Opener(Response({"id": PHONE_ID}, final_url="https://evil.example"))).check_connection()
+
+    def test_http_errors_expose_no_provider_body_and_no_retry(self):
+        for status in (400, 401, 403, 429, 500):
+            failure = error.HTTPError("https://graph.facebook.com", status, TOKEN, {}, io.BytesIO(TOKEN.encode()))
+            opener = Opener(failure)
+            with self.subTest(status=status), self.assertRaises(WhatsAppAPIError) as caught:
+                client(opener).send_template(TO, "cafe_procurement", "en_US", PARAMETERS)
+            self.assertNotIn(TOKEN, str(caught.exception))
+            self.assertEqual(caught.exception.outcome_unknown, status >= 500)
+            self.assertEqual(len(opener.requests), 1)
+
+    def test_timeout_after_post_retains_unknown_result_no_retry(self):
+        opener = Opener(error.URLError("provider detail " + TOKEN))
+        with self.assertRaises(WhatsAppAPIError) as caught:
+            client(opener).send_template(TO, "cafe_procurement", "en_US", PARAMETERS)
+        self.assertTrue(caught.exception.outcome_unknown)
+        self.assertNotIn(TOKEN, str(caught.exception))
+        self.assertEqual(len(opener.requests), 1)
+
+    def test_ambiguous_success_json_and_token_echo_never_become_message_ids(self):
+        escaped = "".join("\\u%04x" % ord(c) for c in TOKEN)
+        invalid = [b'not JSON', b'{"messages":[],"messages":[]}', b'{"value":NaN}',
+                   json.dumps({"messages": [{"id": TOKEN}]}).encode(),
+                   ('{"unknown":"' + escaped + '","messages":[{"id":"wamid.ok"}]}').encode(),
+                   b'{"messages":[{"id":"missing-prefix"}]}', b'[]', b'x' * 131073]
+        for raw in invalid:
+            with self.subTest(raw=raw[:35]), self.assertRaises(WhatsAppAPIError) as caught:
+                client(Opener(Response(raw))).send_template(TO, "cafe_procurement", "en_US", PARAMETERS)
+            self.assertTrue(caught.exception.outcome_unknown)
+            self.assertNotIn(TOKEN, str(caught.exception))
+
+
+class WhatsAppConfigurationTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory(prefix="cafe-whatsapp-config-")
+        self.addCleanup(temporary.cleanup)
+        self.runtime = Path(temporary.name) / "runtime"
+        self.config = IntegrationConfig(self.runtime)
+        environment = patch.dict(os.environ, {}, clear=True)
+        environment.start()
+        self.addCleanup(environment.stop)
+
+    def configure(self):
