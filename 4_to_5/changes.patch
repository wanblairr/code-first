+++ b/public_website/dist/demo/catalog.js
@@ -0,0 +1,48 @@
+/* Procurement catalogue and integer-cent arithmetic. No network or credentials. */
+export const CURRENCY='MYR';
+export const MAX_CUSTOM_ITEMS=20;
+const CATEGORIES=new Set(['sweeteners','flavourings','tea','dairy','bakery','packaging','cleaning','other']);
+const UNITS=new Set(['bag','box','bottle','kg','L','pcs']);
+const DEFAULT_PRICES={coffee_beans:2250,milk:800,oat_milk:1200,cup:2500};
+function boundedInteger(n,max,label){if(!Number.isSafeInteger(n)||n<0||n>max)throw new Error(label+' is outside the allowed range.');return n;}
+function text(value,label){if(typeof value!=='string'||!value.trim()||value.trim().length>80||/[\u0000-\u001f\u007f]/.test(value))throw new Error(label+' must be 1–80 characters without control characters.');return value.trim();}
+export function moneyToCents(value){
+  if(typeof value!=='string'&&typeof value!=='number')throw new Error('Enter a price with at most two decimal places.');
+  const s=String(value).trim();if(!/^\d{1,5}(?:\.\d{1,2})?$/.test(s))throw new Error('Enter a price with at most two decimal places.');
+  const [whole,decimal='']=s.split('.');return boundedInteger(Number(whole)*100+Number(decimal.padEnd(2,'0')),1000000,'Price');
+}
+export function formatMoney(cents){return Number.isSafeInteger(cents)&&cents>=0?'MYR '+Math.floor(cents/100).toLocaleString('en-MY')+'.'+String(cents%100).padStart(2,'0'):'—';}
+export function createDefaultCatalog(model){
+ const seed=[['brown_sugar','Brown sugar','sweeteners','kg',550,'BEANS_DEMO'],['vanilla_syrup','Vanilla syrup','flavourings','bottle',2800,'BEANS_DEMO'],['chocolate_powder','Chocolate powder','flavourings','bag',2500,'BEANS_DEMO'],['matcha','Matcha powder','tea','bag',3500,'BEANS_DEMO'],['black_tea','Black tea','tea','bag',1200,'BEANS_DEMO'],['cream','Cream','dairy','L',1800,'DAIRY_DEMO'],['napkin','Napkins','packaging','box',600,'PACKAGING_DEMO'],['lid','Cup lids','packaging','bag',800,'PACKAGING_DEMO']];
+ return normalizeCatalog({version:1,currency:CURRENCY,prices:Object.fromEntries(model.inventory.map(i=>[i.ingredient_id,DEFAULT_PRICES[i.ingredient_id]??0])),customItems:seed.map(([id,name,category,unit,unitPriceCents,supplierId])=>({id:'custom_'+id,name,category,unit,quantity:0,unitPriceCents,supplierId:model.suppliers.some(s=>s.supplier_id===supplierId)?supplierId:model.suppliers[0].supplier_id}))},model);
+}
+export function normalizeCatalog(input,model){
+ if(!input||input.version!==1||input.currency!==CURRENCY||!input.prices||typeof input.prices!=='object'||Array.isArray(input.prices)||!Array.isArray(input.customItems)||input.customItems.length>MAX_CUSTOM_ITEMS)throw new Error('Invalid procurement catalogue (maximum 20 additional products).');
+ const prices={};for(const i of model.inventory)prices[i.ingredient_id]=boundedInteger(input.prices[i.ingredient_id],1000000,'Price');
+ if(Object.keys(input.prices).some(id=>!model.inventory.some(i=>i.ingredient_id===id)))throw new Error('Unknown standard material price.');
+ const seen=new Set();const customItems=input.customItems.map(i=>{
+  if(!i||typeof i.id!=='string'||!/^custom_[A-Za-z0-9_-]{1,64}$/.test(i.id)||seen.has(i.id))throw new Error('Invalid or duplicate product ID.');seen.add(i.id);
+  if(!CATEGORIES.has(i.category)||!UNITS.has(i.unit)||!model.suppliers.some(s=>s.supplier_id===i.supplierId))throw new Error('Choose a valid category, purchase unit and supplier.');
+  return {id:i.id,name:text(i.name,'Product name'),category:i.category,unit:i.unit,quantity:boundedInteger(i.quantity,10000,'Quantity'),unitPriceCents:boundedInteger(i.unitPriceCents,1000000,'Price'),supplierId:i.supplierId};
+ });return {version:1,currency:CURRENCY,prices,customItems};
+}
+export function applyCatalog(proposal,input,model){
+ const catalog=normalizeCatalog(input,model);
+ const suppliers=Object.fromEntries(model.suppliers.map(s=>[s.supplier_id,s]));
+ const standard=proposal.lines.map(line=>({...line,manual:false,category:['milk','oat_milk'].includes(line.ingredientId)?'dairy':line.ingredientId==='cup'?'packaging':'other',currency:CURRENCY,unitPriceCents:catalog.prices[line.ingredientId]}));
+ const extra=catalog.customItems.filter(i=>i.quantity>0).map(i=>({ingredientId:i.id,name:i.name,manual:true,category:i.category,currency:CURRENCY,unitPriceCents:i.unitPriceCents,unit:i.unit,stock:0,required:0,shortage:0,safetyStock:0,dueInbound:0,packSize:1,packUnit:i.unit,recommendedPacks:i.quantity,referencePacks:i.quantity,packImpact:0,supplierId:i.supplierId,supplierName:suppliers[i.supplierId].name,to:suppliers[i.supplierId].email,minOrder:0,maxOrder:10000,storageCapacity:10000}));
+ return {...proposal,currency:CURRENCY,catalog,lines:[...standard,...extra]};
+}
+export function lineCost(packs,unitPriceCents){boundedInteger(packs,10000,'Quantity');if(unitPriceCents===undefined||unitPriceCents===null)return null;return boundedInteger(packs*boundedInteger(unitPriceCents,1000000,'Price'),10000000000,'Line total');}
+export function sumCosts(lines){if(lines.some(l=>l.lineTotalCents===null||l.lineTotalCents===undefined))return null;let sum=0;for(const l of lines)sum=boundedInteger(sum+l.lineTotalCents,240000000000,'Total');return sum;}
+export function validateStoredPurchaseLine(row,supplierId,model){
+ if(!row||row.supplierId!==supplierId||!model.suppliers.some(s=>s.supplier_id===supplierId))throw new Error('Invalid supplier.');
+ const known=model.inventory.find(i=>i.ingredient_id===row.ingredientId);
+ if(known){if(known.supplier_id!==supplierId||row.packSize!==known.pack_size||row.unit!==known.unit||row.packUnit!==known.purchase_unit)throw new Error('Invalid material snapshot.');}
+ else if(row.manual!==true||!/^custom_[A-Za-z0-9_-]{1,64}$/.test(row.ingredientId)||!CATEGORIES.has(row.category)||!UNITS.has(row.unit)||row.packUnit!==row.unit||row.packSize!==1)throw new Error('Invalid manual product snapshot.');
+ const packs=boundedInteger(row.approvedPacks,10000,'Quantity');if(!packs)throw new Error('Empty purchase row.');
+ const quantity=packs*row.packSize;if(!Number.isFinite(quantity)||row.quantity!==quantity||(known&&(quantity<known.min_order||quantity>known.max_order||quantity>known.storage_capacity)))throw new Error('Invalid purchase quantity.');
+ const price=row.unitPriceCents===undefined||row.unitPriceCents===null?null:boundedInteger(row.unitPriceCents,1000000,'Price');const total=lineCost(packs,price);
+ if(row.lineTotalCents!==undefined&&row.lineTotalCents!==null&&row.lineTotalCents!==total)throw new Error('Invalid line total.');
+ return {ingredientId:row.ingredientId,name:known?known.name:text(row.name,'Product name'),manual:!known,category:row.category||'other',unit:row.unit,packUnit:row.packUnit,packSize:row.packSize,approvedPacks:packs,quantity,supplierId,unitPriceCents:price,lineTotalCents:total,currency:CURRENCY,remainingShortage:Number.isFinite(row.remainingShortage)&&row.remainingShortage>=0?row.remainingShortage:0};
+}
