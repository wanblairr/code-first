+function custom(id='test',price=10,supplierId='BEANS_DEMO'){return {id:'custom_'+id,name:'店铺 / Custom Matcha',category:'tea',unit:'bag',quantity:3,unitPriceCents:price,supplierId};}
+test('money uses exact cents and rejects fractional cents, negatives, infinity and excessive prices',()=>{assert.equal(moneyToCents('0.10'),10);assert.equal(moneyToCents('10000.00'),1000000);assert.equal(lineCost(3,10),30);assert.equal(formatMoney(30),'MYR 0.30');for(const v of ['-1','1.001','1e2','10000.01','NaN','',null])assert.throws(()=>moneyToCents(v));});
+test('catalogue starts with twelve editable kinds and zero optional manual purchases',()=>{const c=createDefaultCatalog(model);assert.equal(Object.keys(c.prices).length+c.customItems.length,12);assert.ok(c.customItems.every(i=>i.quantity===0));const p=applyCatalog(base(),c,model);assert.equal(p.lines.length,4);assert.ok(p.lines.every(l=>Number.isSafeInteger(l.unitPriceCents)));});
+test('catalogue rejects duplicate IDs, unknown suppliers, control text and oversized quantities',()=>{for(const edit of [c=>c.customItems.push(custom('x'),custom('x')),c=>c.customItems.push({...custom(),supplierId:'ATTACK'}),c=>c.customItems.push({...custom(),name:'bad\nname'}),c=>c.customItems.push({...custom(),quantity:10001}),c=>c.customItems.push({...custom(),unitPriceCents:1.1})]){const c=createDefaultCatalog(model);edit(c);assert.throws(()=>normalizeCatalog(c,model));}});
+test('manual products and price edits cannot mutate the base proposal or catalogue',()=>{const b=base(),original=JSON.stringify(b),c=createDefaultCatalog(model);c.customItems=[custom()];const p=applyCatalog(b,c,model);c.customItems[0].name='later edit';c.prices.milk=100;assert.equal(JSON.stringify(b),original);assert.equal(p.lines.at(-1).name,'店铺 / Custom Matcha');assert.equal(p.lines.find(l=>l.ingredientId==='milk').unitPriceCents,800);assert.equal(p.lines.at(-1).required,0);assert.equal(p.lines.at(-1).manual,true);});
+test('preview and supplier drafts include every manual product and exact supplier/grand totals',()=>{const c=createDefaultCatalog(model);c.customItems=[custom('tea',10),custom('dairy',125,'DAIRY_DEMO')];const p=applyCatalog(base(),c,model);const q=Object.fromEntries(p.lines.map(l=>[l.ingredientId,l.manual?3:1]));const preview=previewApproval(p,q,instant);assert.equal(preview.valid,true);assert.equal(preview.totalCents,2250+800+1200+2500+30+375);const drafts=createSupplierDrafts(p,q,'',instant);assert.equal(drafts.reduce((n,d)=>n+d.subtotalCents,0),preview.totalCents);assert.equal(drafts.flatMap(d=>d.lines).length,6);for(const d of drafts){assert.equal(d.subtotalCents,sumCosts(d.lines));assert.ok(d.body.includes(formatMoney(d.subtotalCents)));assert.equal(d.orderTotalCents,preview.totalCents);}assert.ok(drafts.some(d=>d.body.includes('店铺 / Custom Matcha')));});
+test('persisted custom snapshots validate exact totals and preserve original price despite catalog changes',()=>{const c=createDefaultCatalog(model);c.customItems=[custom()];const p=applyCatalog(base(),c,model);const line=previewApproval(p,{custom_test:3},instant).lines.find(l=>l.manual);const restored=validateStoredPurchaseLine(JSON.parse(JSON.stringify(line)),line.supplierId,model);assert.equal(restored.lineTotalCents,30);c.customItems[0].unitPriceCents=999;assert.equal(restored.unitPriceCents,10);assert.throws(()=>validateStoredPurchaseLine({...line,lineTotalCents:31},line.supplierId,model));assert.throws(()=>validateStoredPurchaseLine({...line,supplierId:'ATTACK'},'ATTACK',model));});
+test('legacy missing unit prices remain unknown and never turn into free purchases',()=>{const line=previewApproval(base(),{},instant).lines[0];assert.equal(line.lineTotalCents,null);assert.equal(sumCosts([line]),null);assert.equal(formatMoney(null),'—');});
