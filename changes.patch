+  toastTimer = setTimeout(() => show(elements.toast,false),5000);
+}
+function logEvent(title, detail = '') {
+  state.logs.unshift({at:Date.now(),title:cleanText(title,100),detail:cleanText(detail,700)});
+  state.logs = state.logs.slice(0,60);
+  renderLogs();
+}
+function defaultState() {
+  return {version:1,targetDate:tomorrowKL(),weatherMode:'live',holidayMode:'auto',inventory:createInitialInventory(model),catalog:createDefaultCatalog(model),weather:null,
