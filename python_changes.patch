+        self.log.configure(state="normal")
+        self.log.delete("1.0", "end")
+        self.log.insert("end", "\n".join(f"{e['at']} | {e['actor']} | {e['action']} | {e['detail']}" for e in snap["events"][-100:]))
+        self.log.configure(state="disabled")
+
+    def close(self):
+        self.cancel.set()
+        self.root.destroy()
+
+
+def launch():
+    root = tk.Tk()
+    CafeApp(root)
+    root.mainloop()
