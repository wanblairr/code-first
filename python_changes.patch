@@ -0,0 +1,321 @@
+"""Small fitted demand models, independent of Ollama; synthetic competition data only.
+
+No randomly shuffled time-series splits. Model/regularization selection uses the
+14 days before a final 14-day holdout. Every backtest prediction is made with a
+prefix ending before that target date. Reported scores concern synthetic units
+sold, not observed customer traffic or real-store performance.
+"""
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import math
+import random
+import statistics
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+
+from cafe_core import CafeError, save_json
+
+VERSION = "cafe-demand-ridge-v3.0"
+FEATURES = ["intercept"] + [f"weekday_{i}" for i in range(1, 7)] + [
+    "elapsed_weeks", "previous_observed", "same_weekday_mean_4", "recent_mean_7", "recent_mean_28"]
+MIN_ROWS = 56
+ALPHAS = (0.1, 1.0, 10.0, 100.0)
+
+
+def _digest(obj):
+    return hashlib.sha256(json.dumps(obj, ensure_ascii=False, allow_nan=False,
+                                    sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def _day(value):
+    try:
+        if not isinstance(value, str) or len(value) != 10:
+            raise ValueError
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise CafeError("销售日期须为 YYYY-MM-DD。") from None
+
+
+def validate_sales(sales):
+    if not isinstance(sales, list) or not sales or len(sales) > 100_000:
+        raise CafeError("sales 必须为非空列表，最多 100000 行。")
+    rows, seen = [], set()
+    required = {"date", "sku", "units", "stockout", "data_source"}
+    for raw in sales:
+        if not isinstance(raw, dict) or required - raw.keys() or raw.keys() - required - {"closed"}:
+            raise CafeError("销售列须为 date,sku,units,stockout,data_source，可选 closed。")
+        _day(raw["date"])
+        sku = raw["sku"]
+        if not isinstance(sku, str) or not sku.strip() or len(sku) > 80 or any(ord(c) < 32 for c in sku):
+            raise CafeError("SKU 必须为 1–80 字符的非空文本。")
+        if raw["data_source"] != "synthetic":
+            raise CafeError("比赛演示仅接受 synthetic 模拟数据。")
+        if type(raw["stockout"]) is not bool or type(raw.get("closed", False)) is not bool:
+            raise CafeError("stockout 和 closed 必须为布尔值。")
+        units = raw["units"]
+        if isinstance(units, bool) or not isinstance(units, (int, float)) or not math.isfinite(units) or not 0 <= units <= 100000:
+            raise CafeError("销售量必须是 0–100000 的有限数字。")
+        if raw.get("closed", False) and units != 0:
+            raise CafeError("休业日期销量必须为零。")
+        key = raw["date"], sku
+        if key in seen:
+            raise CafeError("同一天同一 SKU 的销售记录重复。")
+        seen.add(key)
+        rows.append(dict(raw, units=float(units), closed=raw.get("closed", False)))
+    return sorted(rows, key=lambda r: (r["date"], r["sku"]))
+
+
+def read_sales_csv(path):
+    path = Path(path)
+    if path.stat().st_size > 20_000_000:
+        raise CafeError("销售 CSV 超过 20 MB。")
+    with path.open(encoding="utf-8-sig", newline="") as f:
+        rows = list(csv.DictReader(f))
+    for row in rows:
+        try:
+            row["units"] = float(row["units"])
+            for key in ("stockout", "closed"):
+                if key not in row:
+                    continue
+                value = row[key].strip().lower()
+                if value not in ("true", "false", "1", "0"):
+                    raise ValueError
+                row[key] = value in ("true", "1")
+        except (KeyError, TypeError, ValueError):
+            raise CafeError("CSV 的 units/stockout/closed 格式无效。") from None
+    return validate_sales(rows)
+
+
+def _usable(rows):
+    # Sales during a stockout are a censored demand observation. Exclude them
+    # from both label fitting and lag estimates rather than learning low demand.
+    return [r for r in rows if not r["stockout"] and not r["closed"]]
+
+
+def _baseline(rows, target, kind):
+    valid = _usable(rows)
+    if not valid:
+        raise CafeError("没有可用的正常营业且未售罄记录。")
+    if kind == "previous_observed":
+        return valid[-1]["units"]
+    matching = [r["units"] for r in valid if _day(r["date"]).weekday() == target.weekday()][-4:]
+    return statistics.mean(matching or [r["units"] for r in valid[-7:]])
+
+
+def _features(rows, target, origin):
+    valid = _usable([r for r in rows if _day(r["date"]) < target])
+    if not valid:
+        raise CafeError("特征构建没有可用历史。")
+    def recent(days):
+        cutoff = target - timedelta(days=days)
+        values = [r["units"] for r in valid if _day(r["date"]) >= cutoff]
+        return statistics.mean(values or [valid[-1]["units"]])
+    return [1.0] + [float(target.weekday() == i) for i in range(1, 7)] + [
+        (target-origin).days/7, valid[-1]["units"],
+        _baseline(valid, target, "weekday_mean"), recent(7), recent(28)]
+
+
+def _examples(rows, origin):
+    result = []
+    for i, row in enumerate(rows):
+        if row["stockout"] or row["closed"] or len(_usable(rows[:i])) < 7:
+            continue
+        result.append((_features(rows[:i], _day(row["date"]), origin), row["units"]))
+    return result
+
+
+def _solve(matrix, rhs):
+    # Partial-pivot Gaussian elimination on a tiny positive ridge system.
+    a = [list(row) + [rhs[i]] for i, row in enumerate(matrix)]
+    n = len(a)
+    for col in range(n):
+        pivot = max(range(col, n), key=lambda i: abs(a[i][col]))
+        a[col], a[pivot] = a[pivot], a[col]
+        if abs(a[col][col]) < 1e-12:
+            raise CafeError("训练矩阵退化；请检查销售数据。")
+        divisor = a[col][col]
+        a[col] = [v/divisor for v in a[col]]
+        for i in range(n):
+            if i != col:
+                factor = a[i][col]
+                a[i] = [a[i][j]-factor*a[col][j] for j in range(n+1)]
+    return [row[-1] for row in a]
+
+
+def _fit(rows, alpha, origin):
+    examples = _examples(rows, origin)
+    if len(examples) < 14:
+        raise CafeError("可用于拟合的正常营业样本不足 14 条。")
+    n = len(FEATURES)
+    means = [0.0] + [statistics.mean(x[j] for x, _ in examples) for j in range(1, n)]
+    scales = [1.0] + [max(1e-8, statistics.pstdev(x[j] for x, _ in examples)) for j in range(1, n)]
+    matrix = [[0.0]*n for _ in range(n)]
+    rhs = [0.0]*n
+    for raw, label in examples:
+        x = [(raw[j]-means[j])/scales[j] for j in range(n)]
+        for j in range(n):
+            rhs[j] += x[j]*label
+            for k in range(n):
+                matrix[j][k] += x[j]*x[k]
+    for j in range(1, n):
+        matrix[j][j] += alpha
+    return {"weights": _solve(matrix, rhs), "means": means, "scales": scales,
+            "alpha": alpha, "fitted_rows": len(examples)}
+
+
+def _ridge_predict(fit, features):
+    result = sum(w*(x-m)/s for w, x, m, s in zip(
+        fit["weights"], features, fit["means"], fit["scales"]))
+    if not math.isfinite(result):
+        raise CafeError("预测值不是有限数字。")
+    return max(0.0, result)
+
+
+def _metric(actual, guesses):
+    errors = [abs(a-p) for a, p in zip(actual, guesses)]
+    total = sum(actual)
+    return {"n": len(actual), "mae_units": round(statistics.mean(errors), 4),
+            "wape": round(sum(errors)/total, 6) if total else None,
+            "bias_units": round(statistics.mean(p-a for a, p in zip(actual, guesses)), 4)}
+
+
+def _evaluate(rows, indices, algorithms, origin):
+    actual, guesses, details = [], {a: [] for a in algorithms}, []
+    for i in indices:
+        row = rows[i]
+        if row["stockout"] or row["closed"]:
+            continue
+        prefix, target = rows[:i], _day(row["date"])
+        actual.append(row["units"])
+        detail = {"date": row["date"], "actual_units": row["units"],
+                  "history_through": prefix[-1]["date"], "predictions": {}}
+        for algorithm in algorithms:
+            if algorithm.startswith("ridge:"):
+                fit = _fit(prefix, float(algorithm.split(":")[1]), origin)
+                guess = _ridge_predict(fit, _features(prefix, target, origin))
+            else:
+                guess = _baseline(prefix, target, algorithm)
+            guesses[algorithm].append(guess)
+            detail["predictions"][algorithm] = round(guess, 4)
+        details.append(detail)
+    if len(actual) < 7:
+        raise CafeError("验证或留出窗口有效标签少于 7 条；需要更多未售罄营业日。")
+    return {a: _metric(actual, g) for a, g in guesses.items()}, details
+
+
+def train(sales, output_path=None):
+    rows = validate_sales(sales)
+    models, report = {}, {}
+    for sku in sorted({r["sku"] for r in rows}):
+        series = [r for r in rows if r["sku"] == sku]
+        if len(series) < MIN_ROWS or len(_usable(series[:-28])) < 28:
+            raise CafeError(f"{sku} 至少需要 56 条日记录，前缀至少 28 条未售罄营业记录。")
+        origin = _day(series[0]["date"])
+        # Calendar windows retain their meaning when some dates are missing.
+        end = _day(series[-1]["date"])
+        holdout_start, validation_start = end-timedelta(days=13), end-timedelta(days=27)
+        validation_idx = [i for i, r in enumerate(series) if validation_start <= _day(r["date"]) < holdout_start]
+        holdout_idx = [i for i, r in enumerate(series) if _day(r["date"]) >= holdout_start]
+        if not validation_idx or len(_usable(series[:validation_idx[0]])) < 28:
+            raise CafeError(f"{sku} 在验证窗口之前须有至少 28 条有效营业记录。")
+        algorithms = ["previous_observed", "weekday_mean"] + [f"ridge:{a}" for a in ALPHAS]
+        scores, val_rows = _evaluate(series, validation_idx, algorithms, origin)
+        best_baseline = min(algorithms[:2], key=lambda a: scores[a]["mae_units"])
+        best_ridge = min(algorithms[2:], key=lambda a: scores[a]["mae_units"])
+        # Complexity must improve validation MAE by at least 1% to be deployed.
+        chosen = best_ridge if scores[best_ridge]["mae_units"] < scores[best_baseline]["mae_units"]*0.99 else best_baseline
+        # These held-out outcomes never participate in choosing algorithm/alpha.
+        held_scores, held_rows = _evaluate(series, holdout_idx,
+            list(dict.fromkeys([chosen, "previous_observed", "weekday_mean"])), origin)
+        fit = _fit(series, float(chosen.split(":")[1]), origin) if chosen.startswith("ridge:") else None
+        gaps = sum((_day(b["date"])-_day(a["date"])).days-1 for a, b in zip(series, series[1:]))
+        models[sku] = {"algorithm": chosen, "origin": origin.isoformat(),
+                       "trained_through": series[-1]["date"], "fit": fit}
+        report[sku] = {"selected_algorithm": chosen, "selection_rule": "validation MAE, ridge needs >=1% improvement over best baseline",
+            "validation_start": validation_start.isoformat(), "holdout_start": holdout_start.isoformat(),
+            "holdout_end": end.isoformat(), "validation_metrics": scores,
+            "holdout_metrics": held_scores, "validation_predictions": val_rows,
+            "holdout_predictions": held_rows, "records": len(series), "missing_calendar_days": gaps,
+            "excluded_stockout_labels": sum(r["stockout"] for r in series),
+            "excluded_closed_labels": sum(r["closed"] for r in series),
+            "deployment_fitted_through": series[-1]["date"]}
+    artifact = {"version": VERSION, "created_at_utc": datetime.now(timezone.utc).isoformat(),
+        "data_source": "synthetic", "training_data_sha256": _digest(rows),
+        "features": FEATURES, "models": models, "evaluation": report,
+        "notes": ["实际拟合的轻量需求模型；没有训练或微调 Llama 权重。",
+                  "仅模拟数据回测，不能解释为真实门店准确率；预测单位是各饮品份数，不是独立顾客人数。",
+                  "先按验证窗口选模型，最后 14 个自然日仅评估；部署参数随后使用全部历史重新拟合。",
+                  "历史缺日期不当作零销量；售罄和休业记录不作为正常需求标签；未知天气/活动未作为训练特征。",
+                  "滚动单步回测，每个目标只读取目标前记录；留出日前已观测标签可供随后目标使用。"],
+        "references": ["https://scikit-learn.org/stable/modules/generated/sklearn.linear_model.Ridge.html",
+                       "https://scikit-learn.org/stable/modules/generated/sklearn.model_selection.TimeSeriesSplit.html"]}
+    artifact["artifact_sha256"] = _digest(artifact)
+    if output_path is not None:
+        save_json(output_path, artifact)
+    return artifact
+
+
+def predict(model, sales, target_date):
+    if not isinstance(model, dict) or model.get("version") != VERSION or model.get("data_source") != "synthetic":
+        raise CafeError("模型版本或数据来源不兼容。")
+    if model.get("artifact_sha256") != _digest({k: v for k, v in model.items() if k != "artifact_sha256"}):
+        raise CafeError("模型文件完整性校验失败。")
+    target, rows = _day(target_date), validate_sales(sales)
+    if {r["sku"] for r in rows} != set(model["models"]):
+        raise CafeError("销售 SKU 与模型 SKU 不一致，请重新训练。")
+    if any(_day(r["date"]) >= target for r in rows):
+        raise CafeError("预测输入含目标日或未来销量，存在数据泄漏。")
+    output, warnings = [], []
+    for sku, spec in model["models"].items():
+        series = [r for r in rows if r["sku"] == sku]
+        if _day(spec["trained_through"]) >= target:
+            raise CafeError("模型训练包含预测日或未来日期，请使用更早的模型。")
+        if _day(series[-1]["date"]) != target-timedelta(days=1):
+            raise CafeError(f"{sku} 缺少预测前一天的销量；请更新数据，不能重复使用陈旧日数据。")
+        if len(_usable(series)) < 28:
+            raise CafeError(f"{sku} 至少需要 28 条有效历史记录。")
+        algorithm = spec["algorithm"]
+        units = _ridge_predict(spec["fit"], _features(series, target, _day(spec["origin"]))) if algorithm.startswith("ridge:") else _baseline(series, target, algorithm)
+        if units > 100000:
+            raise CafeError("预测超过 100000 份，请检查数据漂移。")
+        output.append({"sku": sku, "forecast_units": round(units, 3), "algorithm": algorithm,
+            "history_through": series[-1]["date"], "holdout_mae_units": model["evaluation"][sku]["holdout_metrics"][algorithm]["mae_units"]})
+        if series[-1]["stockout"]:
+            warnings.append(f"{sku} 最近一天售罄，销量低估需求；已排除该日标签和滞后值，需人工复核。")
+        if not algorithm.startswith("ridge:"):
+            warnings.append(f"{sku} 训练模型未在验证集优于基线，自动使用 {algorithm}。")
+    return {"target_date": target_date, "items": output, "warnings": warnings,
+            "data_source": "synthetic", "model_version": VERSION,
+            "model_sha256": model["artifact_sha256"],
+            "note": "模拟数据预测饮品销量，真实门店效果尚未验证；未预测独立顾客人数。"}
+
+
+def make_demo_sales(path, end_date="2026-10-22", days=180):
+    """Independent transparent stochastic generator, not learned model labels."""
+    if isinstance(days, bool) or not isinstance(days, int) or not 56 <= days <= 3660:
+        raise CafeError("模拟历史 days 须为 56–3660 整数。")
+    end, rng, rows = _day(end_date), random.Random(20261022), []
+    # Fixed synthetic generator parameters are scenarios, not business rules.
+    weekly = (0.92, 0.96, 0.99, 1.03, 1.12, 1.32, 1.20)
+    for i in range(days):
+        day = end-timedelta(days=days-1-i)
+        for sku, base, slope in (("espresso", 58, .035), ("latte", 76, .055), ("oat_latte", 34, .09)):
+            demand = max(0, round((base+slope*i)*weekly[day.weekday()] + rng.gauss(0, 3.5)))
+            stockout = i % 43 == 31 and sku == "oat_latte"
+            units = round(demand*.65) if stockout else demand
+            rows.append({"date": day.isoformat(), "sku": sku, "units": units,
+                         "stockout": stockout, "data_source": "synthetic", "closed": False})
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", newline="", encoding="utf-8-sig") as f:
+        writer = csv.DictWriter(f, fieldnames=["date", "sku", "units", "stockout", "data_source", "closed"])
+        writer.writeheader()
+        writer.writerows(rows)
+    save_json(path.with_name("data_manifest.json"), {"data_source": "synthetic", "seed": 20261022,
+        "generator": "cafe_forecast.make_demo_sales", "days": days, "end_date": end_date,
+        "contains_real_business_records": False,
+        "note": "公开生成公式包含周内差异、缓慢趋势、正态扰动与少量售罄；不是门店记录。"})
+    return rows
