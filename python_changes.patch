+"""Authenticated real-loopback HTTP coverage for the CSV BOM assistant."""
+import http.client
+import json
+import tempfile
+import threading
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+from cafe_auth import make_auth_policy
+from cafe_core import save_json
+from cafe_service import CafeService, SHANGHAI
+from cafe_web import make_server
+
+BASE = Path(__file__).resolve().parent.parent
+PASSWORD = "bom-v36-http-test-password"
+
+
+class BOMWebTests(unittest.TestCase):
+    def setUp(self):
+        self.scratch = Path(tempfile.gettempdir()).resolve()
+        self.temp = tempfile.TemporaryDirectory(prefix="cafe-bom-http-", dir=self.scratch)
+        self.base = Path(self.temp.name).resolve()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-http-")
+        self.instant = datetime(2026, 10, 23, 21, tzinfo=SHANGHAI)
+        self.auth_path = self.base / "auth-test.json"
+        save_json(self.auth_path, make_auth_policy(PASSWORD, iterations=100_000))
+        # HTTP client below uses http.client directly. Any provider via urllib is
+        # a test failure, including accidental weather refresh during state reads.
+        self.no_external = patch("urllib.request.OpenerDirector.open",
+                                 side_effect=AssertionError("BOM HTTP tests must not call external APIs"))
+        self.no_external.start()
+        self.addCleanup(self.no_external.stop)
+        self.cookie = self.csrf = ""
+        self.start_server()
+
+    def start_server(self):
+        self.service = CafeService(self.base, data_dir=BASE / "examples_v3", clock=lambda: self.instant)
+        self.service.bom_enabled = True
+        self.server = make_server(self.service, port=0, password_config=self.auth_path)
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+
+    def stop_server(self):
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(timeout=3)
+
+    def tearDown(self):
+        self.stop_server()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-http-")
+        self.temp.cleanup()
+
+    def request(self, method, path, body=None, headers=None):
+        connection = http.client.HTTPConnection("127.0.0.1", self.server.server_port, timeout=10)
+        values = {"Content-Type":"application/json", "Cookie":self.cookie, "X-CSRF-Token":self.csrf}
+        values.update(headers or {})
+        connection.request(method, path, json.dumps(body) if body is not None else None, values)
+        response = connection.getresponse()
+        status, response_headers, raw = response.status, dict(response.getheaders()), response.read()
+        connection.close()
+        body = json.loads(raw) if response_headers.get("Content-Type","").startswith("application/json") else raw.decode("utf-8")
+        return status, response_headers, body
+
+    def login(self):
+        status, headers, _ = self.request("POST", "/api/login", {"password":PASSWORD}, {"Cookie":""})
+        self.assertEqual(status, 200)
+        self.assertIn("HttpOnly", headers["Set-Cookie"])
+        self.assertIn("SameSite=Strict", headers["Set-Cookie"])
+        self.cookie = headers["Set-Cookie"].split(";")[0]
+        status, _, state = self.request("GET", "/api/bom/state")
+        self.assertEqual(status, 200)
+        self.csrf = state["csrf"]
+        return {"Cookie":self.cookie, "X-CSRF-Token":self.csrf}
+
+    def rain(self):
+        status, _, state = self.request("POST", "/api/bom/context", {
+            "weather_mode":"rain", "holiday_mode":"ordinary", "request_id":"http-rain-context",
+        })
+        self.assertEqual(status, 200, state)
+        self.assertTrue(state["context_ready"])
+        return state
+
+    def sale(self, quantity=36, revision=0, request_id="http-oat-36", headers=None):
+        return self.request("POST", "/api/bom/sale", {
+            "productId":"BV-013", "size":"中杯", "quantity":quantity,
+            "revision":revision, "request_id":request_id,
+        }, headers)
+
+    def suggest(self, headers=None):
+        status, _, state = self.request("POST", "/api/bom/suggest", {"request_id":"http-suggest"}, headers)
+        self.assertEqual(status, 200, state)
+        return state
+
+    @staticmethod
+    def approval(proposal, quantities=None, acknowledged=False):
+        return {
+            "proposal_id":proposal["id"], "revision":proposal["revision"],
+            "input_hash":proposal["input_hash"], "quantities":quantities or {},
+            "acknowledged":acknowledged, "request_id":"http-approve",
+        }
