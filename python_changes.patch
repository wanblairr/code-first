+    def test_all_bom_routes_require_owner_and_new_actions_require_csrf(self):
+        for path in ("/api/bom/state", "/api/bom/drafts/BOM-DRAFT-missing?format=txt"):
+            self.assertEqual(self.request("GET", path)[0], 401)
+        for action in ("sale","suggest","approve","preview","context"):
+            self.assertEqual(self.request("POST", "/api/bom/"+action, {})[0], 401)
+        self.assertEqual(self.request("POST", "/api/login", {"password":"incorrect"})[0], 401)
+        self.login()
+        for action in ("sale","suggest","approve","preview","context"):
+            self.assertEqual(self.request("POST", "/api/bom/"+action, {},
+                                          {"X-CSRF-Token":"invalid"})[0], 403)
+        self.assertEqual(self.service.bom_state()["revision"], 0)
+        self.assertFalse(self.service.bom_state()["proposals"])
+
+    def test_origin_host_cookie_and_json_guards_preserve_inventory(self):
+        self.login()
+        self.assertEqual(self.request("POST", "/api/bom/suggest", {},
+                                      {"Origin":"https://attacker.invalid"})[0], 403)
+        self.assertEqual(self.request("GET", "/api/bom/state",
+                                      headers={"Host":"attacker.invalid"})[0], 403)
+        self.assertEqual(self.request("GET", "/api/bom/state",
+                                      headers={"Cookie":"=broken"})[0], 401)
+        self.assertEqual(self.request("POST", "/api/bom/suggest", {},
+                                      {"Content-Type":"text/plain"})[0], 415)
+        self.rain()
+        origin = "http://127.0.0.1:" + str(self.server.server_port)
+        self.assertEqual(self.request("POST", "/api/bom/suggest", {}, {"Origin":origin})[0], 200)
+        self.assertEqual(self.service.bom_state()["revision"], 0)
