+      } catch {
+        await saveOutcome(store, key, claimed, {status: 'unknown'}, now);
+        throw failure('SEND_OUTCOME_UNKNOWN', 'Message acceptance was not confirmed. Check Meta; this matching message will not be sent again automatically.', 502, true);
