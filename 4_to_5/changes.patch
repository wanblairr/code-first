+      customItems:draft.customItems.map(item=>({
+        id:item.id,name:item.name.trim(),category:item.category,unit:item.unit,
+        quantity:/^[0-9]+$/.test(item.quantity) ? Number(item.quantity) : NaN,
+        unitPriceCents:moneyToCents(item.price),supplierId:item.supplierId
+      }))
+    };
+  }
+  function save(event) {
+    event.preventDefault();
+    for (const control of currentForm.querySelectorAll('input')) control.setCustomValidity('');
+    for (const control of currentForm.querySelectorAll('[data-price]')) {
+      if (safeMoney(control.value) === null) control.setCustomValidity(text('invalid'));
+    }
+    for (const control of currentForm.querySelectorAll('[data-product-name]')) {
+      if (!control.value.trim()) control.setCustomValidity(text('invalid'));
+    }
+    if (!currentForm.checkValidity()) { status('invalid',true); currentForm.reportValidity(); return; }
+    try {
+      const normalized = normalizeCatalog(canonicalDraft(),model);
+      onSave(normalized);
+      draft = cloneDraft(normalized);
+      dirty = false;
+      status('saved');
+      render({preserveDraft:true});
+    } catch { status('saveFailed',true); }
+  }
+  function addProduct() {
+    if (draft.customItems.length >= 20) { status('limit',true); return; }
+    const choice = TEMPLATES.find(item=>item.id === template) || TEMPLATES[TEMPLATES.length-1];
+    const suppliers = model.suppliers.map(item=>item.supplier_id);
+    const preferred = choice.category === 'dairy' ? 'DAIRY_DEMO' : ['packaging','cleaning'].includes(choice.category) ? 'PACKAGING_DEMO' : 'BEANS_DEMO';
+    const id = 'custom_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,8);
+    draft.customItems.push({id,name:choice.id === 'other' ? '' : text(choice.id),category:choice.category,unit:choice.unit,quantity:'1',price:'0.00',supplierId:suppliers.includes(preferred)?preferred:suppliers[0]});
+    dirty = true; isOpen = true; feedback = {key:'unsaved',error:false};
+    render({preserveDraft:true});
+    restoreFocus(id+'-name');
+  }
+  function render(settings={}) {
+    const active = document.activeElement;
+    const focused = container.contains(active) ? active.dataset.catalogFocus : null;
+    let start, end;
+    if (focused) { try { start = active.selectionStart; end = active.selectionEnd; } catch { /* No text selection. */ } }
+    isOpen = container.querySelector('details')?.open ?? isOpen;
+    if (settings.reload || (!dirty && !settings.preserveDraft)) {
+      draft = cloneDraft(normalizeCatalog(getCatalog(),model));
+      if (settings.reload) { dirty = false; feedback = null; }
+    }
+    lineOutputs = new Map();
+    const details = element('details','catalog-editor'); details.open = isOpen;
+    details.addEventListener('toggle',()=>{isOpen = details.open;});
+    const summary = element('summary');
+    summary.append(copy('title'));
+    const count = element('span','catalog-count');
+    count.textContent = String(CORE.length+draft.customItems.length);
+    count.setAttribute('aria-hidden','true');
+    summary.append(count);
+    const body = element('div','catalog-body');
+    body.append(paragraph('intro','catalog-intro'));
+    const form = element('form','catalog-form');
+    form.noValidate = true; currentForm = form;
+    form.addEventListener('submit',save);
+    const coreHeading = element('h3'); coreHeading.append(copy('standard'));
+    const prices = element('div','catalog-core-prices');
+    CORE.forEach(key=>{
+      const input = priceInput(draft.prices[key]); input.dataset.price = 'true';
+      input.addEventListener('input',()=>{draft.prices[key] = input.value; input.setCustomValidity(''); changed();});
+      prices.append(field(key,input,'price-'+key));
+    });
+    const extrasHeading = element('h3'); extrasHeading.append(copy('custom'));
+    const extras = element('div','catalog-products');
+    if (!draft.customItems.length) extras.append(paragraph('empty','catalog-empty'));
+    draft.customItems.forEach((item,index)=>{
+      const card = element('fieldset','catalog-product');
+      const legend = element('legend');
+      const countLabel = element('span','catalog-product-number'); countLabel.textContent = String(index+1).padStart(2,'0');
+      legend.append(countLabel,copy('manual')); card.append(legend);
+      const grid = element('div','catalog-product-grid');
+      const name = element('input'); name.type = 'text'; name.value = item.name; name.required = true; name.maxLength = 80; name.dataset.productName = 'true';
+      name.addEventListener('input',()=>name.setCustomValidity(''));
+      grid.append(field('name',changeBy(name,item,'name'),item.id+'-name'));
+      const category = element('select'); options(category,CATEGORIES,item.category);
+      grid.append(field('category',changeBy(category,item,'category'),item.id+'-category'));
+      const quantity = element('input'); quantity.type = 'number'; quantity.inputMode = 'numeric'; quantity.min = '0'; quantity.max = '10000'; quantity.step = '1'; quantity.required = true; quantity.value = item.quantity;
+      grid.append(field('quantity',changeBy(quantity,item,'quantity'),item.id+'-quantity'));
+      const unit = element('select'); options(unit,UNITS,item.unit);
+      grid.append(field('unit',changeBy(unit,item,'unit'),item.id+'-unit'));
+      const price = priceInput(item.price); price.dataset.price = 'true'; price.addEventListener('input',()=>price.setCustomValidity(''));
+      grid.append(field('price',changeBy(price,item,'price'),item.id+'-price'));
+      const supplier = element('select');
+      options(supplier,model.suppliers.map(row=>row.supplier_id),item.supplierId,id=>COPY[id]?text(id):model.suppliers.find(row=>row.supplier_id===id)?.name||id);
+      grid.append(field('supplier',changeBy(supplier,item,'supplierId'),item.id+'-supplier'));
+      const footer = element('div','catalog-product-footer');
+      const amount = element('div','catalog-line-total'); amount.append(copy('subtotal'));
+      const output = element('output'); lineOutputs.set(item.id,output); amount.append(output);
+      const remove = button('remove','catalog-remove',()=>{
+        draft.customItems = draft.customItems.filter(row=>row.id!==item.id);
+        changed(); render({preserveDraft:true});
+        const next = draft.customItems[Math.min(index,draft.customItems.length-1)];
+        restoreFocus(next ? next.id+'-name' : 'template');
+      });
+      remove.dataset.catalogFocus = item.id+'-remove';
+      remove.setAttribute('aria-label',text('remove')+' · '+(item.name||String(index+1)));
+      footer.append(amount,remove); card.append(grid,footer); extras.append(card);
+    });
+    const addBar = element('div','catalog-add-bar');
+    const picker = element('select'); options(picker,TEMPLATES.map(item=>item.id),template);
+    picker.addEventListener('change',()=>{template = picker.value;});
+    const add = button('add','button secondary catalog-add',addProduct);
+    add.disabled = draft.customItems.length >= 20;
+    add.dataset.catalogFocus = 'add';
+    addBar.append(field('template',picker,'template'),add);
+    const totals = element('div','catalog-extra-total'); totals.append(copy('customTotal'));
+    totalOutput = element('output'); totals.append(totalOutput);
+    const actions = element('div','catalog-actions');
+    const submit = button('save','button primary'); submit.type = 'submit'; submit.dataset.catalogFocus = 'save';
+    const discard = button('reset','text-button',()=>render({reload:true}));
+    discard.disabled = !dirty; discard.dataset.catalogFocus = 'discard';
+    actions.append(submit,discard);
+    liveStatus = element('p','catalog-status');
+    liveStatus.setAttribute('role','status'); liveStatus.setAttribute('aria-live','polite');
+    if (feedback) { liveStatus.append(copy(feedback.key)); liveStatus.classList.toggle('is-error',feedback.error); }
+    form.append(coreHeading,paragraph('standardHint','catalog-help'),prices,extrasHeading,extras,addBar,totals,
+      paragraph('estimate','catalog-help'),paragraph('original','catalog-help'),actions,liveStatus);
+    body.append(form); details.append(summary,body); container.replaceChildren(details);
+    updateAmounts(); restoreFocus(focused,start,end);
+  }
+  document.addEventListener('cafe:languagechange',()=>render({preserveDraft:true}));
+  render({preserveDraft:true});
+  return {render};
+}
