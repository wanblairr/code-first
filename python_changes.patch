+        auth = self.service.runtime / "catalog_test_auth.json"
+        save_json(auth, make_auth_policy("catalog-test-only"))
+        with patch("cafe_web.ThreadingHTTPServer", lambda address, handler: SimpleNamespace(RequestHandlerClass=handler, server_port=8765)):
+            self.server = make_server(self.service, password_config=auth)
+        self.cookie, self.csrf = "", ""
+
+    tearDown = CatalogWorkflowTests.tearDown
+    values = CatalogWorkflowTests.values
+    product = CatalogWorkflowTests.product
+
+    def request(self, method, path, data=None, headers=None):
+        import io
+        class StreamSocket:
+            def __init__(self, payload):
+                self.reader = io.BytesIO(payload)
+                self.output = []
+            def makefile(self, mode, *args):
+                return self.reader
+            def sendall(self, payload):
+                self.output.append(bytes(payload))
+            def settimeout(self, value):
+                pass
+            def getsockname(self):
+                return ("127.0.0.1", 8765)
+        body = b"" if data is None else json.dumps(data, ensure_ascii=False).encode("utf-8")
+        common = {"Host": "127.0.0.1:8765", "Content-Type": "application/json", "Content-Length": str(len(body)),
+                  "Cookie": self.cookie, "X-CSRF-Token": self.csrf}
+        common.update(headers or {})
+        head = method + " " + path + " HTTP/1.0\r\n" + "\r\n".join(key + ": " + value for key, value in common.items()) + "\r\n\r\n"
+        connection = StreamSocket(head.encode("ascii") + body)
+        self.server.RequestHandlerClass(connection, ("127.0.0.1", 32100), self.server)
+        header, content = b"".join(connection.output).split(b"\r\n\r\n", 1)
+        rows = header.decode("latin-1").split("\r\n")
+        return int(rows[0].split()[1]), {line.split(": ", 1)[0]: line.split(": ", 1)[1] for line in rows[1:]}, content
+
+    def login(self):
+        code, headers, body = self.request("POST", "/api/login", {"password": "catalog-test-only"})
+        self.assertEqual(code, 200)
+        self.cookie = headers["Set-Cookie"].split(";")[0]
+        code, headers, body = self.request("GET", "/api/state")
+        self.assertEqual(code, 200)
+        state = json.loads(body)
+        self.csrf = state["csrf"]
+        return state
+
+    def test_http_catalog_owner_csrf_and_origin_required(self):
+        values = self.values(products=[self.product()])
