+  try {
+    const drafts=value.drafts.map(draft=>{
+      const supplier=model.suppliers.find(s=>s.supplier_id===draft.supplierId);
+      if(!supplier||draft.to!==supplier.email||typeof draft.body!=='string'||draft.body.length>16000||typeof draft.subject!=='string'||draft.subject.length>300)throw Error('Invalid draft');
+      const lines=validatedPurchaseLines(draft.lines,supplier.supplier_id);
+      if(Array.isArray(draft.lines)&&!lines)throw Error('Invalid purchase lines');
+      const subtotalCents=lines?sumCosts(lines):null;
+      if(draft.subtotalCents!==undefined&&draft.subtotalCents!==null&&draft.subtotalCents!==subtotalCents)throw Error('Invalid supplier total');
