+            raise GmailOAuthError("Google 返回的令牌资料无效，请重新授权。", code="invalid_response", outcome_unknown=True) from None
+        except (TypeError, ValueError, OverflowError):
+            raise GmailOAuthError("Google 返回的令牌资料无效，请重新授权。", code="invalid_response", outcome_unknown=True) from None
+
+    def exchange_code(self, code, redirect_uri, code_verifier):
+        _ascii(code, "授权码", maximum=4096)
+        validate_redirect_uri(redirect_uri)
+        if not isinstance(code_verifier, str) or not _PKCE.fullmatch(code_verifier):
+            raise GmailOAuthError("PKCE 校验资料无效。", code="invalid_pkce")
+        values = {"client_id": self.client_id, "code": code, "code_verifier": code_verifier,
