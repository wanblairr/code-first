+    server={...server,revision:3,stock:{...server.stock,'INV-005':2600,'INV-001':11552},proposal:null,active_order_id:null,
+      events:[{action:'bom_sale_recorded',subject:body.request_id,request_id:body.request_id,at:'2026-10-24T01:00:00Z'}],
+      sale_result:{request_id:body.request_id,consumed:{'INV-005':5400,'INV-001':648}},
+      last_transaction:{transaction_id:'tx-sale-36',sale:{productId:'BV-013',size:'中杯',quantity:36},
+        consumed:{'INV-005':5400,'INV-001':648},stock_revision:3}};
+  };
+  globalThis.fetch=async(path,init)=>{
+    const payload=init.body?JSON.parse(init.body):null;requests.push({path,init,payload});
+    if(init.method==='GET')return {ok:true,status:200,json:async()=>structuredClone(server)};
+    assert.equal(init.headers['X-CSRF-Token'],'csrf-fixture');
+    assert.ok(payload.request_id);
+    if(path==='/api/bom/sale'){
