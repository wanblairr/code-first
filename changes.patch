+        self.assertTrue(state["context_ready"])
+        self.assertEqual(len(state["data"]["products"]),20)
+        self.assertEqual(self.service.bom().suggest()["proposal"]["target_date"],"2026-10-24")
+        self.assertFalse(self.service.data_dir.exists())
+
+    def test_bom_nightly_schedule_at_22_is_once_and_never_calls_old_trigger_or_runpod(self):
+        self.instant = datetime(2026,10,23,22,5,tzinfo=SHANGHAI)
+        self.rain()
+        with patch.object(self.service,"trigger",side_effect=AssertionError("legacy purchase trigger")), \
+             patch.object(self.service,"start_runpod_review",side_effect=AssertionError("paid review")), \
+             patch.object(self.service,"_cloud",side_effect=AssertionError("cloud scheduler")), \
+             patch.object(self.service,"refresh_weather",side_effect=AssertionError("scenario needs no API")):
+            result = self.service.scheduler_tick(self.instant.astimezone(timezone.utc))
+            self.assertTrue(result["id"].startswith("BOM-PROP-"))
+            self.assertEqual(result["target_date"],"2026-10-24")
+            self.assertIsNone(self.service.scheduler_tick(self.instant))
+        with self.service.store.connect() as db:
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM bom_schedule_days").fetchone()[0],1)
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM schedule_days").fetchone()[0],0)
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM proposals").fetchone()[0],0)
+        self.assertEqual(sum(e["action"]=="bom_scheduled_trigger_completed"
+                             for e in self.service.bom_state()["events"]),1)
+
