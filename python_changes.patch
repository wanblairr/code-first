+    def request(self, method, path, data=None, headers=None):
+        connection = http.client.HTTPConnection("127.0.0.1", self.server.server_port, timeout=10)
+        values = {"Content-Type": "application/json", "Cookie": self.cookie, "X-CSRF-Token": self.csrf}
+        values.update(headers or {})
+        connection.request(method, path, json.dumps(data) if data is not None else None, values)
+        response = connection.getresponse()
+        status, response_headers, payload = response.status, dict(response.getheaders()), response.read()
+        connection.close()
+        decoded = json.loads(payload) if response_headers.get("Content-Type", "").startswith("application/json") else payload.decode("utf-8")
+        return status, response_headers, decoded
+
+    def login(self):
+        status, headers, _ = self.request("POST", "/api/login", {"password": PASSWORD})
+        self.assertEqual(status, 200)
+        self.cookie = headers["Set-Cookie"].split(";")[0]
+        self.csrf = self.request("GET", "/api/state")[2]["csrf"]
