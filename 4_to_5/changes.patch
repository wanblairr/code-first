index 0000000000000000000000000000000000000000..a16723d8b9e17a2c5ce2d88fda2349a809fc6f2d
--- /dev/null
+++ b/public_website/dist/assets/language.js
@@ -0,0 +1,85 @@
+import {translateLocale} from '/demo/locales.js';
+
+const KEY='cafe-replenishment-interface-language-v1';
+const allowed=new Set(['en','zh','ms','es']);
+const languageNames={en:'English',zh:'中文',ms:'Bahasa Melayu',es:'Español'};
+let locale='en';
+try{const saved=localStorage.getItem(KEY);if(allowed.has(saved))locale=saved;}catch{}
+const normalize=text=>text.replace(/\s+/g,' ').trim();
+function readEnglish(element){const copy=element.cloneNode(true);copy.querySelectorAll('br').forEach(br=>br.replaceWith(document.createTextNode(' ')));return normalize(copy.textContent||'');}
+function addMissingTranslations(wrapper){
+  if(wrapper.dataset.languageFixed==='true')return;
+  if(wrapper.dataset.localeBusy==='true')return;
+  const en=Array.from(wrapper.children).find(child=>child.classList.contains('bi-en'));
+  if(!en)return;
+  const english=readEnglish(en);if(!english)return;
+  wrapper.dataset.localeBusy='true';
+  for(const code of ['ms','es']){
+    let target=Array.from(wrapper.children).find(child=>child.classList.contains(`bi-${code}`));
+    if(!target){target=document.createElement('span');target.className=`bi-${code}`;target.lang=code;wrapper.append(target);}
+    const translated=translateLocale(english,code);
+    const value=translated||english;
+    if(target.textContent!==value)target.textContent=value;
+    if(!translated)target.dataset.translationFallback='true';else delete target.dataset.translationFallback;
+  }
+  delete wrapper.dataset.localeBusy;
+}
+function applyAria(root=document){
+  for(const element of root.querySelectorAll('[data-aria-en]')){
+    const en=element.dataset.ariaEn,zh=element.dataset.ariaZh||en;
+    element.setAttribute('aria-label',locale==='zh'?zh:locale==='en'?en:translateLocale(en,locale)||en);
+  }
+}
+function applyOptions(root=document){
+  for(const option of root.querySelectorAll('option[data-i18n-en]')){
+    const en=option.dataset.i18nEn,zh=option.dataset.i18nZh||en;
+    const text=locale==='zh'?zh:locale==='en'?en:translateLocale(en,locale)||en;
+    if(option.textContent!==text)option.textContent=text;
+  }
+}
+function translateTree(root){
+  if(root.nodeType!==Node.ELEMENT_NODE)return;
+  if(root.matches('.bi'))addMissingTranslations(root);
+  root.querySelectorAll('.bi').forEach(addMissingTranslations);
+  applyOptions(root);applyAria(root);
+}
+function applyLanguage(value,save=false){
+  locale=allowed.has(value)?value:'en';
+  document.documentElement.dataset.language=locale;
+  document.documentElement.lang=locale==='zh'?'zh-Hans':locale;
+  applyOptions();applyAria();
+  for(const element of document.querySelectorAll('[data-placeholder-en]')){const en=element.dataset.placeholderEn;const text=locale==='zh'?element.dataset.placeholderZh||en:locale==='en'?en:translateLocale(en,locale)||en;element.setAttribute('placeholder',text);}
+  const page=location.pathname.startsWith('/demo')?'demo':location.pathname.startsWith('/privacy')?'privacy':location.pathname.startsWith('/terms')?'terms':'home';
+  const titles={en:{demo:'Visitor demo',privacy:'Privacy policy',terms:'Terms of use',home:'A calmer close'},zh:{demo:'访客演示',privacy:'隐私政策',terms:'使用条款',home:'从容收店，安心开门'},ms:{demo:'Demo pelawat',privacy:'Dasar privasi',terms:'Syarat penggunaan',home:'Tutup kedai dengan tenang'},es:{demo:'Demo para visitantes',privacy:'Política de privacidad',terms:'Condiciones de uso',home:'Un cierre más tranquilo'}};
+  document.title=`${titles[locale][page]} · Cafe Replenishment`;
+  document.querySelectorAll('[name="interface-language"]').forEach(input=>{input.checked=input.value===locale;});
+  if(save){try{localStorage.setItem(KEY,locale);}catch{}}
+  document.dispatchEvent(new CustomEvent('cafe:languagechange',{detail:{locale}}));
+}
+function message(en,zh,ms,es){
+  const wrapper=document.createElement('span');wrapper.className='bi';wrapper.dataset.languageFixed='true';
+  for(const [code,text] of Object.entries({en,zh,ms,es})){
+    const span=document.createElement('span');span.className=`bi-${code}`;span.lang=code==='zh'?'zh-Hans':code;span.textContent=text;wrapper.append(span);
+  }
+  return wrapper;
+}
+const dialog=document.createElement('dialog');dialog.id='interface-settings';dialog.className='language-dialog';dialog.setAttribute('aria-labelledby','interface-settings-title');
+const body=document.createElement('div');body.className='language-dialog-body';
+const heading=document.createElement('h2');heading.id='interface-settings-title';heading.append(message('Settings','设置','Tetapan','Ajustes'));
+const intro=document.createElement('p');intro.append(message('Choose the interface language.','选择界面语言。','Pilih bahasa antara muka.','Elige el idioma de la interfaz.'));
