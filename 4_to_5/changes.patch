+#bom-root .bom-approve:hover:not(:disabled){background:#125e37}
+#bom-root .bom-order-section,#bom-root .bom-audit{border-top:1px solid var(--line);margin-top:26px;padding-top:24px}
+#bom-root .bom-draft{border:1px solid #cbd9c3;border-radius:10px;padding:20px;background:#f5f8f0}
+#bom-root .bom-draft-text{white-space:pre-wrap;overflow-wrap:anywhere;margin:18px 0;font-family:inherit;font-size:14px;line-height:1.85}
