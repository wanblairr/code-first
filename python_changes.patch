+    def bom_approved_draft(self, draft_id):
+        if not isinstance(draft_id, str) or not draft_id.startswith("BOM-DRAFT-"):
+            raise CafeError("BOM草稿编号无效。")
+        draft, order = self.bom().approved_draft(draft_id)
+        # Compatibility view for existing Gmail/WhatsApp transports: one line
+        # denotes exactly the approved base-unit amount, not a guessed carton.
+        # Transports describe the approved complete-pack purchase while the
+        # immutable order retains its original base-unit requirement.
+        transport_items = []
+        for item in order["items"]:
+            quoted = item.get("price_known") and item.get("pack_quantity") is not None
+            transport_items.append(dict(item,
+                base_quantity=item["approved_quantity"],
+                approved_quantity=item["purchase_quantity"] if quoted else item["approved_quantity"],
+                pack_size=item["pack_quantity"] if quoted else max(1, item["approved_quantity"]),
+                unit_price_cents=item.get("pack_price_cents") if quoted else None,
+                purchase_unit="包" if quoted else "项"))
+        order = dict(order, items=transport_items)
+        return draft, order
