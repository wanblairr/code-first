+import {usage} from './bom-core.mjs?v=3.7.0';
+import {priceBOMRows} from './bom-pricing.mjs?v=3.7.0';
+import {forecastFromHistory, priceExtraPurchases} from './sales-learning.mjs';
+
+// Explicit public demonstration assumptions, not a model trained for 20 SKUs.
+// Existing synthetic weather/holiday forecast scales this fixed menu mix only.
+export const MENU_BASELINE = Object.freeze({
+  'BV-002':12, 'BV-003':20, 'BV-004':12, 'BV-005':10, 'BV-006':8,
+  'BV-010':8, 'BV-011':8, 'BV-013':20, 'BV-015':8, 'BV-016':8,
+  'BV-017':10, 'BV-020':10, 'BV-022':10, 'BV-023':8, 'BV-024':8,
+  'BK-01':20, 'BK-02':10, 'BK-05':14, 'BK-06':10, 'BK-08':6,
+});
+export const FORECAST_SOURCE = 'synthetic_menu_mix_scaled_by_context';
+const valid = value => Number.isSafeInteger(value) && value >= 0;
+const own = (object,key) => object && typeof object === 'object' && Object.hasOwn(object,key);
+
+function validDate(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  const date = new Date(value + 'T00:00:00.000Z');
+  return Number.isFinite(date.getTime()) && date.toISOString().slice(0,10) === value;
+}
+
+function nonempty(value) {
+  return typeof value === 'string' && value.trim().length > 0 && !value.includes('\0');
+}
+
+export function forecastMenu(data, context) {
+  if (!context || !validDate(context.targetDate) ||
+      !Number.isFinite(context.forecastCups) || context.forecastCups < 0 ||
+      !Number.isFinite(context.referenceCups) || context.referenceCups <= 0 ||
+      !nonempty(context.signature) ||
+      !Number.isFinite(context.weather?.temperatureC) ||
+      !Number.isFinite(context.weather?.precipitationMm) || context.weather.precipitationMm < 0 ||
+      typeof context.holiday?.isHoliday !== 'boolean')
+    throw Error('天气、假日或预测上下文无效');
+
+  const coefficient = context.forecastCups / context.referenceCups;
+  if (!Number.isFinite(coefficient)) throw Error('预测系数超出范围');
+  const sales = Object.entries(MENU_BASELINE).map(([productId,base]) => ({
+    productId,
+    size: productId.startsWith('BK-') ? '份' : '中杯',
+    quantity: Math.ceil(base * coefficient),
+  }));
+  usage(data,sales); // Validate exact CSV product joins, units and safe integer totals.
+  return {
+    targetDate: context.targetDate,
+    coefficient,
+    source: FORECAST_SOURCE,
+    contextSignature: context.signature,
+    sales,
+  };
+}
+
+export function createBOMOrder({
+  data, forecast, rows, quantities = {}, signature, approvedAt = Date.now(), id,
+  pricebook = null, extras = [],
+}) {
+  const learnedSource = 'owner_sales_recency_weighted_v1';
+  if (!forecast || !validDate(forecast.targetDate) ||
+      ![FORECAST_SOURCE,learnedSource].includes(forecast.source) || !nonempty(forecast.contextSignature) ||
+      !nonempty(signature) || !valid(approvedAt) || !Number.isFinite(new Date(approvedAt).getTime()))
+    throw Error('审批日期、预测来源或清单签名无效');
+  if (forecast.source === learnedSource) {
+    const verified = forecastFromHistory(data,forecast.contextSnapshot,forecast.historySnapshot,{asOfDate:forecast.asOfDate});
+    for (const key of ['source','targetDate','coefficient','contextSignature','sales','historyRevision','sampleDays','confidence'])
+      if (JSON.stringify(verified[key]) !== JSON.stringify(forecast[key]))
