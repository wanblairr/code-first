+      // Neither token rotation, translated labels nor a new preview/request ID
+      // may resend the same simulated purchase to the same fixed recipient.
+      const key='send/'+digest(['sandbox-send-v1',input.recipient,input.parameters]);
+      const claimed=await durableClaim(store,key,body.request_id,uuid,now);
+      if(claimed.cached)return json({...claimed.cached,provider:'360dialog-sandbox'});
+      let id;
+      try{id=await sandboxPost(input,message,fetchImpl);}catch{
+        await saveOutcome(store,key,claimed,{status:'unknown'},now);
+        throw failure('SEND_OUTCOME_UNKNOWN','Sandbox acceptance is unknown. Check your WhatsApp phone. This matching message cannot be retried automatically.',502,true);
+      }
+      if(!await saveOutcome(store,key,claimed,{status:'accepted',message_id:id},now))
+        throw failure('SEND_RECORD_UNCERTAIN','The sandbox accepted the request but its durable record is uncertain. Check your phone; no automatic retry.',503,true);
+      return json({...publicAccepted({status:'accepted',message_id:id},false),provider:'360dialog-sandbox'});
+    }catch(error){
+      const safe=error instanceof SafeFailure?error:failure('SERVICE_UNAVAILABLE','Sandbox service is unavailable. Nothing will be retried automatically.',503);
+      return json({error:safe.message,code:safe.code,message:safe.message,...(safe.unknown?{status:'unknown',retry_safe:false}:{})},safe.status);
+    }
+  };
+}
+export default createHandler();
