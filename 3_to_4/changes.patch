+const sizeName=s=>s==='中杯'?words('Medium','中杯','Sederhana','Mediano'):s==='大杯'?words('Large','大杯','Besar','Grande'):words('Piece','份','Unit','Unidad');
+function node(tag,className='',text){
+  const item=document.createElement(tag);if(className)item.className=className;
