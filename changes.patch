+}
+function validatedWeather(value, targetDate) {
+  if (!value || value.date !== targetDate || !finite(value.temperatureC) || !finite(value.precipitationMm) || value.temperatureC < -20 || value.temperatureC > 55 || value.precipitationMm < 0 || value.precipitationMm > 500) return null;
+  if (!['open-meteo','simulation'].includes(value.source)) return null;
+  if (value.source === 'open-meteo' && (!Number.isFinite(Date.parse(value.fetchedAt)) || Date.now()-Date.parse(value.fetchedAt)>86400000)) return null;
+  return {date:targetDate,temperatureC:value.temperatureC,precipitationMm:value.precipitationMm,source:value.source,
+    summary:cleanText(value.summary,100),fetchedAt:cleanText(value.fetchedAt,50),offline:value.offline===true,note:cleanText(value.note,400)};
+}
+function validatedPurchaseLines(value,supplierId) {
+  if(!Array.isArray(value)||!value.length||value.length>24)return undefined;
+  try {const seen=new Set();return value.map(row=>{if(seen.has(row?.ingredientId))throw Error('Duplicate material');seen.add(row?.ingredientId);return validateStoredPurchaseLine(row,supplierId,model);});}catch{return undefined;}
+}
