+"""Owner-initiated Gmail drafts and WhatsApp prefilled messages; never send mail.
+
+Gmail requires a user OAuth token with gmail.compose permission.  That scope can
+also send mail, but this adapter deliberately exposes no send operation.  Tokens
+belong in the application's local secret store, not its database or browser.
+"""
+from __future__ import annotations
+
+import base64
+from email.message import EmailMessage
+from email.policy import SMTP
+import http.client
+import json
+import math
+import re
+from urllib import error, parse, request
