+def _decode_response(raw, token, creating):
+    """Reject token echoes and ambiguous JSON before any IDs enter storage."""
+    def invalid():
+        return GmailAPIError("Gmail 返回数据无法安全识别，请先检查草稿箱再重试。",
+                             outcome_unknown=creating)
+
+    if token.encode("utf-8") in raw:
+        raise invalid()
