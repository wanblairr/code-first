@@ -0,0 +1,159 @@
+"""Local Gmail authorization lifecycle; credentials never leave protected storage.
+
+Only explicit owner actions begin OAuth or revoke it. Reading public app state
+does not refresh tokens or contact Google. A known 401 may refresh once; an
+ambiguous draft POST is never retried.
+"""
+from __future__ import annotations
+
+import math
+import threading
+import time
+
+from cafe_core import CafeError
+from cafe_gmail import GmailAPIError
+from cafe_gmail_oauth import GmailAuthorizationFlow, GmailOAuthClient, GmailOAuthError, revoke_token
+
+
+class GmailAuthManager:
+    def __init__(self, config, *, clock=time.time):
+        self.config = config
+        self.clock = clock
+        self.oauth_factory = GmailOAuthClient
+        self.revoke_factory = revoke_token
+        self._lock = threading.RLock()
+        self._flow = None
+        self._flow_client = None
+
+    def __repr__(self):
+        return "GmailAuthManager(credentials=<redacted>)"
+
+    def _settings(self):
+        try:
+            return self.config.public()["gmail"]
+        except CafeError:
+            raise GmailOAuthError("本机 Gmail 授权配置无法读取，请核对或重新连接。", code="configuration_error") from None
+
+    def _client_identity(self):
+        cfg = self._settings()
+        if not cfg["client_configured"]:
+            raise GmailOAuthError("请先导入自己的 Google 桌面应用 OAuth 客户端 JSON，再连接 Gmail。", code="client_not_configured")
+        return cfg["client_id"], self.config.secret("gmail_client_secret")
+
+    def _client(self):
+        client_id, secret = self._client_identity()
+        return self.oauth_factory(client_id, secret, timeout=10, clock=self.clock)
+
+    def _cancel(self):
+        if self._flow is not None:
+            self._flow.cancel()
+        self._flow = self._flow_client = None
+
+    def configure(self, values):
+        with self._lock:
+            result = self.config.update(values)
+            if any(field.startswith("gmail_") or field.startswith("clear_gmail_") for field in values):
+                self._cancel()
+            return result
+
+    def import_client(self, document):
+        with self._lock:
+            result = self.config.import_google_desktop_client(document)
+            self._cancel()
+            return result
+
+    def begin(self, session_binding, redirect_uri):
+        with self._lock:
+            self._cancel()
+            identity = self._client_identity()
+            flow = GmailAuthorizationFlow(self._client(), clock=self.clock)
+            result = flow.begin(redirect_uri, binding=session_binding)
+            self._flow, self._flow_client = flow, identity
+            return result
+
+    def _store(self, bundle):
+        values = {"gmail_access_token": bundle["access_token"], "gmail_token_expires_at": bundle["expires_at"]}
+        if bundle.get("refresh_token"):
+            values["gmail_refresh_token"] = bundle["refresh_token"]
+        try:
+            self.config.update(values)
+        except CafeError:
+            raise GmailOAuthError("Google 已返回授权，但本机安全保存未完成；请修复目录权限后重新连接。", code="storage_error") from None
+
+    def complete(self, code, state, session_binding, redirect_uri):
+        with self._lock:
+            if self._flow is None or self._flow_client != self._client_identity():
+                self._cancel()
+                raise GmailOAuthError("授权客户端或会话已变化，请从本机工作台重新连接 Gmail。", code="invalid_state")
+            # The flow consumes matching state before the exchange. Even an
+            # uncertain network result cannot cause reuse of this code.
+            bundle = self._flow.finish(state, code, redirect_uri, binding=session_binding)
+            self._store(bundle)
+            self._cancel()
+            return {"connected": True, "message": "Gmail 已连接，之后会自动刷新授权。"}
+
+    def access_token(self, *, force_refresh=False, rejected_token=None):
+        # The lock spans refresh and protected save. Concurrent requests reuse
+        # the first successful refresh, including simultaneous 401 responses.
+        with self._lock:
+            cfg = self._settings()
+            access = self.config.secret("gmail_access_token")
+            automatic = cfg["auth_mode"] == "oauth_refresh"
+            if not automatic:
+                if access and not force_refresh:
+                    return access
+                raise GmailOAuthError("Gmail 授权尚未连接或已失效，请在本机重新连接 Gmail。", code="authorization_required")
+            instant = self.clock()
+            if type(instant) not in (int, float) or not 0 <= instant <= 32_503_680_000 or not math.isfinite(instant):
+                raise GmailOAuthError("系统时间无效，请校准后重试。", code="invalid_clock")
+            expiry = cfg["expires_at"]
+            fresh = access and expiry is not None and expiry > instant + 60
+            if fresh and (not force_refresh or (rejected_token is not None and access != rejected_token)):
+                return access
+            refresh = self.config.secret("gmail_refresh_token")
+            try:
+                bundle = self._client().refresh(refresh)
+            except GmailOAuthError as exc:
+                if exc.code == "invalid_grant":
+                    self.config.clear_gmail_authorization()
+                    self._cancel()
+                    raise GmailOAuthError("Google 授权已失效或被撤销，本机令牌已清除；请重新连接 Gmail。", code="authorization_required") from None
+                raise
+            self._store(bundle)
+            return bundle["access_token"]
+
+    def execute(self, operation):
+        """Run one Gmail operation, retrying only a definite unauthorized result."""
+        token = self.access_token()
+        try:
+            return operation(token)
+        except GmailAPIError as exc:
+            if exc.status_code != 401 or exc.outcome_unknown or self._settings()["auth_mode"] != "oauth_refresh":
+                raise
+        refreshed = self.access_token(force_refresh=True, rejected_token=token)
+        # A second 401 or ambiguous result is returned to the owner. No loop.
+        return operation(refreshed)
+
+    def disconnect(self):
+        with self._lock:
+            refresh = self.config.secret("gmail_refresh_token")
+            token = refresh or self.config.secret("gmail_access_token")
+            status = "local_only"
+            try:
+                if token:
+                    self.revoke_factory(token, timeout=10)
+                    status = "confirmed"
+            except GmailOAuthError as exc:
+                status = "already_invalid" if exc.code == "invalid_token" else "unknown"
+            except (CafeError, OSError, ValueError):
+                status = "unknown"
+            finally:
+                public = self.config.clear_gmail_authorization()
+                self._cancel()
+            if public["gmail"]["credential_present"]:
+                message = "本机保存的令牌已清除；环境变量仍配置了 Gmail 凭据，请在系统环境中移除。"
+            elif status == "unknown":
+                message = "本机令牌已清除；Google 撤销结果尚未确认，请在 Google 账号的第三方访问中核对。"
+            else:
+                message = "Gmail 已断开，本机令牌已清除。"
+            return {"revoke_status": status, "message": message}
