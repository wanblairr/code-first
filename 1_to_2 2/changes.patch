@@ -0,0 +1,49 @@
+@echo off
+setlocal
+chcp 65001 >nul
+set PYTHONUTF8=1
+set "launcher_exit=0"
+if not defined CAFE_DEMO_BASE set "CAFE_DEMO_BASE=%~dp0."
+cd /d "%~dp0"
+if errorlevel 1 goto failed
+
+echo 正在准备吉隆坡天气与假日演示资料，保留已有记录……
+python cafe_app.py --base "%CAFE_DEMO_BASE%" demo-context
+if errorlevel 1 goto failed
+
+echo 正在训练模型并生成时间回测报告……
+python cafe_app.py --base "%CAFE_DEMO_BASE%" train
+if errorlevel 1 echo 模型训练未完成，请核对上方错误；仍将打开网页供查看记录，数据修复前不能批准新建议。
+
+echo 正在尝试取得明日吉隆坡天气……
+python cafe_app.py --base "%CAFE_DEMO_BASE%" weather
+if errorlevel 1 (
+    echo.
+    echo 天气未更新，保留已有演示或天气快照。网页将显示来源与失败提示。
+    echo 过期快照不能审批，可在工作台点击“刷新明日天气”重试。
+    echo.
+)
+
+echo 正在生成或核对明日补货建议……
+python cafe_app.py --base "%CAFE_DEMO_BASE%" run
+if errorlevel 1 (
+    echo.
+    echo 本次未能生成初始建议，请查看上方错误；仍会启动网页供核对数据和已有记录。
+    echo 数据更新后，可在工作台重新计算建议。
+    echo.
+)
+
+echo 正在启动手机工作台，请保持此窗口运行……
+python cafe_app.py --base "%CAFE_DEMO_BASE%" serve --lan --port 8768
+if errorlevel 1 goto failed
+goto finished
+
+:failed
+set "launcher_exit=2"
+echo.
+echo 数据准备或网页服务未启动，请查看上方具体错误，检查 Python 3.11+、8768 端口占用、文件完整性及运行目录权限。
+echo 本脚本未执行重置；已有输入、审批和草稿记录仍然保留。
+
+:finished
+pause
+exit /b %launcher_exit%
diff --git a/tests/test_context_v32.py b/tests/test_context_v32.py
new file mode 100644
index 0000000000000000000000000000000000000000..11dc1824b99a681e61a3b0f49c5e91b9f4afc2f6
--- /dev/null
+++ b/tests/test_context_v32.py
@@ -0,0 +1,173 @@
+"""Context boundaries: an absent input must never become dry weather/ordinary day."""
+import copy
+import io
+import json
+import tempfile
+import unittest
+import urllib.error
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+from cafe_context import (ContextUnavailable, KL, _parse_open_meteo, _weather_url,
+                          fetch_weather, holiday_for_day, validate_weather_snapshot)
+
+
+NOW = datetime(2026, 10, 22, 13, 0, tzinfo=timezone.utc)
+TARGET = "2026-10-23"
+
+
+def payload():
+    return {"latitude": 3.125, "longitude": 101.6875,
+            "timezone": "Asia/Kuala_Lumpur", "utc_offset_seconds": 28800,
+            "daily_units": {"time": "iso8601", "temperature_2m_mean": "°C", "precipitation_sum": "mm"},
+            "daily": {"time": [TARGET], "temperature_2m_mean": [28.2], "precipitation_sum": [12.4]}}
+
+
+def snapshot():
+    from datetime import date
+    day = date.fromisoformat(TARGET)
+    return _parse_open_meteo(payload(), day, NOW, _weather_url(day))
+
+
+class Response(io.BytesIO):
+    def getcode(self):
+        return 200
+
+
+class WeatherContextTests(unittest.TestCase):
+    def test_fetch_exact_local_target_and_persist_attributed_snapshot(self):
+        base = Path(tempfile.gettempdir()).resolve()
+        with tempfile.TemporaryDirectory(dir=base) as directory:
+            output = Path(directory) / "weather.json"
+            with patch("cafe_context._utc_now", return_value=NOW), patch("cafe_context.urllib.request.urlopen", return_value=Response(json.dumps(payload()).encode())) as request:
+                actual = fetch_weather(TARGET, output)
+            called = request.call_args.args[0].full_url
+            self.assertTrue(called.startswith("https://api.open-meteo.com/v1/forecast?"))
+            self.assertIn("timezone=Asia%2FKuala_Lumpur", called)
+            self.assertIn("start_date=2026-10-23", called)
+            self.assertEqual(actual["temperature_c"], 28.2)
+            self.assertEqual(actual["precipitation_mm"], 12.4)
+            self.assertEqual(actual["known_at"], NOW.isoformat())
+            self.assertEqual(actual["weather_kind"], "live_forecast")
+            self.assertEqual(json.loads(output.read_text(encoding="utf-8")), actual)
+
+    def test_missing_null_nonfinite_and_negative_rain_never_become_zero(self):
+        from datetime import date
+        for value in (None, "0", True, float("nan"), -1):
+            data = payload()
+            data["daily"]["precipitation_sum"] = [value]
+            with self.subTest(value=value), self.assertRaises(ContextUnavailable):
+                _parse_open_meteo(data, date.fromisoformat(TARGET), NOW, _weather_url(date.fromisoformat(TARGET)))
+        valid_dry = payload()
+        valid_dry["daily"]["precipitation_sum"] = [0]
+        self.assertEqual(_parse_open_meteo(valid_dry, date.fromisoformat(TARGET), NOW, _weather_url(date.fromisoformat(TARGET)))["precipitation_mm"], 0)
+
+    def test_provider_date_units_timezone_and_location_are_checked(self):
+        from datetime import date
+        modifications = [lambda x: x["daily"].update(time=["2026-10-24"]),
+                         lambda x: x["daily"].update(time=[TARGET, TARGET]),
+                         lambda x: x["daily_units"].update(precipitation_sum="inch"),
+                         lambda x: x.update(timezone="UTC", utc_offset_seconds=0),
+                         lambda x: x.update(latitude=1.29, longitude=103.85),
+                         lambda x: x.update(daily=None),
+                         lambda x: x.update(error=True)]
+        for alter in modifications:
+            data = payload()
+            alter(data)
+            with self.subTest(modification=alter), self.assertRaises(ContextUnavailable):
+                _parse_open_meteo(data, date.fromisoformat(TARGET), NOW, _weather_url(date.fromisoformat(TARGET)))
+
+    def test_stale_future_timestamp_and_wrong_cached_date_are_rejected(self):
+        actual = snapshot()
+        stale = copy.deepcopy(actual)
+        stale["fetched_at"] = stale["known_at"] = (NOW - timedelta(hours=25)).isoformat()
+        future = copy.deepcopy(actual)
+        future["fetched_at"] = future["known_at"] = (NOW + timedelta(seconds=1)).isoformat()
+        with self.assertRaises(ContextUnavailable):
+            validate_weather_snapshot(stale, TARGET, NOW)
+        with self.assertRaises(ContextUnavailable):
+            validate_weather_snapshot(future, TARGET, NOW)
+        with self.assertRaises(ContextUnavailable):
+            validate_weather_snapshot(actual, "2026-10-24", NOW)
+        altered_source = copy.deepcopy(actual)
+        altered_source["source"] = actual["source"].replace("start_date=2026-10-23", "start_date=2026-10-24")
+        with self.assertRaises(ContextUnavailable):
+            validate_weather_snapshot(altered_source, TARGET, NOW)
+
+    def test_synthetic_or_observation_cannot_pass_live_validator(self):
+        for kind in ("synthetic_forecast", "historical_observation", "live_forecast"):
+            actual = snapshot()
+            actual["data_kind"] = actual["weather_kind"] = kind
+            if kind == "live_forecast":
+                actual["known_at"] = (NOW - timedelta(days=7)).isoformat()
+            with self.subTest(kind=kind), self.assertRaises(ContextUnavailable):
+                validate_weather_snapshot(actual, TARGET, NOW)
+
+    def test_historical_targets_are_rejected_before_network_request(self):
+        with patch("cafe_context._utc_now", return_value=NOW), patch("cafe_context.urllib.request.urlopen") as request:
+            for target in ("2026-10-21", "2026-10-22", "2026-11-07", "2026-02-30"):
+                with self.subTest(target=target), self.assertRaises(ContextUnavailable):
+                    fetch_weather(target)
+            request.assert_not_called()
+
+    def test_network_failure_preserves_existing_snapshot(self):
+        base = Path(tempfile.gettempdir()).resolve()
+        with tempfile.TemporaryDirectory(dir=base) as directory:
+            output = Path(directory) / "weather.json"
+            output.write_text("prior snapshot", encoding="utf-8")
+            with patch("cafe_context._utc_now", return_value=NOW), patch("cafe_context.urllib.request.urlopen", side_effect=urllib.error.URLError("offline")):
+                with self.assertRaisesRegex(ContextUnavailable, "0 降雨"):
+                    fetch_weather(TARGET, output)
+            self.assertEqual(output.read_text(encoding="utf-8"), "prior snapshot")
+
+    def test_utc_date_rollover_uses_kl_date(self):
+        # UTC Oct22 18:00 is KL Oct23 02:00; Oct23 is no longer tomorrow.
+        with self.assertRaises(ContextUnavailable):
+            validate_weather_snapshot(snapshot(), TARGET, datetime(2026, 10, 22, 18, tzinfo=timezone.utc))
+        self.assertEqual(NOW.astimezone(KL).hour, 21)
+
+
+class HolidayContextTests(unittest.TestCase):
+    def test_kl_not_selangor_or_other_state_calendar(self):
+        for day in ("2026-12-11", "2026-05-28", "2026-03-23"):
+            result = holiday_for_day(day)
+            self.assertEqual(result["location"], "Kuala Lumpur")
+        self.assertFalse(holiday_for_day("2026-12-11")["is_holiday"])
+        self.assertFalse(holiday_for_day("2026-05-28")["is_holiday"])
+        self.assertNotIn("柔佛", holiday_for_day("2026-03-23")["holiday_name"])
+
+    def test_double_holiday_private_employer_condition_stays_unknown(self):
+        self.assertTrue(holiday_for_day("2026-02-01")["is_holiday"])
+        self.assertTrue(holiday_for_day("2026-02-02")["is_holiday"])
+        conditional = holiday_for_day("2026-02-03")
+        self.assertIsNone(conditional["is_holiday"])
+        self.assertFalse(conditional["verified"])
+        self.assertIn("JTK_", conditional["source"])
+        self.assertEqual(conditional["status"], "conditional_employer_selection")
+
+    def test_extra_raya_and_observed_collision_are_attributed(self):
+        self.assertIn("PUB-111", holiday_for_day("2026-03-20")["source"])
+        self.assertEqual(holiday_for_day("2026-03-20")["synthetic_backtest_policy"], "skip_target")
+        self.assertNotIn("calendar_known_from", holiday_for_day("2026-03-20"))
+        for target in ("2026-03-20", "2026-03-21", "2026-03-22", "2026-03-23", "2026-06-01", "2026-06-02", "2026-11-09"):
+            row = holiday_for_day(target)
+            self.assertTrue(row["is_holiday"])
+            self.assertTrue(row["verified"])
+            self.assertTrue(row["source"].startswith("https://"))
+        self.assertIn("卫塞", holiday_for_day("2026-06-02")["holiday_name"])
+        self.assertIn("subject_to_change", holiday_for_day("2026-11-09")["status"])
+
+    def test_unknown_year_and_weekend_are_distinct(self):
+        for target in ("2025-12-25", "2027-01-01"):
+            row = holiday_for_day(target)
+            self.assertIsNone(row["is_holiday"])
+            self.assertFalse(row["verified"])
+            self.assertEqual(row["status"], "unknown")
+        saturday = holiday_for_day("2026-10-24")
+        self.assertIs(saturday["is_holiday"], False)
+        self.assertIs(saturday["is_workday_override"], False)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_forecast_context_v32.py b/tests/test_forecast_context_v32.py
new file mode 100644
index 0000000000000000000000000000000000000000..d537e7f5e4e13b249fd7ecff1f7b174250f1e541
--- /dev/null
+++ b/tests/test_forecast_context_v32.py
@@ -0,0 +1,171 @@
+import copy
+import json
+import math
+import random
+import tempfile
+import unittest
+from datetime import date, datetime, time, timedelta
+from pathlib import Path
+
+from cafe_core import CafeError
+from cafe_forecast_context import (FEATURES, KL, _training_examples, forecast_origin,
+                                   make_demo_context_data, predict, train, validate_context,
+                                   validate_environment)
+
+
+def fixture(days=220, flat=False):
+    """Synthetic unit-test scenarios; these flags are not official KL holidays."""
+    rng=random.Random(72019)
+    sales,env=[],[]
+    for i in range(days):
+        day=date(2026,1,1)+timedelta(days=i)
+        temp=26+rng.random()*7
+        rain=rng.random()*30
+        holiday=i%19==0
+        units=100 if flat else round(68+i*.03+day.weekday()*2+2*(temp-29)-1.2*rain+18*holiday-.1*rain*holiday+rng.gauss(0,.5),3)
+        sales.append({"date":day.isoformat(),"sku":"test_coffee","units":units,
+                      "stockout":False,"closed":False,"data_source":"synthetic"})
+        env.append({"date":day.isoformat(),"temperature_c":temp,"precipitation_mm":rain,
+                    "is_holiday":holiday,"is_workday_override":False,
+                    "known_at":datetime.combine(day-timedelta(days=1),time(18),KL).isoformat(),
+                    "weather_kind":"synthetic_forecast","source":"unit-test synthetic calendar"})
+    target=date.fromisoformat(sales[-1]["date"])+timedelta(days=1)
+    context={"date":target.isoformat(),"temperature_c":32.0,"precipitation_mm":25.0,
+             "is_holiday":True,"is_workday_override":False,
+             "known_at":datetime.combine(target-timedelta(days=1),time(18),KL).isoformat(),
+             "weather_kind":"synthetic_forecast","source":"unit-test synthetic calendar"}
+    return sales,env,context
+
+
+class ContextForecastTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.sales,cls.env,cls.context=fixture()
+        cls.model=train(cls.sales,cls.env)
+
+    def test_real_fitted_covariates_and_validation_selection(self):
+        spec=self.model["models"]["test_coffee"]
+        self.assertTrue(spec["algorithm"].startswith("context:"))
+        self.assertEqual(len(spec["fit"]["weights"]),len(FEATURES))
+        self.assertTrue(all(math.isfinite(w) for w in spec["fit"]["weights"]))
+        self.assertGreater(spec["reference_precipitation_mm"],0)
+        result=self.model["evaluation"]["test_coffee"]
+        self.assertEqual(len(result["validation_predictions"]),28)
+        self.assertEqual(len(result["holdout_predictions"]),56)
+        self.assertLess(result["validation_predictions"][-1]["date"],result["holdout_start"])
+        self.assertIn("previous_observed",result["holdout_metrics"])
+        self.assertIn("weekday_mean",result["holdout_metrics"])
+        self.assertIn(result["best_without_context_algorithm"],result["holdout_metrics"])
+        self.assertIn(result["best_context_algorithm"],result["holdout_metrics"])
+
+    def test_holdout_labels_cannot_select_algorithm(self):
+        changed=copy.deepcopy(self.sales)
+        cutoff=self.model["evaluation"]["test_coffee"]["holdout_start"]
+        for row in changed:
+            if row["date"]>=cutoff:
+                row["units"]=row["units"]*2+100
+        other=train(changed,self.env)["evaluation"]["test_coffee"]
+        original=self.model["evaluation"]["test_coffee"]
+        self.assertEqual(original["selected_algorithm"],other["selected_algorithm"])
+        self.assertEqual(original["validation_metrics"],other["validation_metrics"])
+        self.assertNotEqual(original["holdout_metrics"],other["holdout_metrics"])
+
+    def test_each_backtest_uses_prefix_and_pre_22h_forecast(self):
+        result=self.model["evaluation"]["test_coffee"]
+        for row in result["validation_predictions"]+result["holdout_predictions"]:
+            self.assertLess(row["history_through"],row["date"])
+            self.assertLessEqual(datetime.fromisoformat(row["context_known_at"]),datetime.fromisoformat(row["forecast_origin"]))
+            self.assertEqual(datetime.fromisoformat(row["forecast_origin"]).hour,22)
+
+    def test_forecast_after_scheduled_origin_rejected_even_before_midnight(self):
+        raw=dict(self.env[-1])
+        raw["known_at"]=(forecast_origin(raw["date"])+timedelta(hours=1)).isoformat()
+        raw["forecast_origin"]=raw["known_at"]
+        with self.assertRaisesRegex(CafeError,"未来信息"):
+            validate_context(raw,historical=True)
+
+    def test_no_realized_weather_imputation_or_bad_types(self):
+        for key,value in (("weather_kind","realized_weather"),("temperature_c",float("nan")),
+                          ("precipitation_mm",None),("is_holiday",None),("is_holiday",1),
+                          ("temperature_c",True)):
+            with self.subTest(key=key,value=value),self.assertRaises(CafeError):
+                validate_context(dict(self.context,**{key:value}))
+        with self.assertRaises(CafeError):
+            validate_environment(self.env+[self.env[-1]])
+        with self.assertRaises(CafeError):
+            train(self.sales,self.env[:-1])
+
+    def test_stale_forecast_future_sales_and_corrupt_model_fail(self):
+        old=datetime.fromisoformat(self.context["known_at"])-timedelta(days=3)
+        with self.assertRaisesRegex(CafeError,"48"):
+            predict(self.model,self.sales,dict(self.context,known_at=old.isoformat()))
+        with self.assertRaises(CafeError):
+            predict(self.model,self.sales,dict(self.context,date=self.sales[-1]["date"]))
+        corrupt=copy.deepcopy(self.model)
+        corrupt["models"]["test_coffee"]["fit"]["weights"][0]+=1
+        with self.assertRaisesRegex(CafeError,"完整性"):
+            predict(corrupt,self.sales,self.context)
+
+    def test_counterfactual_shapley_sums_exactly_and_keeps_histories(self):
+        result=predict(self.model,self.sales,self.context)
+        row=result["impact"]["items"][0]
+        self.assertAlmostEqual(row["baseline_units"]+row["weather_delta_units"]+row["holiday_delta_units"],row["combined_units"],places=6)
+        ref=result["counterfactuals"]["reference"]["items"][0]["forecast_units"]
+        w=result["counterfactuals"]["weather_only"]["items"][0]["forecast_units"]
+        h=result["counterfactuals"]["holiday_only"]["items"][0]["forecast_units"]
+        self.assertAlmostEqual(.5*((w-ref)+(row["combined_units"]-h)),row["weather_delta_units"],places=5)
+        self.assertLess(row["weather_delta_units"],0)
+        self.assertGreater(row["holiday_delta_units"],0)
+        changed=predict(self.model,self.sales,dict(self.context,temperature_c=26,precipitation_mm=0))
+        self.assertNotEqual(result["items"][0]["forecast_units"],changed["items"][0]["forecast_units"])
+        self.assertEqual(result["model_sha256"],changed["model_sha256"])
+
+    def test_censored_units_are_not_label_or_lag_features(self):
+        original=copy.deepcopy(self.sales)
+        original[40]["stockout"]=True
+        changed=copy.deepcopy(original)
+        changed[40]["units"]=99999
+        env=validate_environment(self.env)
+        self.assertEqual(_training_examples(original,env),_training_examples(changed,env))
+
+    def test_flat_series_selects_baseline_and_has_no_fabricated_impact(self):
+        sales,env,context=fixture(flat=True)
+        model=train(sales,env)
+        result=predict(model,sales,context)
+        self.assertEqual(model["models"]["test_coffee"]["algorithm"],"previous_observed")
+        impact=result["impact"]["items"][0]
