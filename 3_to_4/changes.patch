+
+// Only the controller may clear the committed last-transaction marker and bump
+// its revision. Recomputing the original sale prevents forged inverse quantities.
+export function restoreLastSale(data,stock,lastTransaction,revision) {
+  checkStock(data,stock);
+  if (!valid(revision) || !valid(revision + 1) || revision <= 0 || !lastTransaction ||
+      typeof lastTransaction !== 'object' || Array.isArray(lastTransaction) ||
+      typeof lastTransaction.transactionId !== 'string' ||
+      !lastTransaction.transactionId.trim() || lastTransaction.transactionId.length > 200 ||
+      lastTransaction.transactionId.includes('\0') ||
+      lastTransaction.stockRevision !== revision || !valid(lastTransaction.stockRevision))
+    throw Error('最近售出编号或库存版本已失效，请刷新后重试');
+  checkStock(data,lastTransaction.beforeStock);
+  if (Object.keys(stock).length !== Object.keys(data.materials).length ||
+      Object.keys(lastTransaction.beforeStock).length !== Object.keys(data.materials).length)
+    throw Error('撤销库存包含未知原料');
+  const expectedAfter = sell(data,lastTransaction.beforeStock,lastTransaction.sale);
+  const consumed = usage(data,[lastTransaction.sale]), recorded = lastTransaction.consumed;
+  if (!recorded || typeof recorded !== 'object' || Array.isArray(recorded) ||
+      Object.keys(recorded).length !== Object.keys(consumed).length ||
+      Object.keys(recorded).some(id=>!own(consumed,id) || !valid(recorded[id]) ||
+        recorded[id] <= 0 || recorded[id] !== consumed[id]) ||
+      Object.keys(data.materials).some(id=>stock[id] !== expectedAfter[id]))
+    throw Error('最近售出扣减与当前库存不一致，不能撤销');
+  const restored = {...stock};
+  for (const [id,quantity] of Object.entries(consumed)) {
+    const value = stock[id] + quantity;
+    if (!valid(value) || value !== lastTransaction.beforeStock[id])
+      throw Error('恢复库存超出安全范围，整单未恢复');
+    restored[id] = value;
+  }
+  return restored;
+}
