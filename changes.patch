+            if i.get("procurement_source") == "manual":
+                detail = f"- {i['name']}：{i['approved_quantity']:g} {i['purchase_unit']}"
+            if "unit_price_cents" in i:
+                detail += f" | {i['approved_quantity'] / i['pack_size']:g} {i.get('purchase_unit', '包')} × {format_money(i['unit_price_cents'])} = {format_money(i['line_total_cents'])}"
+            if i.get("procurement_source") == "manual":
+                detail += " [店主手动添加]"
+            lines.append(detail)
+        cost = totals(items)
+        if cost["prices_complete"]:
