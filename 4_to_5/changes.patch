+  if(typeof row?.name!=='string'||!row.name.trim()||!Number.isSafeInteger(row.approvedPacks)||row.approvedPacks<=0||row.approvedPacks>10000||typeof row.packUnit!=='string'||typeof row.unit!=='string'||!Number.isFinite(row.packSize)||row.packSize<=0)throw Error('old');
+  const price=row.unitPriceCents,total=row.lineTotalCents,unpriced=price==null&&total==null;
+  if(!unpriced&&(!Number.isSafeInteger(price)||price<0||!Number.isSafeInteger(price*row.approvedPacks)||total!==price*row.approvedPacks))throw Error('old');
+  if(unpriced)allPriced=false;else subtotal+=total;
+  const bom=Object.hasOwn(row,'purchaseQuantity')||Object.hasOwn(row,'priceKnown');
+  if(bom){
+   if(!Number.isSafeInteger(row.quantity)||row.quantity<=0||row.priceKnown===unpriced)throw Error('old');
+   if(unpriced){
+    if(row.purchaseQuantity!=null)throw Error('old');
+    return row.name+' approved requirement '+row.quantity+' '+row.unit+'; purchase packaging unconfirmed; unit price unconfirmed; line total unconfirmed';
+   }
+   if(!Number.isSafeInteger(row.packSize)||!Number.isSafeInteger(row.purchaseQuantity)||row.purchaseQuantity<=0)throw Error('old');
+   const pack=BigInt(row.packSize),base=BigInt(row.quantity),count=BigInt(row.approvedPacks);
+   if(count*pack!==BigInt(row.purchaseQuantity)||(base+pack-1n)/pack!==count)throw Error('old');
+   return row.name+' approved requirement '+row.quantity+' '+row.unit+'; purchase '+row.approvedPacks+' '+row.packUnit+' × '+row.packSize+' '+row.unit+' = '+row.purchaseQuantity+' '+row.unit+'; unit price '+purchaseMoney(price)+'; line total '+purchaseMoney(total);
+  }
+  return row.name+' '+row.approvedPacks+' '+row.packUnit+' × '+row.packSize+' '+row.unit+'; unit price '+purchaseMoney(unpriced?null:price)+'; line total '+purchaseMoney(unpriced?null:total);
+ });
+ if(!Number.isSafeInteger(subtotal))throw Error('old');
+ if(draft.subtotalCents!=null&&(!allPriced||draft.subtotalCents!==subtotal))throw Error('old');
