+"""Explicit, versioned BOM price quotes; no inferred or default prices.
+
+Stock and BOM recommendations stay in integer base units. A separate purchase
+quantity rounds those units up to complete quoted packs. Amounts are MYR cents.
+"""
+from __future__ import annotations
+from copy import deepcopy
+from decimal import Decimal, InvalidOperation, ROUND_CEILING, localcontext
+import json
+
+from cafe_core import CafeError, canonical, fingerprint
+from cafe_bom import MAX_SAFE, initial_stock
+
+SOURCES = {'owner_entry', 'supplier_quote', 'demo', 'manual_demo'}
+QUOTE_FIELDS = {'ingredient_id', 'pack_quantity', 'pack_price_cents', 'currency', 'source'}
+
+
+def _integer(value, label):
+    if type(value) is not int or not 0 <= value <= MAX_SAFE:
+        raise CafeError(label + '须为非负安全整数。')
+    return value
+
+
+def _pack_quantity(value):
+    if isinstance(value, bool) or not isinstance(value, (str, int, float, Decimal)):
+        raise CafeError('每包装基础单位量必须为正数。')
+    try:
+        amount = Decimal(str(value))
+        if (not amount.is_finite() or amount <= 0 or amount > MAX_SAFE
+                or amount.as_tuple().exponent < -6):
+            raise InvalidOperation()
+    except (InvalidOperation, ValueError, TypeError, OverflowError):
+        raise CafeError('每包装基础单位量须为正数，最多六位小数。') from None
+    return int(amount) if amount == amount.to_integral_value() else format(amount.normalize(), 'f')
+
+
+def _quote(value, ingredient_id):
+    if value is None:
+        return None
+    if not isinstance(value, dict) or set(value) != QUOTE_FIELDS or value.get('ingredient_id') != ingredient_id:
+        raise CafeError('原料报价字段或ID无效。')
+    if value['currency'] != 'MYR' or not isinstance(value['source'], str) or value['source'] not in SOURCES | {'unquoted'}:
+        raise CafeError('报价币种须为MYR，并标注手动、供应商或模拟来源。')
+    pack, cents = value['pack_quantity'], value['pack_price_cents']
+    if pack is None and cents is None:
+        return None
+    if pack is None or cents is None or value['source'] == 'unquoted':
+        raise CafeError('未知报价必须同时清空包装量和价格，不能当成零元。')
+    return {'ingredient_id': ingredient_id, 'pack_quantity': _pack_quantity(pack),
+            'pack_price_cents': _integer(cents, '包装价格分值'), 'currency': 'MYR', 'source': value['source']}
+
+
+def _pricebook(value):
+    if value is None:
+        return {'price_revision': None, 'currency': 'MYR', 'prices': {}}
+    if not isinstance(value, dict) or value.get('currency') != 'MYR' or not isinstance(value.get('prices'), dict):
+        raise CafeError('报价目录格式或币种无效。')
+    revision = _integer(value.get('price_revision'), '报价版本')
+    prices = {}
+    for key, quote in value['prices'].items():
+        if not isinstance(key, str) or not key or len(key) > 200 or any(ord(c) < 32 for c in key):
+            raise CafeError('报价原料ID无效。')
+        prices[key] = _quote(quote, key)
+    return {'price_revision': revision, 'currency': 'MYR', 'prices': prices}
+
+
+class BOMPricingRepository:
+    """WorkflowStore BEGIN IMMEDIATE serializes CAS and its matching audit event."""
+    def __init__(self, store, data):
+        self.store = store
+        initial_stock(data)  # Reuse the BOM's unit and material validation.
+        self.materials = deepcopy(data['materials'])
+        self.data_version = fingerprint({key: row['unit'] for key, row in self.materials.items()})
+        with store.connect() as db:
+            db.execute('''CREATE TABLE IF NOT EXISTS bom_pricebook (
+                singleton INTEGER PRIMARY KEY CHECK(singleton=1), data_version TEXT NOT NULL,
+                price_revision INTEGER NOT NULL, document TEXT NOT NULL)''')
+            db.execute('INSERT OR IGNORE INTO bom_pricebook VALUES(1,?,0,?)',
+                       (self.data_version, canonical({key: None for key in self.materials})))
+            self._state(db)
+
+    def _state(self, db):
+        row = db.execute('SELECT * FROM bom_pricebook WHERE singleton=1').fetchone()
+        if not row or row['data_version'] != self.data_version:
+            raise CafeError('报价目录的原料或单位已变化，请核对迁移报价后再采购。')
+        try:
+            prices = json.loads(row['document'])
+            if not isinstance(prices, dict) or set(prices) != set(self.materials):
+                raise CafeError('报价目录与原料不一致。')
+            return _pricebook({'price_revision': row['price_revision'], 'currency': 'MYR', 'prices': prices})
+        except (ValueError, TypeError, KeyError) as error:
+            if isinstance(error, CafeError):
+                raise
+            raise CafeError('持久化报价目录无效。') from None
+
+    def state(self):
+        with self.store.connect() as db:
+            return self._state(db)
+
+    def set_prices(self, entries, expected_revision):
+        _integer(expected_revision, '报价版本')
+        if not isinstance(entries, list) or not entries or len(entries) > len(self.materials):
+            raise CafeError('请提供非空原料报价数组。')
+        updates = {}
+        for entry in entries:
+            if not isinstance(entry, dict) or not isinstance(entry.get('ingredient_id'), str):
+                raise CafeError('报价原料ID无效。')
+            key = entry['ingredient_id']
+            if key not in self.materials or key in updates:
+                raise CafeError('未知或重复报价原料。')
+            updates[key] = _quote(entry, key)
+        with self.store.connect() as db:
+            old = self._state(db)
+            if old['price_revision'] != expected_revision:
+                raise CafeError('报价已在其他页面更新，请刷新后重新确认。')
+            prices = dict(old['prices'], **updates)
+            if prices == old['prices']:
+                return old  # Saving identical values does not invalidate approval.
+            revision = _integer(expected_revision + 1, '报价版本')
+            changed = db.execute('UPDATE bom_pricebook SET price_revision=?,document=? WHERE singleton=1 AND price_revision=?',
+                                 (revision, canonical(prices), expected_revision)).rowcount
+            if changed != 1:
+                raise CafeError('报价版本冲突，请刷新后重试。')
+            if db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='bom_proposals'").fetchone():
+                db.execute("UPDATE bom_proposals SET status='superseded',revision=revision+1 WHERE status='pending'")
+            self.store.event(db, 'owner', 'bom_prices_updated', 'bom_pricebook',
+                             {'previous_price_revision': expected_revision, 'price_revision': revision,
+                              'ingredient_ids': sorted(updates), 'currency': 'MYR',
+                              'sources': {key: value['source'] if value else 'unquoted' for key, value in updates.items()}})
+            return {'price_revision': revision, 'currency': 'MYR', 'prices': deepcopy(prices)}
+
+
+def apply_prices(rows, quantities=None, pricebook=None):
+    """Price suggested/approved base quantities without changing their fields.
+
+    Input rows use id+quantity or ingredient_id+approved_quantity. An optional
+    quantities mapping overrides only pricing's base_quantity. Positive unquoted
+    rows keep line_total_cents and total_cents null; zero rows cost exactly zero.
+    purchase_packs/pack_count and purchase_quantity describe whole-pack rounding.
+    """
+    if not isinstance(rows, list) or quantities is not None and not isinstance(quantities, dict):
+        raise CafeError('采购计价明细或数量格式无效。')
+    book = _pricebook(pricebook)
+    selected, known, items, missing, subtotal = quantities or {}, set(), [], [], 0
+    for row in rows:
+        if not isinstance(row, dict):
+            raise CafeError('采购计价行无效。')
+        key = row.get('ingredient_id', row.get('id'))
+        if not isinstance(key, str) or not key or key in known or ('id' in row and row['id'] != key):
+            raise CafeError('采购计价原料ID无效或重复。')
+        known.add(key)
+        quantity = selected.get(key, row.get('approved_quantity', row.get('quantity', row.get('suggested_quantity'))))
+        _integer(quantity, '采购基础单位数量')
+        quote = book['prices'].get(key)
+        priced = deepcopy(row)
+        priced.update(base_quantity=quantity, price_known=quote is not None,
+                      pack_quantity=quote['pack_quantity'] if quote else None,
+                      pack_price_cents=quote['pack_price_cents'] if quote else None,
+                      price_source=quote['source'] if quote else None,
+                      currency='MYR', purchase_packs=None, pack_count=None,
+                      purchase_quantity=None, line_total_cents=None)
+        if quantity == 0:
+            priced.update(purchase_packs=0, pack_count=0, purchase_quantity=0, line_total_cents=0)
+        elif quote is None:
+            missing.append(key)
+        else:
+            with localcontext() as context:
+                context.prec = 80
+                pack = Decimal(str(quote['pack_quantity']))
+                packs = int((Decimal(quantity) / pack).to_integral_value(rounding=ROUND_CEILING))
+                _integer(packs, '采购包装数')
+                purchase_quantity = pack * packs
+                if purchase_quantity > MAX_SAFE:
+                    raise CafeError('包装后的采购量超出安全范围。')
+                amount = int(Decimal(packs) * Decimal(quote['pack_price_cents']))
+                _integer(amount, '采购行金额')
+                actual = int(purchase_quantity) if purchase_quantity == purchase_quantity.to_integral_value() else format(purchase_quantity.normalize(), 'f')
+            subtotal = _integer(subtotal + amount, '已知采购金额合计')
+            priced.update(purchase_packs=packs, pack_count=packs, purchase_quantity=actual, line_total_cents=amount)
+        items.append(priced)
+    if set(selected) - known:
+        raise CafeError('采购数量含未知计价原料。')
+    return {'items': items, 'currency': 'MYR', 'price_revision': book['price_revision'],
+            'total_cents': None if missing else subtotal, 'known_subtotal_cents': subtotal,
+            'prices_complete': not missing, 'missing_price_ids': missing,
+            'pricebook_snapshot': deepcopy(book)}
