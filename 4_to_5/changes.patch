+[build]
+  publish = "dist"
+  functions = "netlify/functions"
+  command = "npm run check:backend"
+
+[build.environment]
+  NODE_VERSION = "22"
+
+[functions]
+  node_bundler = "esbuild"
+
+# Bundle all four independent Functions: account, whatsapp, whatsapp-sandbox, runpod.
+# Gmail uses Google Identity Services directly in the visitor browser.
+# Preserve package.json/package-lock.json and dynamic @netlify/blobs dependencies.
+# No owner WhatsApp credentials belong here or in the public build.
+# Keep the existing Free plan. Deploy Functions with CLI/API/Git and verify
+# their availability; uploading the old static dist ZIP alone is insufficient.
