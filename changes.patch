+<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Gmail 授权 · 明日备货</title><link rel="stylesheet" href="/style.css"><script src="/gmail_callback.js" defer></script></head><body><main class="oauth-callback"><section class="panel"><span class="eyebrow">明日备货 · Gmail 连接</span><h1 id="oauth-title">正在完成授权</h1><p id="oauth-status" role="status" aria-live="polite">正在验证本机登录状态，请稍候。</p><div class="callout">只连接采购草稿功能，邮件仍由你在 Gmail 中确认发送。已有采购草稿不会因授权操作被删除。</div><a class="primary link-button" href="/?setup=gmail">返回工作台</a><p class="fine">完成后可关闭此页，原工作台会显示新的连接状态。</p></section></main></body></html>
diff --git a/local_app/web_v3/gmail_callback.js b/local_app/web_v3/gmail_callback.js
new file mode 100644
index 0000000000000000000000000000000000000000..a49e609b6bfeeeed1921487cbbf49b73b315f41d
--- /dev/null
+++ b/local_app/web_v3/gmail_callback.js
@@ -0,0 +1,25 @@
+'use strict';
+(async()=>{
+  const params=new URLSearchParams(location.search);
+  // Do this before any fetch, navigation, or visible text. Never render codes,
+  // state values, provider descriptions, or tokens into the document.
+  history.replaceState(null,'','/api/integrations/gmail/oauth/callback');
+  const title=document.getElementById('oauth-title'),status=document.getElementById('oauth-status');
+  let code=params.get('code'),state=params.get('state');
+  let completionRequested=false,completionResponded=false;
+  const invalid=params.getAll('code').length!==1||params.getAll('state').length!==1||!code||!state||code.length>8192||state.length>512;
+  const declined=params.has('error');params.delete('code');params.delete('state');
+  try{
+    if(declined)throw Error('Google 授权未完成。可返回工作台重新连接，已有草稿仍保留。');
+    if(invalid)throw Error('授权回调不完整或已失效。请从工作台重新点击“连接 Gmail”。');
+    const sessionResponse=await fetch('/api/state',{credentials:'same-origin',cache:'no-store'});
+    if(!sessionResponse.ok)throw Error('请先在同一浏览器登录 127.0.0.1 工作台，再重新发起 Gmail 授权。');
+    const session=await sessionResponse.json();
+    completionRequested=true;
+    const response=await fetch('/api/integrations/gmail/oauth/complete',{method:'POST',credentials:'same-origin',cache:'no-store',headers:{'Content-Type':'application/json','X-CSRF-Token':session.csrf},body:JSON.stringify({code,state})});
+    code=state=null;const result=await response.json();completionResponded=true;
+    if(!response.ok||result.connected===false)throw Error(result.error||result.message||'授权未完成，请返回工作台重新连接。');
+    title.textContent='Gmail 已连接';status.textContent=result.message||'以后检查连接或保存采购草稿时，会按需自动续期。可以返回工作台。';
+  }catch(error){const unknown=completionRequested&&!completionResponded;title.textContent=unknown?'请核对 Gmail 连接状态':'Gmail 尚未连接';status.textContent=unknown?'授权结果暂未确认。请返回工作台查看连接状态，不要反复提交此回调。':error.message||'请返回工作台重新连接。';}
+  finally{code=state=null;}
+})();
