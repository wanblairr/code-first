diff --git a/public_website/dist/demo/sales-learning.mjs b/public_website/dist/demo/sales-learning.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3ad9e8cb42a7a1a4155c73c9208645d200d8bea2
--- /dev/null
+++ b/public_website/dist/demo/sales-learning.mjs
@@ -0,0 +1,198 @@
+import {initialStock, usage} from './bom-core.mjs?v=3.7.0';
+import {forecastMenu} from './bom-workflow.mjs?v=3.7.0';
+
+// A transparent recent-sales statistic, not a fitted machine-learning model.
+export const SALES_FORECAST_SOURCE = 'owner_sales_recency_weighted_v1';
+export const SALES_HALF_LIFE_DAYS = 7;
+const DAY_MS = 86400000, MAX_DAYS = 366, MAX_ROWS = 100, MAX_DAILY_QUANTITY = 100000, MAX_EXTRAS = 20;
+const EXTRA_UNITS = new Set(['pcs','box','bag','bottle','kg','L','g','ml','个','pack','carton']);
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const own = (value,key) => object(value) && Object.hasOwn(value,key);
+const integer = (value,maximum = Number.MAX_SAFE_INTEGER) => Number.isSafeInteger(value) && value >= 0 && value <= maximum;
+const compare = (a,b) => a < b ? -1 : a > b ? 1 : 0;
+const variantKey = (productId,size) => JSON.stringify([productId,size]);
+
+function todayKL() {
+  const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA',{
+    timeZone:'Asia/Kuala_Lumpur',year:'numeric',month:'2-digit',day:'2-digit',
+  }).formatToParts(new Date()).map(part => [part.type,part.value]));
+  return parts.year + '-' + parts.month + '-' + parts.day;
+}
+function dayNumber(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) throw Error('日期须使用有效的 YYYY-MM-DD');
+  const timestamp = Date.parse(value + 'T00:00:00.000Z');
+  if (!Number.isFinite(timestamp) || new Date(timestamp).toISOString().slice(0,10) !== value)
+    throw Error('日期须使用有效的 YYYY-MM-DD');
+  return timestamp / DAY_MS;
+}
+function optionsDay(options) {
+  if (!object(options)) throw Error('销量分析选项无效');
+  const asOfDate = options.asOfDate === undefined ? todayKL() : options.asOfDate;
+  return {asOfDate,asOfDay:dayNumber(asOfDate)};
+}
+function variants(data) {
+  initialStock(data);
+  const result = [];
+  for (const [productId,product] of Object.entries(data.products)) {
+    if (!object(product) || !object(product.recipes) || !Object.keys(product.recipes).length)
+      throw Error('产品配方无效');
+    for (const size of Object.keys(product.recipes)) result.push({productId,size});
+  }
+  if (!result.length) throw Error('产品目录为空');
+  usage(data,result.map(row => ({...row,quantity:0})));
+  return result.sort((a,b) => compare(a.productId,b.productId) || compare(a.size,b.size));
+}
+
+/** A complete historical day. Omitted product/size combinations mean zero sales. */
+export function normalizeSalesDay(data,day,options = {}) {
+  variants(data);
+  const {asOfDay} = optionsDay(options);
+  if (!object(day) || !Array.isArray(day.rows) || day.rows.length > MAX_ROWS || dayNumber(day.date) >= asOfDay)
+    throw Error('请录入昨天或更早的完整销量，每天最多100个产品规格');
+  const seen = new Set();
+  const rows = day.rows.map(row => {
+    if (!object(row) || !own(data.products,row.productId) ||
+        !own(data.products[row.productId].recipes,row.size) || !integer(row.quantity,MAX_DAILY_QUANTITY))
+      throw Error('销量须使用CSV产品及规格，数量为0至100000的整数');
+    const key = variantKey(row.productId,row.size);
+    if (seen.has(key)) throw Error('同一天不能重复录入相同产品规格');
+    seen.add(key);
+    return {productId:row.productId,size:row.size,quantity:row.quantity};
+  }).sort((a,b) => compare(a.productId,b.productId) || compare(a.size,b.size));
+  usage(data,rows);
+  return {date:day.date,rows};
+}
+function normalizedHistory(data,history,options) {
+  if (!object(history) || !integer(history.revision) || !Array.isArray(history.days) || history.days.length > MAX_DAYS)
+    throw Error('销量历史结构或版本无效，最多保存366天');
+  const seen = new Set();
+  const days = history.days.map(day => {
+    const normalized = normalizeSalesDay(data,day,options);
+    if (seen.has(normalized.date)) throw Error('销量历史包含重复日期');
+    seen.add(normalized.date);
+    return normalized;
+  }).sort((a,b) => compare(a.date,b.date));
+  return {revision:history.revision,days};
+}
+
+/** Re-entering a date replaces it atomically; it never doubles that day's sales. */
+export function upsertSalesDay(data,history,day,options = {}) {
+  optionsDay(options);
+  const current = normalizedHistory(data,history,options);
+  const expected = options.expectedRevision === undefined ? current.revision : options.expectedRevision;
+  if (!integer(expected) || expected !== current.revision) throw Error('销量已在其他页面更新，请刷新后重试');
+  const normalized = normalizeSalesDay(data,day,options);
+  const existing = current.days.find(item => item.date === normalized.date);
+  if (existing && JSON.stringify(existing) === JSON.stringify(normalized)) return current;
+  const days = current.days.filter(item => item.date !== normalized.date);
+  days.push(normalized);
+  days.sort((a,b) => compare(a.date,b.date));
+  if (days.length > MAX_DAYS) throw Error('最多保存366天销量，请先删除较早日期');
+  if (!integer(current.revision + 1)) throw Error('销量版本超出安全范围');
+  return {revision:current.revision + 1,days};
+}
+function popularity(data,history,options) {
+  const {asOfDate,asOfDay} = optionsDay(options);
+  const halfLifeDays = options.halfLifeDays === undefined ? SALES_HALF_LIFE_DAYS : options.halfLifeDays;
+  if (typeof halfLifeDays !== 'number' || !Number.isFinite(halfLifeDays) || halfLifeDays <= 0 || halfLifeDays > 366)
+    throw Error('半衰期须为0至366天之间的有限正数');
+  const current = normalizedHistory(data,history,{asOfDate});
+  const sizes = variants(data).map(row => ({...row,group:row.productId.startsWith('BK-')?'bakery':'beverage',weightedUnits:0,dailyAverage:0,weight:0}));
+  const byKey = new Map(sizes.map(row => [variantKey(row.productId,row.size),row]));
+  // A common scaling factor preserves the weighted mean and avoids underflow
+  // when every imported day is old. Each seven-day gap still halves its weight.
+  const latestDay = current.days.length ? dayNumber(current.days.at(-1).date) : asOfDay - 1;
+  let weightTotal = 0;
+  for (const day of current.days) {
+    const weight = 2 ** (-(latestDay - dayNumber(day.date)) / halfLifeDays);
+    weightTotal += weight;
+    for (const row of day.rows) byKey.get(variantKey(row.productId,row.size)).weightedUnits += row.quantity * weight;
+  }
+  const productsById = new Map();
+  for (const row of sizes) {
+    row.dailyAverage = weightTotal ? row.weightedUnits / weightTotal : 0;
+    if (!productsById.has(row.productId)) productsById.set(row.productId,{productId:row.productId,group:row.group,weightedUnits:0,dailyAverage:0,weight:0,rank:null});
+    const product = productsById.get(row.productId);
+    product.weightedUnits += row.weightedUnits;
+    product.dailyAverage += row.dailyAverage;
+  }
+  const products = [...productsById.values()];
+  for (const group of ['beverage','bakery']) {
+    const rows = products.filter(row => row.group === group).sort((a,b) => b.weightedUnits - a.weightedUnits || compare(a.productId,b.productId));
+    const total = rows.reduce((sum,row) => sum + row.weightedUnits,0);
+    let rank = null;
+    for (let index = 0; index < rows.length; index++) {
+      const row = rows[index];
+      row.weight = total ? row.weightedUnits / total : 0;
+      if (row.weightedUnits > 0) {
+        if (!index || row.weightedUnits !== rows[index - 1].weightedUnits) rank = index + 1;
+        row.rank = rank;
+      }
+    }
+    for (const row of sizes.filter(item => item.group === group)) row.weight = total ? row.weightedUnits / total : 0;
+  }
+  products.sort((a,b) => compare(a.group,b.group) || b.weight - a.weight || compare(a.productId,b.productId));
+  const sampleDays = current.days.length;
+  return {
+    source:SALES_FORECAST_SOURCE,historyRevision:current.revision,sampleDays,
+    lastDate:sampleDays?current.days.at(-1).date:null,asOfDate,halfLifeDays,
+    confidence:sampleDays < 7?'low':sampleDays < 28?'medium':'higher',
+    staleDays:sampleDays?asOfDay - latestDay:null,
+    weightReferenceDate:sampleDays?current.days.at(-1).date:null,
+    method:'Complete-day recency-weighted mean; no simulated prior. Beverage and bakery shares are separate.',
+    products,sizes,
+  };
+}
+export function buildPopularity(data,history,options = {}) {
+  return popularity(data,history,options);
+}
+
+/** Historical mean times the existing weather/holiday ratio, applied once. */
+export function forecastFromHistory(data,context,history,options = {}) {
+  const {asOfDate} = optionsDay(options);
+  const current = normalizedHistory(data,history,{asOfDate});
+  const baseline = forecastMenu(data,context);
+  if (!current.days.length) return baseline;
+  const analysis = popularity(data,current,{asOfDate});
+  const sales = analysis.sizes.map(row => ({productId:row.productId,size:row.size,quantity:Math.ceil(row.dailyAverage * baseline.coefficient)}));
+  if (sales.some(row => !integer(row.quantity))) throw Error('历史销量预测超出安全整数范围');
+  usage(data,sales);
+  return {
+    targetDate:baseline.targetDate,coefficient:baseline.coefficient,
+    source:SALES_FORECAST_SOURCE,contextSignature:baseline.contextSignature,sales,
+    historyRevision:current.revision,sampleDays:analysis.sampleDays,
+    confidence:analysis.confidence,asOfDate,
+    contextSnapshot:{targetDate:context.targetDate,forecastCups:context.forecastCups,referenceCups:context.referenceCups,
+      signature:context.signature,weather:{temperatureC:context.weather.temperatureC,precipitationMm:context.weather.precipitationMm},
+      holiday:{isHoliday:context.holiday.isHoliday}},
+    historySnapshot:current,
+  };
+}
+
+/** Manual additions are purchases, not recipes; they never change ingredient stock. */
+export function normalizeExtraPurchases(data,extras) {
+  initialStock(data);
+  if (!Array.isArray(extras) || extras.length > MAX_EXTRAS) throw Error('最多添加20项店铺加购产品');
+  const seen = new Set();
+  return extras.map(item => {
+    if (!object(item) || typeof item.id !== 'string' || !/^custom_[A-Za-z0-9_-]{1,64}$/.test(item.id) ||
+        own(data.materials,item.id) || own(data.products,item.id) || seen.has(item.id)) throw Error('加购产品编号无效或重复');
+    if (typeof item.name !== 'string' || !item.name.trim() || item.name.trim().length > 80 ||
+        /[\u0000-\u001f\u007f\u2028\u2029]/.test(item.name)) throw Error('产品名称须为1至80个可见字符');
+    if (!integer(item.quantity,10000) || !integer(item.unitPriceCents,1000000) || !EXTRA_UNITS.has(item.unit))
+      throw Error('加购数量须为0至10000的整数，单价须为整数分，且使用有效采购单位');
+    seen.add(item.id);
+    return {id:item.id,name:item.name.trim(),quantity:item.quantity,unit:item.unit,unitPriceCents:item.unitPriceCents};
+  });
+}
+export function priceExtraPurchases(data,extras) {
+  const rows = normalizeExtraPurchases(data,extras);
+  let sum = 0n;
+  const items = rows.map(row => {
+    const amount = BigInt(row.quantity) * BigInt(row.unitPriceCents);
+    sum += amount;
+    if (sum > BigInt(Number.MAX_SAFE_INTEGER)) throw Error('加购总金额超出安全整数范围');
+    return {...row,lineTotalCents:Number(amount)};
+  });
+  return {currency:'MYR',items,totalCents:Number(sum)};
+}
