+        self.login()
+        self.assertEqual(self.request("POST", "/api/catalog", values, {"X-CSRF-Token": "wrong"})[0], 403)
+        self.assertEqual(self.request("POST", "/api/catalog", values, {"Origin": "https://untrusted.invalid"})[0], 403)
+        self.assertEqual(self.service.catalog()["revision"], 1)
