+
+function quantityList(text, locale) {
+  const pattern = new RegExp(`^${names}\\s+${num}\\s+(g|ml|pcs|cups?|bags?|cartons?|packs?)$`);
+  const chunks = text.split(';').map(part=>part.trim());
+  const result = chunks.map(part=>{const match=part.match(pattern);return match?`${units(match[1],locale)} ${match[2]} ${units(match[3],locale)}`:null;});
+  return result.length && result.every(Boolean) ? result.join('; ') : null;
+}
+
+export function translateLocale(english, locale) {
+  if (!['ms','es'].includes(locale) || typeof english !== 'string') return null;
+  const text=normalize(english);
+  if (!text) return null;
+  const known=catalog.get(text)?.[locale];
+  if (known) return known;
+  for(const [pattern,formatter] of dynamic){const match=text.match(pattern);if(match)return formatter(match,locale);}
+  const quantities=quantityList(text,locale);if(quantities)return quantities;
+  const dated=text.match(/^(\d{4}-\d{2}-\d{2}) · (.+)$/);
+  if(dated){const tail=translateLocale(dated[2],locale);if(tail)return `${dated[1]} · ${tail}`;}
+  const shortage=text.match(/^Remaining shortfall: (.+?)\.( Acknowledge it again before approval\.)?$/);
+  if(shortage){const lines=quantityList(shortage[1],locale);if(lines)return select(locale,`Baki kekurangan: ${lines}.${shortage[2]?' Sahkan semula sebelum kelulusan.':''}`,`Déficit restante: ${lines}.${shortage[2]?' Confírmalo de nuevo antes de aprobar.':''}`);}
+  const portions=text.split(' · ').map(part=>part.match(/^(Espresso|Latte|Oat latte) ([\d,.]+) cups$/));
+  if(portions.length&&portions.every(Boolean))return portions.map(m=>`${units(m[1],locale)} ${m[2]} ${units('cups',locale)}`).join(' · ');
+  // Error lists may join several independently known, complete sentences.
+  // Every part must match a known entry/template; unknown prose stays unknown.
+  const parts=text.split(/([.!?])\s+(?=[A-Z])/);
+  if(parts.length>1){
+    const sentences=[];
+    for(let i=0;i<parts.length;i+=2)sentences.push(parts[i]+(parts[i+1]||''));
+    const translated=sentences.map(part=>translateLocale(part,locale));
+    if(translated.every(Boolean))return translated.join(' ');
+  }
+  return null;
+}
+
+export function formatLocaleDraft(englishBody, locale) {
+  if(!['ms','es'].includes(locale)||typeof englishBody!=='string')return englishBody;
+  // Work on a new string. Never alter a stored draft, recipient, quantity or note.
+  const bodyLines=englishBody.split('\n');
+  const noteStart=bodyLines.indexOf('Owner note (original language, unchanged):');
+  const footer='Check quantities, prices, shelf life and delivery arrangements. This draft has not been sent and does not place an order or make a payment.';
+  const footerStart=bodyLines.lastIndexOf(footer);
+  return bodyLines.map((line,index)=>{
+    if(index===noteStart)return select(locale,'Nota pemilik (bahasa asal, tanpa perubahan):','Nota del propietario (idioma original, sin cambios):');
+    if(noteStart>=0&&index>noteStart&&(footerStart<noteStart||index<footerStart))return line;
+    if(line.startsWith('Dear ')&&line.endsWith(',')){const who=line.slice(5,-1);const translated=translateLocale(who,locale);return translated?select(locale,`Kepada ${translated},`,`Estimado ${translated},`):line;}
+    if(line==='This is a public demonstration purchase draft. Sales, stock and supplier details are simulated.')return select(locale,'Ini draf pembelian demonstrasi awam. Jualan, stok dan butiran pembekal adalah simulasi.','Este es un borrador de compra de demostración pública. Las ventas, el inventario y los proveedores son simulados.');
+    const delivery=line.match(/^Requested delivery: (.+) \(before opening; confirm actual arrangements with the supplier\)\.$/);
+    if(delivery)return select(locale,`Penghantaran diminta: ${delivery[1]} (sebelum dibuka; sahkan urusan sebenar dengan pembekal).`,`Entrega solicitada: ${delivery[1]} (antes de abrir; confirma los detalles reales con el proveedor).`);
+    const pricedPurchase=line.match(/^- (.+): (\d+) (.+?) × ([\d.]+) (.+?), total ([\d.]+) (.+?); unit price: (MYR \d+\.\d{2}|unconfirmed); line total: (MYR \d+\.\d{2}|unconfirmed)$/);
+    if(pricedPurchase){const p=pricedPurchase,price=p[8]==='unconfirmed'?select(locale,'belum disahkan','sin confirmar'):p[8],total=p[9]==='unconfirmed'?select(locale,'belum disahkan','sin confirmar'):p[9];return select(locale,
+      '- '+units(p[1],locale)+': '+p[2]+' '+units(p[3],locale)+' × '+p[4]+' '+units(p[5],locale)+', jumlah '+p[6]+' '+units(p[7],locale)+'; harga seunit: '+price+'; jumlah item: '+total,
+      '- '+units(p[1],locale)+': '+p[2]+' '+units(p[3],locale)+' × '+p[4]+' '+units(p[5],locale)+', total '+p[6]+' '+units(p[7],locale)+'; precio unitario: '+price+'; total del producto: '+total);}
+    const supplierSubtotal=line.match(/^Estimated supplier subtotal: (MYR \d+\.\d{2}|unconfirmed) \(excluding tax and delivery\)\.$/);
+    if(supplierSubtotal){const amount=supplierSubtotal[1]==='unconfirmed'?select(locale,'belum disahkan','sin confirmar'):supplierSubtotal[1];return select(locale,'Anggaran subtotal pembekal: '+amount+' (tidak termasuk cukai dan penghantaran).','Subtotal estimado del proveedor: '+amount+' (sin impuestos ni entrega).');}
+    const purchase=line.match(/^- (Coffee beans|Fresh milk|Oat milk|Takeaway cups): (\d+) (bags?|cartons?|packs?) × ([\d.]+) (g|ml|pcs), total ([\d.]+) (g|ml|pcs)$/);
+    if(purchase)return select(locale,`- ${units(purchase[1],locale)}: ${purchase[2]} ${units(purchase[3],locale)} × ${purchase[4]} ${purchase[5]}, jumlah ${purchase[6]} ${purchase[7]}`,`- ${units(purchase[1],locale)}: ${purchase[2]} ${units(purchase[3],locale)} × ${purchase[4]} ${purchase[5]}, total ${purchase[6]} ${purchase[7]}`);
+    if(line==='Acknowledged remaining shortfalls:')return select(locale,'Baki kekurangan yang disahkan:','Déficits restantes aceptados:');
+    const gap=line.match(/^- (Coffee beans|Fresh milk|Oat milk|Takeaway cups): ([\d.]+) (g|ml|pcs); a stockout is possible\.$/);
+    if(gap)return select(locale,`- ${units(gap[1],locale)}: ${gap[2]} ${gap[3]}; stok mungkin kehabisan.`,`- ${units(gap[1],locale)}: ${gap[2]} ${gap[3]}; podría agotarse.`);
+    if(line==='See the approved quantities in the original draft shown below.')return select(locale,'Lihat kuantiti diluluskan dalam draf asal di bawah.','Consulta las cantidades aprobadas en el borrador original que aparece debajo.');
+    if(line==='Check quantities, prices, shelf life and delivery arrangements. This draft has not been sent and does not place an order or make a payment.')return select(locale,'Semak kuantiti, harga, jangka hayat dan urusan penghantaran. Draf ini belum dihantar dan tidak membuat pesanan atau pembayaran.','Comprueba cantidades, precios, vida útil y entrega. Este borrador no se ha enviado ni realiza un pedido o pago.');
+    // Older formatter output can contain an implementation note for the former
+    // bilingual view. It is not part of the single-language supplier draft.
+    if(line==='The original Chinese draft is shown separately and remains unchanged.')return '';
+    return line;
+  }).join('\n');
+}
