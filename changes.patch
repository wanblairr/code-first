+        self.assertEqual(self.request("POST", routes[2], {"recipient": recipient, "opt_in": True})[2]["status"], "preview")
+        self.service.preview_whatsapp_message.assert_called_once_with("draft-1", recipient, True)
+        payload = {"recipient": recipient, "opt_in": True, "confirmed": True, "preview_id": "p"}
+        self.assertEqual(self.request("POST", routes[3], payload)[2]["status"], "accepted")
+        self.service.send_whatsapp_message.assert_called_once_with("draft-1", recipient, "p", True, True)
+
+    def test_whatsapp_configuration_checks_and_hello_test_stay_loopback_only(self):
+        self.login()
+        self.service.test_whatsapp_message.return_value = {"status": "accepted", "delivery_confirmed": False}
+        from unittest.mock import patch
+        with patch("cafe_web.client_is_loopback", return_value=False):
+            for path in ("/api/integrations/whatsapp/check", "/api/integrations/whatsapp/test"):
+                self.assertEqual(self.request("POST", path, {"recipient": "60123456789", "opt_in": True, "confirmed": True})[0], 403)
+        self.service.check_integration.assert_not_called()
