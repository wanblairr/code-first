+from unittest.mock import Mock, patch
+
+from cafe_app import prepare_demo, prepare_context_demo
+from cafe_cloud_workflow import CloudWorkflow
+from cafe_core import CafeError, canonical, save_json
+from cafe_gmail import GmailAPIError
+from cafe_gmail_oauth import GmailOAuthClient, GmailOAuthError
+from cafe_runpod import RunpodError
+from cafe_service import CafeService, SHANGHAI, load_json
+
+
+BASE = Path(__file__).resolve().parent.parent
+KEY = "workflow-test-runpod-secret"
+TOKEN = "workflow-test-gmail-secret"
+
+
+class CloudWorkflowTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.base = Path(self.temp.name).resolve()
+        self.instant = datetime(2026, 10, 22, 21, tzinfo=SHANGHAI)
+        self.env = patch.dict(os.environ, RUNPOD_API_KEY=KEY, GMAIL_ACCESS_TOKEN=TOKEN,
+                              GMAIL_CLIENT_ID="", GMAIL_CLIENT_SECRET="", GMAIL_REFRESH_TOKEN="")
+        self.env.start()
+        prepare_demo(self.base, "2026-10-22")
+        self.service = CafeService(self.base, clock=lambda: self.instant)
+        shutil.copyfile(BASE / "models" / "demand_v3.json", self.service.model_path)
+        save_json(self.service.runtime / "training_source.json", self.service.training_stamp(self.service.inputs()))
+        self.proposal = self.service.trigger()
+        self.cloud = self.service._cloud()
+        self.cloud.configure({"runpod_enabled": True, "endpoint_id": "test-endpoint", "model": "test-model"})
+        self.cloud.poll_limit = 0
+        self.client = Mock()
+        self.client.submit.return_value = self.completed(self.proposal)
+        self.cloud.runpod_factory = Mock(return_value=self.client)
+        self.gmail = Mock()
+        self.gmail.create_draft.return_value = {"gmail_draft_id": "gmail-draft-1", "gmail_message_id": "gmail-msg-1", "status": "draft", "sent": False}
+        self.cloud.gmail_factory = Mock(return_value=self.gmail)
+
+    def tearDown(self):
+        self.service.stop.set()
+        for thread in self.cloud.threads.values():
+            thread.join(timeout=2)
+        self.env.stop()
+        self.temp.cleanup()
+
+    def completed(self, proposal, ratio=1.05):
+        return {"id": "remote-job-1", "status": "COMPLETED", "executionTime": 42, "delayTime": 17,
+                "output": {"target_date": proposal["target_date"],
+                           "predictions": [{"sku": i["sku"], "forecast_units": i["forecast_units"] * ratio,
+                                            "reason": "bounded synthetic review"} for i in proposal["forecast"]["items"]],
+                           "summary": "Review of synthetic demand", "warnings": ["Owner review remains required"]}}
+
+    def start(self, proposal=None):
+        p = proposal or self.proposal
+        return self.cloud.start(p["id"], p["revision"], p["input_hash"], background=False)
+
+    def execute(self, proposal=None):
+        job = self.start(proposal)
+        self.cloud.run_job(job["id"])
+        return self.cloud.job(job["id"])
+
+    def approved_draft(self, proposal=None):
+        p = proposal or self.proposal
+        order = self.service.approve(p["id"], p["revision"], p["input_hash"], {}, True)
+        return self.service.store.drafts_for(order["id"])[0]
+
+    def change_inventory(self):
+        path = self.service.data_dir / "inventory.json"
+        doc = load_json(path)
+        doc["snapshot_id"] = "new-closing-count"
+        save_json(path, doc)
+
+    def test_repeated_start_is_durable_and_public_reads_never_call_provider(self):
+        first, second = self.start(), self.start()
+        self.assertEqual(first["id"], second["id"])
+        self.assertEqual(len(self.cloud.public()["jobs"]), 1)
+        self.client.submit.assert_not_called()
+        self.client.status.assert_not_called()
+        self.client.health.assert_not_called()
+        self.assertNotIn(KEY, canonical(self.cloud.public()))
