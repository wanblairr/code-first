+    def test_concurrent_callbacks_only_one_posts_code(self):
+        flow, opener, _ = self.flow(Response())
+        flow.begin(REDIRECT, binding="owner-session")
+        barrier = threading.Barrier(3)
+        results = []
+
+        def call():
+            barrier.wait(timeout=5)
+            try:
+                results.append(("success", self.finish(flow)))
+            except GmailOAuthError as exc:
+                results.append(("error", exc.code))
+
+        workers = [threading.Thread(target=call) for _ in range(2)]
+        for worker in workers:
+            worker.start()
+        barrier.wait(timeout=5)
+        for worker in workers:
+            worker.join(timeout=5)
+            self.assertFalse(worker.is_alive())
+        self.assertEqual(sum(kind == "success" for kind, _ in results), 1)
+        self.assertEqual([value for kind, value in results if kind == "error"], ["invalid_state"])
+        self.assertEqual(len(opener.calls), 1)
