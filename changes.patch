+"""Google Desktop OAuth with PKCE, one-use state and explicit token refresh.
+
+Secrets returned by this module are server-internal values. Never place them in
+URLs, logs, public API responses, approval evidence, or release archives. This
+module does not persist credentials, open a browser, or send Gmail messages.
+
+Protocol: https://developers.google.com/identity/protocols/oauth2/native-app
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import http.client
+import json
+import math
+import re
+import secrets
+import threading
+import time
+from urllib import error, parse, request
+
+from cafe_core import CafeError
+
+
+AUTHORIZATION_URL = "https://accounts.google.com/o/oauth2/v2/auth"
+TOKEN_URL = "https://oauth2.googleapis.com/token"
+REVOKE_URL = "https://oauth2.googleapis.com/revoke"
+COMPOSE_SCOPE = "https://www.googleapis.com/auth/gmail.compose"
+CALLBACK_PATH = "/api/integrations/gmail/oauth/callback"
+_CLIENT = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,220}\.apps\.googleusercontent\.com\Z")
+_PKCE = re.compile(r"[A-Za-z0-9._~-]{43,128}\Z")
+_STATE = re.compile(r"[A-Za-z0-9_-]{32,128}\Z")
+_MAX_RESPONSE = 32768
+
+
+class GmailOAuthError(CafeError):
+    """Sanitized OAuth failure; code exchanges are never retried automatically."""
+
+    def __init__(self, message, *, code="oauth_error", outcome_unknown=False, status_code=None):
+        super().__init__(message)
+        self.code = code
+        self.outcome_unknown = bool(outcome_unknown)
+        self.status_code = status_code
+
+
+class _NoRedirect(request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _ascii(value, label, maximum=8192, *, empty=False):
+    if (not isinstance(value, str) or (not value and not empty) or len(value) > maximum
+            or any(ord(c) < 33 or ord(c) > 126 for c in value)):
+        raise GmailOAuthError(label + "格式无效。", code="invalid_input")
+    return value
+
+
+def _clock_value(clock):
+    value = clock()
+    try:
+        valid = type(value) in (int, float) and math.isfinite(value)
+    except OverflowError:
+        valid = False
+    if not valid:
+        raise GmailOAuthError("系统时间无效，请校准后重新授权。", code="invalid_clock")
+    return value
+
+
+def validate_redirect_uri(value):
+    """Only the exact IPv4 loopback callback; no DNS, query, fragment, or userinfo."""
+    if not isinstance(value, str) or len(value) > 256:
+        raise GmailOAuthError("OAuth 回调必须使用本机 127.0.0.1 工作台地址。", code="invalid_redirect")
+    try:
+        p = parse.urlsplit(value)
+        port = p.port
+        if (p.scheme != "http" or p.hostname != "127.0.0.1" or p.username is not None
+                or p.password is not None or port is None or not 1 <= port <= 65535
+                or p.path != CALLBACK_PATH or p.query or p.fragment
+                or value != f"http://127.0.0.1:{port}{CALLBACK_PATH}"):
+            raise ValueError
+    except ValueError:
+        raise GmailOAuthError("OAuth 回调必须使用本机 127.0.0.1 工作台地址。", code="invalid_redirect") from None
+    return value
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("Duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _parse_json(raw):
+    try:
+        result = json.loads(raw.decode("utf-8"), object_pairs_hook=_unique_object,
+                            parse_constant=lambda _: (_ for _ in ()).throw(ValueError("Invalid JSON number")))
+        if not isinstance(result, dict):
+            raise ValueError
+        pending = [(result, 0)]
+        while pending:
+            value, depth = pending.pop()
+            if depth > 20:
+                raise ValueError
+            if isinstance(value, dict):
+                pending.extend((item, depth + 1) for item in value.values())
+            elif isinstance(value, list):
+                pending.extend((item, depth + 1) for item in value)
+        return result
+    except (ValueError, UnicodeError, RecursionError, TypeError):
+        raise GmailOAuthError("Google 授权响应无法识别，请重新授权。", code="invalid_response", outcome_unknown=True) from None
+
+
+def _failure(status, raw=b"", *, operation="exchange"):
+    code = "oauth_error"
+    try:
+        result = _parse_json(raw)
+        returned = result.get("error")
+        if isinstance(returned, str) and returned in {"invalid_grant", "invalid_client", "unauthorized_client", "access_denied", "invalid_scope", "temporarily_unavailable"}:
+            code = returned
+    except GmailOAuthError:
+        pass
+    if operation == "revoke" and status == 400:
+        code = "invalid_token"
+    messages = {
+        "invalid_grant": "Google 授权已失效或被撤销，请重新连接 Gmail。",
+        "invalid_client": "Google OAuth 客户端资料无效，请核对自己的桌面应用客户端配置。",
+        "unauthorized_client": "Google 未允许此 OAuth 客户端，请核对客户端类型和 Gmail API 设置。",
+        "access_denied": "Google 授权未获同意，未连接 Gmail。",
+        "invalid_scope": "Google 未授予 Gmail 草稿权限，请重新连接。",
+        "invalid_token": "Google 提示该令牌无效；未记录新的有效授权。",
+    }
+    message = messages.get(code, "Google 授权请求未完成，请核对网络或稍后重新连接。")
+    unknown = status >= 500 or status == 408 or 300 <= status < 400
+    return GmailOAuthError(message, code=code, outcome_unknown=unknown, status_code=status)
+
+
+def _post_google(opener, timeout, url, values, *, operation):
+    if url not in (TOKEN_URL, REVOKE_URL):
+        raise GmailOAuthError("不支持的 Google 授权地址。", code="invalid_input")
+    req = request.Request(url, data=parse.urlencode(values).encode("ascii"), method="POST",
+                          headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"})
+    response = None
+    try:
+        response = getattr(opener, "open", opener)(req, timeout=timeout)
+        status = response.getcode()
+        if type(status) is not int:
+            raise GmailOAuthError("Google 返回无效状态，请重新连接 Gmail。", code="invalid_response", outcome_unknown=True)
+        geturl = getattr(response, "geturl", None)
+        if geturl is not None and geturl() != url:
+            raise GmailOAuthError("已拒绝 Google 授权请求重定向。", code="redirect_refused", outcome_unknown=True, status_code=status)
+        raw = response.read(_MAX_RESPONSE + 1)
+        if not isinstance(raw, bytes) or len(raw) > _MAX_RESPONSE:
+            raise GmailOAuthError("Google 授权响应过大，已拒绝。", code="invalid_response", outcome_unknown=True)
+        if status != 200:
+            raise _failure(status, raw, operation=operation)
+        if operation == "revoke":
+            return {"revoked": True, "status_code": 200}
+        return _parse_json(raw)
+    except error.HTTPError as exc:
+        try:
+            raw = exc.read(_MAX_RESPONSE + 1)
+        except (OSError, http.client.HTTPException):
+            raw = b""
+        finally:
+            try:
+                exc.close()
+            except (OSError, http.client.HTTPException):
+                pass
+        raise _failure(exc.code, raw if isinstance(raw, bytes) and len(raw) <= _MAX_RESPONSE else b"", operation=operation) from None
+    except GmailOAuthError:
+        raise
+    except (error.URLError, OSError, http.client.HTTPException, ValueError, UnicodeError):
+        raise GmailOAuthError("Google 授权网络请求结果不确定，请重新连接或核对授权状态。",
+                              code="transport_error", outcome_unknown=True) from None
+    finally:
+        if response is not None:
+            try:
+                response.close()
+            except (OSError, http.client.HTTPException):
+                pass
+
+
+def revoke_token(token, opener=None, timeout=15):
+    """Revoke an existing Google token without requiring OAuth client setup.
+
+    The caller supplies the token only in memory. Never print it, log the
+    request body, or put the token on a command line or in a query string.
+    """
+    _ascii(token, "待撤销令牌")
+    if type(timeout) not in (int, float) or not 1 <= timeout <= 60 or not math.isfinite(timeout):
+        raise GmailOAuthError("Google 请求超时须为 1 至 60 秒。", code="invalid_input")
+    return _post_google(opener or request.build_opener(_NoRedirect()), timeout,
+                        REVOKE_URL, {"token": token}, operation="revoke")
+
+
+class GmailOAuthClient:
+    """Fixed Google OAuth routes; no redirects, retries, or credential logging."""
+
+    def __init__(self, client_id, client_secret="", opener=None, timeout=15, clock=time.time):
+        if not isinstance(client_id, str) or not _CLIENT.fullmatch(client_id):
+            raise GmailOAuthError("请配置自己的 Google 桌面应用 OAuth Client ID。", code="invalid_client")
+        _ascii(client_secret, "OAuth Client Secret", maximum=4096, empty=True)
+        if type(timeout) not in (int, float) or not 1 <= timeout <= 60 or not math.isfinite(timeout):
+            raise GmailOAuthError("Google 请求超时须为 1 至 60 秒。", code="invalid_input")
+        if not callable(clock):
+            raise GmailOAuthError("系统时间配置无效。", code="invalid_clock")
+        self.client_id = client_id
+        self._client_secret = client_secret
+        self._opener = opener or request.build_opener(_NoRedirect())
+        self.timeout = timeout
+        self.clock = clock
+
+    def __repr__(self):
+        return "GmailOAuthClient(credentials=<redacted>)"
+
+    def authorization_url(self, redirect_uri, state, code_verifier):
+        validate_redirect_uri(redirect_uri)
+        if not isinstance(state, str) or not _STATE.fullmatch(state):
+            raise GmailOAuthError("授权状态无效，请重新连接 Gmail。", code="invalid_state")
+        if not isinstance(code_verifier, str) or not _PKCE.fullmatch(code_verifier):
+            raise GmailOAuthError("PKCE 校验资料无效。", code="invalid_pkce")
+        challenge = base64.urlsafe_b64encode(hashlib.sha256(code_verifier.encode("ascii")).digest()).rstrip(b"=").decode("ascii")
+        params = {"client_id": self.client_id, "redirect_uri": redirect_uri, "response_type": "code",
+                  "scope": COMPOSE_SCOPE, "access_type": "offline", "prompt": "consent",
+                  "state": state, "code_challenge": challenge, "code_challenge_method": "S256"}
+        return AUTHORIZATION_URL + "?" + parse.urlencode(params)
+
+    def _post(self, url, values, *, operation):
+        return _post_google(self._opener, self.timeout, url, values, operation=operation)
+
+    def _tokens(self, result, *, require_refresh):
+        try:
+            access = _ascii(result.get("access_token"), "访问令牌")
+            refresh = result.get("refresh_token")
+            if refresh is not None:
+                _ascii(refresh, "刷新令牌")
+            if require_refresh and not refresh:
+                raise GmailOAuthError("Google 未返回刷新令牌，请重新同意离线授权。", code="refresh_token_missing")
+            expiry = result.get("expires_in")
+            if type(expiry) not in (int, float) or not 1 <= expiry <= 86400 or not math.isfinite(expiry):
+                raise ValueError
+            if result.get("token_type") != "Bearer":
+                raise ValueError
+            scope = result.get("scope")
+            if not isinstance(scope, str) or len(scope) > 4096 or any(ord(c) < 32 or ord(c) > 126 for c in scope):
+                raise ValueError
+            scopes = scope.split()
