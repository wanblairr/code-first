+ const date=new Date(`${v.target_date}T00:00:00Z`);
+ if(!Number.isFinite(date.getTime())||date.toISOString().slice(0,10)!==v.target_date)throw new Error('invalid');
+ const seen=new Set();const predictions=v.predictions.map(i=>{
+  if(!record(i)||typeof i.sku!=='string'||!/^[a-z0-9][a-z0-9_-]{0,39}$/.test(i.sku)||seen.has(i.sku)||!finite(i.local_forecast_units,0,100000))throw new Error('invalid');
+  seen.add(i.sku);return {sku:i.sku,local_forecast_units:i.local_forecast_units};
+ }).sort((a,b)=>a.sku<b.sku?-1:a.sku>b.sku?1:0);
