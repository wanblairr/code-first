+            suppliers = inputs["suppliers"] if inputs is not None else load_json(self.data_dir / "suppliers.json")
+            path = self.runtime / "procurement_catalog.json"
+            return validate_saved(load_json(path) if path.exists() else default_catalog(inventory), inventory, suppliers)
