+// Interface text only: CSV IDs, units and quantities remain unchanged.
+const LANGUAGES = ['en', 'zh', 'ms', 'es'];
+const TEXT = {
+  title: ['Your stock assistant', '库存智能助手', 'Pembantu stok anda', 'Tu asistente de inventario'],
+  subtitle: ['Record what you sold. Ingredients, safety checks and replenishment follow your CSV recipes.', '记录卖出了什么，配料扣减、安全线检查与补货都按 CSV 配方计算。', 'Catat jualan. Bahan, semakan keselamatan dan penambahan stok mengikut resipi CSV anda.', 'Registra lo vendido. Los ingredientes, alertas y reposición siguen tus recetas CSV.'],
+  saleProduct: ['Product sold', '售出产品', 'Produk terjual', 'Producto vendido'],
+  size: ['Size', '规格', 'Saiz', 'Tamaño'],
+  saleQuantity: ['Quantity sold', '售出数量', 'Kuantiti terjual', 'Cantidad vendida'],
+  sell: ['Simulate sale', '模拟售出', 'Simulasikan jualan', 'Simular venta'],
+  sold: ['Recorded {quantity} × {product}. All recipe ingredients were deducted.', '已记录售出 {quantity} 份{product}，全部配料已按配方扣减。', '{quantity} × {product} direkodkan. Semua bahan resipi telah ditolak.', 'Se registraron {quantity} × {product}. Se descontaron todos los ingredientes de la receta.'],
+  stockTitle: ['Remaining stock and safety levels', '剩余库存与安全线', 'Baki stok dan paras keselamatan', 'Existencias y niveles de seguridad'],
+  safety: ['Safety level', '安全线', 'Paras keselamatan', 'Nivel de seguridad'],
+  remaining: ['Remaining stock', '剩余库存', 'Baki stok', 'Existencias'],
+  lowWarning: ['⚠ {material} is below its safety level. Replenish now!', '⚠️ 警告：{material}已低于安全线，需立刻补货！', '⚠ {material} di bawah paras keselamatan. Tambah stok sekarang!', '⚠ {material} está por debajo del nivel de seguridad. ¡Repón ahora!'],
+  generate: ['Generate smart replenishment suggestions', '生成 AI 智能补货建议', 'Jana cadangan penambahan stok pintar', 'Generar sugerencias de reposición inteligente'],
+  proposalTitle: ['What to replenish', '智能补货建议', 'Stok yang perlu ditambah', 'Qué reponer'],
