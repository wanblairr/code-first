+    ms:['DEMO / PEMBELIAN SIMULASI — BUKAN PESANAN SEBENAR','Tarikh penghantaran','Pesanan','Ringkasan pembelian'],
+    es:['DEMO / COMPRA SIMULADA — NO ES UN PEDIDO REAL','Fecha de entrega','Pedido','Resumen de compra']}[input.language];
