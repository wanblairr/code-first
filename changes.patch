+"""Runpod protocol and validation tests. No paid API calls or network access."""
+import copy
+import http.client
+import io
+import json
+import unittest
+import urllib.error
+
+from cafe_runpod import (
+    MAX_RESPONSE_BYTES, RunpodClient, RunpodError, _NoRedirect,
+    build_review_input, parse_review_output,
+)
+
+
+KEY = "test_secret_NotARealKey_91"
+
+
+class Response(io.BytesIO):
+    def __init__(self, value, *, raw=False, status=200, url=None):
+        super().__init__(value if raw else json.dumps(value).encode())
+        self.status = status
+        self.url = url
+
+    def getcode(self):
+        return self.status
+
+
+class Opener:
+    def __init__(self, *responses):
+        self.responses = list(responses)
+        self.calls = []
+
+    def open(self, request, timeout):
+        self.calls.append((request, timeout))
+        response = self.responses.pop(0)
+        if isinstance(response, Exception):
+            raise response
+        return response
+
+
+def proposal():
+    return {
+        "target_date": "2026-10-23", "data_source": "synthetic",
+        "password": "never-send-this", "supplier_email": "private@example.com",
+        "forecast": {
+            "target_date": "2026-10-23",
+            "items": [{"sku": "espresso", "forecast_units": 100}, {"sku": "latte", "forecast_units": 80}],
+            "context": {"temperature_c": 31, "precipitation_mm": 20, "is_holiday": True, "holiday_name": "Example holiday", "api_key": "never-send-context-key"},
+        },
+        "plan": {"items": [{"suggested_quantity": 500, "supplier_email": "private@example.com"}]},
+    }
+
+
+def output():
+    return {
+        "target_date": "2026-10-23",
+        "predictions": [
+            {"sku": "espresso", "forecast_units": 110, "reason": "Holiday effect; synthetic data uncertainty."},
+            {"sku": "latte", "forecast_units": 75, "reason": "Rain may reduce walk-ins."},
+        ],
+        "summary": "Review only; owner approval is required.", "warnings": ["Sales history is synthetic."],
+    }
+
+
+def completed(value=None):
+    return {"id": "job-123", "status": "COMPLETED", "output": output() if value is None else value}
+
+
+class RunpodTransportTests(unittest.TestCase):
+    def client(self, opener):
+        return RunpodClient("endpoint-123", KEY, opener=opener, timeout=12)
+
+    def test_async_submit_schema_and_fixed_auth(self):
+        fake = Opener(Response({"id": "job-123", "status": "IN_QUEUE", "unexpected": "ignored"}))
+        result = self.client(fake).submit({"prompt": "review"})
+        req, timeout = fake.calls[0]
+        self.assertEqual(req.full_url, "https://api.runpod.ai/v2/endpoint-123/run")
+        self.assertEqual(req.get_method(), "POST")
+        self.assertEqual(req.get_header("Authorization"), "Bearer " + KEY)
+        self.assertEqual(json.loads(req.data), {"input": {"prompt": "review"}})
+        self.assertEqual(timeout, 12)
+        self.assertEqual(result, {"id": "job-123", "status": "IN_QUEUE"})
+
+    def test_status_only_queries_same_job(self):
+        fake = Opener(Response({"id": "job-123", "status": "IN_PROGRESS"}), Response(completed()))
+        client = self.client(fake)
+        self.assertEqual(client.status("job-123")["status"], "IN_PROGRESS")
+        self.assertEqual(client.status("job-123")["output"], output())
+        for req, _ in fake.calls:
+            self.assertEqual(req.get_method(), "GET")
+            self.assertIsNone(req.data)
+            self.assertEqual(req.full_url, "https://api.runpod.ai/v2/endpoint-123/status/job-123")
+
+    def test_status_rejects_wrong_job_and_unknown_state(self):
+        for value in ({"id": "job-other", "status": "COMPLETED", "output": output()}, {"id": "job-123", "status": "SUCCESS"}):
+            with self.subTest(value=value), self.assertRaises(RunpodError):
+                self.client(Opener(Response(value))).status("job-123")
+
+    def test_health_keeps_safe_bounded_counters(self):
+        fake = Opener(Response({"workers": {"idle": 1, "ready": 0, "running": True, "unhealthy": -1, "token": "private"}, "jobs": {"inQueue": 2, "completed": 20}, "error": "secret"}))
+        self.assertEqual(self.client(fake).health(), {"workers": {"idle": 1, "ready": 0}, "jobs": {"inQueue": 2, "completed": 20}})
+        self.assertEqual(fake.calls[0][0].full_url, "https://api.runpod.ai/v2/endpoint-123/health")
+
+    def test_failed_envelope_does_not_leak_worker_error(self):
+        for state in ("FAILED", "TIMED_OUT", "CANCELLED"):
+            fake = Opener(Response({"id": "job-123", "status": state, "error": "password=external-secret", "output": {"traceback": "private"}}))
+            safe = self.client(fake).status("job-123")
+            self.assertNotIn("external-secret", str(safe))
+            self.assertNotIn("output", safe)
+
+    def test_reject_url_and_path_injection_before_network(self):
+        for endpoint in ("https://evil.example", "../private", "x/y", "x?y", "x\n", ""):
+            with self.subTest(endpoint=endpoint), self.assertRaises(RunpodError):
+                RunpodClient(endpoint, KEY)
+        fake = Opener()
+        for job in ("../x", "https://evil.example", "job?token=secret", "job/next"):
+            with self.subTest(job=job), self.assertRaises(RunpodError):
+                self.client(fake).status(job)
+        self.assertFalse(fake.calls)
+
+    def test_invalid_config_and_input(self):
+        for kwargs in ({"api_key": "x\nsecret"}, {"api_key": ""}, {"timeout": True}, {"timeout": 61}, {"profile": "custom"}, {"model": "m\nmalicious"}):
+            params = {"endpoint_id": "endpoint", "api_key": KEY, **kwargs}
+            with self.subTest(kwargs=kwargs), self.assertRaises(RunpodError):
+                RunpodClient(**params)
+        fake = Opener()
+        for value in ({}, [], {"temperature": float("nan")}, {"prompt": "a" * (130 * 1024)}):
+            with self.subTest(value_type=type(value)), self.assertRaises(RunpodError):
+                self.client(fake).submit(value)
+        self.assertFalse(fake.calls)
+
+    def test_ambiguous_post_timeout_is_not_retried(self):
+        fake = Opener(TimeoutError("private key " + KEY))
+        with self.assertRaises(RunpodError) as raised:
+            self.client(fake).submit({"prompt": "review"})
+        self.assertTrue(raised.exception.outcome_unknown)
+        self.assertEqual(len(fake.calls), 1)
+        self.assertNotIn(KEY, str(raised.exception))
+
+    def test_get_timeout_can_query_again_without_unknown_submission(self):
+        fake = Opener(urllib.error.URLError("secret"))
+        with self.assertRaises(RunpodError) as raised:
+            self.client(fake).status("job-123")
+        self.assertFalse(raised.exception.outcome_unknown)
+
+    def test_incomplete_post_response_is_ambiguous(self):
+        fake = Opener(http.client.IncompleteRead(b"partial-private", 10))
+        with self.assertRaises(RunpodError) as raised:
+            self.client(fake).submit({"prompt": "review"})
+        self.assertTrue(raised.exception.outcome_unknown)
+        self.assertNotIn("partial-private", str(raised.exception))
+
+    def test_escaped_credential_echo_is_refused(self):
+        escaped = "".join("\\u%04x" % ord(char) for char in KEY)
+        fake = Opener(Response(('{"id":"job-123","status":"COMPLETED","output":"' + escaped + '"}').encode(), raw=True))
+        with self.assertRaises(RunpodError) as raised:
+            self.client(fake).submit({"prompt": "review"})
+        self.assertTrue(raised.exception.outcome_unknown)
+        self.assertNotIn(KEY, str(raised.exception))
+
+    def test_http_errors_never_echo_body_and_distinguish_ambiguity(self):
+        for code, unknown in ((401, False), (403, False), (429, False), (500, True), (302, True)):
+            error = urllib.error.HTTPError("https://api.runpod.ai", code, KEY, {}, io.BytesIO(KEY.encode()))
+            fake = Opener(error)
+            with self.subTest(code=code), self.assertRaises(RunpodError) as raised:
+                self.client(fake).submit({"prompt": "review"})
+            self.assertEqual(raised.exception.outcome_unknown, unknown)
+            self.assertNotIn(KEY, str(raised.exception))
+            self.assertEqual(len(fake.calls), 1)
+
+    def test_no_redirect_handler(self):
+        self.assertIsNone(_NoRedirect().redirect_request(None, None, 302, "", {}, "https://evil.example"))
+
+    def test_invalid_large_and_secret_echo_responses_fail_safely(self):
+        values = (b"not json", b"x" * (MAX_RESPONSE_BYTES + 1), json.dumps({"output": KEY}).encode(), b'{"id":"a","id":"b","status":"IN_QUEUE"}', b'{"id":"x","status":"IN_QUEUE","n":NaN}')
+        for raw in values:
+            fake = Opener(Response(raw, raw=True))
+            with self.subTest(length=len(raw)), self.assertRaises(RunpodError) as raised:
+                self.client(fake).submit({"prompt": "review"})
+            self.assertTrue(raised.exception.outcome_unknown)
+            self.assertNotIn(KEY, str(raised.exception))
+
+    def test_repr_has_no_secret(self):
+        self.assertNotIn(KEY, repr(self.client(Opener())))
+
+
+class RunpodReviewContractTests(unittest.TestCase):
+    def test_minimal_input_contains_context_and_no_private_plan(self):
+        for profile in ("messages", "prompt"):
+            value = build_review_input(proposal(), profile=profile, model="compatible-model")
+            text = json.dumps(value)
+            self.assertIn("temperature_c", text)
+            self.assertIn("is_holiday", text)
+            self.assertIn("synthetic", text)
+            self.assertNotIn("private@example.com", text)
+            self.assertNotIn("never-send", text)
+            self.assertNotIn("suggested_quantity", text)
+            self.assertEqual(value["model"], "compatible-model")
+            self.assertEqual(value["sampling_params"]["model"], "compatible-model")
+            self.assertIn(profile, value)
+
+    def test_parse_direct_and_common_text_worker_wrappers(self):
+        text = json.dumps(output())
+        variants = (output(), text, "```json\n" + text + "\n```", {"result": text}, {"text": text}, {"generated_text": text}, [{"choices": [{"tokens": [text[:30], text[30:]]}]}], {"choices": [{"message": {"content": text}}]}, {"choices": [{"text": text}]})
+        for value in variants:
+            with self.subTest(value_type=type(value)):
+                self.assertEqual(parse_review_output(completed(value), proposal()), output())
+
+    def test_reorders_exact_skus_to_local_order(self):
+        value = output()
+        value["predictions"].reverse()
+        self.assertEqual(parse_review_output(completed(value), proposal()), output())
+
+    def test_requires_completed_and_correct_date(self):
+        for state in ("IN_QUEUE", "IN_PROGRESS", "FAILED", "CANCELLED", "TIMED_OUT"):
+            value = completed()
+            value["status"] = state
+            with self.subTest(state=state), self.assertRaises(RunpodError):
+                parse_review_output(value, proposal())
+        value = output()
+        value["target_date"] = "2026-10-24"
+        with self.assertRaises(RunpodError):
+            parse_review_output(completed(value), proposal())
+
+    def test_rejects_unknown_duplicate_missing_and_purchase_fields(self):
+        variants = []
+        value = output(); value["predictions"][0]["sku"] = "unknown"; variants.append(value)
+        value = output(); value["predictions"][1]["sku"] = "espresso"; variants.append(value)
+        value = output(); value["predictions"].pop(); variants.append(value)
+        value = output(); value["purchase_quantity"] = 500; variants.append(value)
+        value = output(); value["predictions"][0]["approved"] = True; variants.append(value)
+        for value in variants:
+            with self.subTest(value=value), self.assertRaises(RunpodError):
+                parse_review_output(completed(value), proposal())
+
+    def test_finite_nonbool_nonnegative_and_max_35_percent(self):
+        for units in (True, "110", float("nan"), float("inf"), -1, 135.01, 64.99):
+            value = output(); value["predictions"][0]["forecast_units"] = units
+            with self.subTest(units=units), self.assertRaises(RunpodError):
+                parse_review_output(completed(value), proposal())
+        for units in (65, 135):
+            value = output(); value["predictions"][0]["forecast_units"] = units
+            self.assertEqual(parse_review_output(completed(value), proposal())["predictions"][0]["forecast_units"], units)
+        with self.assertRaises(RunpodError):
+            parse_review_output(completed(), proposal(), max_change_ratio=0.36)
+        with self.assertRaises(RunpodError):
+            parse_review_output(completed(), proposal(), max_change_ratio=0.05)
+
+    def test_zero_local_cannot_be_invented_and_local_not_mutated(self):
+        local = proposal(); local["forecast"]["items"][0]["forecast_units"] = 0
+        original = copy.deepcopy(local)
+        with self.assertRaises(RunpodError):
+            parse_review_output(completed(), local)
+        self.assertEqual(local, original)
+        value = output(); value["predictions"][0]["forecast_units"] = 0
+        self.assertEqual(parse_review_output(completed(value), local)["predictions"][0]["forecast_units"], 0)
+
+    def test_rejects_image_worker_multiple_samples_and_prose(self):
+        for value in ([{"image": "https://example.com/image.png"}], [output(), output()], {"choices": [{"text": "{}"}, {"text": "{}"}]}, "Here is the answer: " + json.dumps(output()), '{"target_date":"2026-10-23","target_date":"bad"}'):
+            with self.subTest(value_type=type(value)), self.assertRaises(RunpodError):
+                parse_review_output(completed(value), proposal())
+
+    def test_bounded_text_and_warnings(self):
+        for field, value in (("summary", "a" * 1201), ("summary", "text\x00"), ("warnings", ["x"] * 13), ("warnings", [True])):
+            bad = output(); bad[field] = value
+            with self.subTest(field=field), self.assertRaises(RunpodError):
+                parse_review_output(completed(bad), proposal())
+
+
+if __name__ == "__main__":
+    unittest.main()
