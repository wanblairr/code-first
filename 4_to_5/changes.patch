+// CSV BOM inventory core. All quantities use g/ml/individual-item base units.
+const valid = value => Number.isSafeInteger(value) && value >= 0;
+const own = (object, key) => object !== null && typeof object === 'object' &&
+  typeof key === 'string' && Object.hasOwn(object, key);
+
+function materials(data) {
+  if (!data || typeof data.materials !== 'object' || !data.materials ||
+      typeof data.products !== 'object' || !data.products)
+    throw Error('BOM数据无效');
+  const entries = Object.entries(data.materials);
+  if (!entries.length) throw Error('BOM原料为空');
+  for (const [, material] of entries) {
+    if (!material || !valid(material.initial) ||
+        !(material.safety === null || valid(material.safety)))
+      throw Error('安全线或初始库存配置无效');
+  }
+  return entries;
+}
+
+function checkStock(data, stock) {
+  for (const [id] of materials(data)) {
+    if (!own(stock, id) || !valid(stock[id])) throw Error('库存数据无效');
+  }
+}
+
+export function initialStock(data) {
+  return Object.fromEntries(materials(data).map(([id, m]) => [id, m.initial]));
+}
+
+export function usage(data, sales) {
+  materials(data);
+  if (!Array.isArray(sales)) throw Error('销量必须是产品明细数组');
+  const result = {};
+  for (const sale of sales) {
+    if (!sale || !own(data.products, sale.productId) || !valid(sale.quantity))
+      throw Error('产品、杯型或数量无效');
+    const {productId, size, quantity} = sale;
+    const recipes = data.products[productId]?.recipes;
+    if (!own(recipes, size)) throw Error('产品、杯型或数量无效');
+    const recipe = recipes[size];
+    if (!recipe || typeof recipe !== 'object' || !Object.keys(recipe).length)
+      throw Error('配方为空或无效');
+    for (const [id, perUnit] of Object.entries(recipe)) {
+      if (!own(data.materials, id) || !valid(perUnit) || perUnit <= 0)
+        throw Error('配方数量或原料配置无效');
+      const next = (result[id] || 0) + perUnit * quantity;
+      if (!valid(next)) throw Error('配方数量超出安全整数范围');
+      result[id] = next;
+    }
+  }
+  return result;
+}
+
+export function sell(data, stock, sale) {
+  if (!sale || !valid(sale.quantity) || sale.quantity <= 0)
+    throw Error('售出数量须为正整数');
+  checkStock(data, stock);
+  const consumed = usage(data, [sale]);
+  // Preflight every ingredient before creating a new immutable stock snapshot.
+  for (const [id, quantity] of Object.entries(consumed)) {
+    if (stock[id] < quantity)
+      throw Error(data.materials[id].name + '库存不足，未扣减');
+  }
+  const next = {...stock};
+  for (const [id, quantity] of Object.entries(consumed)) next[id] -= quantity;
+  return next;
+}
+
+export function lowStock(data, stock) {
+  checkStock(data, stock);
+  return Object.entries(data.materials)
+    .filter(([id, m]) => m.safety !== null && stock[id] < m.safety)
+    .map(([id]) => id);
+}
+
+export function replenish(data, stock, tomorrowSales) {
+  checkStock(data, stock);
+  const forecast = usage(data, tomorrowSales);
+  return Object.entries(data.materials)
+    .filter(([, m]) => m.safety !== null)
+    .map(([id, m]) => {
+      // Aggregate all products first: add each ingredient safety level only once.
+      const tomorrow = forecast[id] || 0;
+      const required = tomorrow + m.safety;
+      if (!valid(required)) throw Error('预测数量超出安全整数范围');
+      return {
+        id, name: m.name, unit: m.unit, current: stock[id],
+        safety: m.safety, tomorrow,
+        quantity: Math.max(0, required - stock[id]),
+      };
+    });
+}
+
+// Only the controller may clear the committed last-transaction marker and bump
+// its revision. Recomputing the original sale prevents forged inverse quantities.
+export function restoreLastSale(data,stock,lastTransaction,revision) {
+  checkStock(data,stock);
+  if (!valid(revision) || !valid(revision + 1) || revision <= 0 || !lastTransaction ||
+      typeof lastTransaction !== 'object' || Array.isArray(lastTransaction) ||
+      typeof lastTransaction.transactionId !== 'string' ||
+      !lastTransaction.transactionId.trim() || lastTransaction.transactionId.length > 200 ||
+      lastTransaction.transactionId.includes('\0') ||
+      lastTransaction.stockRevision !== revision || !valid(lastTransaction.stockRevision))
+    throw Error('最近售出编号或库存版本已失效，请刷新后重试');
+  checkStock(data,lastTransaction.beforeStock);
+  if (Object.keys(stock).length !== Object.keys(data.materials).length ||
+      Object.keys(lastTransaction.beforeStock).length !== Object.keys(data.materials).length)
+    throw Error('撤销库存包含未知原料');
+  const expectedAfter = sell(data,lastTransaction.beforeStock,lastTransaction.sale);
+  const consumed = usage(data,[lastTransaction.sale]), recorded = lastTransaction.consumed;
+  if (!recorded || typeof recorded !== 'object' || Array.isArray(recorded) ||
+      Object.keys(recorded).length !== Object.keys(consumed).length ||
+      Object.keys(recorded).some(id=>!own(consumed,id) || !valid(recorded[id]) ||
+        recorded[id] <= 0 || recorded[id] !== consumed[id]) ||
+      Object.keys(data.materials).some(id=>stock[id] !== expectedAfter[id]))
+    throw Error('最近售出扣减与当前库存不一致，不能撤销');
+  const restored = {...stock};
+  for (const [id,quantity] of Object.entries(consumed)) {
+    const value = stock[id] + quantity;
+    if (!valid(value) || value !== lastTransaction.beforeStock[id])
+      throw Error('恢复库存超出安全范围，整单未恢复');
+    restored[id] = value;
+  }
+  return restored;
+}
