+import fs from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import { buildProposal, createInitialInventory, previewApproval, createSupplierDrafts, holidayContext, validateProposalFreshness, DemoFreshnessError } from './dist/demo/engine.js';
+
+const model = JSON.parse(await fs.readFile(new URL('./dist/demo/model.json', import.meta.url), 'utf8'));
+const vectors = JSON.parse(await fs.readFile(new URL('./work/public-demo-parity-vectors.json', import.meta.url), 'utf8'));
+// Reproduce the release's dated parity fixtures independently of the date when
+// developers rerun this verifier. Individual expiry tests pass a later clock.
+const realNow = Date.now;
+const fixtureNow = Date.parse('2026-10-22T12:00:00Z');
+Date.now = () => fixtureNow;
+let maxError = 0, numericComparisons = 0;
+const near = (actual, expected, label) => {
+  const error = Math.abs(actual - expected);
+  maxError = Math.max(error, maxError); numericComparisons++;
+  assert.ok(error <= 1e-5, `${label}: ${actual} != ${expected}`);
+};
+for (const vector of vectors) {
+  const proposal = buildProposal({ ...vector.input, inventory: createInitialInventory(model), model });
+  for (const row of vector.expected_forecasts) near(proposal.forecasts.find(f => f.sku === row.sku).forecastCups, row.forecast_units, 'forecast');
+  for (const row of vector.expected_impacts) {
+    const actual = proposal.forecasts.find(f => f.sku === row.sku);
+    near(actual.referenceCups, row.reference, 'reference');
+    near(actual.weatherEffect, row.weather, 'weather'); near(actual.holidayEffect, row.holiday, 'holiday');
+  }
+  for (const row of vector.expected_lines) {
+    const actual = proposal.lines.find(line => line.ingredientId === row.ingredient_id);
+    near(actual.required, row.forecast_usage, 'recipe usage'); near(actual.shortage, row.shortage, 'shortage');
+    assert.equal(actual.recommendedPacks * actual.packSize, row.suggested_quantity, 'pack rounding matches Decimal reference');
+  }
+  near(proposal.referenceCups + proposal.weatherEffect + proposal.holidayEffect, proposal.forecastCups, 'decomposition total');
+}
+const proposal = buildProposal({ ...vectors[0].input, inventory: createInitialInventory(model), model });
+const quantities = Object.fromEntries(proposal.lines.map(line => [line.ingredientId, line.recommendedPacks]));
+assert.equal(previewApproval(proposal, quantities).valid, true);
+assert.equal(createSupplierDrafts(proposal, quantities).length, 3);
+assert.ok(createSupplierDrafts(proposal, quantities).every(draft => draft.to.endsWith('@example.com')));
+const milk = proposal.lines.find(line => line.ingredientId === 'milk');
+const reduced = previewApproval(proposal, { ...quantities, milk: Math.max(0, milk.recommendedPacks - 1) });
+assert.ok(reduced.hasShortage, 'reducing milk retains visible shortfall');
+assert.equal(previewApproval(proposal, { ...quantities, milk: 1.5 }).valid, false);
+assert.equal(previewApproval(proposal, { ...quantities, milk: 9999 }).valid, false);
+assert.equal(previewApproval(proposal, Object.fromEntries(proposal.lines.map(line => [line.ingredientId, 0]))).valid, false);
+assert.equal(holidayContext('2027-01-01', model).isHoliday, null);
+assert.equal(holidayContext('2026-11-08', model).isHoliday, true);
+assert.throws(() => buildProposal({ model, inventory: createInitialInventory(model), targetDate: '2027-01-01', weather: { temperatureC: 29, precipitationMm: 5, source: 'simulation' } }), /尚未核验/);
+assert.throws(() => buildProposal({ ...vectors[0].input, model, weather: { temperatureC: null, precipitationMm: 0 } }), /温度/);
+assert.throws(() => buildProposal({ ...vectors[0].input, model, weather: { date: vectors[0].input.targetDate, temperatureC: 29, precipitationMm: 5, source: 'open-meteo', fetchedAt: '2020-01-01T00:00:00Z' } }), /24小时/);
+const liveProposal = buildProposal({ ...vectors[0].input, model, weather: { date: vectors[0].input.targetDate, temperatureC: 29, precipitationMm: 5, source: 'open-meteo', fetchedAt: '2026-10-21T13:00:00Z' } });
+const restoredLive = JSON.parse(JSON.stringify(liveProposal));
+const expiredAt = Date.parse('2026-10-22T13:00:00.001Z');
+const expectCode = code => error => error instanceof DemoFreshnessError && error.code === code;
+assert.equal(validateProposalFreshness(restoredLive, fixtureNow), true);
+assert.throws(() => previewApproval(restoredLive, quantities, expiredAt), expectCode('STALE_WEATHER'), 'persisted proposal cannot bypass weather TTL at approval');
+assert.throws(() => createSupplierDrafts(restoredLive, quantities, '', expiredAt), expectCode('STALE_WEATHER'), 'draft creation repeats freshness check');
+assert.throws(() => previewApproval(JSON.parse(JSON.stringify(proposal)), quantities, Date.parse('2026-10-22T16:00:00Z')), expectCode('STALE_TARGET'), 'KL midnight makes next-day proposal stale');
+assert.throws(() => createSupplierDrafts(restoredLive, quantities, '', Date.parse('2026-10-22T16:00:00Z')), expectCode('STALE_TARGET'));
+assert.throws(() => validateProposalFreshness({ ...restoredLive, weather: { ...restoredLive.weather, date: '2026-10-24' } }, fixtureNow), expectCode('WEATHER_DATE_MISMATCH'));
+assert.throws(() => validateProposalFreshness({ ...restoredLive, weather: { ...restoredLive.weather, source: 'unknown' } }, fixtureNow), expectCode('INVALID_WEATHER_SOURCE'));
+assert.throws(() => validateProposalFreshness({ ...restoredLive, weather: { ...restoredLive.weather, fetchedAt: '2026-10-22T13:00:00Z' } }, fixtureNow), expectCode('INVALID_WEATHER_TIME'));
+assert.throws(() => validateProposalFreshness({ ...restoredLive, weather: { ...restoredLive.weather, fetchedAt: '2026-10-22T10:00:00' } }, fixtureNow), expectCode('INVALID_WEATHER_TIME'));
+Date.now = realNow;
+const report = { success: true, parityVectors: vectors.length, numericComparisons, maxAbsoluteError: maxError,
+  packRoundingMatchesPythonDecimal: true, shortfallPreservedAfterEdit: true, invalidApprovalInputsRejected: true,
+  unknownCalendarNotAssumedOrdinary: true, staleLiveWeatherRejected: true, persistedApprovalWeatherExpiryRejected: true,
+  draftCreationWeatherExpiryRejected: true, staleTargetAtKLMidnightRejected: true, invalidWeatherProvenanceRejected: true,
+  draftsUseOnlyExampleAddresses: true,
+  privateRuntimeRead: false, externalServicesCalled: false };
+await fs.writeFile(new URL('./dist/demo/engine-verification.json', import.meta.url), JSON.stringify(report, null, 2) + '\n');
+console.log(JSON.stringify(report));
