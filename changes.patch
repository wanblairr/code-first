+        self.assertEqual(changed["context_signature"],before["context_signature"])
+        self.assertEqual(changed["forecast_context"],before["forecast_context"])
+        self.assertEqual(changed["pricing"]["revision"],1)
+        self.assertTrue(all(quote["currency"]=="MYR" and quote["source"]=="owner_entry"
+                            for quote in changed["pricing"]["entries"]))
+        self.assertNotEqual(changed["current_input_hash"],before["current_input_hash"])
+        self.assertIsNone(changed["proposal"])
+        with self.assertRaises(CafeError):
+            self.app.approve(self.payload(proposal))
