+import {orderFingerprint, buildGmailMime} from '../dist/demo/gmail-ui.js';
+import {buildWhatsAppPurchaseSummary} from '../dist/demo/whatsapp-ui.js';
+import {buildSandboxPurchaseSummary} from '../dist/demo/sandbox-ui.js';
+
+const data = JSON.parse(await readFile(new URL('../dist/demo/bom-data.json',import.meta.url),'utf8'));
+const context = overrides => ({
+  targetDate:'2026-10-24', forecastCups:200, referenceCups:200,
+  signature:'synthetic-context-1',
+  weather:{temperatureC:30,precipitationMm:4},
+  holiday:{isHoliday:false},
+  ...overrides,
+});
+const base = {
+  'BV-002':12,'BV-003':20,'BV-004':12,'BV-005':10,'BV-006':8,
+  'BV-010':8,'BV-011':8,'BV-013':20,'BV-015':8,'BV-016':8,
+  'BV-017':10,'BV-020':10,'BV-022':10,'BV-023':8,'BV-024':8,
+  'BK-01':20,'BK-02':10,'BK-05':14,'BK-06':10,'BK-08':6,
+};
+const fixedTime = Date.UTC(2026,9,23,10,0);
+function fixture() {
+  const forecast=forecastMenu(data,context());
+  forecast.sales=[
+    {productId:'BV-003',size:'中杯',quantity:20},
+    {productId:'BV-013',size:'中杯',quantity:20},
+  ];
+  let stock=sell(data,initialStock(data),{productId:'BV-003',size:'中杯',quantity:50});
+  stock=sell(data,stock,{productId:'BV-013',size:'中杯',quantity:36});
+  return {
+    data,forecast,rows:replenish(data,stock,forecast.sales),
+    signature:'immutable-inventory-and-forecast-snapshot', approvedAt:fixedTime,
+    id:'test-approval',
+  };
+}
+
+test('baseline is a frozen explicit assumption covering exact 20 CSV product IDs',()=>{
+  assert.deepEqual(MENU_BASELINE,base);
+  assert.ok(Object.isFrozen(MENU_BASELINE));
+  assert.equal(Object.keys(MENU_BASELINE).length,20);
+  assert.deepEqual(new Set(Object.keys(MENU_BASELINE)),new Set(Object.keys(data.products)));
+});
+
+for (const ratio of [0,0.001,0.5,1,1.01,1.25,2,3.333]) {
+  test('forecast ratio '+ratio+' rounds each product upward without extra holiday multiplier',()=>{
+    const input=context({forecastCups:200*ratio,holiday:{isHoliday:true}});
+    const before=structuredClone(input), forecast=forecastMenu(data,input);
+    assert.equal(forecast.coefficient,ratio);
+    assert.equal(forecast.source,'synthetic_menu_mix_scaled_by_context');
+    assert.equal(forecast.contextSignature,input.signature);
+    assert.equal(forecast.targetDate,input.targetDate);
+    assert.equal(forecast.sales.length,20);
+    for (const sale of forecast.sales) {
+      assert.equal(sale.quantity,Math.ceil(base[sale.productId]*ratio));
+      assert.ok(Number.isSafeInteger(sale.quantity));
+      assert.equal(sale.size,sale.productId.startsWith('BK-')?'份':'中杯');
+    }
+    for (const quantity of Object.values(usage(data,forecast.sales)))
+      assert.ok(Number.isSafeInteger(quantity));
+    assert.deepEqual(input,before);
+  });
+}
+
+test('zero ratio means zero purchases for initial stock, not fabricated minimum sales',()=>{
+  const forecast=forecastMenu(data,context({forecastCups:0}));
+  assert.ok(replenish(data,initialStock(data),forecast.sales).every(row=>row.quantity===0));
+});
+
+test('forecast rejects invalid dates, weather, holiday, denominator and nonfinite counts',()=>{
+  for (const changes of [
+    {targetDate:'2026-02-30'}, {targetDate:'24/10/2026'}, {targetDate:null},
+    {forecastCups:-1}, {forecastCups:NaN}, {forecastCups:Infinity},
+    {referenceCups:0}, {referenceCups:-1}, {referenceCups:'200'},
+    {signature:''}, {signature:null},
+    {weather:{temperatureC:NaN,precipitationMm:1}},
+    {weather:{temperatureC:30,precipitationMm:-1}},
+    {weather:{temperatureC:30,precipitationMm:'4'}},
+    {holiday:{isHoliday:'false'}},
+  ]) assert.throws(()=>forecastMenu(data,context(changes)));
+  assert.throws(()=>forecastMenu(data,context({forecastCups:Number.MAX_VALUE,referenceCups:0.001})));
+  const broken=structuredClone(data);delete broken.products['BK-08'];
+  assert.throws(()=>forecastMenu(broken,context()));
+});
+
+test('order snapshot preserves exact units, no invented price, and demo supplier schema',()=>{
+  const input=fixture(), before=structuredClone(input), order=createBOMOrder(input);
+  assert.equal(order.id,'DEMO-BOM-test-approval');
+  assert.equal(order.signature,input.signature);
+  assert.equal(order.targetDate,'2026-10-24');
+  assert.equal(order.approvedAt,fixedTime);
+  assert.equal(order.currency,'MYR');
+  assert.equal(order.totalCents,null);
+  assert.equal(order.drafts.length,1);
+  const draft=order.drafts[0];
+  assert.equal(draft.supplierId,'BOM_DEMO');
+  assert.equal(draft.to,'bom-orders@example.com');
+  assert.equal(draft.subtotalCents,null);
+  assert.equal(draft.orderTotalCents,null);
+  assert.equal(draft.lines.length,2);
+  for (const [id,quantity] of [['INV-003',5200],['INV-005',3200]]) {
+    const line=draft.lines.find(row=>row.ingredientId===id);
+    assert.equal(line.quantity,quantity);
+    assert.equal(line.packSize,quantity);
+    assert.equal(line.approvedPacks,1);
+    assert.equal(line.packUnit,'item');
+    assert.equal(line.unit,'ml');
+    assert.equal(line.unitPriceCents,null);
+    assert.equal(line.lineTotalCents,null);
+    assert.equal(line.remainingShortage,0);
+    assert.ok(draft.body.includes(line.name+': '+quantity+' ml'));
+  }
+  assert.ok(draft.body.includes('not a trained forecast'));
+  assert.ok(draft.body.includes('Nothing has been sent'));
+  assert.deepEqual(input,before);
+});
+
+test('integer manager overrides produce shortage, zero removes line, above suggestion is allowed',()=>{
+  const input=fixture();
+  const order=createBOMOrder({...input,quantities:{'INV-003':5000,'INV-005':0,'BK-01':3}});
+  assert.equal(order.drafts[0].lines.length,2);
+  const milk=order.drafts[0].lines.find(line=>line.ingredientId==='INV-003');
+  assert.equal(milk.quantity,5000);
+  assert.equal(milk.remainingShortage,200);
