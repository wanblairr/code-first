+class FakeClient:
+    def __init__(self, values=None, engine="fixture"):
+        self.values = iter(values or [100]*10)
+        self.seeds = []
+        self.engine = engine
+
+    def health(self):
+        return {"engine": self.engine, "model": "test-fixture", "digest": "test-only", "mode": "cpu", "ollama_version": "test", "prompt_version": PROMPT_VERSION}
