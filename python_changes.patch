@@ -0,0 +1,271 @@
+"""Connected undo, MYR quote snapshots and Gmail draft integration; no network."""
+from copy import deepcopy
+from datetime import datetime
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+from cafe_core import CafeError
+from cafe_service import CafeService, SHANGHAI
+
+ACCESS = "ya29.connected-fixture-access-only"
+
+
+class BOMConnectedTests(unittest.TestCase):
+    def setUp(self):
+        self.environment = patch.dict(os.environ, {}, clear=True)
+        self.environment.start()
+        self.addCleanup(self.environment.stop)
+        self.network = patch("urllib.request.OpenerDirector.open",
+                             side_effect=AssertionError("Connected BOM tests must never call external APIs"))
+        self.network.start()
+        self.addCleanup(self.network.stop)
+        self.scratch = Path(tempfile.gettempdir()).resolve()
+        self.temp = tempfile.TemporaryDirectory(prefix="cafe-bom-connected-", dir=self.scratch)
+        self.base = Path(self.temp.name).resolve()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-connected-")
+        self.instant = datetime(2026, 10, 23, 21, tzinfo=SHANGHAI)
+        self.service = self.new_service()
+        self.app = self.service.bom()
+        self.app.set_context({"weather_mode":"rain", "holiday_mode":"ordinary"})
+
+    def tearDown(self):
+        self.service.stop.set()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-connected-")
+        self.temp.cleanup()
+
+    def new_service(self):
+        service = CafeService(self.base, clock=lambda:self.instant)
+        service.bom_enabled = True
+        return service
+
+    def sell36(self, request_id="connected-sale-36"):
+        state = self.app.state()
+        return self.app.sale({
+            "productId":"BV-013", "size":"中杯", "quantity":36,
+            "revision":state["revision"], "request_id":request_id,
+        })
+
+    def prices(self, milk=800, oat=1200):
+        # Facade must supply MYR and explicit quote provenance when omitted.
+        state = self.app.state()
+        return self.app.set_prices({
+            "revision":state["pricing"]["revision"], "request_id":"connected-prices",
+            "entries":[
+                {"ingredient_id":"INV-003", "pack_quantity":1000, "pack_price_cents":milk},
+                {"ingredient_id":"INV-005", "pack_quantity":1000, "pack_price_cents":oat},
+            ],
+        })
+
+    @staticmethod
+    def payload(proposal, quantities=None):
+        return {"proposal_id":proposal["id"], "revision":proposal["revision"],
+                "input_hash":proposal["input_hash"], "quantities":quantities or {},
+                "acknowledged":False}
+
+    def approve_priced(self):
+        self.sell36()
+        self.prices()
+        proposal = self.app.suggest()["proposal"]
+        state = self.app.approve(self.payload(proposal, {"INV-005":3000}))
+        order = next(order for order in state["orders"] if order["id"]==state["active_order_id"])
+        return state, order, order["drafts"][0]
+
+    def fake_gmail(self):
+        cloud = self.service._cloud()
+        cloud.config.update({"gmail_access_token":ACCESS})
+        client = Mock()
+        client.create_draft.return_value = {
+            "gmail_draft_id":"connected-gmail-draft", "gmail_message_id":"connected-gmail-message",
+            "status":"draft", "sent":False,
+        }
+        factory = Mock(return_value=client)
+        cloud.gmail_factory = factory
+        return cloud, client, factory
+
+    def test_original_v36_sale_is_lazily_migrated_and_can_be_undone_through_facade(self):
+        self.sell36("old-v36-sale-36")
+        # Emulate the original release, which had durable sale evidence but no
+        # undo marker or quote tables. Do not alter inventory or audit evidence.
+        with self.service.store.connect() as db:
+            db.execute("DROP TABLE bom_last_transaction")
+            db.execute("DROP TABLE bom_undo_requests")
+            db.execute("DROP TABLE bom_pricebook")
+        restarted = self.new_service()
+        app = restarted.bom()
+        state = app.state()
+        self.assertEqual(state["last_transaction"]["transaction_id"],"old-v36-sale-36")
+        self.assertTrue(state["last_transaction"]["can_undo"])
+        undone = app.undo({"revision":state["revision"], "request_id":"undo-legacy-sale",
+                           "transaction_id":"old-v36-sale-36"})
+        self.assertEqual(undone["stock"]["INV-005"],8000)
+        self.assertEqual(undone["stock"]["INV-001"],12200)
+        self.assertEqual(undone["revision"],2)
+        self.assertIsNone(undone["last_transaction"])
+        self.assertEqual(undone["pricing"]["revision"],0)
+
+    def test_sale_undo_and_another_sale_restore_exactly_and_keep_fresh_state_on_retries(self):
+        first = self.sell36()
+        payload = {"revision":first["revision"], "request_id":"connected-undo",
+                   "transaction_id":first["last_transaction"]["transaction_id"]}
+        undone = self.app.undo(payload)
+        self.assertEqual(undone["stock"]["INV-005"],8000)
+        self.assertEqual(undone["stock"]["INV-001"],12200)
+        self.assertNotIn("INV-005",undone["low_stock"])
+        again = self.sell36("connected-second-sale")
+        self.assertEqual(again["stock"]["INV-005"],2600)
+        self.assertEqual(again["revision"],3)
+        replay = self.app.undo(payload)
+        self.assertEqual(replay["stock"],again["stock"])
+        self.assertEqual(replay["revision"],3)
+        self.assertEqual(replay["last_transaction"]["transaction_id"],"connected-second-sale")
+
+    def test_prices_default_to_unknown_and_are_not_misrepresented_as_zero(self):
+        self.sell36()
+        state = self.app.suggest()
+        self.assertEqual(state["pricing"],{"revision":0,"currency":"MYR","entries":[]})
+        pricing = state["proposal"]["pricing"]
+        self.assertIsNone(pricing["total_cents"])
+        self.assertFalse(pricing["prices_complete"])
+        self.assertEqual(set(pricing["missing_price_ids"]),{"INV-003","INV-005"})
+        positive = [row for row in state["proposal"]["rows"] if row["quantity"]>0]
+        self.assertTrue(all(row["line_total_cents"] is None for row in positive))
+        self.assertTrue(all(not row["price_known"] for row in positive))
+
+    def test_quote_update_alone_changes_hash_and_rejects_pending_approval_without_changing_stock_weather(self):
+        self.sell36()
+        before = self.app.suggest()
+        proposal = before["proposal"]
+        changed = self.prices()
+        self.assertEqual(changed["stock"],before["stock"])
+        self.assertEqual(changed["revision"],before["revision"])
+        self.assertEqual(changed["context_signature"],before["context_signature"])
+        self.assertEqual(changed["forecast_context"],before["forecast_context"])
+        self.assertEqual(changed["pricing"]["revision"],1)
+        self.assertTrue(all(quote["currency"]=="MYR" and quote["source"]=="owner_entry"
+                            for quote in changed["pricing"]["entries"]))
+        self.assertNotEqual(changed["current_input_hash"],before["current_input_hash"])
+        self.assertIsNone(changed["proposal"])
+        with self.assertRaises(CafeError):
+            self.app.approve(self.payload(proposal))
+        newer = self.app.suggest()["proposal"]
+        self.assertNotEqual(newer["input_hash"],proposal["input_hash"])
+        rows = {row["id"]:row["quantity"] for row in newer["rows"]}
+        self.assertEqual(rows["INV-003"],5540)
+        self.assertEqual(rows["INV-005"],2750)
+
+    def test_approved_base_quantity_pack_purchase_and_8400_cents_are_distinct_correct_snapshots(self):
+        state, order, draft = self.approve_priced()
+        items = {item["ingredient_id"]:item for item in order["items"]}
+        self.assertEqual(items["INV-003"]["suggested_quantity"],5540)
+        self.assertEqual(items["INV-003"]["approved_quantity"],5540)
+        self.assertEqual(items["INV-003"]["purchase_quantity"],6000)
+        self.assertEqual(items["INV-003"]["purchase_packs"],6)
+        self.assertEqual(items["INV-003"]["line_total_cents"],4800)
+        self.assertEqual(items["INV-005"]["suggested_quantity"],2750)
+        self.assertEqual(items["INV-005"]["approved_quantity"],3000)
+        self.assertEqual(items["INV-005"]["purchase_quantity"],3000)
+        self.assertEqual(items["INV-005"]["line_total_cents"],3600)
+        self.assertEqual(order["total_cents"],8400)
+        self.assertTrue(order["prices_complete"])
+        self.assertIn("6000 ml",draft["body"])
+        self.assertIn("MYR 84.00",draft["body"])
+        self.assertEqual(draft["total_cents"],8400)
+        self.assertEqual(state["stock"]["INV-005"],2600)
+        self.assertEqual(state["revision"],1)
+        self.assertIn("INV-005",state["low_stock"])
+        self.assertFalse(order["inventory_changed"])
+
+    def test_repricing_preserves_approved_order_and_download_but_invalidates_external_draft(self):
+        state, order, draft = self.approve_priced()
+        before_order = self.app.repo.order(order["id"])
+        before_draft = self.app.repo.draft(draft["id"])
+        changed = self.prices(milk=900,oat=1300)
+        self.assertEqual(changed["stock"],state["stock"])
+        self.assertEqual(changed["context_signature"],state["context_signature"])
+        self.assertIsNone(changed["active_order_id"])
+        self.assertEqual(self.app.repo.order(order["id"]),before_order)
+        self.assertEqual(self.app.repo.draft(draft["id"]),before_draft)
+        self.assertIn("MYR 84.00",self.app.draft(draft["id"])["body"])
+        with self.assertRaises(CafeError):
+            self.service.bom_approved_draft(draft["id"])
+        cloud, client, factory = self.fake_gmail()
+        with self.assertRaises(CafeError):
+            cloud.export_gmail(draft["id"])
+        factory.assert_not_called()
+        client.create_draft.assert_not_called()
+
+    def test_zero_quantity_unknown_rows_do_not_block_complete_known_sum(self):
+        _, order, _ = self.approve_priced()
+        zero = [item for item in order["items"] if item["approved_quantity"]==0]
+        self.assertTrue(zero)
+        self.assertTrue(any(not item["price_known"] for item in zero))
+        self.assertTrue(all(item["line_total_cents"]==0 for item in zero))
+        self.assertTrue(all(item["purchase_quantity"]==0 for item in zero))
+        self.assertEqual(order["missing_price_ids"],[])
+        self.assertTrue(order["prices_complete"])
+        self.assertEqual(order["total_cents"],8400)
+
+    def test_partial_quotes_preserve_known_subtotal_but_total_stays_unconfirmed(self):
+        self.sell36()
+        self.app.set_prices({"revision":0,"entries":[
+            {"ingredient_id":"INV-003","pack_quantity":1000,"pack_price_cents":800},
+        ]})
+        proposal = self.app.suggest()["proposal"]
+        self.assertEqual(proposal["pricing"]["known_subtotal_cents"],4800)
+        self.assertEqual(proposal["pricing"]["missing_price_ids"],["INV-005"])
+        self.assertIsNone(proposal["pricing"]["total_cents"])
+        approved = self.app.approve(self.payload(proposal,{"INV-005":3000}))
+        order = approved["orders"][0]
+        self.assertIsNone(order["total_cents"])
+        self.assertFalse(order["prices_complete"])
+        self.assertIn("Estimated total: unconfirmed",order["drafts"][0]["body"])
+        self.assertNotIn("MYR 0.00",order["drafts"][0]["body"])
+
+    def test_gmail_fake_factory_receives_exact_approved_8400_price_snapshot_without_network(self):
+        state, order, draft = self.approve_priced()
+        cloud, client, factory = self.fake_gmail()
+        result = self.service.create_gmail_draft(draft["id"])
+        self.assertEqual(result["status"],"created")
+        self.assertFalse(result["sent"])
+        factory.assert_called_once_with(ACCESS,timeout=10)
+        sent_copy = client.create_draft.call_args.args[0]
+        self.assertEqual(sent_copy["body"],draft["body"])
+        self.assertIn("5540 ml",sent_copy["body"])
+        self.assertIn("6000 ml",sent_copy["body"])
+        self.assertIn("MYR 84.00",sent_copy["body"])
+        self.assertEqual(sent_copy["total_cents"],8400)
+        self.assertEqual(self.app.state()["stock"],state["stock"])
+        self.assertFalse(self.app.draft(draft["id"])["sent"])
+        self.assertEqual(cloud.export_gmail(draft["id"]),result)
+        client.create_draft.assert_called_once()
+
+    def test_price_change_cannot_use_cached_gmail_success_to_bypass_current_validation(self):
+        _, _, draft = self.approve_priced()
+        cloud, client, _ = self.fake_gmail()
+        self.assertEqual(cloud.export_gmail(draft["id"])["status"],"created")
+        self.prices(milk=1000)
+        with self.assertRaises(CafeError):
+            cloud.export_gmail(draft["id"])
+        client.create_draft.assert_called_once()
+
+    def test_pricebook_and_approved_price_snapshot_survive_restart_and_stale_price_revision_is_rejected(self):
+        state, order, draft = self.approve_priced()
+        restarted = self.new_service()
+        after = restarted.bom_state()
+        self.assertEqual(after["pricing"],state["pricing"])
+        self.assertEqual(after["stock"],state["stock"])
+        self.assertEqual(after["active_order_id"],order["id"])
+        self.assertEqual(restarted.bom().repo.draft(draft["id"])["total_cents"],8400)
+        with self.assertRaises(CafeError):
+            restarted.bom().set_prices({"revision":0,"entries":[
+                {"ingredient_id":"INV-003","pack_quantity":1000,"pack_price_cents":900},
+            ]})
+        self.assertEqual(restarted.bom_state()["pricing"],state["pricing"])
+
+
+if __name__=="__main__":
+    unittest.main()
