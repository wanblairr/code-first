+  assert.equal(draft.lines[0].quantity,5300);assert.equal(draft.lines[0].purchaseQuantity,6000);
+  assert.equal(draft.lines[0].lineTotalCents,7200);
+  assert.equal(draft.lines[1].name,'Reusable shop cups');assert.equal(draft.lines[1].lineTotalCents,2050);
