+@echo off
+setlocal
+chcp 65001 >nul
+set PYTHONUTF8=1
+set "launcher_exit=0"
+if not defined CAFE_DEMO_BASE set "CAFE_DEMO_BASE=%~dp0."
+cd /d "%~dp0"
+if errorlevel 1 goto prepare_failed
+echo 运行记录目录："%CAFE_DEMO_BASE%"
+python cafe_app.py --base "%CAFE_DEMO_BASE%" demo
+if errorlevel 1 goto prepare_failed
+python cafe_app.py --base "%CAFE_DEMO_BASE%" run
+if errorlevel 1 goto recommendation_failed
+goto start_server
+
+:recommendation_failed
+echo.
+echo 本次未能生成新建议，请查看上方具体错误。仍会打开网页供核对数据与历史草稿。
