+        actions.append(button('bom-download-txt',words('Download .txt','下载 .txt','Muat turun .txt','Descargar .txt'),()=>download(draft,last,'txt')),button('bom-download-eml',words('Download .eml','下载 .eml','Muat turun .eml','Descargar .eml'),()=>download(draft,last,'eml')));
+        if(active&&createDraftButtons)actions.append(...createDraftButtons(draft,last));
+        card.append(actions);
+      }
+      orderSection.append(card);
+    }else orderSection.append(node('p','empty-state',words('Approve a suggestion to create your purchase draft.','审批补货建议后，这里会生成采购草稿。','Luluskan cadangan untuk mencipta draf pembelian.','Aprueba una sugerencia para crear el borrador.')));
+    root.append(orderSection);
+    const audit=node('section','bom-audit');audit.append(node('h3','',words('Activity','操作记录','Aktiviti','Actividad')));
+    const logList=node('ol','audit-log');logList.id='bom-logs';
+    for(const entry of [...state.logs].reverse()){
+      const item=node('li');const time=node('time','',stamp(entry.at));time.dateTime=new Date(entry.at).toISOString();
+      const detail=node('div');
+      const text=entry.type==='approved'?words('Manager approved the replenishment suggestion','店长已审批通过补货建议','Pengurus meluluskan cadangan penambahan stok','El gerente aprobó la sugerencia de reposición'):entry.type==='sale'?words('Simulated sale recorded','已记录模拟售出','Jualan simulasi direkod','Venta simulada registrada'):words('Replenishment suggestions calculated','已生成补货建议','Cadangan stok dikira','Sugerencias calculadas');
+      detail.append(node('strong','',text));
+      if(entry.sale)detail.append(node('p','',productName(entry.sale.productId)+' · '+sizeName(entry.sale.size)+' × '+number(entry.sale.quantity)));
+      if(entry.type==='approved'){item.className='bom-approved-log';item.append(node('p','bom-exact-log','['+stamp(entry.at)+'] '+text));}
+      else item.append(time,detail);logList.append(item);
+    }
+    if(!state.logs.length)logList.append(node('li','',words('Your actions will appear here.','你的操作会记录在这里。','Aktiviti anda akan muncul di sini.','Tus acciones aparecerán aquí.')));
+    audit.append(logList,node('p','small-copy',storageAvailable?words('Demo records are saved in this browser tab only.','演示记录仅保存在当前浏览器标签页。','Rekod demo disimpan dalam tab ini sahaja.','Los registros de demo solo se guardan en esta pestaña.'):words('Storage is unavailable. Refreshing clears this session.','浏览器存储不可用，刷新会清除本次记录。','Storan tidak tersedia. Muat semula memadam sesi ini.','No hay almacenamiento. Recargar borra esta sesión.')));
+    root.append(audit);refreshApproval();
+    const steps=document.querySelectorAll('.workflow li');
+    steps.forEach((item,index)=>item.classList.toggle('active',index<=(active?3:quote?2:state.revision?1:0)));
+  }
+  const controller={
+    getCurrentOrder,
+    localizeDraft:localizeBOMDraft,
+    getRunpodSnapshot(){
+      try{const context=getContext(),f=getForecast();return {target_date:f.targetDate,data_source:'synthetic',
+        predictions:f.sales.map(s=>({sku:s.productId.toLowerCase().replaceAll('-','_'),local_forecast_units:s.quantity})),
+        context:{temperature_c:context.weather.temperatureC,precipitation_mm:context.weather.precipitationMm,is_holiday:context.holiday.isHoliday},
+        signature:currentSignature()};}catch{return null;}
+    },
+    contextChanged(){
+      let next=null;try{next=getForecast().contextSignature;}catch{}
