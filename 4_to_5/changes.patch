@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {initialStock,usage,sell,restoreLastSale} from '../dist/demo/bom-core.mjs';
+const data=JSON.parse(await readFile(new URL('../dist/demo/bom-data.json',import.meta.url),'utf8'));
+function fixture(sale={productId:'BV-013',size:'中杯',quantity:36}){
+  const beforeStock=initialStock(data);
+  return {stock:sell(data,beforeStock,sale),
+    last:{transactionId:'sale-36',sale,consumed:usage(data,[sale]),stockRevision:1,beforeStock}};
+}
+test('restores exact 36 cup deductions and never mutates current/last transaction objects',()=>{
+  const {stock,last}=fixture(), before=structuredClone({stock,last});
+  assert.equal(stock['INV-005'],2600);
+  assert.deepEqual(restoreLastSale(data,stock,last,1),initialStock(data));
+  assert.deepEqual({stock,last},before);
+});
+test('bakery and water/ice recipes restore all finished and raw base units',()=>{
+  for(const sale of [
+    {productId:'BK-01',size:'份',quantity:3},
+    {productId:'BV-020',size:'中杯',quantity:2},
+  ]){
+    const {stock,last}=fixture(sale);
+    assert.deepEqual(restoreLastSale(data,stock,last,1),initialStock(data));
+  }
+});
+test('stale/newer revision, invalid marker and repeat against already-restored stock fail closed',()=>{
+  const {stock,last}=fixture();
+  for(const revision of [0,2,true,NaN,1.5,Number.MAX_SAFE_INTEGER])
+    assert.throws(()=>restoreLastSale(data,stock,last,revision));
+  const restored=restoreLastSale(data,stock,last,1);
+  assert.throws(()=>restoreLastSale(data,restored,last,1));
+  assert.throws(()=>restoreLastSale(data,stock,null,1));
+  assert.throws(()=>restoreLastSale(data,stock,{...last,transactionId:''},1));
+  assert.throws(()=>restoreLastSale(data,stock,{...last,stockRevision:true},1));
+});
+test('forged consumed quantities or unknown ingredients cannot create extra stock',()=>{
+  const {stock,last}=fixture();
+  for(const consumed of [
+    {'INV-001':648,'INV-005':5401}, {'INV-005':5400},
+    {...last.consumed,UNKNOWN:1},{'INV-001':true,'INV-005':5400},
+    {'INV-001':648,'INV-005':'5400'},
+  ]) assert.throws(()=>restoreLastSale(data,stock,{...last,consumed},1));
+});
+test('beforeStock must exist, match the actual sale and use valid known material quantities',()=>{
+  const {stock,last}=fixture();
+  for(const beforeStock of [
+    null,{}, {...last.beforeStock,'INV-005':9000},
+    {...last.beforeStock,'INV-005':true},{...last.beforeStock,UNKNOWN:1},
+  ]) assert.throws(()=>restoreLastSale(data,stock,{...last,beforeStock},1));
+  assert.throws(()=>restoreLastSale(data,{...stock,UNKNOWN:1},last,1));
+});
+test('new sale/current stock changes invalidate an old undo candidate atomically',()=>{
+  const {stock,last}=fixture();
+  const next=sell(data,stock,{productId:'BV-013',size:'中杯',quantity:1});
+  const before=structuredClone(next);
+  assert.throws(()=>restoreLastSale(data,next,last,1));
+  assert.deepEqual(next,before);
+});
+test('original base stock at MAX_SAFE is restored exactly, while invalid overflow evidence rejects',()=>{
+  const large=structuredClone(data);
+  large.materials['INV-005'].initial=Number.MAX_SAFE_INTEGER;
+  const beforeStock=initialStock(large),sale={productId:'BV-013',size:'中杯',quantity:1};
+  const stock=sell(large,beforeStock,sale);
+  const last={transactionId:'max-safe-sale',sale,consumed:usage(large,[sale]),stockRevision:1,beforeStock};
+  assert.equal(restoreLastSale(large,stock,last,1)['INV-005'],Number.MAX_SAFE_INTEGER);
+  assert.throws(()=>restoreLastSale(large,{...stock,'INV-005':Number.MAX_SAFE_INTEGER},last,1));
+});
