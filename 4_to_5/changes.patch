+++ b/public_website/dist/demo/bom-pricing.mjs
@@ -0,0 +1,133 @@
+import {initialStock} from './bom-core.mjs?v=3.7.0';
+
+const valid = value => Number.isSafeInteger(value) && value >= 0;
+const object = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const own = (value,key) => object(value) && Object.hasOwn(value,key);
+const SOURCES = new Set(['owner_entry','supplier_quote','demo','manual_demo']);
+const QUOTE_FIELDS = new Set(['ingredientId','packQuantity','packPriceCents','currency','source']);
+const LIMIT = BigInt(Number.MAX_SAFE_INTEGER);
+
+function checkedMaterials(data) {
+  initialStock(data);
+  for (const material of Object.values(data.materials)) {
+    if (!['ml','g','个'].includes(material.unit)) throw Error('报价基础单位必须来自CSV原料');
+  }
+  return data.materials;
+}
+
+function integer(value,label) {
+  if (!valid(value)) throw Error(label + '须为非负安全整数');
+  return value;
+}
+
+function quote(value,id) {
+  if (value === null) return null;
+  if (!object(value) || Reflect.ownKeys(value).some(key=>!QUOTE_FIELDS.has(key)) ||
+      (own(value,'ingredientId') && value.ingredientId !== id))
+    throw Error('报价字段或原料ID无效');
+  const currency = value.currency ?? 'MYR';
+  const source = value.source ?? 'owner_entry';
+  if (currency !== 'MYR' || typeof source !== 'string' ||
+      !(SOURCES.has(source) || source === 'unquoted'))
+    throw Error('报价须使用MYR并标明手动、供应商或模拟来源');
+  if (value.packQuantity === null && value.packPriceCents === null) return null;
+  if (!valid(value.packQuantity) || value.packQuantity <= 0 ||
+      !valid(value.packPriceCents) || source === 'unquoted')
+    throw Error('每包装基础单位量须为正整数，包装价格须为非负整数分；未知报价请同时清空');
+  return {ingredientId:id,packQuantity:value.packQuantity,
+    packPriceCents:value.packPriceCents,currency:'MYR',source};
+}
+
+export function createPricebook(data) {
+  return {priceRevision:0,currency:'MYR',
+    prices:Object.fromEntries(Object.keys(checkedMaterials(data)).map(id=>[id,null]))};
+}
+
+export function validatePricebook(data,book = null) {
+  const normalized = createPricebook(data);
+  if (book === null || book === undefined) return normalized;
+  if (!object(book) || book.currency !== 'MYR' || !valid(book.priceRevision) ||
+      !object(book.prices) ||
+      Reflect.ownKeys(book).some(key=>!['priceRevision','currency','prices'].includes(key)))
+    throw Error('报价目录版本、币种或结构无效');
+  for (const id of Reflect.ownKeys(book.prices)) {
+    if (typeof id !== 'string' || !own(data.materials,id)) throw Error('报价含未知原料ID');
+    normalized.prices[id] = quote(book.prices[id],id);
+  }
+  normalized.priceRevision = book.priceRevision;
+  return normalized;
+}
+
+export function setPrices(data,book,entries,expectedRevision = book?.priceRevision ?? 0) {
+  const current = validatePricebook(data,book);
+  integer(expectedRevision,'报价版本');
+  if (expectedRevision !== current.priceRevision) throw Error('报价已在其他页面更新，请刷新后重试');
+  if (!Array.isArray(entries) || !entries.length || entries.length > Object.keys(data.materials).length)
+    throw Error('请提供非空原料报价数组');
+  const next = structuredClone(current), seen = new Set();
+  for (const entry of entries) {
+    const id = entry?.ingredientId;
+    if (!object(entry) || typeof id !== 'string' || !own(data.materials,id) || seen.has(id))
+      throw Error('未知或重复报价原料');
+    seen.add(id);
+    next.prices[id] = quote(entry,id);
+  }
+  if (JSON.stringify(next.prices) === JSON.stringify(current.prices)) return current;
+  next.priceRevision = integer(current.priceRevision + 1,'报价版本');
+  return next;
+}
+
+function number(big,label) {
+  if (big < 0n || big > LIMIT) throw Error(label + '超出安全整数范围');
+  return Number(big);
+}
+
+// A row keeps its suggested/approved base quantity. Physical whole-pack purchase
+// quantities are additional fields and never silently replace that decision.
+export function priceBOMRows(data,rows,quantities = {},book = null) {
+  const pricebook = validatePricebook(data,book);
+  if (!Array.isArray(rows) || !object(quantities)) throw Error('采购计价明细或数量对象无效');
+  const items = [], missingPriceIds = [], seen = new Set();
+  let subtotal = 0n;
+  for (const row of rows) {
+    const id = row?.ingredientId ?? row?.id;
+    if (!object(row) || typeof id !== 'string' || !own(data.materials,id) || seen.has(id) ||
+        (own(row,'id') && row.id !== id) ||
+        (own(row,'unit') && row.unit !== data.materials[id].unit))
+      throw Error('采购原料ID、基础单位或重复计价行无效');
+    seen.add(id);
+    const baseQuantity = own(quantities,id) ? quantities[id] :
+      own(row,'approvedQuantity') ? row.approvedQuantity :
+      own(row,'quantity') ? row.quantity : row.suggestedQuantity;
+    integer(baseQuantity,'采购基础单位数量');
+    const offer = pricebook.prices[id];
+    const item = {
+      ...structuredClone(row), baseQuantity, priceKnown:offer !== null,
+      packQuantity:offer?.packQuantity ?? null, packPriceCents:offer?.packPriceCents ?? null,
+      priceSource:offer?.source ?? null, currency:'MYR',
+      purchasePacks:null,purchaseQuantity:null,lineTotalCents:null,
+    };
+    if (baseQuantity === 0) {
+      item.purchasePacks = 0; item.purchaseQuantity = 0; item.lineTotalCents = 0;
+    } else if (offer === null) {
+      missingPriceIds.push(id);
+    } else {
+      const base = BigInt(baseQuantity), pack = BigInt(offer.packQuantity);
+      const packs = (base + pack - 1n) / pack;
+      const purchased = packs * pack, cost = packs * BigInt(offer.packPriceCents);
+      item.purchasePacks = number(packs,'采购包装数');
+      item.purchaseQuantity = number(purchased,'整包采购数量');
+      item.lineTotalCents = number(cost,'采购行金额');
+      subtotal += cost;
+      number(subtotal,'已知采购金额合计');
+    }
+    items.push(item);
+  }
+  if (Reflect.ownKeys(quantities).some(id=>typeof id !== 'string' || !seen.has(id)))
+    throw Error('采购数量含未知计价原料');
+  const knownSubtotalCents = number(subtotal,'已知采购金额合计');
+  return {items,currency:'MYR',priceRevision:pricebook.priceRevision,
+    totalCents:missingPriceIds.length ? null : knownSubtotalCents,
+    knownSubtotalCents,pricesComplete:missingPriceIds.length === 0,
+    missingPriceIds,pricebookSnapshot:structuredClone(pricebook)};
+}
