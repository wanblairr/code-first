+  const shortfall = text.match(/^(预计缺口：|本次仍有缺口：)(.+?)(。继续审批时需再次确认。|。)$/);
+  if (shortfall) { const lines = translateQuantityList(shortfall[2]); if (lines) return `Remaining shortfall: ${lines}.${shortfall[3].includes('再次') ? ' Acknowledge it again before approval.' : ''}`; }
