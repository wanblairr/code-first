+      const order={items,prices_complete:complete,total_cents:complete?items.reduce((sum,item)=>sum+item.line_total_cents,0):null,id:'bom-order',proposal_id:'proposal-7',target_date:'2026-10-25',status:'approved',drafts:[{
+        id:'bom-draft',order_id:'bom-order',email:'bom-orders@example.com',subject:'Demo',body:'燕麦奶: '+payload.quantities['INV-005']+' ml',
+        lines:[{ingredient_id:'INV-005',quantity:payload.quantities['INV-005']}]}]};
