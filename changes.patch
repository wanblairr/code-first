+  const text=await response.text();if(text.length>24000)throw new Error('invalid');const data=JSON.parse(text);
+  if(JSON.stringify(data).includes(approved.input.apiKey))throw new Error('invalid');
+  if(approved.epoch!==epoch||sourceStamp()!==approved.sourceStamp||JSON.stringify(readConfig())!==approved.configStamp){invalidate();return;}
+  resultStamp=approved.sourceStamp;
