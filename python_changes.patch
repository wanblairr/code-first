+"""Synthetic cafe workflow: durable proposals, owner approval and supplier drafts.
+
+Optional cloud review and Gmail draft export require explicit configuration.
+A database transaction records approval and local draft bodies together.
+Inventory changes only through input snapshots; no supplier message is sent.
+"""
+from __future__ import annotations
+
+import csv
