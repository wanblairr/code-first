diff --git a/local_app/tests/test_bom_connected_v36.py b/local_app/tests/test_bom_connected_v36.py
new file mode 100644
index 0000000000000000000000000000000000000000..d0c29bda8b6197abfe6c86a9e43e1cb684b4eacd
