+.login-layout{gap:64px;min-height:590px}.login-intro{padding:20px 0}.login-intro-note{display:flex;align-items:center;font-size:12px;color:#73856a;margin-top:32px}.login-intro-note .status-dot{background:#91a27d}.login-panel{padding:32px;box-shadow:0 10px 40px #244a3608}.login-access{display:flex;gap:14px;align-items:center}.login-lock{width:50px;height:50px;border-radius:15px;background:#eaf0e2;color:#496d3f;display:grid;place-items:center;flex-shrink:0}.login-lock svg{width:25px;height:25px;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.login-access .eyebrow{display:block;font-size:10px;letter-spacing:1.4px;margin-bottom:4px}.login-access h2{font-size:26px;line-height:1.3}.login-panel>p#login-help{margin-top:18px;font-size:13px;line-height:1.8}.login-panel form{margin-top:25px}.password-control{position:relative;display:flex;align-items:center;margin-bottom:18px}.login-panel .password-control input{width:100%;min-width:0;padding:13px 76px 13px 13px;min-height:51px;margin:0;border-radius:10px;line-height:1.5}.password-control input[aria-invalid=true]{border-color:#c67b54;background:#fffaf5}.password-toggle{position:absolute;right:5px;top:4px;bottom:4px;padding:0 12px;min-width:54px;border:0;border-left:1px solid #e5eadf;background:transparent;font-size:12px;color:#5e7950;border-radius:0 7px 7px 0}.password-toggle:hover{background:#f2f5eb}.login-panel #login-submit{min-height:48px}.login-panel #login-error{margin:-6px 0 16px;font-size:12px}.login-footer-note{display:flex;justify-content:space-between;gap:12px;border-top:1px solid #e6ebdf;margin-top:25px;padding-top:18px;color:#849078;font-size:11px}.login-footer-note>span:first-child{color:#617c51}.login-panel .fine{font-size:11px;margin-top:12px;line-height:1.7;color:#86917e}
+@media(max-width:800px){.login-layout{gap:30px;min-height:560px}}
+@media(max-width:600px){.login-layout{display:block;min-height:0}.login-intro{padding:0;margin:6px 0 25px}.login-intro h1{font-size:29px;line-height:1.4;margin:9px 0 12px}.login-intro>p{font-size:12px;line-height:1.8}.login-intro-note{display:none}.login-panel{padding:25px 22px}.login-lock{width:44px;height:44px;border-radius:13px}.login-access{gap:12px}.login-access h2{font-size:24px}.login-panel>p#login-help{font-size:12px;margin-top:17px}.login-panel form{margin-top:22px}.password-control{margin-bottom:17px}.login-footer-note{margin-top:23px;font-size:10px}.login-panel .fine{font-size:11px}.login-panel .password-control input{font-size:16px}}
