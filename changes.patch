+"""Durable, optional cloud review and approved supplier draft exports.
+
+Network calls never occur on a state read. A submission with an uncertain result
+is not repeated automatically. Remote forecasts still require owner approval.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import json
+import threading
+import uuid
+
+from cafe_core import CafeError, canonical, fingerprint, now
+from cafe_integrations_config import IntegrationConfig
+from cafe_runpod import RunpodClient, RunpodError, build_review_input, parse_review_output
+from cafe_gmail import GmailDraftClient, GmailAPIError, build_whatsapp_draft
+from cafe_gmail_auth_manager import GmailAuthManager
+from cafe_gmail_oauth import GmailOAuthError
+
+
+ACTIVE = {"submitting", "queued", "in_progress", "waiting"}
+
+
+class CloudWorkflow:
+    def __init__(self, service):
+        self.service = service
+        self.config = IntegrationConfig(service.runtime)
+        self.gmail_auth = GmailAuthManager(self.config)
+        self.runpod_factory = RunpodClient
+        self.gmail_factory = GmailDraftClient
+        self._whatsapp_workflow = None
+        self._whatsapp_sandbox_workflow = None
+        self.threads = {}
+        self.poll_seconds = 5
+        self.poll_limit = 60
+        with service.store.connect() as db:
+            db.executescript("""
+            CREATE TABLE IF NOT EXISTS cloud_jobs (
+              id TEXT PRIMARY KEY, dedup TEXT UNIQUE NOT NULL, document TEXT NOT NULL);
+            CREATE TABLE IF NOT EXISTS external_drafts (
+              draft_id TEXT NOT NULL, provider TEXT NOT NULL, document TEXT NOT NULL,
+              PRIMARY KEY(draft_id,provider));
+            CREATE TABLE IF NOT EXISTS integration_checks (
+              provider TEXT PRIMARY KEY, document TEXT NOT NULL);
+            """)
+            # A crash between POST and saving the remote ID is not evidence of failure.
+            for row in db.execute("SELECT id,document FROM cloud_jobs").fetchall():
+                doc = json.loads(row["document"])
+                if doc["status"] in ACTIVE and not doc.get("remote_id"):
+                    doc.update(status="unknown", message="上次提交结果不确定；请在 Runpod 控制台核对，系统不会自动重复付费提交。", updated_at=now())
+                    db.execute("UPDATE cloud_jobs SET document=? WHERE id=?", (canonical(doc), doc["id"]))
+            for row in db.execute("SELECT draft_id,document FROM external_drafts").fetchall():
+                doc = json.loads(row["document"])
+                if doc["status"] == "creating":
+                    doc.update(status="unknown", message="上次保存结果不确定；请先检查 Gmail 草稿箱，避免重复创建。")
+                    db.execute("UPDATE external_drafts SET document=? WHERE draft_id=? AND provider='gmail'", (canonical(doc), row["draft_id"]))
+
+    @staticmethod
+    def public_job(doc):
+        return {key: deepcopy(doc[key]) for key in ("id", "proposal_id", "status", "remote_id", "created_at", "updated_at", "result_proposal_id", "message", "execution_ms", "delay_ms") if key in doc}
+
+    def public(self):
+        with self.service.store.connect() as db:
+            checks = {r["provider"]: json.loads(r["document"]) for r in db.execute("SELECT * FROM integration_checks")}
+            jobs = [self.public_job(json.loads(r[0])) for r in db.execute("SELECT document FROM cloud_jobs ORDER BY rowid DESC LIMIT 20")]
+            exports = [json.loads(r[0]) for r in db.execute("SELECT document FROM external_drafts ORDER BY rowid DESC LIMIT 50")]
+        return {"public_config": self.config.public(), "checks": checks, "jobs": jobs, "exports": exports,
+                "whatsapp_messages": self.whatsapp_api().public(),
+                "whatsapp_sandbox_messages": self.whatsapp_sandbox().public()}
+
+    def configure(self, values):
+        with self.service.lock:
+            self.gmail_auth.configure(values)
+            # A successful check of old credentials is not a check of the new ones.
+            with self.service.store.connect() as db:
+                db.execute("DELETE FROM integration_checks")
+                self.service.store.event(db, "owner", "integration_configured", "integrations", {"providers": ["runpod", "gmail", "whatsapp", "whatsapp_sandbox"], "secrets_recorded": False})
+            return self.public()
+
+    def _gmail_authorization_changed(self, action, detail):
+        with self.service.store.connect() as db:
+            db.execute("DELETE FROM integration_checks WHERE provider='gmail'")
+            self.service.store.event(db, "owner", action, "gmail", detail)
+
+    def import_gmail_client(self, client_json):
+        self.gmail_auth.import_client(client_json)
+        self._gmail_authorization_changed("gmail_oauth_client_imported", {"secrets_recorded": False})
+        return self.public()
+
+    def start_gmail_oauth(self, session_binding, redirect_uri):
+        result = self.gmail_auth.begin(session_binding, redirect_uri)
+        self.service.store.log("gmail_oauth_started", {"secrets_recorded": False}, "gmail", actor="owner")
+        return result
+
+    def complete_gmail_oauth(self, code, state, session_binding, redirect_uri):
+        result = self.gmail_auth.complete(code, state, session_binding, redirect_uri)
+        self._gmail_authorization_changed("gmail_oauth_connected", {"automatic_refresh": True, "secrets_recorded": False})
+        return dict(result, integrations=self.public())
+
+    def disconnect_gmail_oauth(self):
+        result = self.gmail_auth.disconnect()
+        self._gmail_authorization_changed("gmail_oauth_disconnected", {"revoke_status": result["revoke_status"], "secrets_recorded": False})
+        return dict(self.public(), **result)
+
+    def _client(self, cfg=None):
+        cfg = cfg or self.config.public()["runpod"]
+        if not cfg["enabled"] or not cfg["endpoint_id"] or not cfg["credential_present"]:
+            raise CafeError("请先在演示电脑本机配置 Runpod Endpoint ID 和 API Key，并启用接口。")
+        return self.runpod_factory(cfg["endpoint_id"], self.config.secret("runpod_api_key"), profile=cfg["request_profile"], model=cfg["model"], timeout=10)
+
+    def check(self, provider):
+        if provider not in ("runpod", "gmail", "whatsapp"):
+            raise CafeError("不支持的接口。")
+        try:
+            if provider == "runpod":
+                self._client().health()
+            elif provider == "gmail":
+                self.gmail_auth.execute(lambda token: self.gmail_factory(token, timeout=10).check_connection())
+            else:
+                self.whatsapp_api().check()
+            messages = {"runpod": "Runpod 认证与健康接口可用；模型输出仍须单独复核。",
+                        "gmail": "Gmail 草稿接口可访问；不会发送邮件。",
+                        "whatsapp": "WhatsApp 号码只读接口可访问；尚未发送或验证采购模板。"}
+            result = {"connected": True, "at": now(), "message": messages[provider]}
+        except GmailOAuthError as exc:
+            result = {"connected": False, "at": now(), "message": str(exc)}
+        except (CafeError, OSError, ValueError):
+            result = {"connected": False, "at": now(), "message": "连接检查未通过，请核对本机凭据、权限及网络。"}
+        with self.service.store.connect() as db:
+            db.execute("INSERT OR REPLACE INTO integration_checks VALUES(?,?)", (provider, canonical(result)))
+            self.service.store.event(db, "owner", "integration_checked", provider, result)
+        return result
+
+    def _read_job(self, job_id):
+        with self.service.store.connect() as db:
+            row = db.execute("SELECT document FROM cloud_jobs WHERE id=?", (job_id,)).fetchone()
+        if not row:
+            raise CafeError("Runpod 复核任务不存在。")
+        return json.loads(row[0])
+
+    def job(self, job_id):
+        return self.public_job(self._read_job(job_id))
+
+    def _update(self, job_id, **values):
+        with self.service.store.connect() as db:
+            row = db.execute("SELECT document FROM cloud_jobs WHERE id=?", (job_id,)).fetchone()
+            doc = json.loads(row[0])
+            doc.update(values, updated_at=now())
+            db.execute("UPDATE cloud_jobs SET document=? WHERE id=?", (canonical(doc), job_id))
+        return doc
+
+    def start(self, proposal_id, revision, input_hash, *, background=True):
+        svc = self.service
+        with svc.lock:
+            doc = svc.store.proposal(proposal_id)
+            inputs = svc.inputs()
+            if type(revision) is not int or revision != doc["revision"] or input_hash != doc["input_hash"]:
+                raise CafeError("建议版本已变化，请刷新后复核。")
+            if doc["status"] != "pending" or doc.get("cloud_inference"):
+                raise CafeError("仅可复核待审批的本地建议；同一建议不会反复调用云端。")
+            svc.preview(proposal_id, revision, input_hash, {})
+            cfg = self.config.public()["runpod"]
+            self._client(cfg)  # Validate config before reserving a durable submission.
+            policy_hash = self.config.policy_hash()
+            dedup = fingerprint({"proposal_hash": input_hash, "policy_hash": policy_hash})
+            with svc.store.connect() as db:
+                old = db.execute("SELECT document FROM cloud_jobs WHERE dedup=?", (dedup,)).fetchone()
+                if old:
+                    existing = json.loads(old[0])
+                    if existing["status"] in ACTIVE and existing.get("remote_id") and background:
+                        self._launch(existing["id"])
+                    return self.public_job(existing)
+                doc_job = {"id": str(uuid.uuid4()), "proposal_id": proposal_id, "proposal_revision": revision,
+                           "base_input_hash": input_hash, "policy_hash": policy_hash, "config": cfg,
+                           "proposal": doc, "inputs": inputs, "status": "submitting", "created_at": now(), "updated_at": now(),
+                           "message": "已登记复核请求，正在提交；冷启动期间可继续查看本地建议。"}
+                db.execute("INSERT INTO cloud_jobs VALUES(?,?,?)", (doc_job["id"], dedup, canonical(doc_job)))
+                svc.store.event(db, "owner", "runpod_review_requested", doc_job["id"], {"proposal_id": proposal_id, "endpoint_id": cfg["endpoint_id"], "policy_hash": policy_hash})
+            if background:
+                self._launch(doc_job["id"])
+            return self.public_job(doc_job)
+
+    def _launch(self, job_id):
+        current = self.threads.get(job_id)
+        if current and current.is_alive():
+            return
+        thread = threading.Thread(target=self.run_job, args=(job_id,), daemon=True, name="cafe-runpod-review")
+        self.threads[job_id] = thread
+        thread.start()
+
+    def resume(self):
+        """Only query known remote IDs after restart; never repeat a submission."""
+        for job in self.public()["jobs"]:
+            if job["status"] in ACTIVE and job.get("remote_id"):
+                self._launch(job["id"])
+
+    def _claim_submission(self, job_id):
+        """Reserve one POST durably, even if two worker threads race.
+
+        A claim without a recorded remote ID becomes unknown on restart. Another
+        thread must never interpret the missing ID as permission for a new POST.
+        """
+        with self.service.store.connect() as db:
+            row = db.execute("SELECT document FROM cloud_jobs WHERE id=?", (job_id,)).fetchone()
+            doc = json.loads(row[0])
+            if doc["status"] not in ACTIVE or doc.get("remote_id") or doc.get("submission_started_at"):
+                return None
+            doc.update(submission_started_at=now(), updated_at=now())
+            db.execute("UPDATE cloud_jobs SET document=? WHERE id=?", (canonical(doc), job_id))
+            return doc
+
+    def _submission_current(self, job):
+        """Avoid spending a request on inputs that changed while waiting locally."""
+        svc = self.service
+        with svc.lock:
+            try:
+                current = svc.store.proposal(job["proposal_id"])
+                inputs = svc.inputs()
+                if (current["status"] != "pending" or current["revision"] != job["proposal_revision"] or
+                        svc.source_hash(inputs) != job["base_input_hash"] or self.config.policy_hash() != job["policy_hash"]):
+                    raise CafeError("stale")
+                svc.preview(current["id"], current["revision"], current["input_hash"], {})
+            except CafeError:
+                self._update(job["id"], status="stale", message="资料、日期、审批状态或接口配置已更新，未提交旧的云端复核。")
+                return False
+            return True
+
+    def run_job(self, job_id):
+        job = self._read_job(job_id)
+        if job["status"] not in ACTIVE:
+            return
+        try:
+            if job["policy_hash"] != self.config.policy_hash():
+                self._update(job_id, status="stale", message="接口配置已变化，保留本地预测；旧结果不会用于审批。")
+                return
+            client = self._client(job["config"])
+            if job.get("remote_id"):
+                envelope = client.status(job["remote_id"])
+            else:
+                if not self._submission_current(job):
+                    return
+                ratio = job["config"]["max_adjustment_percent"] / 100
+                payload = build_review_input(job["proposal"], job["config"]["request_profile"], job["config"]["model"], max_change_ratio=ratio)
+                payload["sampling_params"].update(max_tokens=job["config"]["max_tokens"], temperature=job["config"]["temperature"])
+                job = self._claim_submission(job_id)
+                if job is None:
+                    return
+                envelope = client.submit(payload)
+                job = self._update(job_id, remote_id=envelope["id"], status="queued", message="Runpod 已接收任务，正在等待或执行模型推理。")
+            for attempt in range(self.poll_limit + 1):
+                state = envelope["status"]
+                if state == "COMPLETED":
+                    self._accept(job, envelope)
+                    return
+                if state in ("FAILED", "CANCELLED", "TIMED_OUT"):
+                    self._update(job_id, status="failed", message="Runpod 任务未成功完成，已保留本地建议。")
+                    return
+                self._update(job_id, status="queued" if state == "IN_QUEUE" else "in_progress", message="等待 Runpod 冷启动／模型执行；审批仍由老板确认。")
+                if attempt == self.poll_limit or self.service.stop.wait(self.poll_seconds):
+                    self._update(job_id, status="waiting", message="已保留远程任务编号；再次打开或复核只查询原任务，不重复提交。")
+                    return
+                envelope = client.status(envelope["id"])
+        except RunpodError as exc:
+            current = self._read_job(job_id)
+            if current.get("remote_id"):
+                status = "waiting"
+                message = "暂时无法查询远程任务，已保留编号；再次复核只查询原任务。"
+                if exc.code in ("invalid_output", "invalid_input"):
+                    status, message = "failed", "云端输出未通过日期、SKU、数值或调整幅度校验，已保留本地建议。"
+            else:
+                status = "unknown" if exc.outcome_unknown else "failed"
+                message = "提交结果不确定，请在 Runpod 控制台核对；不会自动重复提交。" if exc.outcome_unknown else "Runpod 请求未完成，已保留本地建议。"
+            self._update(job_id, status=status, message=message)
+        except Exception:
+            # Neither raw provider responses nor potentially echoed credentials enter logs.
+            current = self._read_job(job_id)
+            self._update(job_id, status="waiting" if current.get("remote_id") else "unknown", message="复核暂未完成，已保留本地建议和任务记录；不会重复提交。")
+
+    def _accept(self, job, envelope):
+        svc = self.service
+        reviewed = parse_review_output(envelope, job["proposal"], job["config"]["max_adjustment_percent"] / 100)
+        with svc.lock:
+            # Concurrent GET-only reconciliation may observe the same completed
+            # remote result. Its second observer must preserve the accepted result.
+            recorded = self._read_job(job["id"])
+            if recorded["status"] == "completed":
+                return
+            current = svc.store.proposal(job["proposal_id"])
+            inputs = svc.inputs()
+            if (current["status"] != "pending" or current["revision"] != job["proposal_revision"] or
+                    svc.source_hash(inputs) != job["base_input_hash"] or self.config.policy_hash() != job["policy_hash"]):
+                self._update(job["id"], status="stale", message="资料、审批状态或接口配置已更新，旧云端结果不应用于采购。")
+                return
+            try:
+                svc.preview(current["id"], current["revision"], current["input_hash"], {})
+            except CafeError:
+                self._update(job["id"], status="stale", message="建议已跨日、天气过期或审批资料变化，旧云端结果不应用于采购。")
+                return
+            from cafe_materials import plan
+            forecast = {"target_date": reviewed["target_date"], "items": reviewed["predictions"], "model_version": "runpod_review_v1",
+                        "context": deepcopy(current["forecast"].get("context", {})), "warnings": reviewed["warnings"] + ["Runpod 为通用模型复核，未使用真实销量微调；仍需老板核对。"]}
+            procurement = plan(forecast, inputs["inventory"], inputs["recipes"], inputs["suppliers"], current["target_date"])
+            from cafe_catalog import decorate_plan
+            procurement = decorate_plan(procurement, inputs["catalog"], inputs["suppliers"])
+            artifact = {"provider": "runpod", "endpoint_id": job["config"]["endpoint_id"], "model": job["config"]["model"],
+                        "job_id": envelope["id"], "policy_hash": job["policy_hash"], "review": reviewed, "at": now()}
+            doc = deepcopy(current)
+            for key in ("status", "revision"):
+                doc.pop(key, None)
+            doc.update(id=str(uuid.uuid4()), created_at=now(), trigger="runpod_review", base_input_hash=job["base_input_hash"],
+                       local_forecast=deepcopy(current["forecast"]), local_plan=deepcopy(current["plan"]), cloud_inference=artifact,
+                       forecast=forecast, plan=procurement)
+            doc["input_hash"] = self.proposal_hash(doc, inputs)
+            if doc.get("analysis"):
+                doc["analysis"]["cloud_review"] = {"local_total": current["plan"]["forecast_total_units"], "cloud_total": procurement["forecast_total_units"], "summary": reviewed["summary"],
+                    "note": "天气和假日影响来自本地回测模型；Runpod 复核调整单独展示，不能当作天气的因果效果。",
+                    "ingredients": [{"ingredient_id": i["ingredient_id"], "name": i["name"], "unit": i["unit"], "local_quantity": old["suggested_quantity"], "cloud_quantity": i["suggested_quantity"]} for i, old in zip(procurement["items"], current["plan"]["items"])]}
+            result_id = svc.store.save_proposal(doc)
+            values = {"status": "completed", "result_proposal_id": result_id, "message": "云端复核已通过校验，已生成新的待审批建议；尚未采购。"}
+            for source, dest in (("executionTime", "execution_ms"), ("delayTime", "delay_ms")):
+                if source in envelope:
+                    values[dest] = envelope[source]
+            self._update(job["id"], **values)
+            svc.store.log("runpod_review_completed", {"proposal_id": result_id, "remote_id": envelope["id"], "endpoint_id": job["config"]["endpoint_id"]}, job["id"])
+
+    def proposal_hash(self, doc, inputs):
+        if not doc.get("cloud_inference"):
+            return self.service.source_hash(inputs)
+        return fingerprint({"base_input_hash": self.service.source_hash(inputs), "cloud_inference": doc["cloud_inference"], "policy_hash": self.config.policy_hash()})
+
+    def export_gmail(self, draft_id):
+        svc = self.service
+        with svc.lock:
+            bom = isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-")
+            draft, bom_order = svc.bom_approved_draft(draft_id) if bom else (svc.store.draft(draft_id), None)
+            with svc.store.connect() as db:
+                order = bom_order if bom else db.execute("SELECT id FROM orders WHERE id=?", (draft["order_id"],)).fetchone()
+                if not order:
+                    raise CafeError("只有老板批准后生成的采购草稿可以保存到 Gmail。")
+                old = db.execute("SELECT document FROM external_drafts WHERE draft_id=? AND provider='gmail'", (draft_id,)).fetchone()
+                previous = json.loads(old[0]) if old else None
+                if previous and previous["status"] != "failed":
+                    return previous
+                if not self.config.public()["gmail"]["credential_present"]:
+                    raise CafeError("请先在演示电脑本机连接 Gmail 授权。")
+                result = {"draft_id": draft_id, "provider": "gmail", "status": "creating", "sent": False, "at": now(),
+                          "attempt": (previous.get("attempt", 1) + 1) if previous else 1}
+                db.execute("INSERT OR REPLACE INTO external_drafts VALUES(?,'gmail',?)", (draft_id, canonical(result)))
+                svc.store.event(db, "owner", "gmail_draft_export_requested", draft_id,
+                                {"attempt": result["attempt"], "sent": False})
+        try:
+            outcome = self.gmail_auth.execute(lambda token: self.gmail_factory(token, timeout=10).create_draft(draft))
+            result.update(outcome, status="created", message="已保存到 Gmail 草稿箱，尚未发送。")
+        except GmailOAuthError as exc:
+            # No draft POST occurred, or a definite 401 preceded the refresh.
+            result.update(status="failed", message=str(exc))
+        except GmailAPIError as exc:
+            result.update(status="unknown" if exc.outcome_unknown else "failed", message="保存结果不确定，请先检查 Gmail 草稿箱；系统不会自动重复创建。" if exc.outcome_unknown else "Gmail 未接受此请求，请核对令牌权限；本地草稿已保留。")
+        except Exception:
+            result.update(status="unknown", message="保存结果暂时不确定，请先检查 Gmail 草稿箱；本地草稿已保留。")
+        with svc.store.connect() as db:
+            db.execute("UPDATE external_drafts SET document=? WHERE draft_id=? AND provider='gmail'", (canonical(result), draft_id))
+            svc.store.event(db, "owner", "gmail_draft_export", draft_id, result)
+        return result
+
+    def whatsapp(self, draft_id):
+        draft = self.service.bom_approved_draft(draft_id)[0] if isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-") else self.service.store.draft(draft_id)
+        return build_whatsapp_draft(draft)
+
+    def whatsapp_api(self):
+        with self.service.lock:
+            if self._whatsapp_workflow is None:
+                from cafe_whatsapp_workflow import WhatsAppWorkflow
+                self._whatsapp_workflow = WhatsAppWorkflow(self.service, self.config)
+            return self._whatsapp_workflow
+
+    def whatsapp_sandbox(self):
+        with self.service.lock:
+            if self._whatsapp_sandbox_workflow is None:
+                from cafe_whatsapp_sandbox_workflow import WhatsAppSandboxWorkflow
+                self._whatsapp_sandbox_workflow = WhatsAppSandboxWorkflow(self.service, self.config)
+            return self._whatsapp_sandbox_workflow
diff --git a/local_app/cafe_context.py b/local_app/cafe_context.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e75db739f25f7a7e1fd14b8135672410e7b86b2
--- /dev/null
+++ b/local_app/cafe_context.py
@@ -0,0 +1,278 @@
+"""Kuala Lumpur's attributed holiday calendar and strictly future weather forecasts.
+
+Live weather is an input snapshot, never a historical training observation. This
+module performs no network request at import time or when reading the calendar.
+The competition's generated weather must be labelled ``synthetic_forecast`` by
+its generator; it cannot pass the live-snapshot validator below.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import socket
+import urllib.error
+import urllib.parse
+import urllib.request
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any
+
+from cafe_core import CafeError
+
+
+KL = timezone(timedelta(hours=8), "Asia/Kuala_Lumpur")
+LOCATION = "Kuala Lumpur"
+TIMEZONE = "Asia/Kuala_Lumpur"
+LATITUDE, LONGITUDE = 3.139, 101.6869
+WEATHER_ENDPOINT = "https://api.open-meteo.com/v1/forecast"
+WEATHER_DOCUMENTATION = "https://open-meteo.com/en/docs"
+CALENDAR_PATH = Path(__file__).resolve().parent / "data" / "calendar_kl_2026.json"
+MAX_FORECAST_DAYS_AHEAD = 15
+MAX_WEATHER_AGE_HOURS = 24
+
+
+class ContextUnavailable(CafeError):
+    """A missing, stale or inconsistent context must be shown to the operator."""
+
+
+def _utc_now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _day(value: str | date) -> date:
+    if isinstance(value, datetime):
+        raise ContextUnavailable("日期必须为 YYYY-MM-DD，不能用时间戳代替门店日期。")
+    if isinstance(value, date):
+        return value
+    try:
+        parsed = date.fromisoformat(value)
+    except (TypeError, ValueError) as exc:
+        raise ContextUnavailable("日期必须为有效的 YYYY-MM-DD。") from exc
+    if value != parsed.isoformat():
+        raise ContextUnavailable("日期必须为 YYYY-MM-DD。")
+    return parsed
+
+
+def _instant(value: str | datetime, label: str) -> datetime:
+    try:
+        parsed = value if isinstance(value, datetime) else datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except (AttributeError, TypeError, ValueError) as exc:
+        raise ContextUnavailable(f"{label}必须为含时区的 ISO 时间。") from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        raise ContextUnavailable(f"{label}缺少时区。")
+    return parsed
+
+
+def _number(value: Any, label: str, minimum: float, maximum: float) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ContextUnavailable(f"{label}缺失或不是数值，不能按 0 处理。")
+    result = float(value)
+    if not math.isfinite(result) or not minimum <= result <= maximum:
+        raise ContextUnavailable(f"{label}超出有效范围。")
+    return result
+
+
+def _check_future_target(target: date, now: datetime) -> None:
+    ahead = (target - now.astimezone(KL).date()).days
+    if not 1 <= ahead <= MAX_FORECAST_DAYS_AHEAD:
+        raise ContextUnavailable("实时天气仅支持吉隆坡明天至未来 15 天；历史实况不能冒充事前预报。")
+
+
+def _weather_url(target: date) -> str:
+    params = {
+        "latitude": LATITUDE,
+        "longitude": LONGITUDE,
+        "daily": "temperature_2m_mean,precipitation_sum",
+        "timezone": TIMEZONE,
+        "start_date": target.isoformat(),
+        "end_date": target.isoformat(),
+        "temperature_unit": "celsius",
+        "precipitation_unit": "mm",
+    }
+    return WEATHER_ENDPOINT + "?" + urllib.parse.urlencode(params)
+
+
+def _parse_open_meteo(payload: dict, target: date, fetched_at: datetime, source: str) -> dict:
+    """Match the requested local day, units and location before accepting a row."""
+    if not isinstance(payload, dict) or payload.get("error"):
+        raise ContextUnavailable("天气服务返回错误，暂无可用天气预报。")
+    if payload.get("timezone") != TIMEZONE or payload.get("utc_offset_seconds") != 28800:
+        raise ContextUnavailable("天气服务的日期时区不是吉隆坡 UTC+8。")
+    actual_lat = _number(payload.get("latitude"), "天气纬度", -90, 90)
+    actual_lon = _number(payload.get("longitude"), "天气经度", -180, 180)
+    # The forecast grid cell need not equal the requested coordinate exactly.
+    if abs(actual_lat - LATITUDE) > .5 or abs(actual_lon - LONGITUDE) > .5:
+        raise ContextUnavailable("天气服务返回的地点不在吉隆坡附近。")
+    daily, units = payload.get("daily"), payload.get("daily_units")
+    if not isinstance(daily, dict) or not isinstance(units, dict):
+        raise ContextUnavailable("天气服务缺少逐日数据或单位。")
+    if units.get("temperature_2m_mean") != "°C" or units.get("precipitation_sum") != "mm":
+        raise ContextUnavailable("天气单位不符，需摄氏度和毫米。")
+    days, temperatures, rain = (daily.get("time"), daily.get("temperature_2m_mean"), daily.get("precipitation_sum"))
+    if not all(isinstance(part, list) for part in (days, temperatures, rain)):
+        raise ContextUnavailable("天气服务缺少日期、日均温或日降水量。")
+    if len(days) != len(temperatures) or len(days) != len(rain):
+        raise ContextUnavailable("天气服务的日期与数值数量不一致。")
+    target_text = target.isoformat()
+    if days.count(target_text) != 1:
+        raise ContextUnavailable("天气服务未返回目标日期，不能沿用其他日期的天气。")
+    index = days.index(target_text)
+    result = {
+        "date": target_text,
+        "temperature_c": _number(temperatures[index], "日均温", -90, 65),
+        "precipitation_mm": _number(rain[index], "日降水量", 0, 3000),
+        "temperature_unit": "°C",
+        "precipitation_unit": "mm",
+        "data_kind": "live_forecast",
+        "weather_kind": "live_forecast",
+        "source": source,
+        "provider": "Open-Meteo",
+        "documentation": WEATHER_DOCUMENTATION,
+        "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
+        "fetched_at": fetched_at.isoformat(),
+        "known_at": fetched_at.isoformat(),
+        "location": LOCATION,
+        "timezone": TIMEZONE,
+        "utc_offset_seconds": 28800,
+        "latitude": LATITUDE,
+        "longitude": LONGITUDE,
+        "forecast_grid_latitude": actual_lat,
+        "forecast_grid_longitude": actual_lon,
+        "status": "available",
+        "max_age_hours": MAX_WEATHER_AGE_HOURS,
+        "note": "当前取得的未来预报；不是历史天气或真实门店销量。",
+    }
+    return validate_weather_snapshot(result, target, now=fetched_at)
+
+
+def validate_weather_snapshot(weather: dict, target_date: str | date,
+                              now: str | datetime | None = None,
+                              max_age_hours: float = MAX_WEATHER_AGE_HOURS) -> dict:
+    """Return a checked copy of a *live* forecast; stale/missing data raises.
+
+    Freshness is time since retrieval, not a claimed upstream model issue time.
+    This is deliberately unsuitable for reconstructing historical backtests.
+    """
+    target = _day(target_date)
+    instant = _instant(now or _utc_now(), "当前时间")
+    _check_future_target(target, instant)
+    if not isinstance(weather, dict) or weather.get("date") != target.isoformat():
+        raise ContextUnavailable("天气快照的日期与本次补货目标不一致。")
+    if weather.get("data_kind") != "live_forecast" or weather.get("weather_kind") != "live_forecast":
+        raise ContextUnavailable("此输入不是实时未来预报；模拟天气必须单独标注。")
+    if weather.get("location") != LOCATION or weather.get("timezone") != TIMEZONE:
+        raise ContextUnavailable("天气快照的门店地点或时区不符。")
+    if weather.get("utc_offset_seconds") != 28800:
+        raise ContextUnavailable("天气快照必须使用吉隆坡 UTC+8 日界线。")
+    if weather.get("temperature_unit") != "°C" or weather.get("precipitation_unit") != "mm":
+        raise ContextUnavailable("天气快照缺少摄氏度或毫米单位。")
+    fetched = _instant(weather.get("fetched_at"), "天气获取时间")
+    known = _instant(weather.get("known_at"), "天气可知时间")
+    if known != fetched:
+        raise ContextUnavailable("实时快照的可知时间必须等于本次获取时间，不能回填成历史预报。")
+    if fetched > instant:
+        raise ContextUnavailable("天气获取时间晚于当前预测时间。")
+    if not isinstance(max_age_hours, (int, float)) or isinstance(max_age_hours, bool) or not 0 < max_age_hours <= 24:
+        raise ContextUnavailable("天气有效期必须在 0 至 24 小时内。")
+    if instant - fetched > timedelta(hours=max_age_hours):
+        raise ContextUnavailable("天气快照已过期，请手动刷新；过期数据不会当作当前预报使用。")
+    _check_future_target(target, fetched)
+    source = weather.get("source")
+    parsed_source = urllib.parse.urlsplit(source) if isinstance(source, str) else None
+    if (not parsed_source or parsed_source.scheme != "https" or parsed_source.netloc != "api.open-meteo.com"
+            or parsed_source.path != "/v1/forecast" or weather.get("provider") != "Open-Meteo"):
+        raise ContextUnavailable("天气快照没有固定的 Open-Meteo 预报来源。")
+    if source != _weather_url(target):
+        raise ContextUnavailable("天气快照的来源查询与吉隆坡目标日期不一致。")
+    result = dict(weather)
+    result["temperature_c"] = _number(weather.get("temperature_c"), "日均温", -90, 65)
+    result["precipitation_mm"] = _number(weather.get("precipitation_mm"), "日降水量", 0, 3000)
+    result["status"] = "available"
+    result["age_hours"] = round((instant - fetched).total_seconds() / 3600, 3)
+    return result
+
+
+def fetch_weather(target_date: str | date, output_path: str | Path | None = None) -> dict:
+    """Explicitly fetch KL forecast from one fixed public HTTPS endpoint.
+
+    No API key, arbitrary URL, observed-weather endpoint or automatic fallback is
+    supported. An optional output is replaced only after the entire response has
+    passed validation. Failed refreshes preserve the prior file for inspection.
+    """
+    target = _day(target_date)
+    _check_future_target(target, _utc_now())
+    url = _weather_url(target)
+    request = urllib.request.Request(url, headers={"User-Agent": "CafeReplenishmentDemo/3.2", "Accept": "application/json"})
+    try:
+        with urllib.request.urlopen(request, timeout=15) as response:
+            if response.getcode() != 200:
+                raise ContextUnavailable("天气服务暂不可用，请稍后手动重试或选择有明确标识的模拟情景。")
+            raw = response.read(1_000_001)
+            if len(raw) > 1_000_000:
+                raise ContextUnavailable("天气服务响应过大。")
+            payload = json.loads(raw.decode("utf-8"))
+    except (urllib.error.URLError, TimeoutError, socket.timeout, OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ContextUnavailable("无法取得吉隆坡天气预报；缺失天气不会按晴天或 0 降雨处理。") from exc
+    result = _parse_open_meteo(payload, target, _utc_now(), url)
+    if output_path is not None:
+        path = Path(output_path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = path.with_suffix(path.suffix + ".tmp")
+        temporary.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+        temporary.replace(path)
+    return result
+
+
+def holiday_for_day(target_date: str | date) -> dict:
+    """2026 KL calendar only: a weekend is not itself a named public holiday.
+
+    ``verified`` means checked against the linked official publication. It does
+    not promise that future, changeable dates can never be amended. Conditional
+    private-employer leave and years outside this finite calendar stay unknown.
+    Malaysia has no Chinese-style make-up workday in this verified calendar.
+    """
+    target = _day(target_date)
+    try:
+        calendar = json.loads(CALENDAR_PATH.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ContextUnavailable("吉隆坡节假日日历文件不可用，请人工核对。") from exc
+    base = {
+        "date": target.isoformat(), "location": LOCATION, "region": "MY-14",
+        "timezone": TIMEZONE, "is_holiday": None, "holiday_name": "",
+        "is_workday_override": False, "source": calendar["sources"]["annual"]["url"],
+        "verified": False, "verified_as_of": calendar["verified_as_of"],
+        "coverage_start": calendar["coverage_start"], "coverage_end": calendar["coverage_end"],
+        "status": "unknown", "notes": "仅收录 2026 年吉隆坡适用公共假日；未覆盖日期不能视作普通营业日。",
+        "data_kind": "official_calendar",
+    }
+    if not calendar["coverage_start"] <= target.isoformat() <= calendar["coverage_end"]:
+        return base
+    entry = next((row for row in calendar["holidays"] if row["date"] == target.isoformat()), None)
+    if entry is not None:
+        base.update({key: value for key, value in entry.items() if key != "source_ids"})
+        evidence = [calendar["sources"][key] for key in entry["source_ids"]]
+        base["source"] = evidence[0]["url"]
+        base["sources"] = evidence
+        return base
+    base.update({"is_holiday": False, "verified": True, "status": "not_listed_as_public_holiday",
+                 "notes": "2026 吉隆坡已核对年历未列为公共假日；周末由星期特征处理，门店及供应商休息日需另设。",
+                 "sources": [calendar["sources"]["annual"]]})
+    return base
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="吉隆坡天气与 2026 节假日查询")
+    parser.add_argument("kind", choices=("weather", "holiday"))
+    parser.add_argument("--date", required=True)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    try:
+        result = fetch_weather(args.date, args.output) if args.kind == "weather" else holiday_for_day(args.date)
+    except ContextUnavailable as exc:
+        parser.exit(2, f"{exc}\n")
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/local_app/cafe_context_workflow.py b/local_app/cafe_context_workflow.py
