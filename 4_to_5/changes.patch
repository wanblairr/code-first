+// Test-only simulation of an en-CA -> en-US locale fallback.
+const NativeDateTimeFormat=Intl.DateTimeFormat;
+function FallbackDateTimeFormat(locales,options){
+  return new NativeDateTimeFormat(locales==='en-CA'?'en-US':locales,options);
+}
+Object.setPrototypeOf(FallbackDateTimeFormat,NativeDateTimeFormat);
+FallbackDateTimeFormat.prototype=NativeDateTimeFormat.prototype;
+Intl.DateTimeFormat=FallbackDateTimeFormat;
