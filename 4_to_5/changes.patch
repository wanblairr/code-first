+++ b/public_website/README_v3_7.md
@@ -0,0 +1,53 @@
+# Cafe Replenishment v3.7 · Google 账户与自家门店
+
+公开工作台：https://www.cafe-replenishment-demo.com/demo/
+登录/注册：https://www.cafe-replenishment-demo.com/demo/?account=login
+
+这份包是已上线公开网站的源码，包含 dist、Netlify 四个函数、账户库、测试与部署配置。它不包含本机私人密钥、OAuth 令牌、任何用户门店数据库，或本机 QA 登录 fixture。原 Python 本机工作台沿用原安装目录。
+
+## 新增功能
+
+- 网站首页与工作台都有登录、注册入口。通过 Google 验证身份，第一次登录自动注册，后续登录恢复自家数据；Gmail 草稿权限另行授权。
+- WhatsApp 登录按当前方案显示“待开通”。此前的 WhatsApp 采购/本人沙盒接口仍保留，它们不作为网站身份验证。
+- 录入昨天或更早的完整日销量，按 CSV 产品与规格保存。同日期再次提交是替换，遗漏产品视当天 0；记录历史不会再次扣当前库存。
+- 权重每 7 天减半，饮品与烘焙分别比较；明日需求=该产品规格的加权日均销量×已有天气/假日系数。少于 7 天会提示样本不足；没有历史时保留标明来源的模拟菜单。属于可解释加权估计，不声称已经完成机器学习训练。
+- 自定义采购项填名称、整数数量、单位、MYR 单价。计价使用整数分；与 BOM 原料一同进入审批、TXT/EML、Gmail/WhatsApp 预览和总额。未确认的 BOM 价格继续显示待确认，不能把未知金额当作 0。
+- 登录后的销量、库存、包装报价、加购与批准草稿按账号保存到 Netlify Blobs。访客缓存不会自动导入新账号；退出清当前会话，页面重新加载以清除本标签页接口凭据。
+- 版本校验防多设备互相覆盖，冲突时保留本标签页修改供下载；网络错误不显示保存成功。账户界面支持中文、English、Bahasa Melayu、Español。
+
+## 本地开发
+
+需要 Node.js 22.12+：
+
+    npm ci
+    npm run test:backend
+    npm run check:backend
+
+可用普通静态服务器预览 dist。账号函数默认只接受正式 https://www.cafe-replenishment-demo.com 来源；静态预览不等于真实 Google 登录或云存储。单元测试通过显式注入的本机环境和临时 RSA 密钥验证登录流程，不包含生产绕过。
+
+## 部署
+
+保持现有 Netlify Free 方案，publish=dist，functions=netlify/functions，Node 22。
+四个函数为 account、runpod、whatsapp、whatsapp-sandbox；只传 dist 的静态 ZIP 不会部署函数。
+account 使用已公开的 Google Web Client ID（dist/demo/public-config.js），Google Cloud 中须为所部署域名配置正确的 JavaScript Origin。若部署到新域名，需要你自己的 Google Web Client 和对应 CSP/来源白名单；不要把 Client Secret 放到浏览器。
+account 使用 Netlify 站点级 Blobs 的强一致读与条件写入，保存身份/会话与门店记录。无须把老板 Runpod 或 WhatsApp Key 放到服务器供全站共用；访客仍填写自己的接口凭据。
+
+Google 登录只验证身份，不申请 Gmail 草稿权限。Gmail 使用原独立可选授权。账户未登录读取店铺返回 401；修改需同源请求、HttpOnly 会话和 CSRF；Google ID token 在服务端验证签名、发行者、audience、有效期、verified email 和一次性 nonce。
+
+## 验证
+
+此次源码测试 331 项全部通过；线上静态文件和函数边界 48 项检查通过。实际 Google 登录和账号数据流程的最终状态见 verification/result.json；本机 QA 使用独立测试账户，不冒充真实 Google 授权。没有在此次功能验收中运行付费推理或发送 WhatsApp 采购消息。
+
+## License
+
+Original project source code and documentation are licensed under the
+[Apache License 2.0](LICENSE) (SPDX: `Apache-2.0`). See [NOTICE](NOTICE) for
+attribution and the scope of this declaration. Third-party dependencies,
+externally supplied datasets, model weights and adapters retain their own
+applicable licenses and notices.
+
+## 2026-10-24 published acceptance
+
+This source matches accepted production deployment `6adbafacd0d9a261aa1b1f98`, including the ICU-safe date fix and the public non-hosted Llama reference notice. See [startup](../START_GUIDE.md), [demo steps](../DEMO_STEPS.md), and [acceptance](../verification/public_acceptance_20261024/ACCEPTANCE_REPORT.txt). The Llama weights are not included.
+
+Deploy all four Functions from this project root after dependency installation, including the dynamic `@netlify/blobs` package. A static-only upload does not deploy account/cloud storage or the API handlers. No private API credentials or account exports are included.
diff --git a/public_website/build_bom_data.py b/public_website/build_bom_data.py
new file mode 100644
index 0000000000000000000000000000000000000000..27891bd2e08ba20c4b750b023938fd33df8b229b
--- /dev/null
+++ b/public_website/build_bom_data.py
@@ -0,0 +1,132 @@
+"""Build the public demo's immutable BOM from the two original CSV files.
+
+Quantities remain in CSV base units (g/ml/individual item). Initial stocks are
+explicit demonstration assumptions; safety thresholds are never inferred.
+"""
+import csv
+import hashlib
+import json
+from decimal import Decimal, InvalidOperation
+from pathlib import Path
+
+MAX_SAFE = 2**53 - 1
+BASE = {
+    "拼配豆": "INV-001", "全脂奶": "INV-003", "脱脂奶": "INV-004",
+    "燕麦奶": "INV-005", "巧克力酱": "INV-010", "茶": "INV-012",
+}
+# The generic syrup/puree/liquid CSV columns require this explicit product join.
+SPECIAL = {
+    ("BV-006", "糖浆"): "INV-007", ("BV-010", "糖浆"): "INV-008",
+    ("BV-020", "糖浆"): "INV-009", ("BV-016", "果泥/酱"): "INV-018",
+    ("BV-022", "果泥/酱"): "INV-015", ("BV-023", "果泥/酱"): "INV-016",
+    ("BV-015", "其他液体"): "INV-021", ("BV-020", "其他液体"): "INV-019",
+    ("BV-023", "其他液体"): "INV-021",
+}
+# Water/ice units and stock are supplementary demo assumptions. The supplied
+# safety CSV contains no thresholds for these, so safety stays explicitly null.
+AUX = {
+    "冰水": ("AUX-COLD", "ml", 20000), "热水": ("AUX-HOT", "ml", 20000),
+    "冰块": ("AUX-ICE", "g", 10000),
+}
+FIELDS = [
+    "拼配豆", "SOE豆", "全脂奶", "脱脂奶", "燕麦奶", "糖浆", "巧克力酱",
+    "抹茶粉", "茶", "果泥/酱", "其他液体", "热水", "冰水", "冰块", "温度供应",
+]
+BOM_HEADERS = ["饮品ID", "饮品名称"] + [
+    size + "·" + field for field in FIELDS for size in ("中杯", "大杯")
+] + ["成品(个)"]
+SAFETY_HEADERS = ["原料ID", "原料名称", "单位", "安全线"]
+
+
+def rows(path, expected_headers):
+    with Path(path).open(encoding="utf-8-sig", newline="") as source:
+        reader = csv.DictReader(source)
+        headers = reader.fieldnames or []
+        if len(headers) != len(set(headers)) or set(headers) != set(expected_headers):
+            raise ValueError(f"{Path(path).name}字段与原始CSV结构不一致")
+        result = list(reader)
+    if not result:
+        raise ValueError(f"{Path(path).name}没有数据")
+    for row in result:
+        if None in row or any(value is None or not value.strip() for value in row.values()):
+            raise ValueError(f"{Path(path).name}存在空值或列数不一致")
+    return result
+
+
+def amount(value):
+    try:
+        number = Decimal(value)
+    except (InvalidOperation, TypeError, ValueError) as exc:
+        raise ValueError(f"无效数量：{value}") from exc
+    if (
+        not number.is_finite() or number < 0
+        or number != number.to_integral_value() or number > MAX_SAFE
+    ):
+        raise ValueError(f"本表使用非负整数基础单位，发现无效数量：{value}")
+    return int(number)
+
+
+def build(bom_path, safety_path):
+    materials, products = {}, {}
+    for row in rows(safety_path, SAFETY_HEADERS):
+        key, safety = row["原料ID"], amount(row["安全线"])
+        if key in materials:
+            raise ValueError(f"重复原料ID：{key}")
+        if row["单位"] not in {"g", "ml", "个"}:
+            raise ValueError(f"不支持的基础单位：{row['单位']}")
+        # CSV milk safety = 51200 ml; oat safety = 2800 ml.
+        initial = {"INV-003": 60000, "INV-005": 8000}.get(key, safety * 2)
+        if initial > MAX_SAFE:
+            raise ValueError(f"演示库存超出安全整数范围：{key}")
+        materials[key] = dict(
+            name=row["原料名称"], unit=row["单位"], safety=safety, initial=initial,
+        )
+
+    for row in rows(bom_path, BOM_HEADERS):
+        key, recipes = row["饮品ID"], {}
+        if key in products:
+            raise ValueError(f"重复产品ID：{key}")
+        finished = amount(row["成品(个)"])
+        for size in ("中杯", "大杯"):
+            recipe = {}
+            for field in FIELDS:
+                if field == "温度供应":
+                    continue
+                quantity = amount(row[size + "·" + field])
+                if quantity == 0:
+                    continue
+                material = SPECIAL.get((key, field), BASE.get(field))
+                if field in AUX:
+                    material, unit, initial = AUX[field]
+                    materials.setdefault(
+                        material,
+                        dict(name=field, unit=unit, safety=None, initial=initial),
+                    )
+                if material not in materials:
+                    raise ValueError(f"非零配料缺少原料映射或安全线配置：{key}/{size}·{field}")
+                recipe[material] = recipe.get(material, 0) + quantity
+                if recipe[material] > MAX_SAFE:
+                    raise ValueError(f"配方数量超出范围：{key}/{material}")
+            recipes[size] = recipe
+
+        if finished:
+            if key not in materials or materials[key]["unit"] != "个" or any(recipes.values()):
+                raise ValueError(f"成品配置冲突：{key}")
+            recipes = {"份": {key: finished}}
+        elif not all(recipes.values()):
+            raise ValueError(f"饮品配方为空：{key}")
+        products[key] = dict(name=row["饮品名称"], recipes=recipes)
+
+    data = dict(materials=materials, products=products)
+    raw = json.dumps(data, ensure_ascii=False, sort_keys=True)
+    data["version"] = hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]
+    return data
+
+
+if __name__ == "__main__":
+    root = Path(__file__).resolve().parent
+    data = build(root / "data/配料表.csv", root / "data/安全线.csv")
+    target = root / "dist/demo/bom-data.json"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(f"BOM: {len(data['products'])} products, {len(data['materials'])} materials -> {target}")
