+/* The assistant replaces only the old inventory/purchase form section. */
+.bom-assistant-mode .shopping-panel,.bom-assistant-mode .drafts-panel,
+.bom-assistant-mode .audit-panel,.bom-assistant-mode #review-dialog{display:none!important}
+#bom-root{scroll-margin-top:24px}
+#bom-root .section-top{align-items:center}
+#bom-root .section-description{max-width:650px}
+#bom-root .bom-sale-card{padding:22px;background:#f0f4eb;border:1px solid #dce6d2;border-radius:12px;margin-bottom:14px}
+#bom-root .bom-controls{display:grid;grid-template-columns:2fr 1fr 1fr auto;align-items:end;gap:14px}
+#bom-root label,#bom-root input,#bom-root select,#bom-root button,#bom-root pre{font-family:inherit;font-size:14px;line-height:1.65}
+#bom-root label{color:var(--ink)}
