+// Local, read-only Llama reference. This module never writes procurement state.
+export const SUPPORTED_SKUS = Object.freeze(['espresso','latte','oat_latte']);
+export const MODEL_ID = 'meta-llama/Llama-3.2-1B-Instruct';
+export const REVISION = '9213176726f574b556790deb65791e0c5aa438b6';
+export const ADAPTER_FILE_SHA256 = '652d02cd62dfbe8dbcef71504b1d4b12118530519e9c61c297ce3b53721b8315';
+export const ADAPTER_TENSOR_SHA256 = '6e3d8dd4470605808f9119a2c9c3f09a3bd581cded99468f199e0c80abaf727d';
+export const NOT_HOSTED_MESSAGE = '模型已本地训练及验证，公网未托管。此页面不请求 Llama 服务；现有账号、BOM 和采购流程照常使用。 Model trained and verified locally; not hosted online.';
+export function isLocalAdvisoryContext(location=globalThis.location){
+  try{
+    const origin=new URL(location?.href||location?.origin||'');
+    return origin.protocol==='http:'&&['127.0.0.1','localhost','[::1]'].includes(origin.hostname)&&!origin.username&&!origin.password;
+  }catch{return false;}
+}
+const finite = (v,min=0,max=600) => typeof v==='number'&&Number.isFinite(v)&&v>=min&&v<=max;
+const record = v => v!==null&&typeof v==='object'&&!Array.isArray(v);
+const require = (condition,message='本地建议数据无效。') => {if(!condition)throw new Error(message);};
+const exact = (v,keys) => record(v)&&Object.keys(v).sort().join('|')===[...keys].sort().join('|');
+const clean = (v,max=600) => {require(typeof v==='string'&&v.length<=max&&!/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/.test(v));return v.trim();};
+const copy = v => JSON.parse(JSON.stringify(v));
+function day(value){require(typeof value==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(value));const d=new Date(value+'T00:00:00Z');require(Number.isFinite(d.getTime())&&d.toISOString().slice(0,10)===value);return d;}
+const shift = (value,days) => {const d=day(value);d.setUTCDate(d.getUTCDate()+days);return d.toISOString().slice(0,10);};
+function snapshotValue(snapshot){
+  require(exact(snapshot,['target_date','data_source','predictions','context'])&&snapshot.data_source==='synthetic');day(snapshot.target_date);
+  require(Array.isArray(snapshot.predictions)&&snapshot.predictions.length===3,'模型仅支持 espresso、latte、oat_latte；其他新增商品需店主手填数量。');
+  const items=snapshot.predictions.map(row=>{require(exact(row,['sku','local_forecast_units'])&&SUPPORTED_SKUS.includes(row.sku)&&finite(row.local_forecast_units,0,100000));return {...row};}).sort((a,b)=>a.sku.localeCompare(b.sku));
+  require(items.map(r=>r.sku).join('|')===SUPPORTED_SKUS.join('|'),'模型不支持当前SKU。');
+  const c=snapshot.context;require(exact(c,['temperature_c','precipitation_mm','is_holiday'])&&finite(c.temperature_c,-20,55)&&finite(c.precipitation_mm,0,500)&&typeof c.is_holiday==='boolean');
+  return {...snapshot,predictions:items,context:{...c}};
+}
+
+export function buildDemandPrompt(snapshot,history,{weather,ownerInput='',nearbyEvent='未知',now=Date.now()}={}){
+  const current=snapshotValue(snapshot),target=current.target_date,asOf=shift(target,-1),reference=shift(target,-2);
+  require(Array.isArray(history)&&history.length>=84&&history.length<=5000,'缺少完整的模拟历史。');
+  const rows=history.map(row=>{require(record(row)&&SUPPORTED_SKUS.includes(row.sku)&&finite(row.units,0,10000)&&typeof row.stockout==='boolean'&&typeof row.closed==='boolean');day(row.date);return {date:row.date,sku:row.sku,units:row.units,stockout:row.stockout,closed:row.closed,data_source:'synthetic'};}).filter(row=>row.date<=reference);
+  const seen=new Set();for(const row of rows){const key=row.sku+':'+row.date;require(!seen.has(key),'历史日期重复。');seen.add(key);}
+  const histories=SUPPORTED_SKUS.map(sku=>{
+    const series=rows.filter(r=>r.sku===sku).sort((a,b)=>a.date.localeCompare(b.date));
+    require(series.filter(r=>!r.stockout&&!r.closed).length>=28,'每个SKU至少需要28条有效模拟观测。');
+    const recent=series.slice(-7),older=series.slice(0,-7).filter(r=>day(r.date).getUTCDay()===day(target).getUTCDay()).slice(-4);
+    return {id:'history:'+sku,sku,records:[...recent,...older]};
