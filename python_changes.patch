+++ b/local_app/cafe_whatsapp.py
@@ -0,0 +1,285 @@
+"""Explicit, template-only WhatsApp Cloud API transport.
+
+The caller owns approval, recipient confirmation and durable deduplication.
+This adapter never retries a POST, follows redirects, sends on a read, or claims
+that an accepted message has been delivered. No free-form send API is exposed.
+"""
+from __future__ import annotations
+
+import http.client
+import json
+import math
+import re
+from urllib import error, parse, request
+
+from cafe_core import CafeError
+
+
+_VERSION = re.compile(r"v[1-9][0-9]{0,2}\.0\Z")
+_OBJECT_ID = re.compile(r"[1-9][0-9]{0,31}\Z")
+_PHONE = re.compile(r"[1-9][0-9]{6,14}\Z")
+_NAME = re.compile(r"[a-z0-9_]{1,512}\Z")
+_LANGUAGE = re.compile(r"[a-z]{2,3}(?:_[A-Z]{2})?\Z")
+_MESSAGE_ID = re.compile(r"wamid\.[A-Za-z0-9_+/=.-]{1,500}\Z")
+_MAX_RESPONSE_BYTES = 131072
+
+
+class WhatsAppAPIError(CafeError):
+    def __init__(self, message, *, outcome_unknown=False, status_code=None):
+        super().__init__(message)
+        self.outcome_unknown = bool(outcome_unknown)
+        self.status_code = status_code
+
+
+class _NoRedirect(request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _text(value, maximum, *, multiline=False):
+    if not isinstance(value, str) or not value.strip() or len(value) > maximum:
+        raise CafeError("WhatsApp 模板内容为空或超过允许长度。")
+    if any(ord(c) < 32 and not (multiline and c in "\r\n") or ord(c) == 127 for c in value):
+        raise CafeError("WhatsApp 模板内容包含不允许的控制字符。")
+    try:
+        value.encode("utf-8")
+    except UnicodeError:
+        raise CafeError("WhatsApp 模板内容包含无效字符。") from None
+    return value
+
+
+def _phone(value):
+    if not isinstance(value, str):
+        raise CafeError("WhatsApp 收件号码须包含国际区号及 7 至 15 位数字。")
+    value = value[1:] if value.startswith("+") else value
+    if not _PHONE.fullmatch(value):
+        raise CafeError("WhatsApp 收件号码须包含国际区号及 7 至 15 位数字。")
+    return value
+
+
+def _template_identity(name, language):
+    if not isinstance(name, str) or not _NAME.fullmatch(name):
+        raise CafeError("WhatsApp 模板名称只能包含小写字母、数字和下划线。")
+    if not isinstance(language, str) or not _LANGUAGE.fullmatch(language):
+        raise CafeError("WhatsApp 模板语言代码无效，请按 Meta 控制台填写。")
+    return name, language
+
+
+def _parameters(values):
+    if not isinstance(values, (list, tuple)) or len(values) != 3:
+        raise CafeError("采购模板必须提供到货日期、订单编号和采购摘要三个参数。")
+    return [_text(value, 1024) for value in values]
+
+
+def _failure(status, sending):
+    unknown = sending and (status in (408, 409) or status >= 500 or 300 <= status < 400)
+    if status == 401:
+        message = "WhatsApp 访问令牌无效或已过期，请在本机更新授权。"
+    elif status == 403:
+        message = "WhatsApp 拒绝访问，请核对应用权限和 WhatsApp Business 资产归属。"
+    elif status == 429:
+        message = "WhatsApp 请求过于频繁；系统不会自动重试发送。"
+    elif 300 <= status < 400:
+        message = "WhatsApp 返回重定向，已停止请求以保护授权信息。"
+    elif status >= 500 or status in (408, 409):
+        message = "WhatsApp 响应异常；请先核对 Meta 消息记录，避免重复发送。"
+    else:
+        message = "WhatsApp 未接受请求，请核对号码、模板审批、语言和参数。"
+    return WhatsAppAPIError(message, outcome_unknown=unknown, status_code=status)
+
+
+def _decode(raw, token, sending):
+    def invalid():
+        return WhatsAppAPIError("WhatsApp 返回数据无法安全识别，请核对 Meta 消息记录。",
+                                outcome_unknown=sending)
+
+    if token.encode("utf-8") in raw:
+        raise invalid()
+
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ValueError("duplicate key")
+            result[key] = value
+        return result
+
+    def nonfinite(unused):
+        raise ValueError("nonfinite")
+
+    try:
+        result = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs, parse_constant=nonfinite)
+    except (ValueError, UnicodeError, RecursionError):
+        raise invalid() from None
+    if not isinstance(result, dict):
+        raise invalid()
+    stack = [(result, 0)]
+    while stack:
+        item, depth = stack.pop()
+        if depth > 25 or isinstance(item, str) and token in item:
+            raise invalid()
+        if isinstance(item, dict):
+            stack.extend((part, depth + 1) for pair in item.items() for part in pair)
+        elif isinstance(item, list):
+            stack.extend((part, depth + 1) for part in item)
+    if "error" in result:
+        raise WhatsAppAPIError("WhatsApp 未接受请求，请核对授权及模板配置。", outcome_unknown=sending)
+    return result
+
+
+class WhatsAppCloudClient:
+    def __init__(self, api_version, phone_number_id, access_token, business_account_id="", opener=None, timeout=10):
+        if not isinstance(api_version, str) or not _VERSION.fullmatch(api_version):
+            raise CafeError("请按 Meta 控制台填写 Graph API 版本，例如 v23.0；程序不自动选择最新版本。")
+        for identifier, optional in ((phone_number_id, False), (business_account_id, True)):
+            if not isinstance(identifier, str) or not (optional and identifier == "" or _OBJECT_ID.fullmatch(identifier)):
+                raise CafeError("WhatsApp Phone Number ID 或 Business Account ID 无效，请勿填写网址。")
+        if (not isinstance(access_token, str) or not 8 <= len(access_token) <= 8192
+                or not access_token.isascii() or access_token.lower().startswith("bearer")
+                or any(ord(c) < 33 or ord(c) == 127 for c in access_token)):
+            raise CafeError("请填写原始 WhatsApp 访问令牌，不含 Bearer 前缀或空白。")
+        if (isinstance(timeout, bool) or not isinstance(timeout, (int, float))
+                or not math.isfinite(timeout) or not 1 <= timeout <= 60):
+            raise CafeError("WhatsApp 超时设置须为 1 至 60 秒。")
+        self.api_version = api_version
+        self.phone_number_id = phone_number_id
+        self.business_account_id = business_account_id
+        self._token = access_token
+        self._opener = opener if opener is not None else request.build_opener(_NoRedirect())
+        self.timeout = timeout
+
+    def __repr__(self):
+        return "WhatsAppCloudClient(access_token=<redacted>)"
+
+    def _request(self, resource, *, query=None, payload=None):
+        sending = payload is not None
+        url = f"https://graph.facebook.com/{self.api_version}/{resource}"
+        if query:
+            url += "?" + parse.urlencode(query)
+        encoded = json.dumps(payload, ensure_ascii=True, separators=(",", ":")).encode("utf-8") if sending else None
+        req = request.Request(url, data=encoded, method="POST" if sending else "GET", headers={
+            "Authorization": "Bearer " + self._token,
+            "Accept": "application/json", "Content-Type": "application/json",
+        })
+        response = None
+        try:
+            opener = getattr(self._opener, "open", self._opener)
+            response = opener(req, timeout=self.timeout)
+            status = response.getcode()
+            if type(status) is not int or not 200 <= status < 300:
+                raise _failure(status if type(status) is int else 502, sending)
+            geturl = getattr(response, "geturl", None)
+            if geturl and geturl() != url:
+                raise _failure(302, sending)
+            raw = response.read(_MAX_RESPONSE_BYTES + 1)
+            if not isinstance(raw, bytes) or len(raw) > _MAX_RESPONSE_BYTES:
+                raise WhatsAppAPIError("WhatsApp 返回数据过大，已停止处理。", outcome_unknown=sending)
+            return _decode(raw, self._token, sending)
+        except error.HTTPError as exc:
+            code = exc.code
+            exc.close()
+            raise _failure(code, sending) from None
+        except WhatsAppAPIError:
+            raise
+        except (error.URLError, OSError, ValueError, http.client.HTTPException):
+            raise WhatsAppAPIError("WhatsApp 网络请求未完成；发送结果不确定时请先核对 Meta 消息记录。",
+                                    outcome_unknown=sending) from None
+        finally:
+            if response is not None:
+                try:
+                    response.close()
+                except (OSError, http.client.HTTPException):
+                    pass
+
+    def check_connection(self):
+        result = self._request(self.phone_number_id, query={"fields": "id,display_phone_number,verified_name"})
+        if result.get("id") != self.phone_number_id:
+            raise WhatsAppAPIError("WhatsApp 返回的发送号码 ID 与配置不一致。")
+        public = {"connected": True, "phone_number_id": self.phone_number_id}
+        for field in ("display_phone_number", "verified_name"):
+            if field in result:
+                public[field] = _text(result[field], 256)
+        return public
+
+    def get_template(self, name, language):
+        name, language = _template_identity(name, language)
+        if not self.business_account_id:
+            raise CafeError("核对采购模板前，请填写 WhatsApp Business Account ID。")
+        result = self._request(self.business_account_id + "/message_templates", query={
+            "name": name, "fields": "id,name,status,language,components,parameter_format", "limit": 100,
+        })
+        rows = result.get("data")
+        if not isinstance(rows, list) or len(rows) > 100:
+            raise WhatsAppAPIError("WhatsApp 模板列表无效。")
+        matches = [row for row in rows if isinstance(row, dict) and row.get("name") == name and row.get("language") == language]
+        if len(matches) != 1:
+            raise CafeError("没有找到唯一匹配名称和语言的 WhatsApp 模板，请核对 Meta 控制台。")
+        row = matches[0]
+        if row.get("status") != "APPROVED":
+            raise CafeError("此 WhatsApp 模板尚未获 Meta 批准，不能发送采购消息。")
+        if row.get("parameter_format", "POSITIONAL") != "POSITIONAL":
+            raise CafeError("采购模板只支持按位置编号的三个 BODY 参数。")
+        components = row.get("components")
+        if not isinstance(components, list) or not 1 <= len(components) <= 2:
+            raise CafeError("采购模板只支持 BODY 和可选的静态 FOOTER。")
+        body = footer = None
+        for component in components:
+            if not isinstance(component, dict):
+                raise CafeError("WhatsApp 模板组件格式无效。")
+            if component.get("type") == "BODY" and body is None:
+                body = _text(component.get("text"), 4096, multiline=True)
+            elif component.get("type") == "FOOTER" and footer is None:
+                footer = _text(component.get("text"), 1024, multiline=True)
+                if "{{" in footer or "}}" in footer:
+                    raise CafeError("采购模板的 FOOTER 必须为静态文本。")
+            else:
+                raise CafeError("采购模板不支持 HEADER、BUTTONS 或重复组件。")
+        if body is None or re.findall(r"\{\{([0-9]+)\}\}", body) != ["1", "2", "3"]:
+            raise CafeError("采购模板 BODY 必须按顺序各包含一次 {{1}}、{{2}}、{{3}}。")
+        remainder = re.sub(r"\{\{[123]\}\}", "", body)
+        if "{{" in remainder or "}}" in remainder:
+            raise CafeError("采购模板 BODY 包含不支持的参数标记。")
+        identifier = row.get("id", "")
+        if not isinstance(identifier, str) or not _OBJECT_ID.fullmatch(identifier):
+            raise WhatsAppAPIError("WhatsApp 模板编号无效。")
+        return {"id": identifier, "name": name, "language": language, "body": body,
+                "footer": footer or "", "parameter_count": 3}
+
+    @staticmethod
+    def _payload(to, name, language, parameters):
+        to = _phone(to)
+        name, language = _template_identity(name, language)
+        parameters = _parameters(parameters)
+        return {"messaging_product": "whatsapp", "recipient_type": "individual", "to": to,
+                "type": "template", "template": {"name": name, "language": {"code": language},
+                    "components": [{"type": "body", "parameters": [{"type": "text", "text": value} for value in parameters]}]}}
+
+    def preview_template(self, to, name, language, parameters):
+        payload = self._payload(to, name, language, parameters)
+        template = self.get_template(name, language)
+        values = _parameters(parameters)
+        # One pass prevents user text containing {{2}} from becoming another parameter.
+        body = re.sub(r"\{\{([123])\}\}", lambda match: values[int(match[1]) - 1], template["body"])
+        if template["footer"]:
+            body += "\n\n" + template["footer"]
+        _text(body, 8192, multiline=True)
+        return {"body": body, "payload": payload, "template": template, "parameter_count": 3,
+                "sent": False}
+
+    def _send(self, payload):
+        result = self._request(self.phone_number_id + "/messages", payload=payload)
+        messages = result.get("messages")
+        message_id = messages[0].get("id") if isinstance(messages, list) and len(messages) == 1 and isinstance(messages[0], dict) else None
+        if not isinstance(message_id, str) or not _MESSAGE_ID.fullmatch(message_id):
+            raise WhatsAppAPIError("WhatsApp 未返回有效消息编号，请先核对 Meta 消息记录。", outcome_unknown=True)
+        return {"message_id": message_id, "status": "accepted", "delivery_confirmed": False}
+
+    def send_template(self, to, name, language, parameters):
+        # Deliberately no hidden template GET and no retry. The workflow must
+        # revalidate the approved preview immediately before this explicit POST.
+        return self._send(self._payload(to, name, language, parameters))
+
+    def hello_world_test(self, to):
+        """Explicit test message only; never represents a procurement send."""
+        return self._send({"messaging_product": "whatsapp", "recipient_type": "individual", "to": _phone(to),
+                           "type": "template", "template": {"name": "hello_world", "language": {"code": "en_US"}}})
