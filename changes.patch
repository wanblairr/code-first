+@echo off
+setlocal
+chcp 65001 >nul
+set PYTHONUTF8=1
+cd /d "%~dp0"
+set "CAFE_DEMO_BASE=%~dp0local_app"
+python -X utf8 setup_owner_password.py
+if errorlevel 1 goto failed
+call "%~dp0local_app\start.cmd"
+exit /b %ERRORLEVEL%
+:failed
+echo Startup requires Python 3.11+ and a local password. Read the error above.
+pause
+exit /b 2
