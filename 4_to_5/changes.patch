-  [new RegExp(`^${names} stock must be between 0 and ${num} (g|ml|pcs)(, using a whole number)?\\.$`),(m,l)=>select(l,`Stok ${units(m[1],l)} mestilah antara 0 dan ${m[2]} ${units(m[3],l)}${m[4]?', dalam nombor bulat':''}.`,`El inventario de ${units(m[1],l)} debe estar entre 0 y ${m[2]} ${units(m[3],l)}${m[4]?', usando un entero':''}.`)],
-  [/^(\d{4}-\d{2}-\d{2}) · Decision saved\. No draft was created or sent\.$/,(m,l)=>select(l,`${m[1]} · Keputusan disimpan. Tiada draf dijana atau dihantar.`,`${m[1]} · Decisión guardada. No se creó ni envió ningún borrador.`)],
-  [/^(\d{4}-\d{2}-\d{2}) · ([\d,.]+) °C · ([\d,.]+) mm · Source: Open-Meteo\.$/,(m,l)=>select(l,`${m[1]} · ${m[2]} °C · ${m[3]} mm · Sumber: Open-Meteo.`,`${m[1]} · ${m[2]} °C · ${m[3]} mm · Fuente: Open-Meteo.`)],
-  [/^(\d{4}-\d{2}-\d{2}) (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) · This changes only the forecast scenario, not the official calendar\.$/,(m,l)=>select(l,`${m[1]} ${weekdays[m[2]][0]} · Hanya senario ramalan berubah, bukan kalendar rasmi.`,`${m[1]} ${weekdays[m[2]][1]} · Solo cambia el escenario de previsión, no el calendario oficial.`)],
-  [/^(\d{4}-\d{2}-\d{2}) (Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) · (Kuala Lumpur public holiday|Not marked as a Kuala Lumpur public holiday|Unknown holiday status must not be treated as ordinary)$/,(m,l)=>{const labels={'Kuala Lumpur public holiday':['Cuti umum Kuala Lumpur','Festivo de Kuala Lumpur'],'Not marked as a Kuala Lumpur public holiday':['Tidak ditandai sebagai cuti umum Kuala Lumpur','No marcado como festivo de Kuala Lumpur'],'Unknown holiday status must not be treated as ordinary':['Status cuti tidak diketahui tidak boleh dianggap hari biasa','El estado desconocido no debe tratarse como día ordinario']};return `${m[1]} ${weekdays[m[2]][l==='ms'?0:1]} · ${labels[m[3]][l==='ms'?0:1]}`;}],
-  [/^([\d,.]+) (g|ml|pcs) \/ (bag|carton|pack) · (Demo coffee supplier|Demo dairy supplier|Demo packaging supplier)$/,(m,l)=>`${m[1]} ${units(m[2],l)} / ${units(m[3],l)} · ${units(m[4],l)}`],
-  [/^(\d+) (bags?|cartons?|packs?) × ([\d,.]+) (g|ml|pcs)$/,(m,l)=>`${m[1]} ${units(m[2],l)} × ${m[3]} ${units(m[4],l)}`],
-  [/^(\d{4}-\d{2}-\d{2}) · ([\d,.]+) expected drink portions · (Live weather forecast|Simulated weather)( · Simulated holiday assumption)?$/,(m,l)=>select(l,`${m[1]} · Anggaran ${m[2]} hidangan minuman · ${units(m[3],l)}${m[4]?' · Andaian cuti simulasi':''}`,`${m[1]} · ${m[2]} porciones previstas · ${units(m[3],l)}${m[4]?' · Supuesto de festivo simulado':''}`)],
-  [/^(.+)\. Weekday differences are already included in the reference forecast\.$/,(m,l)=>{const label=translateLocale(m[1],l);return label?select(l,`${label}. Perbezaan hari minggu sudah diambil kira dalam ramalan rujukan.`,`${label}. Las diferencias del día de la semana ya están incluidas en la previsión de referencia.`):null;}],
-  [/^(.+) Calendar coverage: (\d{4}-\d{2}-\d{2}) to (\d{4}-\d{2}-\d{2})\.$/,(m,l)=>{const note=translateLocale(m[1],l);return note?select(l,`${note} Liputan kalendar: ${m[2]} hingga ${m[3]}.`,`${note} Cobertura del calendario: ${m[2]} a ${m[3]}.`):null;}],
