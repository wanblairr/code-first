+        events:[{action:'bom_sale_undone',request_id:payload.request_id,at:'2026-10-24T01:02:00Z'},...server.events]};
+      if(mode==='undo-accepted-lost')throw Error('undo committed but response lost');
+    }else if(path==='/api/bom/prices'){
+      assert.equal(payload.revision,server.pricing.revision);
+      assert.ok(payload.entries.every(entry=>entry.source==='demo'));
+      server={...server,pricing:{revision:server.pricing.revision+1,currency:'MYR',entries:payload.entries},
+        proposal:null,active_order_id:null};
+      if(mode==='prices-accepted-lost')throw Error('prices saved but response lost');
+    }else if(path==='/api/bom/context'){
+      assert.ok(['source','rain','sunny','mild'].includes(payload.weather_mode));
+      assert.ok(['auto','public_holiday','ordinary'].includes(payload.holiday_mode));
+      server={...server,proposal:null,active_order_id:null,context_signature:'changed-context',bom_context_settings:{weather_mode:payload.weather_mode,holiday_mode:payload.holiday_mode}};
+      if(mode==='context-accepted-lost')throw Error('socket closed after context commit');
+    }else if(path==='/api/bom/suggest'){
+      server={...server,active_order_id:null,proposal:{id:'proposal-7',input_hash:'hash-7',revision:7,stock_revision:server.revision,status:'pending',
+        forecast:{targetDate:'2026-10-25',coefficient:1,sales:[{productId:'BV-013',size:'中杯',quantity:20}]},
+        rows:[{id:'INV-003',unit:'ml',tomorrow:14340,current:server.stock['INV-003'],safety:51200,quantity:5540},{id:'INV-005',unit:'ml',tomorrow:3000,current:server.stock['INV-005'],safety:2800,quantity:3200},
+          {id:'INV-001',unit:'g',tomorrow:360,current:server.stock['INV-001'],safety:6100,quantity:0}]}};
+    }else if(path==='/api/bom/approve'){
+      assert.equal(payload.revision,7,'approval uses proposal version, not stock revision');
+      assert.equal(payload.proposal_id,'proposal-7');assert.equal(payload.input_hash,'hash-7');
+      const items=Object.entries(payload.quantities).filter(([,quantity])=>quantity>0).map(([id,quantity])=>{
+        const price=server.pricing.entries.find(entry=>entry.ingredient_id===id);
+        const priced=Number.isSafeInteger(price?.pack_quantity)&&price.pack_quantity>0&&Number.isSafeInteger(price?.pack_price_cents);
+        const packs=priced?Math.ceil(quantity/price.pack_quantity):null;
+        return {ingredient_id:id,unit:server.data.materials[id].unit,approved_quantity:quantity,
+          pack_quantity:price?.pack_quantity??null,purchase_packs:packs,purchase_quantity:priced?packs*price.pack_quantity:quantity,
+          line_total_cents:priced?packs*price.pack_price_cents:null};
+      });
