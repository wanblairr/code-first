+class FakeResponse:
+    def __init__(self, payload, status=200):
+        self.data = payload if isinstance(payload, bytes) else json.dumps(payload).encode("utf-8")
+        self.status = status
+        self.closed = False
+        self.read_limits = []
+
+    def getcode(self):
+        return self.status
+
+    def read(self, size):
+        self.read_limits.append(size)
+        return self.data[:size]
+
+    def close(self):
+        self.closed = True
+
