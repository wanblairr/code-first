+      if (claimed.cached) return json(claimed.cached);
+      const payload = {messaging_product: 'whatsapp', recipient_type: 'individual', to: body.recipient,
+        type: 'template', template: {name: selected.name, language: {code: selected.language},
+          ...(parameters.length ? {components: [{type: 'body', parameters: parameters.map(text => ({type: 'text', text}))}]} : {})}};
+      let messageID;
+      try {
+        const outcome = await graph(credentials, `${credentials.phone_number_id}/messages`, {fetchImpl, payload});
