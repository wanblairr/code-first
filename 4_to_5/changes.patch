+++ b/public_website/tests/account.test.mjs
@@ -0,0 +1,58 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {generateKeyPairSync,sign,createHash} from 'node:crypto';
+import {createHandler,PUBLIC_ORIGIN} from '../netlify/functions/account.mjs';
+import {PUBLIC_GMAIL_CLIENT_ID} from '../dist/demo/public-config.js';
+import {GOOGLE_JWKS,createGoogleVerifier} from '../netlify/lib/account-google.mjs';
+import {validateShopState} from '../netlify/lib/account-state.mjs';
+import BOM from '../dist/demo/bom-data.json' with {type:'json'};
+import {initialStock} from '../dist/demo/bom-core.mjs';
+import {createPricebook} from '../dist/demo/bom-pricing.mjs';
+import {forecastMenu,createBOMOrder} from '../dist/demo/bom-workflow.mjs';
+import {replenish} from '../dist/demo/bom-core.mjs';
+const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});
+const jwk={...publicKey.export({format:'jwk'}),kid:'test-key',use:'sig',alg:'RS256'};
+const NOW=Date.parse('2026-10-24T06:00:00Z'),BASE=PUBLIC_ORIGIN+'/.netlify/functions/account';
+const copy=v=>JSON.parse(JSON.stringify(v));
+const digest=v=>createHash('sha256').update(v).digest('hex');
+function jwt(nonce,patch={},headerPatch={}){const header=Buffer.from(JSON.stringify({kid:'test-key',alg:'RS256',typ:'JWT',...headerPatch})).toString('base64url');const payload=Buffer.from(JSON.stringify({iss:'https://accounts.google.com',aud:PUBLIC_GMAIL_CLIENT_ID,sub:'fake-account-a',email:'test@example.net',email_verified:true,name:'Test Visitor',iat:Math.floor(NOW/1000)-1,exp:Math.floor(NOW/1000)+3600,nonce,...patch})).toString('base64url');const data=header+'.'+payload;return data+'.'+sign('RSA-SHA256',Buffer.from(data),privateKey).toString('base64url');}
+function state(){return{version:1,shopName:'Test cafe',currency:'MYR',salesHistory:{revision:1,days:[{date:'2026-10-23',rows:[{productId:'BV-013',size:'中杯',quantity:36}]}]},extras:[{id:'custom_napkins',name:'Napkins',quantity:2,unit:'box',unitPriceCents:600}],bom:{stock:initialStock(BOM),revision:0,pricebook:createPricebook(BOM),orders:[],logs:[],activeOrder:null,lastTransaction:null,priceDraft:null}};}
+function fixture(options={}){const h={map:new Map(),writes:[],reads:[],fetches:[],now:NOW,sequence:0};h.store={getWithMetadata:async key=>{h.reads.push(key);if(h.readError)throw new Error('not exposed');const value=h.map.get(key);return value?copy(value):null;},setJSON:async(key,data,condition={})=>{h.writes.push({key,data:copy(data),condition});if(h.writeError)throw new Error('not exposed');const old=h.map.get(key);if(condition.onlyIfNew&&old||condition.onlyIfMatch&&old?.etag!==condition.onlyIfMatch)return{modified:false};const etag='etag-'+(++h.sequence);h.map.set(key,{etag,data:copy(data)});return h.uncertainWrite?{modified:true}:{modified:true,etag};}};h.fetch=async(url,init)=>{h.fetches.push({url,init});assert.equal(url,GOOGLE_JWKS);return new Response(JSON.stringify({keys:[jwk]}),{headers:{'content-type':'application/json'}});};h.handler=createHandler({storeFactory:async()=>h.store,fetchImpl:h.fetch,now:()=>h.now,...options});h.request=(method,input,{cookie='',csrf='',origin=PUBLIC_ORIGIN,headers={},query=''}={})=>h.handler(new Request(BASE+query,{method,headers:{...(method!=='GET'?{'Origin':origin,'Content-Type':'application/json'}:{}),'Sec-Fetch-Site':'same-origin',...(cookie?{Cookie:cookie}:{}),...(csrf?{'X-CSRF-Token':csrf}:{}),...headers},...(method!=='GET'?{body:JSON.stringify(input)}:{})}));h.begin=async()=>{const r=await h.request('POST',{operation:'challenge'});assert.equal(r.status,200);const data=await r.json(),cookie=r.headers.getSetCookie().find(x=>x.startsWith('__Host-cafe_login=')).split(';')[0];return{...data,cookie};};h.finish=async(challenge,patch={})=>h.request('POST',{operation:'google',challengeId:challenge.challengeId,credential:jwt(challenge.nonce,patch)},{cookie:challenge.cookie});h.login=async(patch={})=>{const c=await h.begin(),r=await h.finish(c,patch);assert.equal(r.status,200);const data=await r.json(),cookie=r.headers.getSetCookie().find(x=>x.startsWith('__Host-cafe_session=')).split(';')[0];return{...data,cookie,challenge:c};};return h;}
+
+test('unauthenticated capabilities load without touching unavailable storage',async()=>{const h=fixture({storeFactory:async()=>{throw Error('unavailable');}});const r=await h.request('GET',null,{query:'?operation=session'});assert.equal(r.status,200);const data=await r.json();assert.equal(data.user,null);assert.equal(data.csrf,null);assert.equal(data.clientId,PUBLIC_GMAIL_CLIENT_ID);assert.deepEqual(data.capabilities,{google:true,whatsapp:false});assert.equal(h.fetches.length,0);});
+test('secure challenge cookie binds one-use nonce and stores only hashes',async()=>{const h=fixture(),c=await h.begin();const record=h.map.get('challenges/'+digest(c.challengeId)).data;assert.equal(record.cookieHash,digest(c.cookie.split('=')[1]));assert.equal(record.nonceHash,digest(c.nonce));assert.equal(JSON.stringify([...h.map.values()]).includes(c.nonce),false);const r=await h.request('POST',{operation:'challenge'});const cookie=r.headers.get('set-cookie');for(const text of ['HttpOnly','Secure','SameSite=Lax','Path=/','Max-Age=300'])assert.ok(cookie.includes(text));});
+test('valid Google sign-in auto-registers then issues a private opaque session',async()=>{const h=fixture(),auth=await h.login();assert.equal(auth.user.provider,'google');assert.equal(auth.user.id.length,64);assert.equal(h.fetches.length,1);const r=await h.request('GET',null,{query:'?operation=session',cookie:auth.cookie});assert.equal(r.status,200);assert.deepEqual((await r.json()).user,auth.user);const serialized=JSON.stringify([...h.map.entries()]);assert.equal(serialized.includes(auth.cookie.split('=')[1]),false);assert.equal(serialized.includes(jwt(auth.challenge.nonce)),false);assert.equal(r.headers.get('cache-control'),'no-store, max-age=0');});
+test('Google login stays separate from Gmail compose and never requests mailbox APIs',async()=>{const h=fixture();await h.login();assert.deepEqual(h.fetches.map(x=>x.url),[GOOGLE_JWKS]);assert.equal(h.fetches[0].init.redirect,'error');assert.equal(h.fetches[0].init.credentials,'omit');});
+test('returning Google subject maps to the same store',async()=>{const h=fixture(),a=await h.login(),b=await h.login();assert.equal(a.user.id,b.user.id);assert.notEqual(a.cookie,b.cookie);assert.equal([...h.map.keys()].filter(k=>k.endsWith('/profile')).length,1);assert.equal(h.fetches.length,1);});
+test('missing, wrong and expired login cookies cannot complete sign-in',async()=>{const h=fixture(),c=await h.begin(),input={operation:'google',challengeId:c.challengeId,credential:jwt(c.nonce)};assert.equal((await h.request('POST',input)).status,401);assert.equal((await h.request('POST',input,{cookie:'__Host-cafe_login='+'x'.repeat(43)})).status,401);h.now+=300001;assert.equal((await h.finish(c)).status,401);assert.equal(h.fetches.length,0);});
+test('nonce mismatch does not consume challenge or create a session',async()=>{const h=fixture(),c=await h.begin();const r=await h.request('POST',{operation:'google',challengeId:c.challengeId,credential:jwt('x'.repeat(43))},{cookie:c.cookie});assert.equal(r.status,401);assert.equal(h.map.get('challenges/'+digest(c.challengeId)).data.consumed,false);assert.equal([...h.map.keys()].some(k=>k.startsWith('sessions/')),false);});
+test('consumed challenge cannot replay even with its original cookie',async()=>{const h=fixture(),auth=await h.login();const r=await h.finish(auth.challenge);assert.equal(r.status,401);assert.equal([...h.map.keys()].filter(k=>k.startsWith('sessions/')).length,1);});
+test('simultaneous login consumes a challenge at most once',async()=>{const h=fixture(),c=await h.begin();const replies=await Promise.all([h.finish(c),h.finish(c)]);assert.deepEqual(replies.map(r=>r.status).sort(),[200,409]);assert.equal([...h.map.keys()].filter(k=>k.startsWith('sessions/')).length,1);});
+for(const[title,patch]of Object.entries({audience:{aud:'another-client'},issuer:{iss:'https://attacker.invalid'},expired:{exp:Math.floor(NOW/1000)},future:{iat:Math.floor(NOW/1000)+61},old:{iat:Math.floor(NOW/1000)-7201},unverified:{email_verified:false},stringVerified:{email_verified:'true'},missingSubject:{sub:''},invalidEmail:{email:'a\nb@example.net'},azp:{azp:'another-client'}}))test('rejects invalid Google '+title,async()=>{const h=fixture(),c=await h.begin();assert.equal((await h.finish(c,patch)).status,401);assert.equal([...h.map.keys()].some(k=>k.startsWith('sessions/')),false);});
+test('RS256 signature and algorithm cannot be replaced',async()=>{const h=fixture(),c=await h.begin();for(const credential of [jwt(c.nonce,{}, {alg:'none'}),jwt(c.nonce,{}, {alg:'HS256'}),jwt(c.nonce).slice(0,-8)+'AAAAAAAA',jwt(c.nonce,{}, {jku:'https://attacker.invalid/keys'})]){const r=await h.request('POST',{operation:'google',challengeId:c.challengeId,credential},{cookie:c.cookie});assert.equal(r.status,401);}assert.equal([...h.map.keys()].some(k=>k.startsWith('sessions/')),false);});
+test('JWKS failure is bounded, generic and fails closed',async()=>{const h=fixture({fetchImpl:async()=>new Response('upstream-private-information',{status:500})}),c=await h.begin();const r=await h.finish(c);assert.equal(r.status,503);assert.deepEqual(await r.json(),{code:'google_keys_unavailable'});assert.equal(h.map.get('challenges/'+digest(c.challengeId)).data.consumed,false);});
+test('server never accepts posted identity, custom provider or UID',async()=>{const h=fixture(),c=await h.begin();for(const input of [{operation:'google',credential:jwt(c.nonce),challengeId:c.challengeId,email:'other@example.net'},{operation:'whatsapp',phone:'+60000000000'},{operation:'challenge',userId:'another-user'}])assert.equal((await h.request('POST',input,{cookie:c.cookie})).status,400);});
+test('cross origin, cross-site, paths, methods and non-JSON reject before mutations',async()=>{const h=fixture();for(const headers of [{Origin:'https://attacker.invalid'},{'Sec-Fetch-Site':'cross-site'},{'Content-Type':'text/plain'}])assert.ok((await h.request('POST',{operation:'challenge'},{headers})).status>=400);assert.equal((await h.handler(new Request(PUBLIC_ORIGIN+'/wrong'))).status,404);assert.equal((await h.handler(new Request(BASE,{method:'DELETE'}))).status,405);assert.equal(h.writes.length,0);});
+test('shop requires authentication and CSRF for writes',async()=>{const h=fixture();assert.equal((await h.request('GET',null,{query:'?operation=shop'})).status,401);const auth=await h.login();assert.equal((await h.request('PUT',{operation:'shop',revision:0,state:state()},{cookie:auth.cookie})).status,403);assert.equal((await h.request('PUT',{operation:'shop',revision:0,state:state()},{cookie:auth.cookie,csrf:'x'.repeat(43)})).status,403);});
