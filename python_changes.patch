@@ -0,0 +1,145 @@
+"""360dialog personal Sandbox transport. No retries, redirects or status claims.
+
+Contract: https://docs.360dialog.com/docs/get-started/sandbox
+This endpoint is for the API key's single fixed owner recipient, not suppliers.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import http.client
+import json
+import math
+import re
+from urllib import error, request
+
+from cafe_core import CafeError, canonical
+
+ENDPOINT = "https://waba-sandbox.360dialog.io/v1/messages"
+MAX_RESPONSE = 65536
+
+
+class SandboxAPIError(CafeError):
+    def __init__(self, message, *, outcome_unknown=False, status_code=None):
+        super().__init__(message)
+        self.outcome_unknown = bool(outcome_unknown)
+        self.status_code = status_code
+
+
+class _NoRedirect(request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def sandbox_recipient(kind, value):
+    if not isinstance(value, str):
+        raise CafeError("请填写沙盒 API key 对应的本人收件标识。")
+    if kind == "phone":
+        if not re.fullmatch(r"[1-9][0-9]{6,14}", value):
+            raise CafeError("本人号码须含国际区号，使用 7 至 15 位数字，不含加号。")
+    elif kind == "bsuid":
+        if not 1 <= len(value) <= 256 or not value.isascii() or any(ord(c) < 33 or ord(c) == 127 for c in value):
+            raise CafeError("请按沙盒回复原样填写本人 BSUID，不含空白或控制字符。")
+    else:
+        raise CafeError("沙盒收件人类型只能为 phone 或 bsuid。")
+    return kind, value
+
+
+def recipient_label(kind, value):
+    return ("本人号码 · 尾号 " if kind == "phone" else "本人 BSUID · 末四位 ") + value[-4:]
+
+
+def _failure(status):
+    unknown = not isinstance(status, int) or status in (408, 409) or status >= 500 or 200 <= status < 400
+    messages = {401: "沙盒 API key 无效，请在本机重新配置。",
+                403: "本人收件标识与沙盒 API key 不匹配，平台未接受请求。",
+                429: "沙盒请求额度已用完或受限；失败请求也计入 200 次额度。"}
+    message = messages.get(status, "沙盒未接受请求，请核对本人收件标识与 24 小时会话窗口。")
+    if unknown:
+        message = "沙盒发送结果未知，请先在本人手机核对；系统禁止自动或重复重发。"
+    return SandboxAPIError(message, outcome_unknown=unknown, status_code=status)
+
+
+class SandboxClient:
+    def __init__(self, api_key, recipient_kind, recipient_id, opener=None, timeout=10):
+        if (not isinstance(api_key, str) or not 8 <= len(api_key) <= 8192 or not api_key.isascii()
+                or any(ord(c) < 33 or ord(c) == 127 for c in api_key)):
+            raise CafeError("请填写原始沙盒 API key，不含空白或换行。")
+        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not math.isfinite(timeout) or not 1 <= timeout <= 60:
+            raise CafeError("沙盒请求超时须为 1 至 60 秒。")
+        self.recipient_kind, self.recipient_id = sandbox_recipient(recipient_kind, recipient_id)
+        self._key = api_key
+        self._opener = opener or request.build_opener(_NoRedirect())
+        self.timeout = timeout
+
+    def __repr__(self):
+        return "SandboxClient(api_key=<redacted>, recipient=<redacted>)"
+
+    def preview(self, body):
+        if (not isinstance(body, str) or not body.strip() or len(body) > 4096
+                or any(ord(c) < 32 and c not in "\n" or ord(c) == 127 for c in body)):
+            raise CafeError("沙盒消息必须为最多 4096 字的有效正文。")
+        try:
+            body.encode("utf-8")
+        except UnicodeError:
+            raise CafeError("沙盒正文编码无效。") from None
+        target = "to" if self.recipient_kind == "phone" else "recipient"
+        return {"body": body, "payload": {"messaging_product": "whatsapp", target: self.recipient_id,
+                                            "type": "text", "text": {"body": body}}}
+
+    def send(self, payload):
+        # Validate the exact preview contract; no caller-supplied URL/channel or
+        # alternate recipient can be smuggled into this personal-only adapter.
+        if not isinstance(payload, dict) or not isinstance(payload.get("text"), dict):
+            raise CafeError("沙盒发送资料无效，请重新预览。")
+        expected = self.preview(payload["text"].get("body"))["payload"]
+        if payload != expected:
+            raise CafeError("沙盒发送内容或本人收件标识与预览不一致。")
+        req = request.Request(ENDPOINT, data=canonical(deepcopy(payload)).encode("utf-8"), method="POST",
+                              headers={"D360-API-KEY": self._key, "Content-Type": "application/json", "Accept": "application/json"})
+        response = None
+        status = None
+        try:
+            response = getattr(self._opener, "open", self._opener)(req, timeout=self.timeout)
+            status = response.getcode()
+            # Sandbox documentation uses 201; the platform Messaging API also
+            # documents 200. Both still require the identical strict response
+            # contract below. Other 2xx statuses do not prove acceptance.
+            if status not in (200, 201):
+                raise _failure(status)
+            if getattr(response, "geturl", lambda: ENDPOINT)() != ENDPOINT:
+                raise _failure(302)
+            raw = response.read(MAX_RESPONSE + 1)
+            if not isinstance(raw, bytes) or len(raw) > MAX_RESPONSE or self._key.encode("ascii") in raw:
+                raise SandboxAPIError("沙盒响应无法安全识别，请在本人手机核对。", outcome_unknown=True)
+            def pairs(entries):
+                result = {}
+                for key, value in entries:
+                    if key in result:
+                        raise ValueError("duplicate")
+                    result[key] = value
+                return result
+            document = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs,
+                                  parse_constant=lambda unused: (_ for _ in ()).throw(ValueError("nonfinite")))
+            messages = document.get("messages") if isinstance(document, dict) and "error" not in document else None
+            message_id = messages[0].get("id") if isinstance(messages, list) and len(messages) == 1 and isinstance(messages[0], dict) else None
+            if (not isinstance(message_id, str) or not 1 <= len(message_id) <= 512 or not message_id.isascii()
+                    or any(ord(c) < 33 or ord(c) == 127 for c in message_id) or self._key in message_id):
+                raise ValueError("message id")
+            return {"message_id": message_id, "status": "accepted", "delivery_confirmed": False}
+        except error.HTTPError as exc:
+            status = exc.code
+            exc.close()
+            raise _failure(status) from None
+        except SandboxAPIError as exc:
+            if exc.status_code is None:
+                exc.status_code = status
+            raise
+        except (error.URLError, OSError, ValueError, UnicodeError, RecursionError, TypeError, http.client.HTTPException):
+            raise SandboxAPIError("沙盒发送结果未知，请在本人手机核对；禁止重复重发。",
+                                  outcome_unknown=True, status_code=status) from None
+        finally:
+            if response is not None:
+                try:
+                    response.close()
+                except (OSError, http.client.HTTPException):
+                    pass
