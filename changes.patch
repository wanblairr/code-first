+  const priced = lines.map(approvedLineMoney);
+  const calculatedSubtotal = priced.length && priced.every(line => line.total !== null) ? priced.reduce((sum,line) => sum + line.total, 0) : null;
+  const subtotal = Number.isSafeInteger(calculatedSubtotal) && draft.subtotalCents === calculatedSubtotal ? calculatedSubtotal : null;
+  let note = typeof ownerNote === 'string' ? ownerNote : null;
+  const originalBody = typeof draft.body === 'string' ? draft.body : '';
+  if (note === null) {
+    const start = originalBody.indexOf('\n审批备注：');
+    const end = originalBody.lastIndexOf('\n\n请核对数量、价格、保质期和配送安排。');
+    if (start >= 0 && end > start) note = originalBody.slice(start + '\n审批备注：'.length, end);
+  }
+  return [
+    `Dear ${supplierName(draft.supplierId)},`, '',
+    'This is a public demonstration purchase draft. Sales, stock and supplier details are simulated.',
+    `Requested delivery: ${date || 'as shown in the original draft'} (before opening; confirm actual arrangements with the supplier).`, '',
+    ...(lines.length ? lines.map((line,index) => `- ${line.english}: ${line.packs} ${line.pack} × ${line.size} ${line.unit}, total ${line.quantity} ${line.unit}; unit price: ${draftMoney(priced[index].price)}; line total: ${draftMoney(priced[index].total)}`) : ['See the approved quantities in the original draft shown below.']), '',
