+"""OAuth lifecycle tests use isolated credentials and mocked provider calls."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import tempfile
+import threading
+import unittest
+from unittest.mock import Mock, patch
+from urllib.parse import parse_qs, urlsplit
+
+from cafe_gmail import GmailAPIError
+from cafe_gmail_auth_manager import GmailAuthManager
+from cafe_gmail_oauth import GmailOAuthClient, GmailOAuthError
+from cafe_integrations_config import IntegrationConfig
+
+
+CLIENT_ID = "123456789-manager-test.apps.googleusercontent.com"
+CLIENT_SECRET = "GOCSPX-manager-test-client-secret"
+ACCESS = "ya29.manager-test-old-access-token"
+FRESH_ACCESS = "ya29.manager-test-fresh-access-token"
+REFRESH = "1//manager-test-refresh-token"
+CALLBACK = "http://127.0.0.1:8770/api/integrations/gmail/oauth/callback"
+
+
+class GmailAuthManagerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="gmail-manager-test-")
+        self.addCleanup(self.temp.cleanup)
+        self.env = patch.dict(os.environ, {}, clear=False)
+        self.env.start()
+        self.addCleanup(self.env.stop)
+        for name in ("GMAIL_CLIENT_ID", "GMAIL_CLIENT_SECRET", "GMAIL_REFRESH_TOKEN", "GMAIL_ACCESS_TOKEN", "RUNPOD_API_KEY"):
+            os.environ.pop(name, None)
+        self.config = IntegrationConfig(Path(self.temp.name) / "runtime")
+        self.client_document = {"installed": {"client_id": CLIENT_ID, "client_secret": CLIENT_SECRET}}
+        self.config.import_google_desktop_client(self.client_document)
+        self.tick = 1000
+        self.manager = GmailAuthManager(self.config, clock=lambda: self.tick)
+        self.client = GmailOAuthClient(CLIENT_ID, CLIENT_SECRET, clock=lambda: self.tick)
+        self.client.exchange_code = Mock(return_value=self.bundle())
+        self.client.refresh = Mock(return_value=self.bundle())
+        self.manager.oauth_factory = Mock(return_value=self.client)
+        self.manager.revoke_factory = Mock()
+
+    def bundle(self, access=FRESH_ACCESS, refresh=None):
+        result = {"access_token": access, "expires_at": self.tick + 3600}
+        if refresh is not None:
+            result["refresh_token"] = refresh
+        return result
+
+    def authorized(self, expiry=None):
+        self.config.update({"gmail_access_token": ACCESS, "gmail_refresh_token": REFRESH,
+                            "gmail_token_expires_at": self.tick + 3600 if expiry is None else expiry})
+
