+  if (list) return list;
+  const datedDetail = text.match(/^(\d{4}-\d{2}-\d{2}) · (.+)$/);
+  if (datedDetail) { const detail = translateText(datedDetail[2]); if (detail) return `${datedDetail[1]} · ${detail}`; }
+  const skuList = text.split(' · ').map(part => part.match(/^(意式浓缩|拿铁|燕麦拿铁) ([\d,.]+) 杯$/));
