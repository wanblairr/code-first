+def revoke_token(token, opener=None, timeout=15):
+    """Revoke an existing Google token without requiring OAuth client setup.
+
+    The caller supplies the token only in memory. Never print it, log the
+    request body, or put the token on a command line or in a query string.
+    """
+    _ascii(token, "待撤销令牌")
+    if type(timeout) not in (int, float) or not 1 <= timeout <= 60 or not math.isfinite(timeout):
+        raise GmailOAuthError("Google 请求超时须为 1 至 60 秒。", code="invalid_input")
+    return _post_google(opener or request.build_opener(_NoRedirect()), timeout,
+                        REVOKE_URL, {"token": token}, operation="revoke")
+
+
+class GmailOAuthClient:
+    """Fixed Google OAuth routes; no redirects, retries, or credential logging."""
+
+    def __init__(self, client_id, client_secret="", opener=None, timeout=15, clock=time.time):
+        if not isinstance(client_id, str) or not _CLIENT.fullmatch(client_id):
+            raise GmailOAuthError("请配置自己的 Google 桌面应用 OAuth Client ID。", code="invalid_client")
+        _ascii(client_secret, "OAuth Client Secret", maximum=4096, empty=True)
+        if type(timeout) not in (int, float) or not 1 <= timeout <= 60 or not math.isfinite(timeout):
+            raise GmailOAuthError("Google 请求超时须为 1 至 60 秒。", code="invalid_input")
+        if not callable(clock):
+            raise GmailOAuthError("系统时间配置无效。", code="invalid_clock")
+        self.client_id = client_id
+        self._client_secret = client_secret
+        self._opener = opener or request.build_opener(_NoRedirect())
+        self.timeout = timeout
+        self.clock = clock
+
+    def __repr__(self):
+        return "GmailOAuthClient(credentials=<redacted>)"
+
+    def authorization_url(self, redirect_uri, state, code_verifier):
+        validate_redirect_uri(redirect_uri)
+        if not isinstance(state, str) or not _STATE.fullmatch(state):
+            raise GmailOAuthError("授权状态无效，请重新连接 Gmail。", code="invalid_state")
+        if not isinstance(code_verifier, str) or not _PKCE.fullmatch(code_verifier):
+            raise GmailOAuthError("PKCE 校验资料无效。", code="invalid_pkce")
+        challenge = base64.urlsafe_b64encode(hashlib.sha256(code_verifier.encode("ascii")).digest()).rstrip(b"=").decode("ascii")
+        params = {"client_id": self.client_id, "redirect_uri": redirect_uri, "response_type": "code",
+                  "scope": COMPOSE_SCOPE, "access_type": "offline", "prompt": "consent",
+                  "state": state, "code_challenge": challenge, "code_challenge_method": "S256"}
+        return AUTHORIZATION_URL + "?" + parse.urlencode(params)
+
+    def _post(self, url, values, *, operation):
+        return _post_google(self._opener, self.timeout, url, values, operation=operation)
+
+    def _tokens(self, result, *, require_refresh):
+        try:
+            access = _ascii(result.get("access_token"), "访问令牌")
+            refresh = result.get("refresh_token")
+            if refresh is not None:
+                _ascii(refresh, "刷新令牌")
+            if require_refresh and not refresh:
+                raise GmailOAuthError("Google 未返回刷新令牌，请重新同意离线授权。", code="refresh_token_missing")
+            expiry = result.get("expires_in")
+            if type(expiry) not in (int, float) or not 1 <= expiry <= 86400 or not math.isfinite(expiry):
+                raise ValueError
+            if result.get("token_type") != "Bearer":
+                raise ValueError
+            scope = result.get("scope")
+            if not isinstance(scope, str) or len(scope) > 4096 or any(ord(c) < 32 or ord(c) > 126 for c in scope):
+                raise ValueError
+            scopes = scope.split()
+            if COMPOSE_SCOPE not in scopes or any(not item.startswith("https://www.googleapis.com/auth/") for item in scopes):
+                raise ValueError
+            normalized = {"access_token": access, "expires_in": expiry, "expires_at": _clock_value(self.clock) + expiry,
+                          "token_type": "Bearer", "scope": " ".join(sorted(set(scopes)))}
+            if refresh:
+                normalized["refresh_token"] = refresh
+            return normalized
+        except GmailOAuthError as exc:
+            if exc.code in ("refresh_token_missing", "invalid_clock"):
+                raise
+            raise GmailOAuthError("Google 返回的令牌资料无效，请重新授权。", code="invalid_response", outcome_unknown=True) from None
+        except (TypeError, ValueError, OverflowError):
+            raise GmailOAuthError("Google 返回的令牌资料无效，请重新授权。", code="invalid_response", outcome_unknown=True) from None
+
+    def exchange_code(self, code, redirect_uri, code_verifier):
+        _ascii(code, "授权码", maximum=4096)
+        validate_redirect_uri(redirect_uri)
+        if not isinstance(code_verifier, str) or not _PKCE.fullmatch(code_verifier):
+            raise GmailOAuthError("PKCE 校验资料无效。", code="invalid_pkce")
+        values = {"client_id": self.client_id, "code": code, "code_verifier": code_verifier,
+                  "redirect_uri": redirect_uri, "grant_type": "authorization_code"}
+        if self._client_secret:
+            values["client_secret"] = self._client_secret
+        return self._tokens(self._post(TOKEN_URL, values, operation="exchange"), require_refresh=True)
+
+    def refresh(self, refresh_token):
+        _ascii(refresh_token, "刷新令牌")
+        values = {"client_id": self.client_id, "refresh_token": refresh_token, "grant_type": "refresh_token"}
+        if self._client_secret:
+            values["client_secret"] = self._client_secret
+        result = self._post(TOKEN_URL, values, operation="refresh")
+        # RFC 6749 sections 5.1 and 6 permit omission when scope is unchanged.
+        # This client requests only compose. An explicitly returned null, empty,
+        # or insufficient scope is still rejected; initial exchange stays strict.
+        if "scope" not in result:
+            result["scope"] = COMPOSE_SCOPE
+        return self._tokens(result, require_refresh=False)
+
+    def revoke(self, token):
+        _ascii(token, "待撤销令牌")
+        return self._post(REVOKE_URL, {"token": token}, operation="revoke")
+
+
+class GmailAuthorizationFlow:
+    """One in-memory, short-lived login attempt; never put pending state on disk."""
+
+    def __init__(self, client, clock=time.time, token_factory=secrets.token_urlsafe, ttl=600):
+        if type(ttl) not in (int, float) or not 1 <= ttl <= 600 or not math.isfinite(ttl):
+            raise GmailOAuthError("OAuth 登录有效期须为 1 至 600 秒。", code="invalid_input")
+        self.client = client
+        self.clock = clock
+        self.token_factory = token_factory
+        self.ttl = ttl
+        self._pending = None
+        self._lock = threading.Lock()
+
+    def __repr__(self):
+        return "GmailAuthorizationFlow(pending=<redacted>)"
+
+    def begin(self, redirect_uri, binding=""):
+        validate_redirect_uri(redirect_uri)
+        if not isinstance(binding, str) or len(binding) > 256:
+            raise GmailOAuthError("授权会话无效，请重新登录。", code="invalid_state")
+        state, verifier = self.token_factory(32), self.token_factory(64)
+        url = self.client.authorization_url(redirect_uri, state, verifier)
+        instant = _clock_value(self.clock)
+        with self._lock:
+            self._pending = {"state": state, "verifier": verifier, "redirect_uri": redirect_uri,
+                             "binding": binding, "created_at": instant, "expires_at": instant + self.ttl}
+        return {"authorization_url": url, "expires_at": instant + self.ttl}
+
+    def cancel(self):
+        with self._lock:
+            self._pending = None
+
+    def finish(self, state, code, redirect_uri, binding=""):
+        # Unrelated callbacks must not consume the owner's valid attempt.
+        if not isinstance(state, str) or not _STATE.fullmatch(state):
+            raise GmailOAuthError("授权状态无效，请从本机工作台重新连接。", code="invalid_state")
+        validate_redirect_uri(redirect_uri)
+        with self._lock:
+            pending = self._pending
+            if (pending is None or not hmac.compare_digest(state, pending["state"])
+                    or redirect_uri != pending["redirect_uri"] or binding != pending["binding"]):
+                raise GmailOAuthError("授权状态不匹配或已使用，请从本机工作台重新连接。", code="invalid_state")
+            self._pending = None  # consume before exchanging, even on ambiguous POST failure
+            instant = _clock_value(self.clock)
+            if instant < pending["created_at"] or instant >= pending["expires_at"]:
+                raise GmailOAuthError("Gmail 登录链接已过期，请重新连接。", code="expired_state")
+        return self.client.exchange_code(code, redirect_uri, pending["verifier"])
