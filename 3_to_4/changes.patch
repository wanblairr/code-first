+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {createPricebook,validatePricebook,setPrices,priceBOMRows} from '../dist/demo/bom-pricing.mjs';
+import {initialStock,sell,replenish} from '../dist/demo/bom-core.mjs';
+import {forecastMenu,createBOMOrder} from '../dist/demo/bom-workflow.mjs';
+
+const data=JSON.parse(await readFile(new URL('../dist/demo/bom-data.json',import.meta.url),'utf8'));
+const milk={ingredientId:'INV-003',packQuantity:1000,packPriceCents:800,source:'demo'};
+const oat={ingredientId:'INV-005',packQuantity:1000,packPriceCents:1200,source:'demo'};
+const rows=[
+  {id:'INV-003',name:'全脂牛奶',unit:'ml',quantity:5540},
+  {id:'INV-005',name:'燕麦奶',unit:'ml',quantity:2750},
+  {id:'INV-007',name:'焦糖糖浆',unit:'ml',quantity:0},
+];
+const offered=()=>setPrices(data,createPricebook(data),[milk,oat]);
+
+test('pricebook begins with unknown MYR quotes and independent state for every material',()=>{
+  const book=createPricebook(data);
+  assert.equal(book.priceRevision,0);
+  assert.equal(book.currency,'MYR');
+  assert.equal(Object.keys(book.prices).length,21);
+  assert.ok(Object.values(book.prices).every(value=>value===null));
+  const changed=offered();
+  assert.equal(book.prices['INV-003'],null);
+  assert.equal(changed.priceRevision,1);
+});
+
+test('save defaults currency/source, normalizes snapshots and unchanged values do not bump revision',()=>{
+  const input={ingredientId:'INV-003',packQuantity:1000,packPriceCents:800};
+  const book=setPrices(data,createPricebook(data),[input]);
+  assert.equal(book.prices['INV-003'].currency,'MYR');
+  assert.equal(book.prices['INV-003'].source,'owner_entry');
+  assert.equal(setPrices(data,book,[input],1).priceRevision,1);
+  input.packPriceCents=99;
+  assert.equal(book.prices['INV-003'].packPriceCents,800);
+  assert.throws(()=>setPrices(data,book,[milk],0));
+});
+
+test('quotes accept explicit supported provenance, while null/null explicitly clears a quote',()=>{
+  for(const source of ['owner_entry','supplier_quote','demo','manual_demo']){
+    const book=setPrices(data,createPricebook(data),[{...milk,source}]);
+    assert.equal(book.prices['INV-003'].source,source);
+  }
+  const cleared=setPrices(data,offered(),[{ingredientId:'INV-003',packQuantity:null,packPriceCents:null,source:'unquoted'}]);
+  assert.equal(cleared.prices['INV-003'],null);
+  assert.equal(cleared.priceRevision,2);
+});
+
+test('invalid quote identifiers, units, money, provenance and ambiguous unknowns fail closed',()=>{
+  for(const quote of [
+    {...milk,ingredientId:'UNKNOWN'}, {...milk,packQuantity:0},
+    {...milk,packQuantity:1.5},{...milk,packQuantity:true},
+    {...milk,packQuantity:'1000'},{...milk,packPriceCents:-1},
+    {...milk,packPriceCents:NaN},{...milk,packPriceCents:Infinity},
+    {...milk,packPriceCents:0.5},{...milk,packPriceCents:false},
+    {...milk,packPriceCents:Number.MAX_SAFE_INTEGER+1},
