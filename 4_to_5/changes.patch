-  [/^(\d{4}-\d{2}-\d{2}) · Estimated drink portions, not unique visitors$/, (m,l)=>select(l,`${m[1]} · Anggaran hidangan minuman, bukan pelawat unik`,`${m[1]} · Porciones de bebida estimadas, no visitantes únicos`)],
-  [/^(\d{4}-\d{2}-\d{2}) · ([\d,.]+) expected drink portions, (\d+) ingredients\. (Live forecast used\.|Simulated weather used\.)$/, (m,l)=>select(l,`${m[1]} · Anggaran ${m[2]} hidangan minuman, ${m[3]} bahan. ${m[4].startsWith('Live')?'Ramalan terkini digunakan.':'Cuaca simulasi digunakan.'}`,`${m[1]} · ${m[2]} porciones previstas, ${m[3]} ingredientes. ${m[4].startsWith('Live')?'Se usa pronóstico actualizado.':'Se usa clima simulado.'}`)],
-  [/^Training uses deterministic synthetic sales and simulated historic weather, from (\d{4}-\d{2}-\d{2}|—) to (\d{4}-\d{2}-\d{2}|—)\. Visitor-date history is generated for this demo and cannot replace real café records\.$/, (m,l)=>select(l,`Latihan menggunakan jualan sintetik deterministik dan cuaca sejarah simulasi, dari ${m[1]} hingga ${m[2]}. Sejarah tarikh pelawat dijana untuk demo dan tidak menggantikan rekod kafe sebenar.`,`El entrenamiento usa ventas sintéticas deterministas y clima histórico simulado, de ${m[1]} a ${m[2]}. El historial de la fecha elegida se genera para esta demo y no sustituye registros reales.`)],
-  [/^(\d+)-day chronological holdout evaluation, describing this synthetic dataset only\.$/, (m,l)=>select(l,`Penilaian mengikut urutan masa selama ${m[1]} hari, hanya menerangkan set data sintetik ini.`,`Evaluación cronológica con ${m[1]} días reservados, válida solo para este conjunto sintético.`)],
-  [/^Closing stock ([\d,.]+) (g|ml|pcs)$/, (m,l)=>select(l,`Stok penutupan ${m[1]} ${units(m[2],l)}`,`Inventario de cierre ${m[1]} ${units(m[2],l)}`)],
-  [/^Forecast use ([\d,.]+) \+ safety stock ([\d,.]+) (g|ml|pcs)$/, (m,l)=>select(l,`Jangkaan penggunaan ${m[1]} + stok keselamatan ${m[2]} ${units(m[3],l)}`,`Uso previsto ${m[1]} + stock de seguridad ${m[2]} ${units(m[3],l)}`)],
-  [/^Confirmed inbound ([\d,.]+) (g|ml|pcs)$/, (m,l)=>select(l,`Stok dalam penghantaran disahkan ${m[1]} ${units(m[2],l)}`,`Entradas confirmadas ${m[1]} ${units(m[2],l)}`)],
