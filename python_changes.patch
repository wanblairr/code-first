+"""BOM facade and nightly scheduling use local state, not old purchase triggers."""
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+from cafe_core import CafeError
+from cafe_service import CafeService, SHANGHAI
+
+BASE = Path(__file__).resolve().parent.parent
+
+
+class BOMServiceTests(unittest.TestCase):
+    def setUp(self):
+        self.scratch = Path(tempfile.gettempdir()).resolve()
+        self.temp = tempfile.TemporaryDirectory(prefix="cafe-bom-service-", dir=self.scratch)
+        self.base = Path(self.temp.name).resolve()
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-service-")
+        self.instant = datetime(2026, 10, 23, 21, tzinfo=SHANGHAI)
+        self.service = CafeService(self.base, clock=lambda: self.instant)
+        self.service.bom_enabled = True
+
+    def tearDown(self):
+        assert self.base.parent == self.scratch and self.base.name.startswith("cafe-bom-service-")
+        self.temp.cleanup()
+
+    def rain(self):
+        return self.service.bom().set_context({"weather_mode":"rain","holiday_mode":"ordinary"})
+
+    def test_missing_legacy_examples_does_not_block_explicit_bom_simulation(self):
+        self.assertFalse(self.service.data_dir.exists())
+        state = self.service.bom_state()
+        self.assertFalse(state["context_ready"])
+        self.assertIsNone(state["active_order_id"])
+        state = self.rain()
+        self.assertTrue(state["context_ready"])
+        self.assertEqual(len(state["data"]["products"]),20)
+        self.assertEqual(self.service.bom().suggest()["proposal"]["target_date"],"2026-10-24")
+        self.assertFalse(self.service.data_dir.exists())
+
+    def test_bom_nightly_schedule_at_22_is_once_and_never_calls_old_trigger_or_runpod(self):
+        self.instant = datetime(2026,10,23,22,5,tzinfo=SHANGHAI)
+        self.rain()
+        with patch.object(self.service,"trigger",side_effect=AssertionError("legacy purchase trigger")), \
+             patch.object(self.service,"start_runpod_review",side_effect=AssertionError("paid review")), \
+             patch.object(self.service,"_cloud",side_effect=AssertionError("cloud scheduler")), \
+             patch.object(self.service,"refresh_weather",side_effect=AssertionError("scenario needs no API")):
+            result = self.service.scheduler_tick(self.instant.astimezone(timezone.utc))
+            self.assertTrue(result["id"].startswith("BOM-PROP-"))
+            self.assertEqual(result["target_date"],"2026-10-24")
+            self.assertIsNone(self.service.scheduler_tick(self.instant))
+        with self.service.store.connect() as db:
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM bom_schedule_days").fetchone()[0],1)
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM schedule_days").fetchone()[0],0)
+            self.assertEqual(db.execute("SELECT COUNT(*) FROM proposals").fetchone()[0],0)
+        self.assertEqual(sum(e["action"]=="bom_scheduled_trigger_completed"
+                             for e in self.service.bom_state()["events"]),1)
+
+    def test_before_local_22_scheduler_does_nothing_even_with_bom_enabled(self):
+        self.rain()
+        self.instant = datetime(2026,10,23,13,59,tzinfo=timezone.utc)
+        with patch.object(self.service,"bom_scheduler_tick",side_effect=AssertionError("too early")), \
+             patch.object(self.service,"trigger",side_effect=AssertionError("legacy trigger")):
+            self.assertIsNone(self.service.scheduler_tick(self.instant))
+        self.assertFalse(self.service.bom_state()["proposals"])
+
+    def test_scheduler_restart_same_day_keeps_durable_once_guard(self):
+        self.instant = datetime(2026,10,23,22,1,tzinfo=SHANGHAI)
+        self.rain()
+        first = self.service.scheduler_tick()
+        restarted = CafeService(self.base, clock=lambda:self.instant)
+        restarted.bom_enabled = True
+        with patch.object(restarted,"trigger",side_effect=AssertionError("old trigger")), \
+             patch.object(restarted,"refresh_weather",side_effect=AssertionError("already scheduled")):
+            self.assertIsNone(restarted.scheduler_tick())
+        self.assertEqual(len(restarted.bom_state()["proposals"]),1)
+        self.assertEqual(restarted.bom_state()["proposal"]["id"],first["id"])
+
+    def test_bom_external_transport_adapter_rechecks_real_approval_and_stock(self):
+        self.rain()
+        application = self.service.bom()
+        proposal = application.suggest()["proposal"]
+        values = {"proposal_id":proposal["id"],"revision":proposal["revision"],
+                  "input_hash":proposal["input_hash"],"quantities":{},"acknowledged":False}
+        approved = application.approve(values)
+        draft = approved["orders"][0]["drafts"][0]
+        resolved, order = self.service.bom_approved_draft(draft["id"])
+        self.assertEqual(resolved["id"],draft["id"])
+        self.assertEqual(order["id"],approved["active_order_id"])
+        self.assertTrue(all(item["pack_size"]>=1 for item in order["items"]))
+        application.sale({"productId":"BV-013","size":"中杯","quantity":1,"revision":0,"request_id":"transport-stale"})
+        with self.assertRaises(CafeError):
+            self.service.bom_approved_draft(draft["id"])
+
+
+if __name__=="__main__":
+    unittest.main()
