-  [/^Remaining shortfall after reduction: ([\d,.]+) (g|ml|pcs)$/, (m,l)=>select(l,`Baki kekurangan selepas pengurangan: ${m[1]} ${units(m[2],l)}`,`Déficit restante tras reducir: ${m[1]} ${units(m[2],l)}`)],
-  [/^(\d+) ingredients · ([\d,.]+) supplier packs in total$/, (m,l)=>select(l,`${m[1]} bahan · Jumlah ${m[2]} pek pembekal`,`${m[1]} ingredientes · ${m[2]} paquetes del proveedor en total`)],
-  [/^(\d+) suppliers · Not sent$/, (m,l)=>select(l,`${m[1]} pembekal · Belum dihantar`,`${m[1]} proveedores · No enviado`)],
-  [/^Your \.(eml|txt) download is ready\. Check the browser’s downloads list\.$/, (m,l)=>select(l,`Muat turun .${m[1]} sedia. Semak senarai muat turun pelayar.`,`Tu descarga .${m[1]} está lista. Consulta las descargas del navegador.`)],
-  [/^\[Demo purchase draft\] Café replenishment for (\d{4}-\d{2}-\d{2})$/, (m,l)=>select(l,`[Draf pembelian demo] Penambahan stok kafe untuk ${m[1]}`,`[Borrador de compra de demo] Reabastecimiento del café para ${m[1]}`)],
-  [/^Select a demo date after the training end date, (\d{4}-\d{2}-\d{2})\.$/, (m,l)=>select(l,`Pilih tarikh demo selepas tarikh akhir latihan, ${m[1]}.`,`Elige una fecha de demo posterior al fin del entrenamiento, ${m[1]}.`)],
-  [/^The (temperature|precipitation) value is invalid\.$/, (m,l)=>select(l,`Nilai ${m[1]==='temperature'?'suhu':'hujan'} tidak sah.`,`El valor de ${m[1]==='temperature'?'temperatura':'precipitación'} no es válido.`)],
-  [new RegExp(`^${names} stock is invalid\\.$`),(m,l)=>select(l,`Stok ${units(m[1],l)} tidak sah.`,`El inventario de ${units(m[1],l)} no es válido.`)],
-  [new RegExp(`^${names} pack quantity must be a whole number from 0 to 10,000\\.$`),(m,l)=>select(l,`Bilangan pek ${units(m[1],l)} mestilah nombor bulat dari 0 hingga 10,000.`,`La cantidad de paquetes de ${units(m[1],l)} debe ser un entero entre 0 y 10.000.`)],
-  [new RegExp(`^${names} is below the minimum order quantity\\.$`),(m,l)=>select(l,`${units(m[1],l)} kurang daripada kuantiti pesanan minimum.`,`${units(m[1],l)} está por debajo del pedido mínimo.`)],
-  [new RegExp(`^${names} exceeds the single-order limit\\.$`),(m,l)=>select(l,`${units(m[1],l)} melebihi had satu pesanan.`,`${units(m[1],l)} supera el límite por pedido.`)],
-  [new RegExp(`^${names} would exceed storage capacity on arrival\\.$`),(m,l)=>select(l,`${units(m[1],l)} akan melebihi kapasiti storan semasa ketibaan.`,`${units(m[1],l)} superaría la capacidad al llegar.`)],
-  [new RegExp(`^${names} still has a shortfall of ${num} (g|ml|pcs); a stockout is possible\\.$`),(m,l)=>select(l,`${units(m[1],l)} masih kurang ${m[2]} ${units(m[3],l)}; stok mungkin kehabisan.`,`${units(m[1],l)} aún tiene un déficit de ${m[2]} ${units(m[3],l)}; podría agotarse.`)],
-  [new RegExp(`^${names} \\((g|ml|pcs)\\)$`),(m,l)=>`${units(m[1],l)} (${units(m[2],l)})`],
-  [new RegExp(`^${names} demo closing stock$`),(m,l)=>select(l,`Stok penutupan demo ${units(m[1],l)}`,`Inventario de cierre de demo de ${units(m[1],l)}`)],
-  [new RegExp(`^(Decrease|Increase) ${names} packs$`),(m,l)=>select(l,`${m[1]==='Decrease'?'Kurangkan':'Tambah'} pek ${units(m[2],l)}`,`${m[1]==='Decrease'?'Reducir':'Aumentar'} paquetes de ${units(m[2],l)}`)],
-  [new RegExp(`^${names} pack quantity$`),(m,l)=>select(l,`Bilangan pek ${units(m[1],l)}`,`Cantidad de paquetes de ${units(m[1],l)}`)],
