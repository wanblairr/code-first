+@media(max-width:800px){#bom-root .bom-controls{grid-template-columns:1fr 1fr}#bom-root .bom-controls label:first-child{grid-column:1/-1}#bom-root .bom-controls>.button{grid-column:1/-1}#bom-root .bom-stock-grid{grid-template-columns:1fr 1fr}}
+@media(max-width:520px){#bom-root .section-top{flex-direction:column;align-items:stretch}#bom-root .soft-badge{align-self:flex-start}#bom-root .bom-sale-card{padding:16px}#bom-root .bom-proposal-line{grid-template-columns:1fr}#bom-root .bom-recommended{text-align:left}#bom-root .bom-adjust label{margin-left:0}#bom-root .bom-demand-grid{grid-template-columns:1fr}#bom-root .bom-draft{padding:15px}#bom-root .bom-draft-actions button{width:100%}#bom-root .audit-log li{grid-template-columns:1fr;gap:2px}}
+
+#bom-root .audit-log li.bom-approved-log{display:block;color:#167443}#bom-root .audit-log li.bom-approved-log p{color:inherit;font-weight:600}
+
