diff --git a/public_site/dist/demo/engine.js b/public_site/dist/demo/engine.js
new file mode 100644
index 0000000000000000000000000000000000000000..0627e912b7262fd7f1f3b2369f0d68c15a58dc2e
--- /dev/null
+++ b/public_site/dist/demo/engine.js
@@ -0,0 +1,241 @@
+import {lineCost, sumCosts, formatMoney} from './catalog.js';
+/* Pure public demonstration engine. No DOM, credentials, account or persistence. */
+const DAY = 86400000;
+const SKU_NAMES = { espresso: '意式浓缩', latte: '拿铁', oat_latte: '燕麦拿铁' };
+const round6 = n => Math.round(n * 1e6) / 1e6;
+const mean = values => values.reduce((sum, value) => sum + value, 0) / values.length;
+
+export class DemoFreshnessError extends Error {
+  constructor(code, message) { super(message); this.name = 'DemoFreshnessError'; this.code = code; }
+}
+
+function targetFreshness(targetDate, nowMs) {
+  const target = parseDay(targetDate);
+  if (!Number.isFinite(nowMs)) throw new DemoFreshnessError('INVALID_CLOCK', '当前时间不可用，请检查设备时间。');
+  const today = new Date(nowMs + 8 * 3600000).toISOString().slice(0, 10);
+  if (targetDate <= today) throw new DemoFreshnessError('STALE_TARGET', '采购目标日已到达或已过期，请选择吉隆坡明天或之后的日期并重新生成建议。');
+  return (target - parseDay(today)) / DAY;
+}
+
+function parseDay(value) {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) throw new Error('日期须为 YYYY-MM-DD。');
+  const result = new Date(`${value}T00:00:00Z`);
+  if (!Number.isFinite(result.getTime()) || result.toISOString().slice(0, 10) !== value) throw new Error('日期无效。');
+  return result;
+}
+function dayText(value) { return value.toISOString().slice(0, 10); }
+function addDays(value, days) { return new Date(value.getTime() + days * DAY); }
+function weekday(value) { return (value.getUTCDay() + 6) % 7; }
+function number(value, label, min = 0, max = 1e9) {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value < min || value > max) throw new Error(`${label}数值无效。`);
+  return value;
+}
+
+export async function loadModel(url = new URL('./model.json', import.meta.url)) {
+  const response = await fetch(url, { credentials: 'omit', referrerPolicy: 'no-referrer' });
+  if (!response.ok) throw new Error('演示模型暂时无法加载，请刷新重试。');
+  const model = await response.json();
+  if (model?.schemaVersion !== 1 || model?.dataSource !== 'synthetic' || !model.models || !Array.isArray(model.inventory)) throw new Error('演示模型格式无效。');
+  return model;
+}
+
+export function createInitialInventory(model) {
+  return Object.fromEntries(model.inventory.map(item => [item.ingredient_id, item.initial_stock]));
+}
+
+export function holidayContext(date, model) {
+  parseDay(date);
+  const calendar = model.calendar;
+  const base = { date, coverageStart: calendar.coverage_start, coverageEnd: calendar.coverage_end,
+    verifiedAsOf: calendar.verified_as_of, sourceUrl: calendar.sources.annual.url,
+    scope: calendar.scope, location: calendar.location };
+  if (date < calendar.coverage_start || date > calendar.coverage_end) return { ...base, known: false, isHoliday: null, name: '此年份假日日历尚未核验', status: 'outside_coverage', notes: '请选择普通日或公共假日模拟情景；未知不能当作非假日。' };
+  const found = calendar.holidays.find(row => row.date === date);
+  if (found) return { ...base, known: found.verified === true && typeof found.is_holiday === 'boolean', isHoliday: found.is_holiday,
+    name: found.holiday_name, status: found.status, notes: found.notes,
+    sources: found.source_ids.map(id => calendar.sources[id]).filter(Boolean) };
+  return { ...base, known: true, isHoliday: false, name: '已核验日历中的普通日', status: 'ordinary', notes: '周末客流由星期特征单独计算；不将学校假期、雪兰莪假日或门店轮休混为吉隆坡公共假日。' };
+}
+
+class Random {
+  constructor(seed) { this.value = seed >>> 0; }
+  uniform() { let x = this.value; x ^= x << 13; x ^= x >>> 17; x ^= x << 5; this.value = x >>> 0; return this.value / 4294967296; }
+  noise() { let sum = 0; for (let i = 0; i < 6; i++) sum += this.uniform(); return sum - 3; }
+}
+
+export function generateSyntheticHistory(targetDate, model) {
+  const target = parseDay(targetDate), start = addDays(target, -180), rng = new Random(model.seed);
+  const rows = [], weekly = [.92, .96, .99, 1.03, 1.12, 1.32, 1.20];
+  for (let index = 0; index < 180; index++) {
+    const day = addDays(start, index), text = dayText(day);
+    const h = holidayContext(text, model).isHoliday === true;
+    const temperature = Math.round((26 + rng.uniform() * 7) * 1000) / 1000;
+    const rain = Math.round((rng.uniform() < .42 ? 0 : rng.uniform() * 32) * 1000) / 1000;
+    const latentTemperature = temperature + rng.noise() * .7;
+    const latentRain = Math.max(0, rain + rng.noise() * 2.5);
+    for (const [sku, base, slope, thermal, wet, boost] of [
+      ['espresso', 58, .035, .8, -.70, 14], ['latte', 76, .045, 1.3, -.95, 20], ['oat_latte', 34, .065, 1.6, -.60, 12],
+    ]) {
+      const demand = (base + slope * index) * weekly[weekday(day)] + thermal * (latentTemperature - 29) + wet * latentRain + (h ? boost - .15 * latentRain : 0) + rng.noise() * 4.2;
+      const stockout = index % 67 === 41 && sku === 'oat_latte';
+      let units = Math.max(0, Math.floor(demand + .5));
+      if (stockout) units = Math.floor(units * .65 + .5);
+      rows.push({ date: text, sku, units, stockout, closed: false });
+    }
+  }
+  return rows;
+}
+
+function baseline(rows, target, algorithm) {
+  const valid = rows.filter(row => !row.stockout && !row.closed);
+  if (algorithm === 'previous_observed') return valid.at(-1).units;
+  const same = valid.filter(row => weekday(parseDay(row.date)) === weekday(target)).slice(-4);
+  return mean((same.length ? same : valid.slice(-7)).map(row => row.units));
+}
+function features(rows, target, context, contextual) {
+  const valid = rows.filter(row => !row.stockout && !row.closed && parseDay(row.date) < target);
+  const recent = days => {
+    const cutoff = dayText(addDays(target, -days));
+    const values = valid.filter(row => row.date >= cutoff).map(row => row.units);
+    return mean(values.length ? values : [valid.at(-1).units]);
+  };
+  const x = [1, ...Array.from({ length: 6 }, (_, i) => Number(weekday(target) === i + 1)),
+    (target - parseDay(rows[0].date)) / DAY / 7, valid.at(-1).units,
+    baseline(valid, target, 'weekday_mean'), recent(7), recent(28)];
+  return contextual ? [...x, context.temperature, context.rain, Number(context.holiday), 0,
+    context.temperature * Number(context.holiday), context.rain * Number(context.holiday)] : x;
+}
+function estimate(spec, rows, target, context) {
+  if (!/^(context|legacy):/.test(spec.algorithm)) return baseline(rows, target, spec.algorithm);
+  const x = features(rows, target, context, spec.algorithm.startsWith('context:'));
