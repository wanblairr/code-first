+    // Exact published names are populated separately by the UI's holidayLabel;
+    // date matching here is deliberately not used to rewrite arbitrary text.
+    if (text === `${date} 公共假日`) return `${date} · ${english}`;
+  }
+  return null;
+}
+
+const ERROR_CODES = Object.freeze({
+  STALE_TARGET: 'The target date has arrived or passed. Choose tomorrow or later in Kuala Lumpur and generate a new suggestion.',
+  STALE_WEATHER: 'The live forecast is over 24 hours old. Refresh the weather and generate a new suggestion.',
+  INVALID_WEATHER_TIME: 'The live forecast timestamp is invalid. Refresh it and generate a new suggestion.',
+  WEATHER_DATE_MISMATCH: 'The weather date does not match the target date. Refresh it or explicitly choose a simulation.',
+  WEATHER_TARGET_OUT_OF_RANGE: 'Live weather supports tomorrow through the next 15 days in Kuala Lumpur. Choose an available date or an explicit simulation.',
+  INVALID_WEATHER_SOURCE: 'The weather source is invalid. Refresh it or explicitly choose a simulation.',
+  INVALID_CLOCK: 'The current time is unavailable. Check the device clock.',
+});
+export function bilingualError(error) {
+  return ERROR_CODES[error?.code] || translateText(typeof error === 'string' ? error : error?.message) || 'This action could not be completed. Review the original message below.';
+}
+
+function approvedDraftLines(draft) {
+  if (Array.isArray(draft.lines)) return draft.lines.map(line => ({
+    english: INGREDIENTS[line.ingredientId] ? ingredientName(line.ingredientId) : String(line.name || 'Ingredient'), packs: String(line.approvedPacks), pack: packName(line.packUnit, line.approvedPacks),
+    size: String(line.packSize), unit: line.unit, quantity: String(line.quantity), shortfall: line.remainingShortage, unitPriceCents: line.unitPriceCents, lineTotalCents: line.lineTotalCents,
+  }));
+  // Old approved snapshots have no structured lines. Only parse the initial
+  // contiguous block in the engine's exact known format, never a free-text note.
+  const original = typeof draft.body === 'string' ? draft.body.split('\n') : [];
+  const start = original.findIndex(line => line.startsWith('- '));
+  if (start < 0) return [];
+  const result = [];
+  for (const line of original.slice(start)) {
+    const match = line.match(/^- (咖啡豆|牛奶|燕麦奶|外带杯)：(\d+) (袋|盒|包) × ([\d.]+) (g|ml|pcs)，共 ([\d.]+) (g|ml|pcs)$/);
+    if (!match) break;
+    result.push({english:nameFromChinese(match[1]),packs:match[2],pack:packName(match[3], match[2]),size:match[4],unit:match[5],quantity:match[6]});
+  }
+  return result;
+}
+
+
+function draftMoney(value) { return Number.isSafeInteger(value) && value >= 0 ? 'MYR ' + (value / 100).toFixed(2) : 'unconfirmed'; }
+function approvedLineMoney(line) {
+  const packs = Number(line.packs), price = line.unitPriceCents, total = line.lineTotalCents;
+  return Number.isSafeInteger(packs) && packs > 0 && Number.isSafeInteger(price) && price >= 0 && Number.isSafeInteger(packs * price) && total === packs * price
+    ? {price, total} : {price:null, total:null};
+}
+
+export function formatBilingualDraft(draft, {targetDate, ownerNote} = {}) {
+  if (!draft || typeof draft !== 'object') return 'Demo purchase draft unavailable.';
+  const date = /^\d{4}-\d{2}-\d{2}$/.test(targetDate || '') ? targetDate : String(draft.subject || '').match(/\d{4}-\d{2}-\d{2}/)?.[0];
