+const ORIGIN = 'https://www.cafe-replenishment-demo.com';
+const TOKEN = 'synthetic_access_token_do_not_use_20261022';
+const CREDENTIALS = {api_version: 'v23.0', phone_number_id: '123456789012345',
+  business_account_id: '987654321098765', access_token: TOKEN};
+const BASE = {credentials: CREDENTIALS, recipient: '60123456789', template: {name: 'cafe_purchase', language: 'en_US'},
+  parameters: ['2026-10-23', 'DEMO-20261023-test001', 'Fresh milk 18 cartons; oat milk 8 cartons'],
