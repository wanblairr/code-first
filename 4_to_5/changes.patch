+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {initialStock, usage, sell, lowStock, replenish} from '../dist/demo/bom-core.mjs';
+
+const data = JSON.parse(await readFile(new URL('../dist/demo/bom-data.json', import.meta.url), 'utf8'));
+const tomorrow = [
+  {productId:'BV-003', size:'中杯', quantity:20},
+  {productId:'BV-013', size:'中杯', quantity:20},
+];
+const row = (stock, id, sales = tomorrow) => replenish(data, stock, sales).find(r => r.id === id);
+
+// Independent expected amounts transcribed from the supplied 33-column CSV.
+// This verifies every product and both beverage sizes, not only sample latte IDs.
+const beverages = {
+  'BV-002': [['INV-001',18,20],['INV-003',150,200]],
+  'BV-003': [['INV-001',18,20],['INV-003',200,270],['AUX-ICE',80,100]],
+  'BV-004': [['INV-001',18,20],['INV-003',160,210]],
+  'BV-005': [['INV-001',18,20],['INV-003',190,260],['INV-010',15,20],['AUX-ICE',80,100]],
+  'BV-006': [['INV-001',18,20],['INV-003',190,260],['INV-007',10,15],['AUX-ICE',80,100]],
+  'BV-010': [['INV-001',18,20],['INV-003',190,260],['INV-008',10,15],['AUX-ICE',80,100]],
+  'BV-011': [['INV-001',18,20],['INV-004',200,270],['AUX-ICE',80,100]],
+  'BV-013': [['INV-001',18,20],['INV-005',150,200]],
+  'BV-015': [['INV-001',18,20],['INV-021',180,240],['AUX-ICE',80,100]],
+  'BV-016': [['INV-001',18,20],['INV-018',30,40],['AUX-COLD',100,140],['AUX-ICE',80,100]],
+  'BV-017': [['INV-001',22,28],['AUX-COLD',200,260],['AUX-ICE',60,80]],
+  'BV-020': [['INV-009',10,15],['INV-012',5,6],['INV-019',25,35],['AUX-COLD',150,200],['AUX-ICE',80,100]],
+  'BV-022': [['INV-003',180,240],['INV-015',60,80],['AUX-ICE',80,100]],
+  'BV-023': [['INV-001',18,20],['INV-016',50,70],['INV-021',120,160],['AUX-ICE',80,100]],
+  'BV-024': [['INV-003',220,290],['INV-010',25,35]],
+};
+const bakery = ['BK-01','BK-02','BK-05','BK-06','BK-08'];
+
+test('includes all 20 CSV products and all 19 supplied safety thresholds', () => {
+  assert.equal(Object.keys(data.products).length, 20);
+  assert.equal(Object.keys(data.materials).length, 21);
+  assert.equal(Object.values(data.materials).filter(m=>m.safety !== null).length,19);
+  assert.deepEqual(new Set(Object.keys(data.products)),new Set([...Object.keys(beverages),...bakery]));
+  assert.equal(data.materials['INV-003'].safety,51200);
+  assert.equal(data.materials['INV-005'].safety,2800);
+  assert.equal(data.materials['INV-003'].initial,60000);
+  assert.equal(data.materials['INV-005'].initial,8000);
+  for (const [id,m] of Object.entries(data.materials)) {
+    if (m.safety !== null && !['INV-003','INV-005'].includes(id))
+      assert.equal(m.initial,2*m.safety);
+  }
+});
+
+for (const [productId, recipe] of Object.entries(beverages)) {
+  for (const [size,index] of [['中杯',1],['大杯',2]]) {
+    test(productId+' '+size+' deducts every CSV ingredient', () => {
+      const expected = Object.fromEntries(recipe.map(parts=>[parts[0],parts[index]*2]));
+      const sale={productId,size,quantity:2};
+      assert.deepEqual(usage(data,[sale]), expected);
+      const before=initialStock(data);
+      const original=structuredClone(before);
+      const after=sell(data,before,sale);
+      for (const id of Object.keys(before)) assert.equal(after[id],before[id]-(expected[id]||0));
+      assert.deepEqual(before,original);
+    });
+  }
+}
+for (const productId of bakery) {
+  test(productId+' deducts finished goods, not invented flour recipes', () => {
+    assert.deepEqual(usage(data,[{productId,size:'份',quantity:3}]),{[productId]:3});
+    const before=initialStock(data);
+    const after=sell(data,before,{productId,size:'份',quantity:3});
+    assert.equal(after[productId],before[productId]-3);
+    assert.equal(after['INV-001'],before['INV-001']);
+  });
+}
+
+test('36 medium oat flat whites: 8000 -> 2600 ml, warning and recommendation 3200 ml',()=>{
+  const after=sell(data,initialStock(data),{productId:'BV-013',size:'中杯',quantity:36});
+  assert.equal(after['INV-005'],2600);
+  assert.ok(lowStock(data,after).includes('INV-005'));
+  assert.equal(row(after,'INV-005').quantity,3200);
+  assert.equal(row(after,'INV-005').tomorrow,3000);
+});
+
+test('50 medium lattes: milk 60000 -> 50000 ml and recommendation 5200 ml',()=>{
+  const after=sell(data,initialStock(data),{productId:'BV-003',size:'中杯',quantity:50});
+  assert.equal(after['INV-003'],50000);
+  assert.equal(after['AUX-ICE'],6000);
+  assert.ok(lowStock(data,after).includes('INV-003'));
+  assert.equal(row(after,'INV-003').quantity,5200);
+});
+
+test('stock exactly at safety is not below; next sale triggers warning',()=>{
+  const stock=initialStock(data);
+  stock['INV-005']=2950;
+  const equal=sell(data,stock,{productId:'BV-013',size:'中杯',quantity:1});
+  assert.equal(equal['INV-005'],2800);
+  assert.ok(!lowStock(data,equal).includes('INV-005'));
+  assert.ok(lowStock(data,sell(data,equal,{productId:'BV-013',size:'中杯',quantity:1})).includes('INV-005'));
+});
+
+test('oversale checks the whole recipe atomically; no partial beans deduction',()=>{
+  const stock=initialStock(data);
+  stock['INV-005']=100;
+  const snapshot=structuredClone(stock);
+  assert.throws(()=>sell(data,stock,{productId:'BV-013',size:'中杯',quantity:1}),/库存不足/);
+  assert.deepEqual(stock,snapshot);
+});
+
+test('a depleted unthresholded ice ingredient still prevents oversale',()=>{
+  const stock=initialStock(data);
+  stock['AUX-ICE']=79;
+  const snapshot=structuredClone(stock);
+  assert.throws(()=>sell(data,stock,{productId:'BV-003',size:'中杯',quantity:1}),/库存不足/);
+  assert.deepEqual(stock,snapshot);
+});
+
+test('bakery crossing safety and forecasting uses individual finished items',()=>{
+  const after=sell(data,initialStock(data),{productId:'BK-01',size:'份',quantity:36});
+  assert.equal(after['BK-01'],34);
+  assert.ok(lowStock(data,after).includes('BK-01'));
+  assert.equal(row(after,'BK-01',[{productId:'BK-01',size:'份',quantity:10}]).quantity,11);
+});
+
+test('multiple products aggregate demand before adding the safety threshold once',()=>{
+  const stock=initialStock(data);
+  stock['INV-003']=51200;
+  const sales=[
+    {productId:'BV-003',size:'中杯',quantity:20},
+    {productId:'BV-024',size:'中杯',quantity:10},
+  ];
+  assert.equal(row(stock,'INV-003',sales).tomorrow,6200);
+  assert.equal(row(stock,'INV-003',sales).quantity,6200);
+});
+
+test('recommendation is clamped at zero and never mutates stock',()=>{
+  const stock=initialStock(data), before=structuredClone(stock);
+  assert.equal(row(stock,'INV-003').quantity,0);
+  assert.equal(row(stock,'INV-005').quantity,0);
+  assert.deepEqual(stock,before);
+});
+
+test('water and ice retain null thresholds and never become automatic purchase lines',()=>{
+  const stock=initialStock(data);
+  stock['AUX-COLD']=0;
+  stock['AUX-ICE']=0;
+  assert.equal(data.materials['AUX-COLD'].safety,null);
+  assert.equal(data.materials['AUX-ICE'].safety,null);
+  assert.ok(!lowStock(data,stock).some(id=>id.startsWith('AUX-')));
+  assert.ok(!replenish(data,stock,tomorrow).some(r=>r.id.startsWith('AUX-')));
+});
+
+test('unknown product, wrong size, fractions, nonnumeric and overflow quantities fail',()=>{
+  for (const sale of [
+    null, {productId:'NO-SKU',size:'中杯',quantity:1},
+    {productId:'BV-013',size:'份',quantity:1},
+    ...[-1,0,1.5,'2',NaN,Infinity,Number.MAX_SAFE_INTEGER].map(quantity=>
+      ({productId:'BV-013',size:'中杯',quantity})),
+  ]) assert.throws(()=>sell(data,initialStock(data),sale));
+  assert.throws(()=>usage(data,[{productId:'constructor',size:'prototype',quantity:1}]));
+});
+
+test('invalid stock or threshold is rejected rather than hiding warning',()=>{
+  for (const value of [-1,1.5,NaN,'8000',undefined]) {
+    const stock={...initialStock(data),'INV-005':value};
+    assert.throws(()=>lowStock(data,stock));
+    assert.throws(()=>replenish(data,stock,tomorrow));
+  }
+  const broken=structuredClone(data);
+  broken.materials['INV-005'].safety=undefined;
+  assert.throws(()=>lowStock(broken,initialStock(data)));
+});
+
+test('nonzero unmapped, empty or negative recipes fail closed',()=>{
+  for (const recipe of [{'NO-MATERIAL':1},{},{'INV-001':-1},{'INV-001':1.5}]) {
+    const broken=structuredClone(data);
+    broken.products['BV-013'].recipes['中杯']=recipe;
+    assert.throws(()=>usage(broken,[{productId:'BV-013',size:'中杯',quantity:1}]));
+  }
+});
