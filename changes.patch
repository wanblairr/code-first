+"""Price-book binding through real BOM proposals, approvals and provider gates.
+
+All state is temporary SQLite; external transports are never contacted.
+"""
+from copy import deepcopy
+from datetime import datetime
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from cafe_bom import MAX_SAFE
+from cafe_core import CafeError
+from cafe_service import CafeService, SHANGHAI
+
+
+def quote(key, cents, pack=1000):
+    return {'ingredient_id': key, 'pack_quantity': pack,
+            'pack_price_cents': cents, 'currency': 'MYR', 'source': 'demo'}
+
+
+class BOMPriceBindingTests(unittest.TestCase):
+    def setUp(self):
+        self.environment = patch.dict(os.environ, {}, clear=True)
+        self.environment.start()
+        self.addCleanup(self.environment.stop)
+        network = patch('urllib.request.OpenerDirector.open',
+                        side_effect=AssertionError('pricing test attempted external API'))
+        network.start()
+        self.addCleanup(network.stop)
+        temporary = tempfile.TemporaryDirectory(prefix='bom-price-binding-', dir=tempfile.gettempdir())
+        self.addCleanup(temporary.cleanup)
+        self.service = CafeService(Path(temporary.name),
+            clock=lambda: datetime(2026, 10, 23, 21, tzinfo=SHANGHAI))
+        self.addCleanup(self.service.stop.set)
+        self.app = self.service.bom()
+        self.app.set_context({'weather_mode': 'rain', 'holiday_mode': 'ordinary'})
+        state = self.app.state()
+        self.app.sale({'productId': 'BV-013', 'size': '中杯', 'quantity': 36,
+            'revision': state['revision'], 'request_id': 'price-binding-sale'})
+        self.stock = deepcopy(self.app.state()['stock'])
+
+    def prices(self, cents=800):
+        state = self.app.state()
+        return self.app.set_prices({'revision': state['pricing']['revision'],
+            'entries': [quote('INV-003', cents), quote('INV-005', 1200)]})
+
+    def proposal(self):
+        return self.app.suggest()['proposal']
+
+    def values(self, proposal, quantities=None):
+        return {'proposal_id': proposal['id'], 'revision': proposal['revision'],
+            'input_hash': proposal['input_hash'], 'quantities': quantities or {}, 'acknowledged': True}
+
+    def approve(self, proposal, quantities=None):
+        result = self.app.approve(self.values(proposal, quantities))
+        order = next(order for order in result['orders'] if order['id'] == result['active_order_id'])
+        return result, order, order['drafts'][0]
+
+    def test_initialization_and_same_connection_state_read_share_one_pricebook(self):
+        self.assertEqual(self.app.pricing.state(), self.app.repo.pricing.state())
+        with self.service.store.connect() as db:
+            state = self.app.repo._state(db)
+            self.assertEqual(state['pricebook'], self.app.pricing._state(db))
+            self.assertEqual(db.execute('SELECT COUNT(*) FROM bom_pricebook').fetchone()[0], 1)
+
+    def test_price_update_binds_input_hash_and_supersedes_old_pending_proposal(self):
+        first = self.proposal()
+        self.prices()
+        old = self.app.repo.proposal(first['id'])
+        self.assertEqual(old['status'], 'superseded')
+        with self.assertRaises(CafeError):
+            self.app.preview(self.values(first))
+        with self.assertRaises(CafeError):
+            self.app.approve(self.values(first))
+        second = self.proposal()
+        self.assertNotEqual(second['input_hash'], first['input_hash'])
+        self.assertEqual(second['stock_revision'], first['stock_revision'])
+        self.assertEqual(second['forecast'], first['forecast'])
+        self.assertEqual(second['pricebook']['price_revision'], 1)
+        self.assertEqual({row['id']: row['quantity'] for row in second['rows']},
