+    {type: 'FOOTER', text: 'Please confirm availability.'}]};
+
+class FakeStore {
+  constructor() { this.entries = new Map(); this.writes = []; this.revision = 0; }
+  async setJSON(key, value, condition) {
+    this.writes.push({key, value: structuredClone(value), condition});
+    const old = this.entries.get(key);
+    if ((condition.onlyIfNew && old) || (condition.onlyIfMatch && old?.etag !== condition.onlyIfMatch)) return {modified: false};
+    const etag = `"revision-${++this.revision}"`;
+    this.entries.set(key, {data: structuredClone(value), etag});
+    return {modified: true, etag};
+  }
+  async getWithMetadata(key, options) {
+    assert.equal(options.consistency, 'strong');
+    const entry = this.entries.get(key); return entry ? structuredClone(entry) : null;
+  }
+}
+
+function harness({template = structuredClone(ROW), store = new FakeStore(), sendResponse, phoneResponse,
+  templateResponse, thrownSend, storeError = false} = {}) {
+  const calls = [];
+  const fetchImpl = async (url, options) => {
+    calls.push({url, method: options.method, options});
+    assert.ok(url.startsWith('https://graph.facebook.com/v23.0/'));
+    assert.equal(options.redirect, 'error'); assert.equal(options.headers.Authorization, 'Bearer ' + TOKEN);
+    assert.ok(options.signal instanceof AbortSignal);
+    if (url.includes('/messages')) {
+      if (thrownSend) throw new Error('synthetic network error ' + TOKEN);
+      return sendResponse?.() ?? Response.json({messaging_product: 'whatsapp', messages: [{id: 'wamid.synthetic_accepted_id'}]});
+    }
+    if (url.includes('/message_templates')) return templateResponse?.() ?? Response.json({data: [template]});
+    return phoneResponse?.() ?? Response.json({id: CREDENTIALS.phone_number_id, display_phone_number: '+60 100 000 000', verified_name: 'Synthetic test café'});
