+CLIENT_ID = "1234-cafe-test.apps.googleusercontent.com"
+CLIENT_SECRET = "test-client-secret"
+REDIRECT = "http://127.0.0.1:8770" + CALLBACK_PATH
+STATE = "S" * 43
+VERIFIER = "V" * 86
+ACCESS = "test-access-token"
+REFRESH = "test-refresh-token"
+CODE = "test-authorization-code"
+
+
+def token_result(**changes):
+    result = {"access_token": ACCESS, "refresh_token": REFRESH, "expires_in": 3600,
+              "token_type": "Bearer", "scope": COMPOSE_SCOPE}
+    result.update(changes)
+    return result
+
+
+class Response:
+    def __init__(self, result=None, *, raw=None, status=200, url=TOKEN_URL):
+        self.raw = json.dumps(token_result() if result is None else result).encode() if raw is None else raw
+        self.status, self.url = status, url
+        self.closed = False
+        self.read_sizes = []
+
+    def getcode(self):
+        return self.status
+
+    def geturl(self):
+        return self.url
+
+    def read(self, size):
+        self.read_sizes.append(size)
+        return self.raw[:size]
+
+    def close(self):
+        self.closed = True
+
+
+class Opener:
+    def __init__(self, *responses):
+        self.responses = list(responses)
+        self.calls = []
+
+    def open(self, req, timeout):
+        self.calls.append((req, timeout))
+        result = self.responses.pop(0)
+        if isinstance(result, BaseException):
+            raise result
+        return result
+
+
+class OAuthTest(unittest.TestCase):
+    def client(self, *responses, **kwargs):
+        opener = Opener(*responses)
+        return GmailOAuthClient(CLIENT_ID, CLIENT_SECRET, opener=opener, clock=lambda: 1000, **kwargs), opener
+
+    def assert_error(self, action, expected, *, unknown=None):
+        with self.assertRaises(GmailOAuthError) as caught:
+            action()
+        self.assertEqual(caught.exception.code, expected)
+        if unknown is not None:
+            self.assertEqual(caught.exception.outcome_unknown, unknown)
+        return caught.exception
+
+    def exchange(self, client):
+        return client.exchange_code(CODE, REDIRECT, VERIFIER)
+
+    def test_authorization_uses_only_compose_offline_consent_and_pkce(self):
+        client, _ = self.client()
+        url = client.authorization_url(REDIRECT, STATE, VERIFIER)
+        parts = parse.urlsplit(url)
+        self.assertEqual(parts.scheme + "://" + parts.netloc + parts.path, AUTHORIZATION_URL)
+        params = parse.parse_qs(parts.query)
+        self.assertEqual(set(params), {"client_id", "redirect_uri", "response_type", "scope", "access_type",
+                                      "prompt", "state", "code_challenge", "code_challenge_method"})
+        for name, value in {"client_id": CLIENT_ID, "redirect_uri": REDIRECT, "response_type": "code",
+                            "scope": COMPOSE_SCOPE, "access_type": "offline", "prompt": "consent",
+                            "state": STATE, "code_challenge_method": "S256"}.items():
+            self.assertEqual(params[name], [value])
+        challenge = base64.urlsafe_b64encode(hashlib.sha256(VERIFIER.encode()).digest()).rstrip(b"=").decode()
+        self.assertEqual(params["code_challenge"], [challenge])
+        self.assertNotIn(VERIFIER, url)
+        self.assertNotIn(CLIENT_SECRET, url)
