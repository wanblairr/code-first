@@ -0,0 +1,145 @@
+"""Bounded transport-only handling of rejected POST bodies; no socket is opened."""
+import io
+import unittest
+from email.message import Message
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from cafe_web import make_server
+
+
+class CountingBody(io.BytesIO):
+    def __init__(self, payload=b"", error=None, drip=False):
+        super().__init__(payload)
+        self.calls = []
+        self.error = error
+        self.drip = drip
+
+    def read(self, size=-1):
+        self.calls.append(("read", size))
+        if self.error:
+            raise self.error
+        return super().read(size)
+
+    def read1(self, size=-1):
+        self.calls.append(("read1", size))
+        if self.error:
+            raise self.error
+        return super().read(min(size, 1) if self.drip else size)
+
+
+class RejectedPostTests(unittest.TestCase):
+    def setUp(self):
+        self.service = Mock()
+        def listener(address, handler):
+            return SimpleNamespace(RequestHandlerClass=handler, server_port=8765)
+        with patch("cafe_web.ThreadingHTTPServer", listener), \
+             patch("cafe_web.load_auth_policy", return_value={}):
+            self.server = make_server(self.service, port=0)
+        self.handler_type = self.server.RequestHandlerClass
+
+    def handler(self, lengths=("2",), transfer_encodings=(), payload=b"{}",
+                origin="https://untrusted.invalid", host="127.0.0.1:8765",
+                content_type="application/json", error=None, drip=False):
+        handler = self.handler_type.__new__(self.handler_type)
+        handler.server = self.server
+        handler.headers = Message()
+        handler.headers["Host"] = host
+        handler.headers["Content-Type"] = content_type
+        if origin is not None:
+            handler.headers["Origin"] = origin
+        for length in lengths:
+            handler.headers["Content-Length"] = length
+        for encoding in transfer_encodings:
+            handler.headers["Transfer-Encoding"] = encoding
+        handler.connection = Mock()
+        handler.connection.getsockname.return_value = ("127.0.0.1", 8765)
+        handler.rfile = CountingBody(payload, error=error, drip=drip)
+        handler.close_connection = False
+        handler.reply = Mock(return_value="rejected")
+        handler.session = Mock(side_effect=AssertionError("Rejected headers must not enter session/business handling"))
+        return handler
+
+    def reject(self, handler, code):
+        with patch("cafe_web.json.loads", side_effect=AssertionError("Rejected body must not be parsed")):
+            result = handler.do_POST()
+        self.assertEqual(result, "rejected")
+        self.assertTrue(handler.close_connection)
+        self.assertEqual(handler.reply.call_count, 1)
+        self.assertEqual(handler.reply.call_args.args[0], code)
+        self.assertIn("error", handler.reply.call_args.args[1])
+        handler.session.assert_not_called()
+        self.assertEqual(self.service.mock_calls, [])
+        return handler
+
+    def test_short_unambiguous_body_is_fully_consumed_before_original_origin_403(self):
+        handler = self.reject(self.handler(), 403)
+        self.assertEqual(handler.rfile.tell(), 2)
+        self.assertTrue(handler.rfile.calls)
+        self.assertTrue(all(kind=="read1" and 0<size<=8192 for kind,size in handler.rfile.calls))
+        self.assertEqual(handler.connection.settimeout.call_args.args, (15,))
+
+    def test_bad_host_and_wrong_content_type_keep_403_415_without_parsing_or_business(self):
+        for changes, code in (
+            ({"host":"attacker.invalid","origin":None}, 403),
+            ({"content_type":"text/plain","origin":None}, 415),
+        ):
+            with self.subTest(changes=changes):
+                handler = self.reject(self.handler(**changes), code)
+                self.assertEqual(handler.rfile.tell(), 2)
+
+    def test_largest_allowed_body_is_drained_in_bounded_chunks(self):
+        handler = self.reject(self.handler(lengths=("65536",), payload=b"x"*65536), 403)
+        self.assertEqual(handler.rfile.tell(), 65536)
+        self.assertTrue(all(0<size<=8192 for _,size in handler.rfile.calls))
+        self.assertLessEqual(sum(size for _,size in handler.rfile.calls), 65536)
+
+    def test_oversized_body_is_not_read_at_all(self):
+        for length in ("65537", "99999", "100000", "9"*5000):
+            with self.subTest(length=length[:12]):
+                handler = self.reject(self.handler(lengths=(length,), payload=b"x"*20), 403)
+                self.assertEqual(handler.rfile.calls, [])
+                handler.connection.settimeout.assert_not_called()
+
+    def test_duplicate_content_lengths_are_never_drained_even_when_equal(self):
+        for lengths in (("2","2"), ("2","3")):
+            with self.subTest(lengths=lengths):
+                handler = self.reject(self.handler(lengths=lengths), 403)
+                self.assertEqual(handler.rfile.calls, [])
+
+    def test_any_transfer_encoding_including_empty_value_prevents_drain(self):
+        for encodings in (("chunked",), ("identity",), ("",), ("","chunked")):
+            with self.subTest(encodings=encodings):
+                handler = self.reject(self.handler(transfer_encodings=encodings), 403)
+                self.assertEqual(handler.rfile.calls, [])
+                handler.connection.settimeout.assert_not_called()
+
+    def test_missing_or_malformed_content_length_is_not_read(self):
+        for lengths in ((), ("",), ("-1",), ("+2",), ("2, 2",), ("²",), ("two",)):
+            with self.subTest(lengths=lengths):
+                handler = self.reject(self.handler(lengths=lengths), 403)
+                self.assertEqual(handler.rfile.calls, [])
+
+    def test_truncated_body_or_read_error_still_replies_original_status_and_closes(self):
+        for options in ({"payload":b"{"}, {"error":OSError("peer closed")},
+                        {"error":TimeoutError("incomplete rejected body")}):
+            with self.subTest(options=options):
+                handler = self.reject(self.handler(**options), 403)
+                self.assertTrue(handler.rfile.calls)
+                self.assertEqual(handler.connection.settimeout.call_args.args, (15,))
+
+    def test_slow_drip_stops_at_total_deadline_instead_of_resetting_timeout_per_byte(self):
+        handler = self.handler(lengths=("100",), payload=b"x"*100, drip=True)
+        ticks = iter((0.0, 0.1, 0.3, 0.51))
+        with patch("cafe_web.time.monotonic", side_effect=lambda:next(ticks, 1.0)):
+            self.reject(handler, 403)
+        self.assertGreater(handler.rfile.tell(), 0)
+        self.assertLess(handler.rfile.tell(), 100)
+        self.assertLessEqual(len(handler.rfile.calls), 3)
+        budgets = [call.args[0] for call in handler.connection.settimeout.call_args_list[:-1]]
+        self.assertTrue(all(0 < budget <= 0.5 for budget in budgets))
+        self.assertEqual(handler.connection.settimeout.call_args.args, (15,))
+
+
+if __name__=="__main__":
+    unittest.main()
