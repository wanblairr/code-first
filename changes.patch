+  assert.ok(h.store.writes[1].condition.onlyIfMatch); assert.equal(h.store.writes[1].value.status, 'accepted');
+  assert.ok(!JSON.stringify(h.store.writes).includes(TOKEN));
+  assert.ok(!JSON.stringify(h.store.writes).includes(BASE.recipient));
+  assert.ok(!JSON.stringify(h.store.writes).includes(BASE.parameters[2]));
