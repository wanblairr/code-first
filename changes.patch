+    def completed(self, proposal, ratio=1.05):
+        return {"id": "remote-job-1", "status": "COMPLETED", "executionTime": 42, "delayTime": 17,
+                "output": {"target_date": proposal["target_date"],
+                           "predictions": [{"sku": i["sku"], "forecast_units": i["forecast_units"] * ratio,
+                                            "reason": "bounded synthetic review"} for i in proposal["forecast"]["items"]],
+                           "summary": "Review of synthetic demand", "warnings": ["Owner review remains required"]}}
+
+    def start(self, proposal=None):
+        p = proposal or self.proposal
+        return self.cloud.start(p["id"], p["revision"], p["input_hash"], background=False)
+
+    def execute(self, proposal=None):
+        job = self.start(proposal)
