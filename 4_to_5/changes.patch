+#bom-root .bom-proposal-line p{margin:0}
+#bom-root .bom-recommended{text-align:right}
+#bom-root .bom-recommended>strong{font-size:21px;white-space:nowrap}
+#bom-root .bom-adjust summary{font-size:12px;font-weight:400;color:var(--muted)}
+#bom-root .bom-adjust label{font-size:12px;max-width:210px;margin-left:auto}
+#bom-root .bom-adjust input{text-align:right}
