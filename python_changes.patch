+_MAILBOX = re.compile(
+    rf"{_ATOM}(?:\.{_ATOM})*@"
+    r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
+    r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+\Z"
+)
+_ID = re.compile(r"[A-Za-z0-9_-]{1,256}\Z")
+
+
+class GmailAPIError(CafeError):
+    """Safe error without remote bodies, credentials, or exception details.
+
+    outcome_unknown means a create request may have succeeded.  The caller must
+    preserve that state and let the owner inspect Gmail before trying again.
+    """
+
+    def __init__(self, message, *, outcome_unknown=False, status_code=None):
+        super().__init__(message)
+        self.outcome_unknown = bool(outcome_unknown)
+        self.status_code = status_code
+
+
+class _NoRedirect(request.HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def _validated_text(draft):
+    if not isinstance(draft, dict):
+        raise CafeError("采购草稿格式无效，请先完成审批。")
+    body = draft.get("body")
+    if not isinstance(body, str) or not body.strip():
+        raise CafeError("采购草稿正文不能为空。")
+    try:
+        body_bytes = body.encode("utf-8")
+    except UnicodeError:
+        raise CafeError("采购草稿正文包含无效字符。") from None
+    if len(body_bytes) > _MAX_BODY_BYTES or any(
+        ord(char) < 32 and char not in "\t\r\n" for char in body
+    ) or "\x7f" in body:
+        raise CafeError("采购草稿正文过长或包含无效控制字符。")
+    return body
+
+
+def _mime_for_draft(draft):
+    body = _validated_text(draft)
+    address = draft.get("email")
+    if (not isinstance(address, str) or len(address) > 254
+            or not _MAILBOX.fullmatch(address)):
+        raise CafeError("请为已审批采购草稿填写一个有效的供应商邮箱地址。")
+    subject = draft.get("subject")
+    if (not isinstance(subject, str) or not subject.strip() or len(subject) > 300
+            or any(ord(char) < 32 or ord(char) == 127 for char in subject)):
+        raise CafeError("采购草稿主题无效，请检查主题长度和换行。")
+    try:
+        subject.encode("utf-8")
+        message = EmailMessage(policy=SMTP)
+        message["To"] = address
+        message["Subject"] = subject
+        message["X-Unsent"] = "1"
+        message.set_content(body)
+        # Rebuild exclusively from approved canonical fields. Stored MIME cannot
+        # add Bcc/Cc recipients, sender headers, attachments, or another body.
+        return message.as_bytes()
+    except (UnicodeError, ValueError):
+        raise CafeError("采购草稿无法转换为邮件，请检查正文和主题。") from None
+
+
+def _http_failure(status, creating):
+    if status == 401:
+        message = "Gmail OAuth 访问令牌已失效或不正确，请在本机重新授权。"
+    elif status == 403:
+        message = ("Gmail 拒绝访问，请确认已启用 Gmail API，且 OAuth 授权包含 "
+                   "gmail.compose 草稿权限。")
+    elif status == 429:
+        message = "Gmail 请求过于频繁，请稍后由老板手动重试。"
+    elif 300 <= status < 400:
+        message = "Gmail 返回重定向，已停止请求以保护授权信息。"
+    elif status >= 500 or status == 408:
+        message = "Gmail 服务响应异常，请先检查 Gmail 草稿箱，避免重复创建。"
+    else:
+        message = "Gmail 未接受草稿请求，请检查 OAuth 配置及供应商邮箱。"
+    return GmailAPIError(
+        message, status_code=status,
+        outcome_unknown=creating and (status >= 500 or status == 408 or 300 <= status < 400),
+    )
+
+
+def _decode_response(raw, token, creating):
+    """Reject token echoes and ambiguous JSON before any IDs enter storage."""
+    def invalid():
+        return GmailAPIError("Gmail 返回数据无法安全识别，请先检查草稿箱再重试。",
+                             outcome_unknown=creating)
+
+    if token.encode("utf-8") in raw:
+        raise invalid()
+
+    def unique_keys(pairs):
+        value = {}
+        for key, part in pairs:
+            if key in value:
+                raise ValueError("duplicate JSON field")
+            value[key] = part
+        return value
+
+    def reject_constant(unused):
+        raise ValueError("nonfinite JSON value")
+
+    try:
+        result = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_keys,
+                            parse_constant=reject_constant)
+    except (ValueError, UnicodeError, RecursionError):
+        raise invalid() from None
+    if not isinstance(result, dict):
+        raise invalid()
+    # Tokens can be echoed as JSON-escaped characters, in an ID, unknown field,
+    # or object key. Refuse the whole response rather than silently stripping it.
+    pending = [(result, 0)]
+    while pending:
+        value, depth = pending.pop()
+        if depth > 30 or (isinstance(value, str) and token in value):
+            raise invalid()
+        if isinstance(value, dict):
+            pending.extend((part, depth + 1) for pair in value.items() for part in pair)
+        elif isinstance(value, list):
+            pending.extend((part, depth + 1) for part in value)
+    return result
+
+
+class GmailDraftClient:
+    """Small stdlib Gmail transport with no redirects or automatic POST retries.
+
+    opener may be an urllib opener object or a callable accepting
+    (Request, timeout=seconds), primarily for isolated transport tests.
+    """
+
+    def __init__(self, access_token, opener=None, timeout=15):
+        if (not isinstance(access_token, str) or not access_token
+                or len(access_token) > 8192
+                or any(ord(char) < 33 or ord(char) > 126 for char in access_token)):
+            raise CafeError("请先在本机填写有效的 Gmail OAuth 访问令牌。")
+        if (not isinstance(timeout, (int, float)) or isinstance(timeout, bool)
+                or not math.isfinite(timeout) or not 1 <= timeout <= 60):
+            raise CafeError("Gmail 超时设置须在 1 至 60 秒之间。")
+        self._access_token = access_token
+        self._opener = opener if opener is not None else request.build_opener(_NoRedirect())
+        self.timeout = timeout
+
+    def __repr__(self):
+        return "GmailDraftClient(access_token=<redacted>)"
+
+    def _request_json(self, *, creating, payload=None):
+        url = GMAIL_DRAFTS_URL if creating else GMAIL_DRAFTS_URL + "?maxResults=1"
+        data = (json.dumps(payload, ensure_ascii=True, separators=(",", ":"))
+                .encode("utf-8")) if creating else None
+        req = request.Request(
+            url, data=data, method="POST" if creating else "GET",
+            headers={"Authorization": "Bearer " + self._access_token,
+                     "Accept": "application/json", "Content-Type": "application/json"},
+        )
+        response = None
+        try:
+            open_fn = getattr(self._opener, "open", self._opener)
+            response = open_fn(req, timeout=self.timeout)
+            status = response.getcode()
+            if not isinstance(status, int) or not 200 <= status < 300:
+                raise _http_failure(status if isinstance(status, int) else 502, creating)
+            geturl = getattr(response, "geturl", None)
+            if geturl and geturl() != req.full_url:
+                raise GmailAPIError("Gmail 重定向已拒绝，请先核对草稿箱后再重试。",
+                                    outcome_unknown=creating)
+            raw = response.read(_MAX_RESPONSE_BYTES + 1)
+            if not isinstance(raw, bytes) or len(raw) > _MAX_RESPONSE_BYTES:
+                raise GmailAPIError("Gmail 返回数据异常，请先检查草稿箱再重试。",
+                                    outcome_unknown=creating)
+            return _decode_response(raw, self._access_token, creating)
+        except error.HTTPError as exc:
+            status = exc.code
+            try:
+                exc.close()
+            except (OSError, http.client.HTTPException):
+                pass
+            raise _http_failure(status, creating) from None
+        except GmailAPIError:
+            raise
+        except (error.URLError, OSError, ValueError, http.client.HTTPException):
+            raise GmailAPIError(
+                "Gmail 网络请求未完成，请先检查草稿箱，确认是否已创建后再手动重试。"
+                if creating else "无法连接 Gmail，请检查网络与 OAuth 配置。",
+                outcome_unknown=creating,
+            ) from None
+        finally:
+            if response is not None:
+                try:
+                    response.close()
+                except (OSError, http.client.HTTPException):
+                    pass
+
+    def create_draft(self, draft):
+        raw = base64.urlsafe_b64encode(_mime_for_draft(draft)).decode("ascii")
+        result = self._request_json(creating=True, payload={"message": {"raw": raw}})
+        draft_id = result.get("id")
+        message = result.get("message")
+        message_id = message.get("id") if isinstance(message, dict) else None
+        if (not isinstance(draft_id, str) or not _ID.fullmatch(draft_id)
+                or not isinstance(message_id, str) or not _ID.fullmatch(message_id)):
+            raise GmailAPIError("Gmail 未返回有效草稿编号，请先检查草稿箱再重试。",
+                                outcome_unknown=True)
+        return {"gmail_draft_id": draft_id, "gmail_message_id": message_id,
+                "status": "draft", "sent": False}
+
+    def check_connection(self):
+        # Listing at most one draft returns IDs only; do not fetch message bodies.
+        result = self._request_json(creating=False)
+        drafts = result.get("drafts", [])
+        if not isinstance(drafts, list) or len(drafts) > 1:
+            raise GmailAPIError("Gmail 连接检查返回格式无效。")
+        return {"connected": True, "provider": "gmail"}
+
+
+def build_whatsapp_draft(draft, phone=None):
+    """Prepare local text/link only; WhatsApp has no cloud draft creation here."""
+    body = _validated_text(draft)
+    if phone is None:
+        stored_url = draft.get("whatsapp_url")
+        if stored_url:
+            if not isinstance(stored_url, str):
+                raise CafeError("供应商 WhatsApp 链接无效。")
+            try:
+                parts = parse.urlsplit(stored_url)
+            except ValueError:
+                raise CafeError("供应商 WhatsApp 链接无效。") from None
+            if (parts.scheme != "https" or parts.netloc != "wa.me"
+                    or parts.fragment or not re.fullmatch(r"/[1-9][0-9]{6,14}", parts.path)):
+                raise CafeError("供应商 WhatsApp 链接无效，请填写国际区号号码。")
+            phone = parts.path[1:]
+        else:
+            phone = ""
+    if not isinstance(phone, str):
+        raise CafeError("WhatsApp 号码须包含国际区号及 7 至 15 位数字。")
+    phone = phone.strip()
+    digits = phone[1:] if phone.startswith("+") else phone
+    if phone == "+" or (digits and not re.fullmatch(r"[1-9][0-9]{6,14}", digits)):
+        raise CafeError("WhatsApp 号码须包含国际区号及 7 至 15 位数字。")
+    url = "https://wa.me/" + digits + "?text=" + parse.quote(body, safe="") if digits else None
+    return {"channel": "whatsapp", "draft_id": draft.get("id"), "body": body,
+            "phone": digits, "whatsapp_url": url, "requires_phone": not bool(digits),
+            "external_draft": False, "sent": False,
+            "note": "这是预填消息链接，需要在 WhatsApp 中手动确认发送；未创建云端草稿。"}
