+@echo off
+setlocal
+chcp 65001 >nul
+set PYTHONUTF8=1
+cd /d "%~dp0"
+if errorlevel 1 goto failed
+where py.exe >nul 2>nul
+if errorlevel 1 goto use_python
+py -3 -X utf8 cafe_start.py %*
+set "cafe_exit=%ERRORLEVEL%"
+goto finished
+:use_python
+python -X utf8 cafe_start.py %*
+set "cafe_exit=%ERRORLEVEL%"
+goto finished
+:failed
+set "cafe_exit=2"
+:finished
+if "%cafe_exit%"=="0" exit /b 0
+echo.
+echo Read the error above. Python 3.11+ and a writable local database folder are required.
+pause
+exit /b %cafe_exit%
