+++ b/public_website/dist/demo/engine.js
@@ -0,0 +1,241 @@
+import {lineCost, sumCosts, formatMoney} from './catalog.js';
+/* Pure public demonstration engine. No DOM, credentials, account or persistence. */
+const DAY = 86400000;
+const SKU_NAMES = { espresso: '意式浓缩', latte: '拿铁', oat_latte: '燕麦拿铁' };
+const round6 = n => Math.round(n * 1e6) / 1e6;
+const mean = values => values.reduce((sum, value) => sum + value, 0) / values.length;
+
+export class DemoFreshnessError extends Error {
+  constructor(code, message) { super(message); this.name = 'DemoFreshnessError'; this.code = code; }
+}
+
