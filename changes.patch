+"""Public fixture parity for local BOM context; no sockets, training or APIs."""
+from copy import deepcopy
+import json
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+from cafe_core import CafeError
+from cafe_bom_context import generate, load_context_model, forecast_context
+from cafe_bom import load_bom_data, initial_stock, sell, forecast_menu, replenish
+
+APP = Path(__file__).resolve().parents[1]
+
+
+class BOMContextTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.model = load_context_model()
+        cls.vectors = json.loads((APP / 'data/bom-public-parity-vectors.json').read_text(encoding='utf-8'))
+        cls.data = load_bom_data()
+
+    def context(self, **changes):
+        values = dict(model=self.model, target_date='2026-10-24', temperature_c=27,
+                      precipitation_mm=24, is_holiday=False)
+        values.update(changes)
+        return forecast_context(**values)
+
+    def test_all_published_forecast_and_impact_vectors(self):
+        self.assertEqual(len(self.vectors), 6)
+        for vector in self.vectors:
+            raw = vector['input']
+            result = self.context(target_date=raw['targetDate'],
+                temperature_c=raw['weather']['temperatureC'],
+                precipitation_mm=raw['weather']['precipitationMm'],
+                is_holiday=raw['holidayOverride'] == 'public_holiday')
+            by_sku = {row['sku']: row for row in result['forecasts']}
+            for row in vector['expected_forecasts']:
+                with self.subTest(target=raw['targetDate'], sku=row['sku'], field='forecast'):
+                    self.assertAlmostEqual(by_sku[row['sku']]['forecastCups'], row['forecast_units'], delta=1e-6)
+            for row in vector['expected_impacts']:
+                for actual, expected in [('referenceCups', 'reference'), ('weatherEffect', 'weather'),
+                                         ('holidayEffect', 'holiday'), ('forecastCups', 'combined')]:
+                    with self.subTest(target=raw['targetDate'], sku=row['sku'], field=actual):
+                        self.assertAlmostEqual(by_sku[row['sku']][actual], row[expected], delta=1e-6)
+            self.assertAlmostEqual(result['forecastCups'], sum(r['forecast_units'] for r in vector['expected_forecasts']), delta=1e-6)
+            self.assertAlmostEqual(result['referenceCups'], sum(r['reference'] for r in vector['expected_impacts']), delta=1e-6)
+
+    def test_rain_scenario_matches_public_menu_purchase(self):
+        context = self.context()
+        menu = forecast_menu(self.data, context)
+        stock = sell(self.data, initial_stock(self.data),
+                     {'productId': 'BV-013', 'size': '中杯', 'quantity': 36})
+        rows = {row['id']: row for row in replenish(self.data, stock, menu['sales'])}
+        self.assertEqual(stock['INV-005'], 2600)
+        self.assertEqual(rows['INV-003']['quantity'], 5540)
+        self.assertEqual(rows['INV-005']['quantity'], 2750)
+        self.assertEqual(menu['contextSignature'], context['signature'])
+        self.assertEqual(len(menu['sales']), 20)
+
+    def test_signatures_are_stable_and_json_key_order_independent(self):
+        a = self.context(signature_material={'source': 'simulation', 'known_at': '2026-10-23T10:00:00Z'})
+        b = self.context(signature_material={'known_at': '2026-10-23T10:00:00Z', 'source': 'simulation'})
+        self.assertEqual(a, b)
+        self.assertEqual(len(a['signature']), 64)
+        self.assertEqual(self.context(temperature_c=27)['signature'], self.context(temperature_c=27.0)['signature'])
+
+    def test_signatures_bind_weather_holiday_date_and_provenance(self):
+        original = self.context()
+        for changes in ({'temperature_c': 28}, {'precipitation_mm': 25}, {'is_holiday': True},
+                        {'target_date': '2026-10-25'}, {'signature_material': {'fetched_at': 'changed'}}):
+            with self.subTest(changes=changes):
+                self.assertNotEqual(original['signature'], self.context(**changes)['signature'])
+
+    def test_unknown_or_nonfinite_context_is_rejected(self):
+        for changes in ({'temperature_c': None}, {'temperature_c': True}, {'temperature_c': float('nan')},
+                        {'temperature_c': 56}, {'precipitation_mm': -1}, {'precipitation_mm': float('inf')},
+                        {'precipitation_mm': '24'}, {'is_holiday': None}, {'is_holiday': 1},
+                        {'target_date': '20261024'}, {'target_date': '2026-02-30'},
+                        {'target_date': '2026-10-22'}, {'signature_material': {'bad': float('nan')}}):
+            with self.subTest(changes=changes), self.assertRaises(CafeError):
+                self.context(**changes)
+
+    def test_public_model_artifact_is_verified(self):
+        model = deepcopy(self.model)
+        model['models']['latte']['reference_temperature_c'] += 1
+        with self.assertRaises(CafeError):
+            self.context(model=model)
+        model = deepcopy(self.model)
+        model['publicArtifactSha256'] = '0' * 64
+        with self.assertRaises(CafeError):
+            self.context(model=model)
+
+    def test_no_model_input_mutation_or_training_network_or_runtime_reads(self):
+        before = deepcopy(self.model)
+        with patch('pathlib.Path.read_text', side_effect=AssertionError('unexpected disk read')), \
+             patch('cafe_forecast_context.train', side_effect=AssertionError('unexpected training')), \
+             patch('urllib.request.urlopen', side_effect=AssertionError('unexpected network')):
+            result = self.context()
+        self.assertEqual(self.model, before)
+        self.assertGreater(result['referenceCups'], 0)
+
+    def test_generator_is_deterministic_180_days_three_skus(self):
+        from datetime import date
+        a = generate(date(2026, 10, 23), self.model['calendar'], seed=self.model['seed'])
+        b = generate(date(2026, 10, 23), self.model['calendar'], seed=self.model['seed'])
+        self.assertEqual(a, b)
+        sales, environment = a
+        self.assertEqual(len(sales), 540)
+        self.assertEqual(len(environment), 180)
+        self.assertEqual({row['sku'] for row in sales}, {'espresso', 'latte', 'oat_latte'})
+        self.assertEqual(sales[-1]['date'], '2026-10-23')
+
+    def test_default_and_explicit_bundled_models_agree(self):
+        self.assertEqual(self.context(), self.context(model=None))
+        self.assertEqual(self.context(), self.context(model=APP / 'data/bom-context-model.json'))
+
+
+
+if __name__ == '__main__':
+    unittest.main()
