+const validDay = value => typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) && Number.isFinite(Date.parse(`${value}T00:00:00Z`)) && new Date(`${value}T00:00:00Z`).toISOString().slice(0,10) === value;
+
+// Presentation only: no translated string is written into business state or signatures.
+function setBilingual(target, english, chinese) {
+  const wrapper=document.createElement('span');wrapper.className='bi';
+  const en=document.createElement('span');en.className='bi-en';en.lang='en';en.textContent=english;
+  const zh=document.createElement('span');zh.className='bi-zh';zh.lang='zh-CN';zh.textContent=chinese;
+  wrapper.append(en,zh);target.replaceChildren(wrapper);
+}
+function localizeTextNode(text) {
+  if(!text.parentElement||text.parentElement.closest('#bom-root,.bi,pre,textarea,input,script,style,code,title'))return;
+  const chinese=text.textContent.trim();if(!/[\u3400-\u9fff]/.test(chinese))return;
+  const english=translateText(chinese);if(!english||english===chinese)return;
+  const option=text.parentElement.closest('option');
+  if(option){if(!option.dataset.i18nEn){option.dataset.i18nEn=english;option.dataset.i18nZh=chinese;const locale=document.documentElement.dataset.language||'en';option.textContent=locale==='zh'?chinese:locale==='en'?english:translateLocale(english,locale)||english;}return;}
+  const wrapper=document.createElement('span');wrapper.className='bi';
+  const en=document.createElement('span');en.className='bi-en';en.lang='en';en.textContent=english;
+  const zh=document.createElement('span');zh.className='bi-zh';zh.lang='zh-CN';zh.textContent=chinese;wrapper.append(en,zh);text.replaceWith(wrapper);
+}
+function localizeTree(root) {
+  if(root.nodeType===Node.TEXT_NODE){localizeTextNode(root);return;}
+  if(root.nodeType!==Node.ELEMENT_NODE||root.closest('#bom-root,.bi,pre,textarea,input,script,style,code'))return;
+  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);const pending=[];
+  while(walker.nextNode())pending.push(walker.currentNode);
+  pending.forEach(localizeTextNode);
+}
+localizeTree(document.body);
+const bilingualObserver=new MutationObserver(records=>{for(const record of records){if(record.type==='characterData')localizeTextNode(record.target);else record.addedNodes.forEach(localizeTree);}});
+bilingualObserver.observe(document.body,{childList:true,characterData:true,subtree:true});
+
+function node(tag, className, text) {
+  const result = document.createElement(tag);
+  if (className) result.className = className;
+  if (text !== undefined) result.textContent = String(text);
+  return result;
+}
+function setAria(target,english,chinese){target.dataset.ariaEn=english;target.dataset.ariaZh=chinese;const locale=document.documentElement.dataset.language||'en';target.setAttribute('aria-label',locale==='zh'?chinese:locale==='en'?english:translateLocale(english,locale)||english);}
+function replaceChildren(target, children = []) { target.replaceChildren(...children); }
+function show(target, visible) { target.hidden = !visible; }
+function nowText(value = Date.now()) {
