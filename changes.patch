+echo.
+
+:start_server
+python cafe_app.py --base "%CAFE_DEMO_BASE%" serve --lan
+if errorlevel 1 goto server_failed
+goto finished
+
+:prepare_failed
+set "launcher_exit=2"
+echo 数据准备未完成。请查看上方错误，检查 Python 3.11+、文件完整性和目录写入权限。
+goto finished
+
+:server_failed
+set "launcher_exit=2"
+echo 网页服务未启动。请查看上方错误，检查端口占用、运行目录权限及 SQLite 存储兼容性。
+
+:finished
+pause
+exit /b %launcher_exit%
