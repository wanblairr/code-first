+class Response:
+    def __init__(self, document, status=201, url=ENDPOINT):
+        self.raw = document if isinstance(document, bytes) else json.dumps(document).encode()
+        self.status, self.url, self.closed = status, url, False
+    def getcode(self): return self.status
+    def geturl(self): return self.url
+    def read(self, maximum): return self.raw[:maximum]
+    def close(self): self.closed = True
+
+
+class Opener:
+    def __init__(self, response): self.response, self.requests = response, []
+    def open(self, req, timeout):
+        self.requests.append((req, timeout))
+        if isinstance(self.response, Exception): raise self.response
+        return self.response
+
