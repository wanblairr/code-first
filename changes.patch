+ */
+import {createHash, randomUUID} from 'node:crypto';
+
+export const config = {
+  rateLimit: {action: 'rate_limit', aggregateBy: ['ip', 'domain'], windowSize: 60, windowLimit: 10},
+};
+
+const PRODUCTION_ORIGIN = 'https://www.cafe-replenishment-demo.com';
+const MAX_REQUEST_BYTES = 32768;
+const MAX_RESPONSE_BYTES = 65536;
+const GRAPH_TIMEOUT_MS = 12000;
+const STORE_NAME = 'cafe-whatsapp-outbound-v1';
+const HEADERS = {'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store',
+  'Pragma': 'no-cache', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'no-referrer'};
+const REQUEST_FIELDS = new Set(['operation', 'credentials', 'recipient', 'template', 'parameters',
+  'request_id', 'preview_id', 'confirmed', 'opt_in']);
+
+class SafeFailure extends Error {
+  constructor(code, message, status = 400, unknown = false) {
+    super(message); this.code = code; this.status = status; this.unknown = unknown;
+  }
+}
+const failure = (code, message, status = 400, unknown = false) => new SafeFailure(code, message, status, unknown);
+const isObject = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const digest = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
+const json = (data, status = 200) => new Response(JSON.stringify(data), {status, headers: HEADERS});
+const cleanString = (value, max) => typeof value === 'string' && value.length > 0 && value.length <= max
+  && !/[\u0000-\u001f\u007f\u2028\u2029]/u.test(value);
+
+function exactFields(value, fields, code = 'INVALID_REQUEST') {
+  if (!isObject(value) || Object.keys(value).some(key => !fields.has(key))) {
+    throw failure(code, 'Unsupported or invalid request fields.');
+  }
+}
+
+async function readBounded(stream, maximum, code) {
+  if (!stream) throw failure(code, 'A JSON body is required.');
+  const reader = stream.getReader(); const chunks = []; let total = 0;
+  try {
+    while (true) {
+      const {value, done} = await reader.read();
+      if (done) break;
+      total += value.byteLength;
+      if (total > maximum) {
+        await reader.cancel().catch(() => {});
+        throw failure(code, 'The response or request exceeds the supported size.');
+      }
+      chunks.push(value);
+    }
+    const bytes = new Uint8Array(total); let offset = 0;
+    for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.byteLength; }
+    return new TextDecoder('utf-8', {fatal: true}).decode(bytes);
+  } catch (error) {
+    if (error instanceof SafeFailure) throw error;
+    throw failure(code, 'The request or response could not be read safely.');
+  } finally { reader.releaseLock(); }
+}
+
+function validateCredentials(value, operation) {
+  exactFields(value, new Set(['api_version', 'phone_number_id', 'business_account_id', 'access_token']), 'INVALID_CREDENTIALS');
+  if (typeof value.api_version !== 'string' || !/^v[1-9][0-9]{0,2}\.0$/.test(value.api_version)
+      || typeof value.phone_number_id !== 'string' || !/^[1-9][0-9]{4,31}$/.test(value.phone_number_id)
+      || typeof value.access_token !== 'string' || !/^[\x21-\x7e]{16,8192}$/.test(value.access_token)) {
+    throw failure('INVALID_CREDENTIALS', 'Enter your API version, Phone Number ID and access token.');
+  }
+  if (value.business_account_id !== undefined && value.business_account_id !== ''
+      && (typeof value.business_account_id !== 'string' || !/^[1-9][0-9]{4,31}$/.test(value.business_account_id))) {
+    throw failure('INVALID_CREDENTIALS', 'The WhatsApp Business Account ID is invalid.');
+  }
+  if (['preview', 'send'].includes(operation) && !value.business_account_id) {
+    throw failure('INVALID_CREDENTIALS', 'Enter the WhatsApp Business Account ID to validate your template.');
+  }
+  return {...value};
+}
+
+function validateTemplate(value) {
+  exactFields(value, new Set(['name', 'language']), 'INVALID_TEMPLATE');
+  if (typeof value.name !== 'string' || !/^[a-z][a-z0-9_]{0,127}$/.test(value.name)
+      || typeof value.language !== 'string' || !/^[a-z]{2,3}(?:_[A-Z]{2})?$/.test(value.language)) {
+    throw failure('INVALID_TEMPLATE', 'Enter an exact template name and language code.');
+  }
+  return {name: value.name, language: value.language};
+}
+
+function validateParameters(value) {
+  if (!Array.isArray(value) || value.length !== 3
+      || !cleanString(value[0], 10) || !/^\d{4}-\d{2}-\d{2}$/.test(value[0])
+      || !Number.isFinite(Date.parse(value[0] + 'T00:00:00Z'))
+      || new Date(value[0] + 'T00:00:00Z').toISOString().slice(0, 10) !== value[0]
+      || !cleanString(value[1], 80) || !/^[A-Za-z0-9_-]+$/.test(value[1])
+      || !cleanString(value[2], 1000) || !value[2].trim()) {
+    throw failure('INVALID_PARAMETERS', 'Provide a valid date, approved order ID and one-line purchase summary.');
+  }
+  return [...value];
+}
+
+function responseContainsToken(value, token, depth = 0) {
+  if (depth > 24) return true;
+  if (typeof value === 'string') return value.includes(token);
+  if (Array.isArray(value)) return value.some(part => responseContainsToken(part, token, depth + 1));
+  if (isObject(value)) return Object.entries(value).some(([key, part]) =>
+    key.includes(token) || responseContainsToken(part, token, depth + 1));
+  return false;
+}
+
+async function graph(credentials, path, {fetchImpl, payload} = {}) {
+  // path is assembled only from validated IDs, never a visitor-supplied URL.
+  const url = `https://graph.facebook.com/${credentials.api_version}/${path}`;
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), GRAPH_TIMEOUT_MS);
+  try {
+    const response = await fetchImpl(url, {
+      method: payload ? 'POST' : 'GET', redirect: 'error', signal: controller.signal,
+      headers: {'Authorization': 'Bearer ' + credentials.access_token, 'Accept': 'application/json',
+        ...(payload ? {'Content-Type': 'application/json'} : {})},
+      ...(payload ? {body: JSON.stringify(payload)} : {}),
+    });
+    if (!response.ok || response.redirected || (response.url && response.url !== url)) {
+      // Do not read or expose provider errors; they may contain credentials.
+      await response.body?.cancel().catch(() => {});
+      throw failure(response.status === 401 || response.status === 403 ? 'WHATSAPP_AUTHORIZATION' : 'WHATSAPP_REQUEST_FAILED',
+        'Meta did not accept this request. Check your account, permissions and template in Meta.', 502, Boolean(payload));
+    }
+    const text = await readBounded(response.body, MAX_RESPONSE_BYTES, 'WHATSAPP_RESPONSE_INVALID');
+    let result;
+    try { result = JSON.parse(text); } catch { throw failure('WHATSAPP_RESPONSE_INVALID', 'Meta returned an invalid response.', 502, Boolean(payload)); }
+    if (!isObject(result) || responseContainsToken(result, credentials.access_token)) {
+      throw failure('WHATSAPP_RESPONSE_INVALID', 'Meta returned a response that could not be handled safely.', 502, Boolean(payload));
+    }
+    return result;
+  } catch (error) {
+    if (error instanceof SafeFailure) {
+      if (error.code === 'WHATSAPP_RESPONSE_INVALID') error.status = 502;
+      if (payload) error.unknown = true;
+      throw error;
+    }
+    throw failure('WHATSAPP_UNAVAILABLE', 'The Meta request did not complete. No automatic retry will occur.', 502, Boolean(payload));
+  } finally { clearTimeout(timer); }
+}
+
+async function checkPhone(credentials, fetchImpl) {
+  const result = await graph(credentials, `${credentials.phone_number_id}?fields=id,display_phone_number,verified_name`, {fetchImpl});
+  if (result.id !== credentials.phone_number_id || !cleanString(result.display_phone_number, 40)
+      || !cleanString(result.verified_name, 150)) {
+    throw failure('WHATSAPP_PHONE_INVALID', 'Meta did not return the requested WhatsApp phone number.', 502);
+  }
+  return {id: result.id, display_phone_number: result.display_phone_number, verified_name: result.verified_name};
+}
+
+function validateBodyTemplate(row, selected) {
+  if (!isObject(row) || row.name !== selected.name || row.language !== selected.language || row.status !== 'APPROVED'
+      || (row.parameter_format !== undefined && row.parameter_format !== 'POSITIONAL')
+      || !Array.isArray(row.components) || row.components.length > 2) {
+    throw failure('TEMPLATE_NOT_APPROVED', 'Use the exact approved positional template and language.');
+  }
+  const bodies = row.components.filter(component => component?.type === 'BODY');
+  const footers = row.components.filter(component => component?.type === 'FOOTER');
+  if (bodies.length !== 1 || footers.length > 1 || bodies.length + footers.length !== row.components.length) {
+    throw failure('TEMPLATE_UNSUPPORTED', 'Use a BODY with exactly {{1}}, {{2}}, {{3}} and an optional static FOOTER. Headers and buttons are unsupported.');
+  }
+  const body = bodies[0].text, footer = footers[0]?.text ?? '';
+  if (typeof body !== 'string' || !body.trim() || body.length > 4096
+      || /[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/u.test(body)
+      || typeof footer !== 'string' || footer.length > 200
+      || /[\u0000-\u001f\u007f]/u.test(footer) || /[{}]/.test(footer)) {
+    throw failure('TEMPLATE_UNSUPPORTED', 'The template contains unsupported text or a dynamic footer.');
+  }
+  const placeholders = body.match(/{{[^{}]*}}/g) ?? [];
+  if (JSON.stringify([...placeholders].sort()) !== JSON.stringify(['{{1}}', '{{2}}', '{{3}}'])
+      || /[{}]/.test(body.replace(/{{[123]}}/g, ''))) {
+    throw failure('TEMPLATE_UNSUPPORTED', 'The template BODY must contain exactly one each of {{1}}, {{2}} and {{3}}.');
+  }
+  return {name: row.name, language: row.language, id: typeof row.id === 'string' ? row.id : '', body, footer};
+}
+
+async function fetchTemplate(credentials, selected, fetchImpl) {
+  const query = new URLSearchParams({name: selected.name, fields: 'id,name,language,status,components,parameter_format', limit: '100'});
+  const result = await graph(credentials, `${credentials.business_account_id}/message_templates?${query}`, {fetchImpl});
+  if (!Array.isArray(result.data) || result.data.length > 100) {
+    throw failure('TEMPLATE_RESPONSE_INVALID', 'The Meta template list could not be verified.', 502);
+  }
+  const rows = result.data.filter(row => row?.name === selected.name && row?.language === selected.language);
+  if (rows.length !== 1) throw failure('TEMPLATE_NOT_FOUND', 'The exact template name and language were not found uniquely.');
+  return validateBodyTemplate(rows[0], selected);
+}
+
+function previewFor(credentials, recipient, template, parameters) {
+  const renderedBody = template.body.replace(/{{([123])}}/g, (_, number) => parameters[Number(number) - 1])
+    + (template.footer ? '\n\n' + template.footer : '');
+  if (renderedBody.length > 4096) throw failure('TEMPLATE_TOO_LONG', 'The fully rendered message exceeds the supported length.');
+  const previewID = digest(['preview-v1', credentials.api_version, credentials.phone_number_id,
+    credentials.business_account_id, recipient, template, parameters]);
+  return {status: 'preview', preview_id: previewID, body: renderedBody, rendered_body: renderedBody,
+    template: {name: template.name, language: template.language}, parameters: [...parameters], recipient};
+}
+
+function publicAccepted(record, cached) {
+  if (!isObject(record) || record.status !== 'accepted' || typeof record.message_id !== 'string'
+      || !/^wamid\.[A-Za-z0-9._:=+/~-]{1,500}$/.test(record.message_id)) return null;
+  return {status: 'accepted', accepted: true, delivered: false, delivery_confirmed: false,
+    message_id: record.message_id, cached};
+}
+
+async function durableClaim(store, key, requestID, uuid, now) {
+  const claim = {version: 1, status: 'submitting', claim_id: uuid(), request_id: requestID,
+    created_at: now().toISOString()};
+  let written;
+  try { written = await store.setJSON(key, claim, {onlyIfNew: true}); }
+  catch { throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection is unavailable. Nothing was sent.', 503); }
+  if (!isObject(written) || typeof written.modified !== 'boolean') {
+    throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection could not be confirmed. Nothing was sent.', 503);
+  }
+  let stored;
+  try { stored = await store.getWithMetadata(key, {type: 'json', consistency: 'strong'}); }
+  catch { throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection could not be confirmed. Nothing was sent.', 503); }
+  if (!written.modified) {
+    const accepted = publicAccepted(stored?.data, true);
+    if (accepted) return {cached: accepted};
+    throw failure('DUPLICATE_UNCERTAIN', 'A prior matching send is pending or uncertain. Check Meta before taking further action; it will not be sent again.', 409, true);
+  }
+  // Some SDK versions can claim modified:true on a failed conditional write.
+  // A real nonempty ETag AND strong read-back of our unique claim are required.
+  if (typeof written.etag !== 'string' || !written.etag || !isObject(stored?.data)
+      || !stored.etag || stored.etag !== written.etag || stored.data.claim_id !== claim.claim_id
+      || stored.data.status !== 'submitting') {
+    throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection could not be confirmed. Nothing was sent.', 503);
+  }
+  return {claim, etag: stored.etag};
+}
+
+async function saveOutcome(store, key, claimed, changes, now) {
+  const record = {...claimed.claim, ...changes, updated_at: now().toISOString()};
+  try {
+    const written = await store.setJSON(key, record, {onlyIfMatch: claimed.etag});
+    if (written?.modified !== true || typeof written.etag !== 'string' || !written.etag) return false;
+    const stored = await store.getWithMetadata(key, {type: 'json', consistency: 'strong'});
+    return stored?.etag === written.etag && stored?.data?.claim_id === record.claim_id
+      && stored.data.status === record.status && stored.data.message_id === record.message_id;
+  } catch { return false; }
+}
+
+async function defaultStore() {
+  const {getStore} = await import('@netlify/blobs');
+  return getStore({name: STORE_NAME, consistency: 'strong'});
+}
+
+/** Injectable dependencies are for isolated tests; the deployed handler uses no
+ * incoming choice of store, fetch target, allowed origin or owner credential. */
+export function createHandler({fetchImpl = fetch, storeFactory = defaultStore,
+  allowedOrigin = PRODUCTION_ORIGIN, uuid = randomUUID, now = () => new Date()} = {}) {
+  return async function handle(req) {
+    try {
+      if (req.method !== 'POST') throw failure('METHOD_NOT_ALLOWED', 'Use a same-origin JSON POST request.', 405);
+      const url = new URL(req.url);
+      if (url.origin !== allowedOrigin || req.headers.get('Origin') !== allowedOrigin
+          || url.pathname !== '/.netlify/functions/whatsapp' || url.search || url.hash
+          || (req.headers.has('Sec-Fetch-Site') && req.headers.get('Sec-Fetch-Site') !== 'same-origin')) {
+        throw failure('ORIGIN_NOT_ALLOWED', 'This endpoint accepts requests only from the public workbench origin.', 403);
+      }
+      if ((req.headers.get('Content-Type') ?? '').split(';')[0].trim().toLowerCase() !== 'application/json') {
+        throw failure('JSON_REQUIRED', 'Use application/json.', 415);
+      }
+      const declaredSize = req.headers.get('Content-Length');
+      if (declaredSize !== null && (!/^\d+$/.test(declaredSize) || Number(declaredSize) > MAX_REQUEST_BYTES)) {
+        throw failure('INVALID_REQUEST', 'The request exceeds the supported size.');
+      }
+      let body;
+      try { body = JSON.parse(await readBounded(req.body, MAX_REQUEST_BYTES, 'INVALID_REQUEST')); }
+      catch (error) { if (error instanceof SafeFailure) throw error; throw failure('INVALID_JSON', 'A valid JSON object is required.'); }
+      exactFields(body, REQUEST_FIELDS);
+      if (!['check', 'preview', 'send', 'test'].includes(body.operation)) throw failure('INVALID_OPERATION', 'The requested operation is unsupported.');
+      const credentials = validateCredentials(body.credentials, body.operation);
+      const nonCredentialFields = {...body}; delete nonCredentialFields.credentials;
+      if (responseContainsToken(nonCredentialFields, credentials.access_token)) {
+        throw failure('INVALID_REQUEST', 'Do not include access credentials in message content.');
+      }
+      const phone = await checkPhone(credentials, fetchImpl);
+      if (body.operation === 'check') return json({connected: true, status: 'connected', phone_number: phone});
+      if (typeof body.recipient !== 'string' || !/^[1-9][0-9]{6,14}$/.test(body.recipient)) {
+        throw failure('INVALID_RECIPIENT', 'Use an international recipient number containing digits only.');
+      }
+      const selected = validateTemplate(body.template);
+      let parameters, preview;
+      if (body.operation === 'test') {
+        if (selected.name !== 'hello_world' || selected.language !== 'en_US'
+            || (body.parameters !== undefined && (!Array.isArray(body.parameters) || body.parameters.length))) {
+          throw failure('TEST_TEMPLATE_ONLY', 'The test operation only sends hello_world in en_US without purchase parameters.');
+        }
+        parameters = [];
+      } else {
+        parameters = validateParameters(body.parameters);
+        const template = await fetchTemplate(credentials, selected, fetchImpl);
+        preview = previewFor(credentials, body.recipient, template, parameters);
+        if (body.operation === 'preview') return json(preview);
+      }
+      if (body.confirmed !== true || body.opt_in !== true) {
+        throw failure('SEND_NOT_CONFIRMED', 'Confirm the full message and that the recipient expects this WhatsApp message.');
+      }
+      if (!cleanString(body.request_id, 128) || !/^[A-Za-z0-9_-]{8,128}$/.test(body.request_id)) {
+        throw failure('INVALID_REQUEST_ID', 'Provide a valid send request ID.');
+      }
+      if (body.operation === 'send' && (typeof body.preview_id !== 'string'
+          || !/^[a-f0-9]{64}$/.test(body.preview_id) || body.preview_id !== preview.preview_id)) {
+        throw failure('PREVIEW_CHANGED', 'The template or message changed. Review a new full preview before sending.', 409);
+      }
+      let store;
+      try { store = await storeFactory(); } catch { throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection is unavailable. Nothing was sent.', 503); }
+      if (!store?.setJSON || !store?.getWithMetadata) throw failure('IDEMPOTENCY_UNAVAILABLE', 'Durable send protection is unavailable. Nothing was sent.', 503);
+      // Intentionally exclude request_id and token: neither a retry nor a token
+      // rotation permits the same purchase message to be sent a second time.
+      const key = digest(['whatsapp-send-v1', credentials.phone_number_id, body.recipient, selected, parameters]);
+      const claimed = await durableClaim(store, key, body.request_id, uuid, now);
+      if (claimed.cached) return json(claimed.cached);
+      const payload = {messaging_product: 'whatsapp', recipient_type: 'individual', to: body.recipient,
+        type: 'template', template: {name: selected.name, language: {code: selected.language},
+          ...(parameters.length ? {components: [{type: 'body', parameters: parameters.map(text => ({type: 'text', text}))}]} : {})}};
+      let messageID;
+      try {
+        const outcome = await graph(credentials, `${credentials.phone_number_id}/messages`, {fetchImpl, payload});
+        messageID = outcome.messages?.[0]?.id;
+        if (outcome.messaging_product !== 'whatsapp' || !Array.isArray(outcome.messages) || outcome.messages.length !== 1
+            || typeof messageID !== 'string' || !/^wamid\.[A-Za-z0-9._:=+/~-]{1,500}$/.test(messageID)) {
+          throw failure('WHATSAPP_RESPONSE_INVALID', 'Meta did not return a verifiable message acceptance ID.', 502, true);
+        }
+      } catch {
+        await saveOutcome(store, key, claimed, {status: 'unknown'}, now);
+        throw failure('SEND_OUTCOME_UNKNOWN', 'Message acceptance was not confirmed. Check Meta; this matching message will not be sent again automatically.', 502, true);
+      }
+      const saved = await saveOutcome(store, key, claimed, {status: 'accepted', message_id: messageID}, now);
+      if (!saved) {
+        throw failure('SEND_RECORD_UNCERTAIN', 'Meta accepted the request but its local record could not be confirmed. Check Meta; it will not be sent again automatically.', 503, true);
+      }
+      return json(publicAccepted({status: 'accepted', message_id: messageID}, false));
+    } catch (error) {
+      const safe = error instanceof SafeFailure ? error : failure('SERVICE_UNAVAILABLE', 'The WhatsApp service is unavailable. No automatic retry will occur.', 503);
+      return json({error: safe.message, code: safe.code, message: safe.message,
+        ...(safe.unknown ? {status: 'unknown', retry_safe: false} : {})}, safe.status);
+    }
+  };
+}
+
+export default createHandler();
