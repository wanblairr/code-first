--- /dev/null
+++ b/local_app/make_examples.py
@@ -0,0 +1,44 @@
+"""Reproducible, explicitly synthetic fixtures. NEVER evidence of real forecasting accuracy."""
+from datetime import date, timedelta
+import math
+import random
+from pathlib import Path
+from cafe_core import save_json
+from cafe_io import demo_context, safe_csv, write_template
+
+
+def generate(base):
+    rng = random.Random(20261021)
+    first = date(2026, 7, 1)
+    all_rows = []
+    for i in range(112):
+        d = first + timedelta(days=i)
+        weather = "模拟：下雨" if i % 5 == 0 else "模拟：晴"
+        event = "模拟：附近校园活动，规模未知" if i % 11 == 0 else "模拟：无已确认活动"
+        # These arbitrary coefficients create TEST DATA, not a claim about actual cafes.
+        cups = max(0, round(90 + 16*(d.weekday() >= 5) - 9*(i % 5 == 0) + 20*(i % 11 == 0) + 5*math.sin(i/5) + rng.randint(-8, 8)))
+        all_rows.append({"date": d.isoformat(), "cups": cups, "weather": weather, "is_holiday": False,
+                         "event": event, "stockout": False, "data_source": "synthetic"})
+    c = demo_context("2026-10-21")
+    history = [r for r in all_rows if r["date"] <= c["sales_date"]][-28:]
+    history[-1]["cups"] = c["cups_sold"]
+    save_json(base / "examples" / "input.json", {"context": c, "history": history})
+    write_template(base / "examples" / "cafe_input.xlsx", c, history)
+    safe_csv(base / "examples" / "history.csv", history)
+    cases = []
+    for index in range(35, 75):
+        target = all_rows[index]
+        ref = all_rows[index-2]
+        context = demo_context((date.fromisoformat(target["date"])-timedelta(days=1)).isoformat())
+        context.update(cups_sold=ref["cups"], weather=target["weather"], nearby_event=target["event"], opening_stock_kg=0,
+                       safety_stock_kg=0, owner_comment="模拟：没有额外判断", max_order_kg=20)
+        cases.append({"context": context, "history": all_rows[max(0,index-29):index-1], "actual_cups": target["cups"]})
+    save_json(base / "examples" / "synthetic_backtest_cases.json", cases)
+    save_json(base / "examples" / "data_manifest.json", {
+        "source": "team_created_synthetic", "seed": 20261021, "generator": "make_examples.py",
+        "contains_real_business_records": False, "forecast_accuracy_claim": None,
+        "note": "人为规律和随机扰动仅用于工程测试。不得把模型在这些案例的效果称为真实店铺验证。"})
+
+
+if __name__ == "__main__":
+    generate(Path(__file__).resolve().parent)
diff --git a/local_app/original/cafe_ollama_stock_original.py b/local_app/original/cafe_ollama_stock_original.py
new file mode 100644
index 0000000000000000000000000000000000000000..75576f6f587020b78866f6f33e26ff46830a3268
--- /dev/null
+++ b/local_app/original/cafe_ollama_stock_original.py
@@ -0,0 +1,138 @@
+import requests
+import json
+
+# ================= 原有配置 =================
+OLLAMA_URL = "http://127.0.0.1:11434/api/generate"
+MODEL_NAME = "llama3.1:8b"
+log_file = "cafe_decision_log.txt"
+total_round = 10
+
+# 业务常量
+COFFEE_POWDER_PER_CUP = 0.018
+# 新增：人工合理范围，根据你的场景设置，你可以自己改
+MIN_STOCK = 5
+MAX_STOCK = 80
+
+print("====咖啡店AI咖啡粉进货预测====")
+coffee_cups = int(input("1. 昨日销售杯数："))
+weather = input("2. 明日天气：")
+nearby_event = input("3. 周边活动：")
+weekday = input("4. 明天是周几：")
+is_holiday = input("5. 是否节假日（是/否）：")
+owner_comment = input("6. 店主看法：")
+owner_opinion = owner_comment.strip() if owner_comment.strip() else "店主希望不要囤太多货，优先减少浪费"
+
+result_list = []
+
+def ai_first_predict(coffee_cups, powder_per_cup, weather, nearby_event, weekday, is_holiday):
+    prompt = f"""
+你是咖啡店库存顾问，根据信息预测明天咖啡粉进货公斤数。
+昨日销量：{coffee_cups}杯
+每杯消耗咖啡粉：{powder_per_cup} kg
+星期：{weekday}
+是否节假日：{is_holiday}
+明日天气：{weather}
+周边活动：{nearby_event}
+【硬性规则】预测进货量必须在 {MIN_STOCK} ~ {MAX_STOCK} kg 之间，不能超出这个范围，符合咖啡店真实进货逻辑，不要夸张。
+只输出JSON：{{"suggest_kg":数字,"risk_comment":"风险描述"}}
+不要多余文字
+"""
+    payload = {
+        "model": MODEL_NAME,
+        "prompt": prompt,
+        "temperature": 0.85,
+        "stream": False
+    }
+    try:
+        res = requests.post(OLLAMA_URL, json=payload, timeout=60)
+        res.raise_for_status()
+        raw = res.json()["response"].strip()
+        s = raw.find("{")
+        e = raw.rfind("}") + 1
+        data = json.loads(raw[s:e])
+        # Python侧二次截断兜底，防止AI无视规则输出离谱数字
+        data["suggest_kg"] = max(MIN_STOCK, min(MAX_STOCK, float(data["suggest_kg"])))
+        return data
+    except Exception as e:
+        print(f"第一轮预测报错：{e}")
+        return None
+
+
+def ai_final_decision(base_kg, powder_per_cup, coffee_cups, owner_opinion, weather, nearby_event, weekday, is_holiday):
+    prompt = f"""
+基于初次推荐{base_kg}kg，结合店主意见：{owner_opinion}
+昨日销量{coffee_cups}杯，每杯耗粉{powder_per_cup}kg，星期{weekday}，节假日：{is_holiday}
+天气：{weather}，周边活动：{nearby_event}
+【硬性规则】最终进货量必须在 {MIN_STOCK} ~ {MAX_STOCK} kg 之间，符合咖啡店真实经营，禁止极端离谱数值。
+重新权衡，输出最终进货量JSON格式：{{"final_kg":数字,"comment":"说明"}}
+"""
+    payload = {
+        "model": MODEL_NAME,
+        "prompt": prompt,
+        "temperature": 0.85,
+        "stream": False
+    }
+    try:
+        res = requests.post(OLLAMA_URL, json=payload, timeout=60)
+        res.raise_for_status()
+        raw = res.json()["response"].strip()
+        s = raw.find("{")
+        e = raw.rfind("}") + 1
+        data = json.loads(raw[s:e])
+        # 兜底截断
+        data["final_kg"] = max(MIN_STOCK, min(MAX_STOCK, float(data["final_kg"])))
+        return data
+    except Exception as e:
+        raise e
+
+
+with open(log_file, "w", encoding="utf-8") as f:
+    f.write("====咖啡店咖啡粉进货AI预测日志====\n")
+
+for i in range(1, total_round + 1):
+    print(f"\n----------【第 {i}/{total_round} 轮】----------")
+    first_res = ai_first_predict(coffee_cups, COFFEE_POWDER_PER_CUP, weather, nearby_event, weekday, is_holiday)
+    if first_res is None:
+        print("❌第一轮预测失败，跳过本轮")
+        continue
+    ai_rec = float(first_res["suggest_kg"])
+    print(f"✅【AI第一轮模拟推荐】推荐进货：{ai_rec:.2f} kg，风险提示：{first_res['risk_comment']}")
+    try:
+        final_out = ai_final_decision(ai_rec, COFFEE_POWDER_PER_CUP, coffee_cups, owner_opinion, weather, nearby_event, weekday, is_holiday)
+        final_val = float(final_out["final_kg"])
+        print(f"✅【AI正在结合海量模拟数据 + 店主经验，独立重新权衡，生成最终方案...】")
+        print(f"✅本轮最终进货推荐：{final_val:.2f} kg，备注：{final_out['comment']}")
+        result_list.append(final_val)
+        log_line = f"第{i}轮 | 初次:{ai_rec:.2f}kg | 最终:{final_val:.2f}kg | {final_out['comment']}\n"
+        with open(log_file, "a", encoding="utf-8") as f:
+            f.write(log_line)
+    except Exception as err:
+        print(f"❌本轮二次决策失败（主+兜底模型全部挂掉）：{err}，跳过本轮")
+        final_val = ai_rec
+        result_list.append(final_val)
+        print(f"⚠️  二次决策异常，暂用第一轮推荐值：{final_val:.2f} kg")
+        log_line = f"第{i}轮 | 初次:{ai_rec:.2f}kg | 二次失败，复用初次值:{final_val:.2f}kg\n"
+        with open(log_file, "a", encoding="utf-8") as f:
+            f.write(log_line)
+
+
+print("\n======== 全部轮次运行结束 ========")
+print(f"全部有效结果：{result_list}")
+if len(result_list) >= 5:
+    sorted_res = sorted(result_list)
+    trimmed = sorted_res[2:-2]
+    avg_val = sum(trimmed) / len(trimmed)
+    print(f"排序后全部有效结果: {sorted_res}")
+    print(f"剔除最小2个、最大2个之后保留数据: {trimmed}")
+    print(f"🎯 综合最终建议进货量（截尾均值）: {avg_val:.2f} kg")
+else:
+    print("⚠️ 有效轮次不足，无法剔除极值，可用结果：", result_list)
+
+with open(log_file, "a", encoding="utf-8") as f:
+    f.write("\n===== 汇总 =====\n")
+    if len(result_list) >= 5:
+        f.write(f"原始列表:{result_list}\n剔除极值后:{trimmed}\n最终推荐进货 {avg_val:.2f} kg\n")
+    else:
+        f.write(f"有效数据不足，原始列表:{result_list}\n")
+
+print(f"\n📝 {total_round}轮模拟运行完毕！所有结果保存在 {log_file}")
