-  [/^([+−-]?[\d,.]+) (bags?|cartons?|packs?) vs\. the ordinary reference scenario$/, (m,l)=>select(l,`${m[1]} ${units(m[2],l)} berbanding senario rujukan biasa`,`${m[1]} ${units(m[2],l)} frente al escenario ordinario de referencia`)],
