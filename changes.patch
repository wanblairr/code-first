+            if result["status"] == "superseded":
+                result = next((p for p in self.store.snapshot()["proposals"]
+                               if p["status"] == "pending" and p.get("base_input_hash") == doc["input_hash"]), result)
+            if result["status"] == "pending" and not result.get("cloud_inference"):
