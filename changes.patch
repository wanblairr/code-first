+import copy
+import json
+import unittest
+from pathlib import Path
+
+from cafe_core import CafeError
+from cafe_materials import plan, validate_quantities
+
+
+BASE = Path(__file__).resolve().parents[1] / "examples_v3"
+
+
+class MaterialsTests(unittest.TestCase):
+    def setUp(self):
+        self.inventory = json.loads((BASE / "inventory.json").read_text(encoding="utf-8"))
+        self.recipes = json.loads((BASE / "recipes.json").read_text(encoding="utf-8"))
+        self.suppliers = json.loads((BASE / "suppliers.json").read_text(encoding="utf-8"))
+        self.forecast = {"items": [{"sku": "espresso", "forecast_units": 20}, {"sku": "latte", "forecast_units": 40}, {"sku": "oat_latte", "forecast_units": 20}]}
+
+    def make_plan(self):
+        return plan(self.forecast, self.inventory, self.recipes, self.suppliers, "2026-10-23")
+
+    def test_bom_aggregates_shared_beans_and_does_not_subtract_today_twice(self):
+        output = self.make_plan()
+        rows = {x["ingredient_id"]: x for x in output["items"]}
+        self.assertEqual(rows["coffee_beans"]["forecast_usage"], 1440)
+        self.assertEqual(rows["coffee_beans"]["shortage"], 840)
+        self.assertEqual(rows["coffee_beans"]["suggested_quantity"], 1000)
+        self.assertEqual(rows["milk"]["suggested_quantity"], 8000)
+        self.assertEqual(rows["oat_milk"]["due_inbound"], 1000)
+        self.assertEqual(rows["oat_milk"]["suggested_quantity"], 3000)
+        self.assertEqual(rows["cup"]["suggested_quantity"], 50)
+        self.assertEqual(output["blockers"], [])
+
+    def test_decimal_pack_ceiling_does_not_add_a_spurious_pack(self):
+        stock = self.inventory["items"][0]
+        stock.update(batches=[], safety_stock=0, pack_size=0.1, min_order=0)
+        self.recipes["recipes"][0]["ingredients"][0]["quantity"] = 0.1
+        self.forecast["items"] = [{"sku": "espresso", "forecast_units": 3}, {"sku": "latte", "forecast_units": 0}, {"sku": "oat_latte", "forecast_units": 0}]
+        self.assertEqual(self.make_plan()["items"][0]["suggested_quantity"], 0.3)
+
+    def test_moq_is_rounded_up_to_whole_packs(self):
+        self.inventory["items"][0].update(min_order=1250, pack_size=500)
+        self.assertEqual(self.make_plan()["items"][0]["suggested_quantity"], 1500)
+
+    def test_expired_and_blocked_batches_cannot_cover_demand(self):
+        self.inventory["items"][0]["batches"] = [
+            {"quantity": 100, "usable_through": "2026-10-22", "blocked": False},
+            {"quantity": 200, "usable_through": "2026-10-30", "blocked": True},
+            {"quantity": 300, "usable_through": "2026-10-23", "blocked": False},
+        ]
+        row = self.make_plan()["items"][0]
+        self.assertEqual(row["available"], 300)
+        self.assertEqual(row["physical_on_hand"], 600)
+        self.assertEqual(row["excluded_stock"], 300)
+
+    def test_late_inbound_excluded_and_late_new_delivery_blocks(self):
+        self.inventory["items"][2]["inbounds"][0]["arrival_date"] = "2026-10-24"
+        self.suppliers["suppliers"][1]["delivery_date"] = "2026-10-24"
+        output = self.make_plan()
+        row = output["items"][2]
+        self.assertEqual(row["due_inbound"], 0)
+        self.assertEqual(row["late_inbound"], 1000)
+        self.assertEqual(row["suggested_quantity"], 4000)
+        self.assertTrue(any("无法" in value for value in output["blockers"]))
+
+    def test_order_and_storage_limits_block_instead_of_silent_clamping(self):
+        self.inventory["items"][0].update(max_order=500, storage_capacity=1500)
+        output = self.make_plan()
+        self.assertEqual(output["items"][0]["suggested_quantity"], 1000)
+        self.assertEqual(len(output["items"][0]["blockers"]), 2)
+        with self.assertRaises(CafeError):
+            validate_quantities(output, {})
+        # Explicit owner reduction is allowed, with unmet shortage kept visible.
+        rows = validate_quantities(output, {"coffee_beans": 500})
+        self.assertEqual(rows[0]["approved_quantity"], 500)
+        self.assertTrue(rows[0]["approval_warnings"])
+
+    def test_missing_recipe_unknown_ingredient_and_unit_mismatch_fail(self):
+        original = copy.deepcopy(self.recipes)
+        self.recipes["recipes"] = self.recipes["recipes"][1:]
+        with self.assertRaises(CafeError):
+            self.make_plan()
+        self.recipes = copy.deepcopy(original)
+        self.recipes["recipes"][0]["ingredients"][0]["unit"] = "kg"
+        with self.assertRaises(CafeError):
+            self.make_plan()
+        self.recipes = original
+        self.recipes["recipes"][0]["ingredients"][0]["ingredient_id"] = "missing"
+        with self.assertRaises(CafeError):
+            self.make_plan()
+
+    def test_snapshot_shop_and_date_mismatches_fail(self):
+        for change in ({"as_of_date": "2026-10-21"}, {"shop_id": "OTHER"}, {"data_source": "real"}):
+            original = copy.deepcopy(self.inventory)
+            self.inventory.update(change)
+            with self.assertRaises(CafeError):
+                self.make_plan()
+            self.inventory = original
+
+    def test_received_inbound_must_not_be_counted_twice(self):
+        self.inventory["items"][2]["inbounds"][0]["arrival_date"] = "2026-10-22"
+        with self.assertRaises(CafeError):
+            self.make_plan()
+
+    def test_duplicate_forecast_or_recipe_rejected(self):
+        self.forecast["items"].append(copy.deepcopy(self.forecast["items"][0]))
+        with self.assertRaises(CafeError):
+            self.make_plan()
+
+    def test_quantity_validation_guards_packages_limits_and_unknown_ids(self):
+        output = self.make_plan()
+        for override in ({"unknown": 1}, {"coffee_beans": -1}, {"coffee_beans": True}, {"coffee_beans": float("nan")}, {"coffee_beans": 750}, {"coffee_beans": 15000}):
+            with self.subTest(override=override), self.assertRaises(CafeError):
+                validate_quantities(output, override)
+        rows = validate_quantities(output, {"coffee_beans": 0})
+        self.assertTrue(rows[0]["approval_warnings"])
+        self.assertEqual(rows[0]["approved_quantity"], 0)
+        self.assertNotIn("approved_quantity", output["items"][0])
+        with self.assertRaises(CafeError):
+            validate_quantities(output, {row["ingredient_id"]: 0 for row in output["items"]})
+
+    def test_piece_stock_is_whole_and_values_must_be_finite(self):
+        for value in (0.5, float("nan"), float("inf"), True):
+            self.inventory["items"][3]["batches"][0]["quantity"] = value
+            with self.subTest(value=value), self.assertRaises(CafeError):
+                self.make_plan()
+
+    def test_fractional_forecast_units_are_allowed_for_expected_demand(self):
+        self.forecast["items"][0]["forecast_units"] = 20.5
+        output = self.make_plan()
+        self.assertEqual(output["items"][0]["forecast_usage"], 1449)
+        self.assertEqual(output["items"][3]["forecast_usage"], 80.5)
+
+    def test_forecast_target_and_supplier_references_validated(self):
+        self.forecast["target_date"] = "2026-10-24"
+        with self.assertRaises(CafeError):
+            self.make_plan()
+        self.forecast.pop("target_date")
+        self.inventory["items"][0]["supplier_id"] = "missing"
+        with self.assertRaises(CafeError):
+            self.make_plan()
+
+    def test_each_active_menu_sku_requires_explicit_prediction(self):
+        self.forecast["items"] = self.forecast["items"][:1]
+        with self.assertRaisesRegex(CafeError, "在售配方缺少预测"):
+            self.make_plan()
+
+
+if __name__ == "__main__":
+    unittest.main()
