+  'MYR '+(cents/100).toLocaleString(language==='zh'?'zh-CN':language,{minimumFractionDigits:2,maximumFractionDigits:2}):
+  ({en:'Pending confirmation',zh:'待确认',ms:'Menunggu pengesahan',es:'Pendiente de confirmar'}[language]||'Pending confirmation');
+function parsePrice(text){
+  if(!/^(0|[1-9]\d*)(?:\.\d{1,2})?$/.test(text))return null;
+  const [whole,fraction='']=text.split('.');
+  const cents=Number(whole)*100+Number(fraction.padEnd(2,'0'));
+  return Number.isSafeInteger(cents)&&cents>=0&&cents<=1000000000?cents:null;
