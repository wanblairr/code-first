+import {normalizeSnapshot as browser} from '../dist/demo/runpod-ui.js';
+const snapshot={target_date:'2026-10-25',data_source:'owner_entered',predictions:[{sku:'bv_013',local_forecast_units:36}],context:{temperature_c:27,precipitation_mm:24,is_holiday:false}};
+test('own sales source is preserved in request preview and server normalization',()=>{assert.deepEqual(browser(snapshot),server(snapshot));assert.equal(server(snapshot).data_source,'owner_entered');const body=buildPayload({endpointId:'endpoint123',model:'Qwen/model'},snapshot);assert.equal(JSON.parse(body.input.messages[1].content).data_source,'owner_entered');});
+test('unknown data-source labels cannot bypass normalization',()=>{assert.throws(()=>browser({...snapshot,data_source:'unknown'}));assert.throws(()=>server({...snapshot,data_source:'unknown'}));});
diff --git a/public_website/tests/account-ui-store.test.mjs b/public_website/tests/account-ui-store.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..76d8956a978f09b04706876ef4db2bc43fa41ac4
--- /dev/null
+++ b/public_website/tests/account-ui-store.test.mjs
@@ -0,0 +1,15 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createAccountStore} from '../dist/demo/account-ui.mjs';
+const response=(status,data)=>({status,ok:status>=200&&status<300,json:async()=>data});
+const user={id:'user-a'};
+test('guest cannot save and cannot make a cloud request',async()=>{let calls=0;const s=createAccountStore({request:async()=>{calls++;}});await assert.rejects(s.saveProfile({shopName:'Guest'}));assert.equal(calls,0);});
+test('coalesces edits with server revision and CSRF, without leaking identity into request',async()=>{const requests=[],statuses=[];const s=createAccountStore({initialUser:user,csrf:'csrf-only',revision:3,onStatus:v=>statuses.push(v),request:async(url,options)=>{requests.push({url,options});return response(200,{revision:4});}});const p1=s.saveProfile({version:1,shopName:'One'}),value={version:1,shopName:'Two'},p2=s.saveProfile(value);value.shopName='mutated';await s.flush();await Promise.all([p1,p2]);assert.equal(requests.length,1);const body=JSON.parse(requests[0].options.body);assert.deepEqual(body,{operation:'shop',revision:3,state:{version:1,shopName:'Two'}});assert.equal(requests[0].options.headers['X-CSRF-Token'],'csrf-only');assert.equal(requests[0].options.credentials,'same-origin');assert.equal(s.getSnapshot().shopName,'Two');assert.equal(s.getStatus(),'saved');assert.equal(s.isDirty(),false);assert.ok(statuses.includes('saving'));});
+test('edits during a save are serialized with the new revision',async()=>{const requests=[];let release;const s=createAccountStore({initialUser:user,revision:0,request:async(url,o)=>{const body=JSON.parse(o.body);requests.push(body);if(requests.length===1)await new Promise(r=>{release=r;});return response(200,{revision:body.revision+1});}});const a=s.saveProfile({shopName:'A'});const first=s.flush();const b=s.saveProfile({shopName:'B'});release();await first;await Promise.all([a,b]);assert.deepEqual(requests.map(v=>[v.revision,v.state.shopName]),[[0,'A'],[1,'B']]);assert.equal(s.isDirty(),false);});
+test('conflict does not overwrite cloud data and export retains the user edit',async()=>{let calls=0;const statuses=[];const s=createAccountStore({initialUser:user,onStatus:v=>statuses.push(v),request:async()=>{calls++;return response(409,{code:'CONFLICT'});}});const pending=s.saveProfile({shopName:'Keep me'});const rejected=assert.rejects(pending,e=>e.code==='CONFLICT');await assert.rejects(s.flush(),e=>e.code==='CONFLICT');await rejected;assert.equal(s.getStatus(),'conflict');assert.equal(s.getSnapshot().shopName,'Keep me');assert.equal(s.isDirty(),true);await assert.rejects(s.retry(),e=>e.code==='CONFLICT');assert.equal(calls,1);assert.ok(!statuses.includes('saved'));});
+test('failed write stays unsaved and explicit retry uses original revision',async()=>{let calls=0;const revisions=[];const s=createAccountStore({initialUser:user,revision:8,request:async(u,o)=>{revisions.push(JSON.parse(o.body).revision);if(++calls===1)throw Error('network');return response(200,{revision:9});}});const p=s.saveProfile({shopName:'Keep this'});const rejected=assert.rejects(p);await assert.rejects(s.flush());await rejected;assert.equal(s.getStatus(),'error');assert.equal(s.isDirty(),true);await s.retry();assert.equal(s.getStatus(),'saved');assert.deepEqual(revisions,[8,8]);});
+
+test('new edits after a conflict retain the conflict and reject rather than hang',async()=>{let calls=0;const s=createAccountStore({initialUser:user,request:async()=>{calls++;return response(409,{code:'revision_conflict'});}});const first=s.saveProfile({shopName:'First'});const firstReject=assert.rejects(first);await assert.rejects(s.flush());await firstReject;await assert.rejects(s.saveProfile({shopName:'Latest edit'}),e=>e.code==='CONFLICT');assert.equal(s.getStatus(),'conflict');assert.equal(s.getSnapshot().shopName,'Latest edit');assert.equal(calls,1);assert.equal(s.isDirty(),true);});
+
+test('hung cloud write times out and retains pending data',async()=>{const s=createAccountStore({initialUser:user,timeoutMs:5,request:()=>new Promise(()=>{})});const p=s.saveProfile({shopName:'Pending'});const rejected=assert.rejects(p,/timed out/);await assert.rejects(s.flush(),/timed out/);await rejected;assert.equal(s.getStatus(),'error');assert.equal(s.isDirty(),true);assert.equal(s.getSnapshot().shopName,'Pending');});
+test('hung response body also times out',async()=>{const s=createAccountStore({initialUser:user,timeoutMs:5,request:async()=>({ok:true,status:200,json:()=>new Promise(()=>{})})});const p=s.saveProfile({shopName:'Pending'});const rejected=assert.rejects(p,/timed out/);await assert.rejects(s.flush(),/timed out/);await rejected;assert.equal(s.getStatus(),'error');});
diff --git a/public_website/tests/account.test.mjs b/public_website/tests/account.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4d6a5934f0cb9b2dd1f6012eaad9059236720593
