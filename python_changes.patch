+"""Owner-only Sandbox demonstration of an immutable approved procurement draft.
+
+No automatic fallback, provider probing, webhook delivery claims, stock updates
+or supplier-order side effects. The 24h window is a user's stated contact time,
+not a provider-verified event; both preview and send enforce its expiry.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from datetime import date, datetime, timedelta, timezone
+from decimal import Decimal, DecimalException
+import json
+import re
+import time
+import uuid
+
+from cafe_core import CafeError, canonical, fingerprint, now
+from cafe_whatsapp_sandbox import SandboxClient, SandboxAPIError, recipient_label
+
+
+def _line(value):
+    if not isinstance(value, str) or not value or len(value) > 300 or any(ord(c) < 32 or ord(c) == 127 for c in value):
+        raise CafeError("已批准采购资料含无效文本，请先核对记录。")
+    return value
+
+
+class WhatsAppSandboxWorkflow:
+    def __init__(self, service, config):
+        self.service, self.config = service, config
+        self.client_factory = SandboxClient
+        with service.store.connect() as db:
+            db.executescript("""
+            CREATE TABLE IF NOT EXISTS whatsapp_sandbox_messages (dedup TEXT PRIMARY KEY, document TEXT NOT NULL);
+            CREATE TABLE IF NOT EXISTS whatsapp_sandbox_previews (id TEXT PRIMARY KEY, document TEXT NOT NULL);
+            """)
+            for row in db.execute("SELECT dedup,document FROM whatsapp_sandbox_messages").fetchall():
+                document = json.loads(row["document"])
+                if document.get("status") == "submitting":
+                    document.update(status="unknown", message="上次本人沙盒发送结果未知；禁止重试，请先核对本人手机。")
+                    db.execute("UPDATE whatsapp_sandbox_messages SET document=? WHERE dedup=?", (canonical(document), row["dedup"]))
+
+    def public(self):
+        with self.service.store.connect() as db:
+            return [json.loads(row[0]) for row in db.execute("SELECT document FROM whatsapp_sandbox_messages ORDER BY rowid DESC LIMIT 30")]
+
+    def _client(self):
+        cfg = self.config.public().get("whatsapp_sandbox", {})
+        if not cfg.get("enabled") or not cfg.get("credential_present") or not cfg.get("recipient_id"):
+            raise CafeError("请先在演示电脑配置本人 360dialog Sandbox；这不会解锁 Meta 正式账户。")
+        key = self.config.secret("whatsapp_sandbox_api_key")
+        client = self.client_factory(key, cfg["recipient_kind"], cfg["recipient_id"], timeout=10)
+        stamp = fingerprint({"settings": {name: cfg.get(name) for name in ("enabled", "recipient_kind", "recipient_id")},
+                             "credential": fingerprint({"sandbox_credential": key})})
+        return cfg, client, stamp
+
+    def _contact(self, value, opt_in, window_confirmed):
+        if opt_in is not True or window_confirmed is not True:
+            raise CafeError("请确认绑定标识属于本人，并确认本人已主动联系沙盒且仍在 24 小时窗口内。")
+        if not isinstance(value, str) or len(value) > 40:
+            raise CafeError("请填写本人最近主动联系沙盒的准确时间。")
+        try:
+            contacted = datetime.fromisoformat(value.replace("Z", "+00:00"))
+            if contacted.tzinfo is None:
+                raise ValueError("timezone")
+            contacted = contacted.astimezone(timezone.utc)
+            current = self.service.clock().astimezone(timezone.utc)
+            if contacted > current or current - contacted >= timedelta(hours=24):
+                raise ValueError("window")
+        except (ValueError, TypeError, OverflowError):
+            raise CafeError("主动联系时间不能在未来或超过 24 小时；请先用本人 WhatsApp 给沙盒发消息，再填写实际时间。") from None
+        return contacted.isoformat(), contacted.timestamp() + 86400
+
+    def _approved(self, draft_id):
+        if isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-"):
+            draft, order = self.service.bom_approved_draft(draft_id)
+            row = None
+        else:
+            draft = self.service.store.draft(draft_id)
+            with self.service.store.connect() as db:
+                row = db.execute("SELECT document FROM orders WHERE id=?", (draft["order_id"],)).fetchone()
+            order = json.loads(row[0]) if row else None
+        if order is None:
+            raise CafeError("只有已审批的采购草稿可以进行本人沙盒演示。")
+        if date.fromisoformat(order["target_date"]) < self.service.clock().astimezone(timezone(timedelta(hours=8))).date():
+            raise CafeError("采购日期已过，不能为历史清单发送本人沙盒演示。")
+        items = [item for item in order["items"] if item["supplier_id"] == draft["supplier_id"] and item.get("base_quantity", item["approved_quantity"]) > 0]
+        if not items:
+            raise CafeError("此草稿没有已批准的采购数量。")
+        parts = []
+        for item in items:
+            try:
+                amount, pack = Decimal(str(item["approved_quantity"])), Decimal(str(item["pack_size"]))
+                if not amount.is_finite() or not pack.is_finite() or amount <= 0 or pack <= 0:
+                    raise ValueError("quantity")
+                packs = amount / pack
+                if packs != packs.to_integral_value():
+                    raise ValueError("packs")
+            except (DecimalException, ValueError, TypeError, OverflowError):
+                raise CafeError("批准的完整包装数量无效，已停止本人沙盒演示。") from None
+            parts.append(f"{_line(item['name'])}: {packs:g} × {pack:g} {_line(item['unit'])} = {amount:g} {_line(item['unit'])}")
+        body = ("PERSONAL SANDBOX DEMO / 本人沙盒模拟，非正式下单\n"
+                f"Target date / 到货日: {_line(order['target_date'])}\n"
+                f"Approved order / 已批准订单: {_line(order['id'])}\n"
+                f"Supplier / 模拟供应商: {_line(draft['supplier_name'])}\n" + "\n".join(parts) +
+                "\nSimulation only. Do not fulfill, invoice or deliver.\n仅用于本人 API 演示；不向供应商下单，不付款、不入库。")
+        if isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-"):
+            # Use the exact immutable approval including pack rounding and prices.
+            body = ("PERSONAL SANDBOX DEMO / 本人沙盒模拟，非正式下单\n"
+                + draft["body"]
+                + "\nSimulation only. Do not fulfill, invoice or deliver.\n"
+                + "仅用于本人 API 演示；不向供应商下单，不付款、不入库。")
+        return draft, order, body
+
+    def preview(self, draft_id, opt_in=False, window_confirmed=False, contact_at=None):
+        with self.service.lock:
+            contact_at, window_end = self._contact(contact_at, opt_in, window_confirmed)
+            draft, order, body = self._approved(draft_id)
+            cfg, client, stamp = self._client()
+            rendered = client.preview(body)
+            document = {"preview_id": uuid.uuid4().hex, "draft_id": draft_id,
+                        "draft_hash": fingerprint(draft), "order_hash": fingerprint(order), "configuration_hash": stamp,
+                        "body": rendered["body"], "payload": rendered["payload"],
+                        "recipient_label": recipient_label(cfg["recipient_kind"], cfg["recipient_id"]),
+                        "contact_at": contact_at, "window_evidence": "user_attestation_not_provider_verified",
+                        "expires_at": time.time() + min(600, max(0, window_end - self.service.clock().timestamp()))}
+            # The actual wall clock also bounds preview lifetime. Tests and demo
+            # clocks may be fixed, so the contact window itself is checked using
+            # the service clock again on send.
+            with self.service.store.connect() as db:
+                db.execute("DELETE FROM whatsapp_sandbox_previews WHERE json_extract(document,'$.expires_at') < ?", (time.time(),))
+                db.execute("INSERT INTO whatsapp_sandbox_previews VALUES(?,?)", (document["preview_id"], canonical(document)))
+            return {key: deepcopy(document[key]) for key in ("preview_id", "body", "recipient_label", "contact_at", "window_evidence")} | {"status": "preview", "provider": "360dialog_sandbox"}
+
+    def send(self, draft_id, preview_id, opt_in=False, window_confirmed=False, confirmed=False, contact_at=None):
+        if confirmed is not True:
+            raise CafeError("请先阅读完整预览并单独确认本次本人沙盒实际发送；采购审批不会发消息。")
+        if not isinstance(preview_id, str) or not re.fullmatch(r"[a-f0-9]{32}", preview_id):
+            raise CafeError("请先生成本人沙盒消息预览。")
+        with self.service.lock:
+            contact_at, unused_window_end = self._contact(contact_at, opt_in, window_confirmed)
+            draft, order, body = self._approved(draft_id)
+            cfg, client, stamp = self._client()
+            rendered = client.preview(body)
+            with self.service.store.connect() as db:
+                row = db.execute("SELECT document FROM whatsapp_sandbox_previews WHERE id=?", (preview_id,)).fetchone()
+            preview = json.loads(row[0]) if row else None
+            if (not preview or preview["expires_at"] <= time.time() or preview["draft_id"] != draft_id
+                    or preview["draft_hash"] != fingerprint(draft) or preview["order_hash"] != fingerprint(order)
+                    or preview["configuration_hash"] != stamp or preview["contact_at"] != contact_at
+                    or preview["body"] != rendered["body"] or preview["payload"] != rendered["payload"]):
+                raise CafeError("本人沙盒预览已过期，或采购、设置、联系时间有变化，请重新预览。")
+            identity = {"provider": "360dialog_sandbox", "draft_id": draft_id,
+                        "recipient_kind": cfg["recipient_kind"], "recipient_id": cfg["recipient_id"], "payload": rendered["payload"]}
+            dedup = fingerprint(identity)
+            with self.service.store.connect() as db:
+                row = db.execute("SELECT document FROM whatsapp_sandbox_messages WHERE dedup=?", (dedup,)).fetchone()
+                previous = json.loads(row[0]) if row else None
+                if previous and (previous["status"] != "failed" or previous.get("preview_id") == preview_id):
+                    return previous
+                record = {"dedup": dedup, "provider": "360dialog_sandbox", "kind": "personal_procurement_demo",
+                          "draft_id": draft_id, "order_id": order["id"], "target_date": order["target_date"],
+                          "recipient_label": preview["recipient_label"], "preview_id": preview_id,
+                          "status": "submitting", "delivery_confirmed": False, "at": now(),
+                          "attempt": previous["attempt"] + 1 if previous else 1,
+                          "window_evidence": "user_attestation_not_provider_verified"}
+                db.execute("INSERT OR REPLACE INTO whatsapp_sandbox_messages VALUES(?,?)", (dedup, canonical(record)))
+                self.service.store.event(db, "owner", "whatsapp_sandbox_requested", dedup,
+                                         {"draft_id": draft_id, "provider": "360dialog_sandbox", "recipient_label": preview["recipient_label"]})
+            try:
+                result = client.send(deepcopy(preview["payload"]))
+                record.update(status="accepted", message_id=result["message_id"],
+                              message="360dialog 沙盒 API 已接受；尚无可验证送达回执，请在本人手机核对。非正式下单，不代表 Meta 账户解锁。")
+            except SandboxAPIError as exc:
+                record.update(status="unknown" if exc.outcome_unknown else "failed",
+                              message="本人沙盒发送结果未知；禁止重试，请先核对本人手机。" if exc.outcome_unknown else "沙盒未接受请求，请核对凭据、固定本人标识、会话窗口及剩余额度后重新预览。")
+            except Exception:
+                record.update(status="unknown", message="本人沙盒发送结果未知；禁止重试，请先核对本人手机。")
+            with self.service.store.connect() as db:
+                db.execute("UPDATE whatsapp_sandbox_messages SET document=? WHERE dedup=?", (canonical(record), dedup))
+                self.service.store.event(db, "owner", "whatsapp_sandbox_result", dedup,
+                                         {"status": record["status"], "delivery_confirmed": False, "provider": "360dialog_sandbox"})
+            return record
