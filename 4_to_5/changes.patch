+const STATUS={disabled:'本地建议已关闭。',ready:'可选本地复核，不改变采购数值。',stale:'输入已改变，旧建议已失效。',offline:'本地服务离线；现有预测和采购功能可继续使用。',running:'正在本机生成10次估计，请等待；不会发送数据到云端。',completed:'本地复核完成：十次估计去掉两高两低，保留六次。',busy:'本地模型正忙，请稍后检查状态。',unsupported:'当前输入不受本地模型支持。',invalid_output:'本次未得到完整有效的十次估计，请人工核对；采购仍使用现有预测器。',timeout:'本页等待超时。计算可能仍在继续，不会自动重复请求。',already_submitted:'此输入已提交，避免重复计算；可检查服务状态。',model_unavailable:'本地模型不可用，采购仍使用现有预测器。',invalid_input:'请先核对日期、模拟历史和输入。'};
