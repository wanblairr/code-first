@@ -0,0 +1,156 @@
+"""Owner-maintained procurement catalog; MYR amounts are integer cents.
+
+Manual products supplement the simulated four-ingredient demand model. Changing
+catalog data invalidates pending approval hashes; orders retain copied snapshots.
+"""
+from copy import deepcopy
+from decimal import Decimal
+import re
+import uuid
+
+from cafe_core import CafeError
+
+CATEGORIES = ["咖啡与茶", "乳品与替代奶", "糖浆与调味", "烘焙与食品", "杯具与包装", "清洁与门店用品", "其他"]
+TEMPLATES = [
+    {"name": "低脂牛奶", "category": "乳品与替代奶", "purchase_unit": "盒"},
+    {"name": "杏仁奶", "category": "乳品与替代奶", "purchase_unit": "盒"},
+    {"name": "豆奶", "category": "乳品与替代奶", "purchase_unit": "盒"},
+    {"name": "抹茶粉", "category": "咖啡与茶", "purchase_unit": "袋"},
+    {"name": "红茶茶叶", "category": "咖啡与茶", "purchase_unit": "袋"},
+    {"name": "巧克力粉", "category": "糖浆与调味", "purchase_unit": "袋"},
+    {"name": "香草糖浆", "category": "糖浆与调味", "purchase_unit": "瓶"},
+    {"name": "焦糖糖浆", "category": "糖浆与调味", "purchase_unit": "瓶"},
+    {"name": "可颂", "category": "烘焙与食品", "purchase_unit": "盒"},
+    {"name": "杯盖", "category": "杯具与包装", "purchase_unit": "包"},
+    {"name": "纸巾", "category": "杯具与包装", "purchase_unit": "包"},
+    {"name": "咖啡机清洁剂", "category": "清洁与门店用品", "purchase_unit": "瓶"},
+]
+DEFAULT_PRICES = {"coffee_beans": 2250, "milk": 800, "oat_milk": 1200, "cup": 2500}
+DEFAULT_CATEGORIES = {"coffee_beans": CATEGORIES[0], "milk": CATEGORIES[1], "oat_milk": CATEGORIES[1], "cup": CATEGORIES[4]}
+
+
+def text(value, label, limit=80):
+    if not isinstance(value, str) or not value.strip() or len(value) > limit or any(ord(c) < 32 for c in value):
+        raise CafeError(f"{label}须为非空文本，最多 {limit} 字，不能含控制字符。")
+    return value.strip()
+
+
+def price_cents(value):
+    # Accept decimal text from the UI; never multiply a binary float by 100.
+    if isinstance(value, bool) or not isinstance(value, (str, int, float)):
+        raise CafeError("单价须为 MYR 金额，最多两位小数。")
+    raw = str(value)
+    if not re.fullmatch(r"(?:0|[1-9][0-9]{0,6})(?:\.[0-9]{1,2})?", raw):
+        raise CafeError("单价须为非负 MYR 金额，最多两位小数，不能使用指数格式。")
+    amount = Decimal(raw)
+    if amount > 100000:
+        raise CafeError("每采购单位单价不能超过 MYR 100,000。")
+    return int(amount * 100)
+
+
+def default_catalog(inventory):
+    return {"version": 1, "revision": 1,
+            "prices": {i["ingredient_id"]: DEFAULT_PRICES.get(i["ingredient_id"], 0) for i in inventory["items"]},
+            "products": []}
+
+
+def validate_saved(document, inventory, suppliers):
+    """Validate persisted cents without converting them back through floats."""
+    if not isinstance(document, dict) or set(document) != {"version", "revision", "prices", "products"} or document["version"] != 1:
+        raise CafeError("采购目录格式无效。")
+    if type(document["revision"]) is not int or document["revision"] < 1:
+        raise CafeError("采购目录版本无效。")
+    prices = document["prices"]
+    ids = {i["ingredient_id"] for i in inventory["items"]}
+    if not isinstance(prices, dict) or set(prices) != ids or any(type(v) is not int or not 0 <= v <= 10000000 for v in prices.values()):
+        raise CafeError("原材料单价目录与库存不一致，或金额超出范围。")
+    rows = document["products"]
+    if not isinstance(rows, list) or len(rows) > 50:
+        raise CafeError("手动采购产品最多 50 项。")
+    supplier_ids = {s["supplier_id"] for s in suppliers["suppliers"]}
+    seen = set()
+    for row in rows:
+        if not isinstance(row, dict) or set(row) != {"product_id", "name", "category", "purchase_unit", "quantity", "unit_price_cents", "supplier_id"}:
+            raise CafeError("手动采购产品字段无效。")
+        pid = row["product_id"]
+        if not isinstance(pid, str) or not re.fullmatch(r"custom_[A-Za-z0-9_-]{1,70}", pid) or pid in ids or pid in seen:
+            raise CafeError("手动采购产品编号无效或重复。")
+        seen.add(pid)
+        text(row["name"], "产品名称")
+        text(row["purchase_unit"], "采购单位", 12)
+        if not isinstance(row["category"], str) or row["category"] not in CATEGORIES or not isinstance(row["supplier_id"], str) or row["supplier_id"] not in supplier_ids:
+            raise CafeError("请选择已列明的种类和供应商。")
+        if type(row["quantity"]) is not int or not 0 <= row["quantity"] <= 10000:
+            raise CafeError("手动采购数量须为 0–10,000 的整数。")
+        if type(row["unit_price_cents"]) is not int or not 0 <= row["unit_price_cents"] <= 10000000:
+            raise CafeError("单价金额超出范围。")
+    return deepcopy(document)
+
+
+def update_catalog(old, values, inventory, suppliers):
+    if not isinstance(values, dict) or set(values) != {"revision", "prices", "products"}:
+        raise CafeError("采购目录更新字段无效。")
+    if type(values["revision"]) is not int or values["revision"] != old["revision"]:
+        raise CafeError("采购目录已在其他页面更新，请重新打开后修改。")
+    if not isinstance(values["prices"], dict) or not isinstance(values["products"], list) or len(values["products"]) > 50:
+        raise CafeError("单价须为对象，手动产品最多 50 项。")
+    rows = []
+    for row in values["products"]:
+        if not isinstance(row, dict) or set(row) != {"product_id", "name", "category", "purchase_unit", "quantity", "unit_price_myr", "supplier_id"}:
+            raise CafeError("手动采购产品字段无效。")
+        rows.append({**{k: v for k, v in row.items() if k != "unit_price_myr"},
+                     "product_id": row["product_id"] or "custom_" + uuid.uuid4().hex,
+                     "unit_price_cents": price_cents(row["unit_price_myr"])})
+    result = {"version": 1, "revision": old["revision"] + 1,
+              "prices": {k: price_cents(v) for k, v in values["prices"].items()}, "products": rows}
+    return validate_saved(result, inventory, suppliers)
+
+
+def format_money(cents):
+    return f"MYR {cents // 100:,}.{cents % 100:02d}"
+
+
+def apply_costs(items, quantity_key):
+    for item in items:
+        if "unit_price_cents" not in item:
+            continue  # Legacy snapshots remain readable, without fabricated prices.
+        packs = Decimal(str(item[quantity_key])) / Decimal(str(item["pack_size"]))
+        if packs != packs.to_integral_value() or packs < 0 or packs > 1000000000:
+            raise CafeError("采购包装数无效，无法计算金额。")
+        item["line_total_cents"] = int(packs) * item["unit_price_cents"]
+    return items
+
+
+def totals(items):
+    known = [i for i in items if "line_total_cents" in i]
+    return {"currency": "MYR", "total_cents": sum(i["line_total_cents"] for i in known),
+            "ai_total_cents": sum(i["line_total_cents"] for i in known if i.get("procurement_source") != "manual"),
+            "manual_total_cents": sum(i["line_total_cents"] for i in known if i.get("procurement_source") == "manual"),
+            "prices_complete": len(known) == len(items),
+            "note": "估算金额：按采购单位单价计算，未含税费、运费或折扣；最终以供应商报价为准。"}
+
+
+def decorate_plan(plan, catalog, suppliers):
+    result = deepcopy(plan)
+    contacts = {s["supplier_id"]: s for s in suppliers["suppliers"]}
+    for item in result["items"]:
+        item.update(unit_price_cents=catalog["prices"][item["ingredient_id"]],
+                    category=DEFAULT_CATEGORIES.get(item["ingredient_id"], "其他"), procurement_source="ai")
+    for product in catalog["products"]:
+        contact = contacts[product["supplier_id"]]
+        row = {"ingredient_id": product["product_id"], "name": product["name"], "unit": "pcs",
+               "purchase_unit": product["purchase_unit"], "category": product["category"], "procurement_source": "manual",
+               "target_date": result["target_date"], "forecast_usage": 0, "available": 0,
+               "physical_on_hand": 0, "excluded_stock": 0, "due_inbound": 0, "late_inbound": 0,
+               "safety_stock": 0, "shortage": 0, "suggested_quantity": product["quantity"], "pack_size": 1,
+               "min_order": 0, "max_order": 10000, "storage_capacity": 10000,
+               "supplier_id": contact["supplier_id"], "supplier_name": contact["name"],
+               "delivery_date": contact["delivery_date"], "email": contact["email"], "whatsapp": contact["whatsapp"],
+               "unit_price_cents": product["unit_price_cents"], "approval_warnings": [], "blockers": []}
+        if row["suggested_quantity"] and row["delivery_date"] > result["target_date"]:
+            row["blockers"].append(f"{row['name']}新采购无法在目标日开店前送达。")
+            result["blockers"].extend(row["blockers"])
