+  const extras=[{id:'custom_cups',name:'Reusable shop cups',quantity:2,unit:'box',unitPriceCents:1025}];
+  return {data,forecast,pricebook,rows:replenish(data,initialStock(data),forecast.sales),extras,
+    id:'shop-order',signature:'snapshot-signature',approvedAt:Date.UTC(2026,9,24,0)};
+}
