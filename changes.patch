+function node(tag,className='',text){
+  const item=document.createElement(tag);if(className)item.className=className;
+  if(text!==undefined)item.textContent=String(text);return item;
+}
+function button(id,text,action,className='button secondary'){
+  const b=node('button',className,text);b.id=id;b.type='button';b.addEventListener('click',action);return b;
+}
