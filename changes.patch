+test('UTF8 MIME folding and normalized line endings',()=>{const subject='补货 🥛 café pedido '.repeat(10);const raw=buildGmailMime({to:'dairy@example.com',subject,body:'你好\nleche 🥛\rcafé\r\n谢谢'});const [headers,body]=raw.split('\r\n\r\n');assert.match(headers,/^To: dairy@example\.com\r\n/);assert.equal(Buffer.from(body.replace(/\s/g,''),'base64').toString('utf8'),'你好\r\nleche 🥛\r\ncafé\r\n谢谢');const encoded=[...headers.matchAll(/=\?UTF-8\?B\?([^?]+)\?=/g)];assert.ok(encoded.length>1);assert.ok(encoded.every(x=>Buffer.byteLength(x[0])<=75));assert.equal(encoded.map(x=>Buffer.from(x[1],'base64').toString('utf8')).join(''),subject);});
