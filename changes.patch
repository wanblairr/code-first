+function quantityList(text, locale) {
+  const pattern = new RegExp(`^${names}\\s+${num}\\s+(g|ml|pcs|cups?|bags?|cartons?|packs?)$`);
+  const chunks = text.split(';').map(part=>part.trim());
+  const result = chunks.map(part=>{const match=part.match(pattern);return match?`${units(match[1],locale)} ${match[2]} ${units(match[3],locale)}`:null;});
+  return result.length && result.every(Boolean) ? result.join('; ') : null;
+}
