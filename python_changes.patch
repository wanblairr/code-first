+class BOMWebInMemoryTests(BOMWebTests):
+    """Identical real Handler/auth/SQLite assertions with only socket I/O replaced.
+
+    This is additional coverage, not a claim that loopback networking was tested.
+    The BOMWebTests above retain their real HTTPConnection transport unchanged.
+    """
+
+    def start_server(self):
+        from types import SimpleNamespace
+        self.service = CafeService(self.base, data_dir=BASE / "examples_v3", clock=lambda:self.instant)
+        self.service.bom_enabled = True
+        def listener(address, handler):
+            return SimpleNamespace(RequestHandlerClass=handler, server_port=8765)
+        with patch("cafe_web.ThreadingHTTPServer", listener):
+            self.server = make_server(self.service, port=0, password_config=self.auth_path)
+
+    def stop_server(self):
+        pass
+
+    def request(self, method, path, body=None, headers=None):
+        from test_catalog_v34 import CatalogHttpWithoutSocketTests
+        status, response_headers, raw = CatalogHttpWithoutSocketTests.request(
+            self, method, path, body, headers)
+        result = json.loads(raw) if response_headers.get("Content-Type","").startswith("application/json") else raw.decode("utf-8")
+        return status, response_headers, result
+
