+        if self._client_secret:
+            values["client_secret"] = self._client_secret
+        return self._tokens(self._post(TOKEN_URL, values, operation="exchange"), require_refresh=True)
+
+    def refresh(self, refresh_token):
+        _ascii(refresh_token, "刷新令牌")
+        values = {"client_id": self.client_id, "refresh_token": refresh_token, "grant_type": "refresh_token"}
+        if self._client_secret:
+            values["client_secret"] = self._client_secret
+        result = self._post(TOKEN_URL, values, operation="refresh")
