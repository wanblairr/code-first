@@ -0,0 +1,169 @@
+"""Public-model scenario parity for the local CSV BOM assistant.
+
+Regenerates the same 180-day synthetic history as public_demo_training.py and
+engine.js. It never trains, reads private runtime, or makes network requests.
+"""
+from __future__ import annotations
+from datetime import date, datetime, time, timedelta, timezone
+import json
+import math
+from pathlib import Path
+
+from cafe_core import CafeError, fingerprint
+from cafe_forecast import _baseline
+from cafe_forecast_context import _features, _estimate
+
+SEED = 2026102303
+KL = timezone(timedelta(hours=8))
+MODEL_PATH = Path(__file__).resolve().parent / 'data/bom-context-model.json'
+
+
+class Random:
+    """The browser's seeded xorshift32, not Python's random generator."""
+    def __init__(self, seed=SEED):
+        self.value = seed & 0xffffffff
+
+    def uniform(self):
+        x = self.value
+        x ^= (x << 13) & 0xffffffff
+        x ^= x >> 17
+        x ^= (x << 5) & 0xffffffff
+        self.value = x & 0xffffffff
+        return self.value / 4294967296
+
+    def noise(self):
+        return sum(self.uniform() for unused in range(6)) - 3
+
+
+def holiday_for(day, calendar):
+    if not calendar['coverage_start'] <= day <= calendar['coverage_end']:
+        return None
+    matching = next((r for r in calendar['holidays'] if r['date'] == day), None)
+    return matching['is_holiday'] if matching else False
+
+
+def generate(end, calendar, days=180, seed=SEED):
+    """Identical generator/PRNG sequence to the published synthetic model."""
+    start = end - timedelta(days=days - 1)
+    rng = Random(seed)
+    sales, environment = [], []
+    weekly = (.92, .96, .99, 1.03, 1.12, 1.32, 1.20)
+    for index in range(days):
+        day = start + timedelta(days=index)
+        # Outside-coverage historical labels are synthetic ordinary-day
+        # generator assumptions, never advertised as verified holidays.
+        h = holiday_for(day.isoformat(), calendar) is True
+        temperature = round(26 + rng.uniform() * 7, 3)
+        rain = round(0 if rng.uniform() < .42 else rng.uniform() * 32, 3)
+        known = datetime.combine(day - timedelta(days=1), time(18), KL).isoformat()
+        environment.append({'date': day.isoformat(), 'temperature_c': temperature,
+            'precipitation_mm': rain, 'is_holiday': h, 'is_workday_override': False,
+            'known_at': known, 'weather_kind': 'synthetic_forecast'})
+        latent_temperature = temperature + rng.noise() * .7
+        latent_rain = max(0, rain + rng.noise() * 2.5)
+        for sku, base, slope, thermal, wet, boost in (
+            ('espresso', 58, .035, .8, -.70, 14),
+            ('latte', 76, .045, 1.3, -.95, 20),
+            ('oat_latte', 34, .065, 1.6, -.60, 12),
+        ):
+            demand = ((base + slope * index) * weekly[day.weekday()]
+                      + thermal * (latent_temperature - 29) + wet * latent_rain
+                      + (boost - .15 * latent_rain if h else 0) + rng.noise() * 4.2)
+            stockout = index % 67 == 41 and sku == 'oat_latte'
+            units = max(0, int(demand + .5))
+            if stockout:
+                units = int(units * .65 + .5)
+            sales.append({'date': day.isoformat(), 'sku': sku, 'units': units,
+                          'stockout': stockout, 'closed': False, 'data_source': 'synthetic'})
+    return sales, environment
+
+
+def load_context_model(path=None):
+    source = Path(path) if path is not None else MODEL_PATH
+    try:
+        if source.stat().st_size > 2_000_000:
+            raise CafeError('公共情景模型超过大小限制。')
+        return json.loads(source.read_text(encoding='utf-8-sig'))
+    except (OSError, ValueError) as error:
+        raise CafeError('公共情景模型无法读取，请核对 data/bom-context-model.json。') from error
+
+
+def _round6(value):
+    # Match JavaScript Math.round including negative halfway values.
+    return math.floor(value * 1_000_000 + .5) / 1_000_000
+
+
+def _number(value, label, low, high):
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or not low <= value <= high:
+        raise CafeError(label + '必须是范围内的有限数字。')
+    return float(value)
+
+
+def forecast_context(model, target_date, temperature_c, precipitation_mm, is_holiday, signature_material=None):
+    """Return public-engine-compatible context for cafe_bom.forecast_menu.
+
+    ``model`` is a loaded public model, an explicit JSON path, or None for the
+    bundled immutable data/bom-context-model.json. The caller owns provenance,
+    weather freshness, holiday selection and approval invalidation checks.
+    """
+    if model is None or isinstance(model, (str, Path)):
+        model = load_context_model(model)
+    try:
+        target = date.fromisoformat(target_date)
+        if not isinstance(target_date, str) or target.isoformat() != target_date:
+            raise ValueError()
+    except (TypeError, ValueError):
+        raise CafeError('目标日期须为有效 YYYY-MM-DD。') from None
+    temperature = _number(temperature_c, '温度', -20, 55)
+    rain = _number(precipitation_mm, '降水', 0, 500)
+    if type(is_holiday) is not bool:
+        raise CafeError('假日状态必须为明确布尔值，未知不能当普通日。')
+    if (not isinstance(model, dict) or model.get('schemaVersion') != 1
+            or model.get('dataSource') != 'synthetic' or not model.get('models')
+            or type(model.get('seed')) is not int or not isinstance(model.get('calendar'), dict)):
+        raise CafeError('公共情景模型格式无效。')
+    if target_date <= model.get('training', {}).get('training_end', target_date):
+        raise CafeError('目标日须在公共模型训练结束日之后。')
+    try:
+        artifact = fingerprint({k: v for k, v in model.items() if k != 'publicArtifactSha256'})
+        if artifact != model.get('publicArtifactSha256'):
+            raise CafeError('公共情景模型完整性校验失败。')
+        signature = fingerprint({'modelArtifactSha256': artifact, 'targetDate': target_date,
+            'temperatureC': temperature, 'precipitationMm': rain,
+            'isHoliday': is_holiday, 'signatureMaterial': signature_material})
+    except (TypeError, ValueError) as error:
+        if isinstance(error, CafeError):
+            raise
+        raise CafeError('模型或情景签名包含非 JSON 值。') from None
+
+    sales, unused = generate(target - timedelta(days=1), model['calendar'], seed=model['seed'])
+    context = {'temperature_c': temperature, 'precipitation_mm': rain,
+               'is_holiday': is_holiday, 'is_workday_override': False}
+    forecasts = []
+    for sku, spec in model['models'].items():
+        series = [row for row in sales if row['sku'] == sku]
+        if not series:
+            raise CafeError('公共模型 SKU 不在固定合成历史中。')
+        origin = date.fromisoformat(series[0]['date'])
+        reference = dict(context, temperature_c=spec['reference_temperature_c'],
+                         precipitation_mm=spec['reference_precipitation_mm'], is_holiday=False)
+        weather_only = dict(reference, temperature_c=temperature, precipitation_mm=rain)
+        holiday_only = dict(reference, is_holiday=is_holiday)
+        def estimate(c):
+            kind = spec['algorithm']
+            if kind.startswith(('context:', 'legacy:')):
+                return _estimate(spec['fit'], _features(series, target, origin, c, kind.startswith('context:')))
+            return _baseline(series, target, kind)
+        ref, w, h, combined = [estimate(c) for c in (reference, weather_only, holiday_only, context)]
+        reference_cups, forecast_cups = _round6(ref), _round6(combined)
+        weather_effect = _round6(.5 * ((w - ref) + (combined - h)))
+        forecasts.append({'sku': sku, 'forecastCups': forecast_cups,
+            'referenceCups': reference_cups, 'weatherEffect': weather_effect,
+            'holidayEffect': _round6(forecast_cups - reference_cups - weather_effect)})
+    total = lambda key: _round6(sum(row[key] for row in forecasts))
+    if total('referenceCups') <= 0:
+        raise CafeError('公共情景参考销量不足，不能缩放菜单。')
+    return {'targetDate': target_date, 'forecastCups': total('forecastCups'),
+        'referenceCups': total('referenceCups'), 'signature': signature,
+        'weather': {'temperatureC': temperature, 'precipitationMm': rain},
+        'holiday': {'isHoliday': is_holiday}, 'forecasts': forecasts}
