+        self.service.whatsapp_draft.return_value = {"body": "已审批采购", "sent": False, "external_draft": False}
+        self.service.import_gmail_oauth_client.return_value = public
+        self.service.start_gmail_oauth.return_value = {"authorization_url": "https://accounts.google.com/o/oauth2/v2/auth?state=test-state"}
+        self.service.complete_gmail_oauth.return_value = {"connected": True, "message": "Gmail 已连接"}
+        self.service.disconnect_gmail_oauth.return_value = public
+        self.auth_directory = tempfile.TemporaryDirectory(prefix="cafe-http-auth-v33-")
+        self.addCleanup(self.auth_directory.cleanup)
+        auth_path = Path(self.auth_directory.name) / "auth_config.json"
+        auth_path.write_text(json.dumps(make_auth_policy(PASSWORD, iterations=100_000)), encoding="utf-8")
+        parsed_policy = load_auth_policy(auth_path)
+        with patch("cafe_web.load_auth_policy", return_value=parsed_policy):
+            self.server = make_server(self.service, port=0)
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+        self.cookie = self.csrf = ""
