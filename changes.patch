+"""Explicit, approved-template WhatsApp sends with durable uncertainty tracking."""
+from __future__ import annotations
+
+from copy import deepcopy
+from datetime import date, timedelta, timezone
+from decimal import Decimal, DecimalException
+import json
+import re
+import time
+import uuid
+
+from cafe_core import CafeError, canonical, fingerprint, now
+from cafe_whatsapp import WhatsAppCloudClient, WhatsAppAPIError
+
+
+def recipient_number(value):
+    if not isinstance(value, str):
+        raise CafeError("请填写同意接收测试采购消息的国际区号号码。")
+    value = value.strip().removeprefix("+")
+    if not re.fullmatch(r"[1-9][0-9]{6,14}", value):
+        raise CafeError("WhatsApp 收件号码须含国际区号，只使用 7 至 15 位数字。")
+    return value
+
+
+class WhatsAppWorkflow:
+    def __init__(self, service, config):
+        self.service, self.config = service, config
+        self.client_factory = WhatsAppCloudClient
+        with service.store.connect() as db:
+            db.executescript("""
+            CREATE TABLE IF NOT EXISTS whatsapp_messages (
+              dedup TEXT PRIMARY KEY, document TEXT NOT NULL);
+            CREATE TABLE IF NOT EXISTS whatsapp_previews (
+              id TEXT PRIMARY KEY, document TEXT NOT NULL);
+            """)
+            for row in db.execute("SELECT dedup,document FROM whatsapp_messages").fetchall():
+                doc = json.loads(row["document"])
+                if doc.get("status") == "submitting":
+                    doc.update(status="unknown", message="上次请求结果未知，请在 Meta 核对；不会自动重发。")
+                    db.execute("UPDATE whatsapp_messages SET document=? WHERE dedup=?", (canonical(doc), row["dedup"]))
+
+    def public(self):
+        with self.service.store.connect() as db:
+            return [json.loads(row[0]) for row in db.execute("SELECT document FROM whatsapp_messages ORDER BY rowid DESC LIMIT 30")]
+
+    def _client(self):
+        cfg = self.config.public().get("whatsapp", {})
+        if not cfg.get("enabled") or not cfg.get("credential_present"):
+            raise CafeError("请先在本机配置并启用 WhatsApp Cloud API。")
+        client = self.client_factory(cfg["api_version"], cfg["phone_number_id"],
+                                     self.config.secret("whatsapp_access_token"),
+                                     business_account_id=cfg.get("business_account_id", ""), timeout=10)
+        return cfg, client
+
+    def check(self):
+        unused, client = self._client()
+        client.check_connection()
+        return {"connected": True, "status": "connected", "at": now(),
+                "message": "WhatsApp 号码只读接口可访问；尚未发送消息，也未验证采购模板。"}
+
+    def _approved(self, draft_id):
+        if isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-"):
+            draft, order = self.service.bom_approved_draft(draft_id)
+            row = None
+        else:
+            draft = self.service.store.draft(draft_id)
+            with self.service.store.connect() as db:
+                row = db.execute("SELECT document FROM orders WHERE id=?", (draft["order_id"],)).fetchone()
+            order = json.loads(row[0]) if row else None
+        if order is None:
+            raise CafeError("只有已审批的采购草稿可以预览 WhatsApp 模板。")
+        if date.fromisoformat(order["target_date"]) < self.service.clock().astimezone(timezone(timedelta(hours=8))).date():
+            raise CafeError("采购到货日期已过，请重新核对明日采购，不能发送历史清单。")
+        items = [item for item in order["items"] if item["supplier_id"] == draft["supplier_id"] and item.get("base_quantity", item["approved_quantity"]) > 0]
+        if not items:
+            raise CafeError("此供应商没有已批准的采购食材。")
+        parts = []
+        for item in items:
+            try:
+                amount, pack = Decimal(str(item["approved_quantity"])), Decimal(str(item["pack_size"]))
+                if not amount.is_finite() or not pack.is_finite() or amount <= 0 or pack <= 0:
+                    raise CafeError("已批准的包装数量无效，请检查采购记录。")
+                packs = amount / pack
+            except (DecimalException, ValueError, TypeError, OverflowError):
+                raise CafeError("已批准的包装数量无效，请检查采购记录。") from None
+            if packs != packs.to_integral_value():
+                raise CafeError("已批准的包装数量无效，请检查采购记录。")
+            parts.append(f"{item['name']}: {packs:g} × {pack:g} {item['unit']} = {amount:g} {item['unit']}")
+        if isinstance(draft_id, str) and draft_id.startswith("BOM-DRAFT-"):
+            for index, item in enumerate(items):
+                if item.get("line_total_cents") is not None:
+                    cents = item["line_total_cents"]
+                    parts[index] += f" | MYR {cents // 100}.{cents % 100:02d}"
+            if order.get("prices_complete"):
+                cents = order["total_cents"]
+                parts.append(f"Estimated total MYR {cents // 100}.{cents % 100:02d}")
+        summary = "DEMO / 模拟采购: " + "; ".join(parts)
+        if len(summary) > 800 or any(ord(c) < 32 for c in summary):
+            raise CafeError("采购摘要过长或包含控制字符，不能放入模板参数。")
+        parameters = [order["target_date"], order["id"], summary]
+        return draft, order, parameters
+
+    @staticmethod
+    def _configuration_hash(cfg):
+        return fingerprint({key: cfg.get(key) for key in (
+            "enabled", "api_version", "phone_number_id", "business_account_id", "template_name", "template_language")})
+
+    def preview(self, draft_id, recipient, opt_in=False):
+        if opt_in is not True:
+            raise CafeError("请先确认收件人已同意接收 WhatsApp 测试采购消息。")
+        recipient = recipient_number(recipient)
+        with self.service.lock:
+            draft, unused_order, parameters = self._approved(draft_id)
+            cfg, client = self._client()
+        rendered = client.preview_template(recipient, cfg["template_name"], cfg["template_language"], parameters)
+        document = {"preview_id": uuid.uuid4().hex, "draft_id": draft_id, "draft_hash": fingerprint(draft),
+                    "configuration_hash": self._configuration_hash(cfg), "recipient": recipient,
+                    "parameters": parameters, "template": {"name": cfg["template_name"], "language": cfg["template_language"]},
+                    "body": rendered["body"], "payload": rendered["payload"], "expires_at": time.time() + 600}
+        with self.service.lock:
+            current_draft, unused_order, current_parameters = self._approved(draft_id)
+            current_cfg, unused_client = self._client()
+            if (fingerprint(current_draft) != document["draft_hash"] or current_parameters != parameters
+                    or self._configuration_hash(current_cfg) != document["configuration_hash"]):
+                raise CafeError("采购或接口设置已改变，请重新预览。")
+            with self.service.store.connect() as db:
+                db.execute("DELETE FROM whatsapp_previews WHERE json_extract(document,'$.expires_at') < ?", (time.time(),))
+                db.execute("INSERT INTO whatsapp_previews VALUES(?,?)", (document["preview_id"], canonical(document)))
+        return {key: deepcopy(document[key]) for key in ("preview_id", "recipient", "parameters", "template", "body")} | {"status": "preview"}
+
+    def _submit(self, identity, operation):
+        dedup = fingerprint(identity)
+        with self.service.lock, self.service.store.connect() as db:
+            row = db.execute("SELECT document FROM whatsapp_messages WHERE dedup=?", (dedup,)).fetchone()
+            previous = json.loads(row[0]) if row else None
+            if previous and previous["status"] != "failed":
+                return previous
+            record = {"dedup": dedup, "kind": identity["kind"], "draft_id": identity.get("draft_id"),
+                      "recipient": identity["recipient"], "status": "submitting", "delivery_confirmed": False,
+                      "at": now(), "attempt": previous["attempt"] + 1 if previous else 1}
+            db.execute("INSERT OR REPLACE INTO whatsapp_messages VALUES(?,?)", (dedup, canonical(record)))
+            self.service.store.event(db, "owner", "whatsapp_api_requested", dedup,
+                                     {"kind": record["kind"], "recipient_last4": record["recipient"][-4:], "draft_id": record["draft_id"]})
+        try:
+            result = operation()
+            record.update(status="accepted", message_id=result["message_id"], delivery_confirmed=False,
+                          message="Meta 已受理消息；没有送达回执，不能视为已送达或供应商已接单。")
+        except WhatsAppAPIError as exc:
+            uncertain = bool(exc.outcome_unknown)
+            record.update(status="unknown" if uncertain else "failed",
+                          message="发送结果未知，请在 Meta 核对；系统禁止自动重复发送。" if uncertain else "Meta 未接受请求，请核对号码、权限及模板后手动操作。")
+        except Exception:
+            record.update(status="unknown", message="发送结果未知，请在 Meta 核对；系统禁止自动重复发送。")
+        with self.service.store.connect() as db:
+            db.execute("UPDATE whatsapp_messages SET document=? WHERE dedup=?", (canonical(record), dedup))
+            self.service.store.event(db, "owner", "whatsapp_api_result", dedup,
+                                     {key: record[key] for key in ("status", "kind", "delivery_confirmed")})
+        return record
+
+    def send(self, draft_id, recipient, preview_id, opt_in=False, confirmed=False):
+        if opt_in is not True or confirmed is not True:
+            raise CafeError("请单独确认收件人同意及实际发送；采购审批本身不会发消息。")
+        recipient = recipient_number(recipient)
+        if not isinstance(preview_id, str) or not re.fullmatch(r"[a-f0-9]{32}", preview_id):
+            raise CafeError("请先预览准确的收件人和模板内容。")
+        with self.service.lock:
+            draft, unused_order, parameters = self._approved(draft_id)
+            cfg, client = self._client()
+            with self.service.store.connect() as db:
+                row = db.execute("SELECT document FROM whatsapp_previews WHERE id=?", (preview_id,)).fetchone()
+            preview = json.loads(row[0]) if row else None
+            if (not preview or preview["expires_at"] < time.time() or preview["draft_id"] != draft_id
+                    or preview["recipient"] != recipient or preview["draft_hash"] != fingerprint(draft)
+                    or preview["parameters"] != parameters or preview["configuration_hash"] != self._configuration_hash(cfg)):
+                raise CafeError("预览过期，或收件人、采购、设置已改变，请重新预览后确认。")
+        rendered = client.preview_template(recipient, cfg["template_name"], cfg["template_language"], parameters)
+        if rendered["payload"] != preview["payload"] or rendered["body"] != preview["body"]:
+            raise CafeError("Meta 模板内容已变化，请重新预览，不会发送旧确认内容。")
+        with self.service.lock:
+            current_draft, unused_order, current_parameters = self._approved(draft_id)
+            current_cfg, unused_client = self._client()
+            if (fingerprint(current_draft) != preview["draft_hash"] or current_parameters != parameters
+                    or self._configuration_hash(current_cfg) != preview["configuration_hash"]):
+                raise CafeError("发送前资料已变化，请重新预览。")
+            identity = {"kind": "procurement", "draft_id": draft_id, "sender": cfg["phone_number_id"],
+                        "recipient": recipient, "payload": rendered["payload"]}
+            # Claim the request while holding the same configuration lock. No POST
+            # occurs during approval, polling or a read-only connection check.
+            return self._submit(identity, lambda: client.send_template(recipient, cfg["template_name"], cfg["template_language"], parameters))
+
+    def test(self, recipient, opt_in=False, confirmed=False):
+        if opt_in is not True or confirmed is not True:
+            raise CafeError("请确认测试号码已授权，且同意实际发送 hello_world 测试消息。")
+        recipient = recipient_number(recipient)
+        with self.service.lock:
+            cfg, client = self._client()
+            identity = {"kind": "connection_test", "sender": cfg["phone_number_id"], "recipient": recipient,
+                        "template": "hello_world", "language": "en_US"}
+            return self._submit(identity, lambda: client.hello_world_test(recipient))
