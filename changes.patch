+
+_DEFAULTS = {
+    "enabled": False,
+    "endpoint_id": "",
+    "model": "",
+    "request_profile": "messages",
+    "auto_review": False,
+    "max_adjustment_percent": 35,
+    "max_tokens": 700,
+    "temperature": 0.2,
+}
+_FIELD_MAP = {"runpod_enabled": "enabled", **{key: key for key in _DEFAULTS if key != "enabled"}}
+_SECRET_ENV = {"runpod_api_key": "RUNPOD_API_KEY", "gmail_access_token": "GMAIL_ACCESS_TOKEN",
+               "gmail_client_secret": "GMAIL_CLIENT_SECRET", "gmail_refresh_token": "GMAIL_REFRESH_TOKEN",
+               "whatsapp_access_token": "WHATSAPP_ACCESS_TOKEN",
+               "whatsapp_sandbox_api_key": "WHATSAPP_SANDBOX_API_KEY"}
+_GMAIL_DEFAULTS = {"client_id": "", "token_expires_at": None}
+_GMAIL_FIELDS = {"gmail_client_id": "client_id", "gmail_token_expires_at": "token_expires_at"}
+_WHATSAPP_DEFAULTS = {"enabled": False, "api_version": "", "phone_number_id": "",
+                      "business_account_id": "", "template_name": "", "template_language": ""}
+_WHATSAPP_FIELDS = {"whatsapp_" + key: key for key in _WHATSAPP_DEFAULTS}
+_SANDBOX_DEFAULTS = {"enabled": False, "recipient_kind": "phone", "recipient_id": ""}
+_SANDBOX_FIELDS = {"whatsapp_sandbox_" + key: key for key in _SANDBOX_DEFAULTS}
+_CLEAR_FIELDS = {"clear_" + key: key for key in _SECRET_ENV}
+_ALLOWED_UPDATES = set(_FIELD_MAP) | set(_SECRET_ENV) | set(_CLEAR_FIELDS) | set(_GMAIL_FIELDS) | set(_WHATSAPP_FIELDS) | set(_SANDBOX_FIELDS)
+_ENTROPY = b"CafeReplenishmentAPI-v33"
+_MAX_FILE_BYTES = 65536
+
+
+def _storage_kind():
+    return "windows_dpapi_current_user" if os.name == "nt" else "posix_permissions_0600"
+
+
+def _dpapi(data, *, decrypt=False):
+    """Protect bytes for the current Windows user, without displaying prompts."""
+    if os.name != "nt":
+        raise CafeError("此凭据文件需要原 Windows 用户在原设备上打开。")
+    from ctypes import wintypes
+
+    class Blob(ctypes.Structure):
+        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_ubyte))]
+
+    incoming_buffer = ctypes.create_string_buffer(data)
+    entropy_buffer = ctypes.create_string_buffer(_ENTROPY)
+    incoming = Blob(len(data), ctypes.cast(incoming_buffer, ctypes.POINTER(ctypes.c_ubyte)))
+    entropy = Blob(len(_ENTROPY), ctypes.cast(entropy_buffer, ctypes.POINTER(ctypes.c_ubyte)))
+    outgoing = Blob()
+    try:
+        crypt32 = ctypes.WinDLL("crypt32", use_last_error=True)
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        kernel32.LocalFree.argtypes = [ctypes.c_void_p]
+        kernel32.LocalFree.restype = ctypes.c_void_p
+        if decrypt:
+            function = crypt32.CryptUnprotectData
+            function.argtypes = [ctypes.POINTER(Blob), ctypes.POINTER(wintypes.LPWSTR), ctypes.POINTER(Blob),
+                                 ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(Blob)]
+            arguments = (ctypes.byref(incoming), None, ctypes.byref(entropy), None, None, 1, ctypes.byref(outgoing))
+        else:
+            function = crypt32.CryptProtectData
+            function.argtypes = [ctypes.POINTER(Blob), wintypes.LPCWSTR, ctypes.POINTER(Blob),
+                                 ctypes.c_void_p, ctypes.c_void_p, wintypes.DWORD, ctypes.POINTER(Blob)]
+            arguments = (ctypes.byref(incoming), "Cafe API credentials", ctypes.byref(entropy), None, None, 1,
+                         ctypes.byref(outgoing))
+        function.restype = wintypes.BOOL
+        if not function(*arguments):
+            raise CafeError("无法保护或解锁本机 API 凭据；请使用原 Windows 用户，或重新配置凭据。")
+        try:
+            return ctypes.string_at(outgoing.pbData, outgoing.cbData)
+        finally:
+            kernel32.LocalFree(ctypes.cast(outgoing.pbData, ctypes.c_void_p))
+    except CafeError:
+        raise
+    except (OSError, AttributeError, ValueError):
+        raise CafeError("Windows 凭据保护不可用；未保存 API 凭据。") from None
+
+
+def _object_pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate field")
+        result[key] = value
+    return result
+
+
+def _decode_json(data, message):
+    try:
+        return json.loads(data.decode("utf-8"), object_pairs_hook=_object_pairs,
+                          parse_constant=lambda unused: (_ for _ in ()).throw(ValueError("nonfinite")))
+    except (UnicodeError, ValueError, TypeError, RecursionError):
+        raise CafeError(message) from None
+
+
+def _validate_settings(values):
+    if not isinstance(values, dict) or set(values) != set(_DEFAULTS):
+        raise CafeError("API 设置文件字段不完整或不受支持，请修复设置文件后重试。")
+    result = dict(values)
+    for field in ("enabled", "auto_review"):
+        if type(result[field]) is not bool:
+            raise CafeError("API 开关必须为布尔值。")
+    endpoint = result["endpoint_id"]
+    if not isinstance(endpoint, str) or (endpoint and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,127}", endpoint)):
+        raise CafeError("Runpod Endpoint ID 只能包含字母、数字和连字符，请勿填写网址。")
+    model = result["model"]
+    if not isinstance(model, str) or len(model) > 160 or any(ord(char) < 32 or ord(char) == 127 for char in model):
+        raise CafeError("模型名称必须为不含控制字符的文本，最多 160 个字符。")
+    if model != model.strip():
+        raise CafeError("模型名称首尾不能包含空白。")
+    if result["request_profile"] not in ("messages", "prompt"):
+        raise CafeError("Runpod 请求格式只能选择 messages 或 prompt。")
+    for field, low, high in (("max_tokens", 64, 4096), ("max_adjustment_percent", 0, 35)):
+        if type(result[field]) is not int or not low <= result[field] <= high:
+            raise CafeError("生成长度或需求调整上限不在允许范围内。")
+    temperature = result["temperature"]
+    if isinstance(temperature, bool) or not isinstance(temperature, (int, float)) or not math.isfinite(temperature) or not 0 <= temperature <= 2:
+        raise CafeError("temperature 必须为 0 到 2 之间的有限数字。")
+    result["temperature"] = float(temperature)
+    return result
+
+
+def _validate_secret(value, name):
+    # Accept raw provider tokens without assuming a provider-specific prefix.
+    maximum = 4096 if name == "runpod_api_key" else 8192
+    if not isinstance(value, str) or not 8 <= len(value) <= maximum or not value.isascii() or any(char.isspace() or ord(char) < 33 or ord(char) == 127 for char in value) or value.lower().startswith("bearer"):
+        raise CafeError("API 凭据格式无效：请填写原始令牌，不含空白、换行或 Bearer 前缀。")
+    return value
+
+
+def _validate_client_id(value):
+    if not isinstance(value, str) or (value and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,220}\.apps\.googleusercontent\.com", value)):
+        raise CafeError("Gmail OAuth Client ID 格式无效，请导入 Google 桌面应用客户端 JSON。")
+    return value
+
+
+def _validate_gmail_settings(values):
+    if not isinstance(values, dict) or set(values) != set(_GMAIL_DEFAULTS):
+        raise CafeError("Gmail OAuth 设置结构无效。")
+    result = dict(values)
+    result["client_id"] = _validate_client_id(result["client_id"])
+    value = result["token_expires_at"]
+    if value is not None:
+        if isinstance(value, bool) or not isinstance(value, (int, float)) or not 0 <= value <= 32_503_680_000 or not math.isfinite(value):
+            raise CafeError("Gmail 令牌失效时间必须为有限的 Unix 时间戳。")
+        result["token_expires_at"] = float(value)
+    return result
+
+
+def _validate_whatsapp_settings(values):
+    if not isinstance(values, dict) or set(values) != set(_WHATSAPP_DEFAULTS):
+        raise CafeError("WhatsApp 设置结构无效。")
+    result = dict(values)
+    if type(result["enabled"]) is not bool:
+        raise CafeError("WhatsApp 开关必须为布尔值。")
+    patterns = {"api_version": r"v[1-9][0-9]{0,2}\.0", "phone_number_id": r"[1-9][0-9]{0,31}",
+                "business_account_id": r"[1-9][0-9]{0,31}", "template_name": r"[a-z0-9_]{1,512}",
+                "template_language": r"[a-z]{2,3}(?:_[A-Z]{2})?"}
+    for field, pattern in patterns.items():
+        value = result[field]
+        if not isinstance(value, str) or value and not re.fullmatch(pattern, value):
+            raise CafeError("WhatsApp 版本、号码 ID 或模板设置无效，请按 Meta 控制台填写。")
+    return result
+
+
+def _validate_sandbox_settings(values):
+    if not isinstance(values, dict) or set(values) != set(_SANDBOX_DEFAULTS) or type(values.get("enabled")) is not bool:
+        raise CafeError("本人 WhatsApp 沙盒设置结构无效。")
+    result = dict(values)
+    if result["recipient_kind"] not in ("phone", "bsuid") or not isinstance(result["recipient_id"], str):
+        raise CafeError("本人沙盒收件标识类型无效。")
+    if result["recipient_id"]:
+        from cafe_whatsapp_sandbox import sandbox_recipient
+        sandbox_recipient(result["recipient_kind"], result["recipient_id"])
+    return result
+
+
+class IntegrationConfig:
+    """Read and update one runtime's integration settings without exposing keys."""
+
+    def __init__(self, runtime):
+        self.runtime = Path(runtime)
+        self.settings_path = self.runtime / "integrations.json"
+        self.credentials_path = self.runtime / "private_api_credentials.json"
+        self._lock = threading.RLock()
+
+    def _read_bytes(self, path):
+        try:
+            if path.is_symlink():
+                raise CafeError("API 设置或凭据路径不能是符号链接。")
+            try:
+                with path.open("rb") as stream:
+                    data = stream.read(_MAX_FILE_BYTES + 1)
+            except FileNotFoundError:
+                return None
+            if len(data) > _MAX_FILE_BYTES:
+                raise CafeError("API 设置或凭据文件过大，已停止读取。")
+            return data
+        except CafeError:
+            raise
+        except OSError:
+            raise CafeError("无法读取 API 设置或本机凭据，请检查目录权限。") from None
+
+    def _load_settings(self):
+        return self._load_document()[0]
+
+    def _load_document(self):
+        # Preserve the existing two-item internal contract for Gmail managers.
+        return self._load_all()[:2]
+
+    def _load_all(self):
+        raw = self._read_bytes(self.settings_path)
+        if raw is None:
+            return dict(_DEFAULTS), dict(_GMAIL_DEFAULTS), dict(_WHATSAPP_DEFAULTS), dict(_SANDBOX_DEFAULTS)
+        data = _decode_json(raw, "API 设置文件损坏，请修复后重试；未恢复为默认配置。")
+        if (not isinstance(data, dict) or not {"version", "runpod"} <= set(data) or
+                not set(data) <= {"version", "runpod", "gmail", "whatsapp", "whatsapp_sandbox"} or type(data["version"]) is not int or data["version"] != 1):
+            raise CafeError("API 设置文件版本或结构不受支持。")
+        return (_validate_settings(data["runpod"]), _validate_gmail_settings(data.get("gmail", dict(_GMAIL_DEFAULTS))),
+                _validate_whatsapp_settings(data.get("whatsapp", dict(_WHATSAPP_DEFAULTS))),
+                _validate_sandbox_settings(data.get("whatsapp_sandbox", dict(_SANDBOX_DEFAULTS))))
+
+    def _load_secrets(self):
+        raw = self._read_bytes(self.credentials_path)
+        if raw is None:
+            return {}
+        message = "本机 API 凭据文件损坏或无法解锁，请重新配置凭据。"
+        envelope = _decode_json(raw, message)
+        if not isinstance(envelope, dict) or type(envelope.get("version")) is not int or envelope["version"] != 1:
+            raise CafeError(message)
+        if envelope.get("protection") != _storage_kind():
+            raise CafeError("本机 API 凭据的保护方式与当前平台不符，请在本机重新配置。")
+        if os.name == "nt":
+            if set(envelope) != {"version", "protection", "ciphertext"} or not isinstance(envelope["ciphertext"], str):
+                raise CafeError(message)
+            try:
+                encrypted = base64.b64decode(envelope["ciphertext"], validate=True)
+            except (ValueError, TypeError):
+                raise CafeError(message) from None
+            payload = _decode_json(_dpapi(encrypted, decrypt=True), message)
+        else:
+            if set(envelope) != {"version", "protection", "credentials"}:
+                raise CafeError(message)
+            try:
+                if self.credentials_path.stat().st_mode & 0o077:
+                    raise CafeError("本机凭据文件权限过宽；请将权限设为 0600 后重试。")
+            except OSError:
+                raise CafeError("无法检查本机 API 凭据文件权限。") from None
+            payload = envelope["credentials"]
+        if not isinstance(payload, dict) or not set(payload) <= set(_SECRET_ENV):
+            raise CafeError(message)
+        try:
+            return {name: _validate_secret(value, name) for name, value in payload.items()}
+        except CafeError:
+            raise CafeError(message) from None
+
+    def _credential(self, name, local):
+        value = os.environ.get(_SECRET_ENV[name], "")
+        if value:
+            try:
+                return _validate_secret(value, name), "environment"
+            except CafeError:
+                raise CafeError("环境变量中的 API 凭据格式无效，请在本机修复后重试。") from None
+        if name in local:
+            return local[name], "local"
+        return "", "none"
+
+    def _public(self, settings, local, gmail=None, whatsapp=None, sandbox=None):
+        if gmail is None or whatsapp is None or sandbox is None:
+            unused, saved_gmail, saved_whatsapp, saved_sandbox = self._load_all()
+            gmail = gmail if gmail is not None else saved_gmail
+            whatsapp = whatsapp if whatsapp is not None else saved_whatsapp
+            sandbox = sandbox if sandbox is not None else saved_sandbox
+        key, key_source = self._credential("runpod_api_key", local)
+        token, token_source = self._credential("gmail_access_token", local)
+        client_secret, client_source = self._credential("gmail_client_secret", local)
+        refresh_token, refresh_source = self._credential("gmail_refresh_token", local)
+        client_id = _validate_client_id(os.environ.get("GMAIL_CLIENT_ID", "") or gmail["client_id"])
+        client_configured = bool(client_id and client_secret)
+        automatic = bool(client_configured and refresh_token)
+        runpod = dict(settings)
+        runpod.update(credential_present=bool(key), credential_source=key_source,
+                      status="ready_to_test" if settings["enabled"] and settings["endpoint_id"] and key else "unconfigured")
+        whatsapp_token, whatsapp_source = self._credential("whatsapp_access_token", local)
+        whatsapp_public = dict(whatsapp)
+        whatsapp_public.update(credential_present=bool(whatsapp_token), credential_source=whatsapp_source,
+                               status="ready_to_test" if whatsapp["enabled"] and whatsapp["api_version"] and
+                               whatsapp["phone_number_id"] and whatsapp_token else "unconfigured",
+                               template_configured=bool(whatsapp["business_account_id"] and whatsapp["template_name"] and
+                                                        whatsapp["template_language"]),
+                               sending_mode="approved_template_only")
+        sandbox_key, sandbox_source = self._credential("whatsapp_sandbox_api_key", local)
+        sandbox_public = dict(sandbox)
+        sandbox_public.update(credential_present=bool(sandbox_key), credential_source=sandbox_source,
+                              status="configured_not_verified" if sandbox["enabled"] and sandbox["recipient_id"] and sandbox_key else "unconfigured",
+                              provider="360dialog_sandbox", sending_mode="personal_sandbox_only", delivery_verification="not_available")
+        return {"runpod": runpod,
+                "gmail": {"credential_present": bool(token or automatic), "credential_source": token_source if token else refresh_source,
+                          "status": "ready_to_test" if token or automatic else "unconfigured",
+                          "client_id": client_id, "client_configured": client_configured,
+                          "client_credential_source": client_source, "refresh_token_present": bool(refresh_token),
+                          "refresh_credential_source": refresh_source, "expires_at": gmail["token_expires_at"],
+                          "auth_mode": "oauth_refresh" if automatic else "manual_token" if token else "unconfigured"},
+                "whatsapp": whatsapp_public, "whatsapp_sandbox": sandbox_public, "storage": {"kind": _storage_kind()}}
+
+    def public(self):
+        with self._lock:
+            settings, gmail, whatsapp, sandbox = self._load_all()
+            return self._public(settings, self._load_secrets(), gmail, whatsapp, sandbox)
+
+    def secret(self, name):
+        if not isinstance(name, str) or name not in _SECRET_ENV:
+            raise CafeError("不支持的 API 凭据类型。")
+        with self._lock:
+            return self._credential(name, self._load_secrets())[0]
+
+    def policy_hash(self):
+        with self._lock:
+            return fingerprint({"policy_version": 1, "runpod": self._load_settings()})
+
+    def _credential_bytes(self, secrets):
+        if os.name == "nt":
+            envelope = {"version": 1, "protection": _storage_kind(),
+                        "ciphertext": base64.b64encode(_dpapi(canonical(secrets).encode("utf-8"))).decode("ascii")}
+        else:
+            envelope = {"version": 1, "protection": _storage_kind(), "credentials": secrets}
+        return (canonical(envelope) + "\n").encode("utf-8")
+
+    def _stage(self, data):
+        path = None
+        descriptor = None
+        try:
+            descriptor, filename = tempfile.mkstemp(prefix=".cafe-api-", suffix=".tmp", dir=self.runtime)
+            path = Path(filename)
+            if os.name != "nt":
+                os.chmod(path, 0o600)
+            with os.fdopen(descriptor, "wb") as stream:
+                descriptor = None
+                stream.write(data)
+                stream.flush()
+                os.fsync(stream.fileno())
+            return path
+        except OSError:
+            if descriptor is not None:
+                os.close(descriptor)
+            if path is not None:
+                path.unlink(missing_ok=True)
+            raise
+
+    def _save(self, settings, secrets, gmail=None, whatsapp=None, sandbox=None):
+        if gmail is None or whatsapp is None or sandbox is None:
+            unused, saved_gmail, saved_whatsapp, saved_sandbox = self._load_all()
+            gmail = gmail if gmail is not None else saved_gmail
+            whatsapp = whatsapp if whatsapp is not None else saved_whatsapp
+            sandbox = sandbox if sandbox is not None else saved_sandbox
+        # Stage every file before changing the active configuration. Snapshots
+        # are already DPAPI-protected on Windows, including rollback copies.
+        blobs = [(self.credentials_path, self._credential_bytes(secrets)),
+                 (self.settings_path, (canonical({"version": 1, "runpod": settings, "gmail": gmail,
+                                                  "whatsapp": whatsapp, "whatsapp_sandbox": sandbox}) + "\n").encode("utf-8"))]
+        staged, changed, previous = [], [], {}
+        try:
+            self.runtime.mkdir(parents=True, exist_ok=True)
+            for path, data in blobs:
+                previous[path] = self._read_bytes(path)
+                staged.append((path, self._stage(data)))
+            for path, temporary in staged:
+                os.replace(temporary, path)
+                changed.append(path)
+        except (OSError, CafeError):
+            restored = True
+            for path in reversed(changed):
+                try:
+                    if previous[path] is None:
+                        path.unlink(missing_ok=True)
+                    else:
+                        rollback = self._stage(previous[path])
+                        try:
+                            os.replace(rollback, path)
+                        finally:
+                            rollback.unlink(missing_ok=True)
+                except OSError:
+                    restored = False
+            message = "无法保存 API 设置；请检查本地目录权限和可用空间。" if restored else "API 设置保存及恢复未完成，请检查本机配置后重试。"
+            raise CafeError(message) from None
+        finally:
+            for unused, temporary in staged:
+                try:
+                    temporary.unlink(missing_ok=True)
+                except OSError:
+                    pass
+
+    def update(self, values):
+        if not isinstance(values, dict) or not set(values) <= _ALLOWED_UPDATES:
+            raise CafeError("API 设置包含不支持的字段。")
+        with self._lock:
+            settings, gmail, whatsapp, sandbox = self._load_all()
+            secrets = self._load_secrets()
+            previous_client = (gmail["client_id"], secrets.get("gmail_client_secret", ""))
+            for field, destination in _FIELD_MAP.items():
+                if field in values:
+                    settings[destination] = values[field]
+            settings = _validate_settings(settings)
+            for field, destination in _GMAIL_FIELDS.items():
+                if field in values:
+                    gmail[destination] = values[field]
+            gmail = _validate_gmail_settings(gmail)
+            for field, destination in _WHATSAPP_FIELDS.items():
+                if field in values:
+                    whatsapp[destination] = values[field]
+            whatsapp = _validate_whatsapp_settings(whatsapp)
+            for field, destination in _SANDBOX_FIELDS.items():
+                if field in values:
+                    sandbox[destination] = values[field]
+            sandbox = _validate_sandbox_settings(sandbox)
+            for flag, name in _CLEAR_FIELDS.items():
+                if flag in values and type(values[flag]) is not bool:
+                    raise CafeError("清除 API 凭据开关必须为布尔值。")
+                incoming = values.get(name, "")
+                if name in values and not isinstance(incoming, str):
+                    raise CafeError("API 凭据必须为文本。")
+                if values.get(flag, False):
+                    if incoming:
+                        raise CafeError("不能同时清除和替换同一 API 凭据。")
+                    secrets.pop(name, None)
+                elif incoming:
+                    secrets[name] = _validate_secret(incoming, name)
+            if previous_client != (gmail["client_id"], secrets.get("gmail_client_secret", "")):
+                # Refresh tokens belong to the client that obtained them. Never
+                # silently attach an old authorization to a different client.
+                for field in ("gmail_access_token", "gmail_refresh_token"):
+                    if not values.get(field):
+                        secrets.pop(field, None)
+                if "gmail_token_expires_at" not in values:
+                    gmail["token_expires_at"] = None
+            if values.get("clear_gmail_access_token") and "gmail_token_expires_at" not in values:
+                gmail["token_expires_at"] = None
+            # Validate environment values too, before writing any changes.
+            result = self._public(settings, secrets, gmail, whatsapp, sandbox)
+            self._save(settings, secrets, gmail, whatsapp, sandbox)
+            return result
+
+    def import_google_desktop_client(self, document):
+        """Import only Google's installed-app client contract, never remote URLs."""
+        if isinstance(document, str):
+            try:
+                raw = document.encode("utf-8")
+            except UnicodeError:
+                raise CafeError("Google OAuth 客户端 JSON 编码无效。") from None
+            if len(raw) > _MAX_FILE_BYTES:
+                raise CafeError("Google OAuth 客户端文件过大。")
+            document = _decode_json(raw, "Google OAuth 客户端 JSON 无效。")
+        if not isinstance(document, dict) or set(document) != {"installed"} or not isinstance(document["installed"], dict):
+            raise CafeError("请使用 Google 类型为 Desktop app 的客户端文件（installed），不能导入 Web 客户端。")
+        installed = document["installed"]
+        allowed = {"client_id", "project_id", "auth_uri", "token_uri", "auth_provider_x509_cert_url", "client_secret", "redirect_uris", "universe_domain"}
+        if not {"client_id", "client_secret"} <= set(installed) or not set(installed) <= allowed:
+            raise CafeError("Google 桌面客户端文件字段无效。")
+        auth_uri = installed.get("auth_uri", "https://accounts.google.com/o/oauth2/auth")
+        if not isinstance(auth_uri, str) or auth_uri not in {"https://accounts.google.com/o/oauth2/auth", "https://accounts.google.com/o/oauth2/v2/auth"}:
+            raise CafeError("Google OAuth 授权地址无效。")
+        if installed.get("token_uri", "https://oauth2.googleapis.com/token") != "https://oauth2.googleapis.com/token":
+            raise CafeError("Google OAuth 令牌地址无效。")
+        client_id = _validate_client_id(installed["client_id"])
+        if not client_id:
+            raise CafeError("Google OAuth Client ID 不能为空。")
+        client_secret = _validate_secret(installed["client_secret"], "gmail_client_secret")
+        return self.update({"gmail_client_id": client_id, "gmail_client_secret": client_secret})
+
+    def clear_gmail_authorization(self):
+        """Forget local authorization after revocation; retain reusable client setup."""
+        return self.update({"clear_gmail_access_token": True, "clear_gmail_refresh_token": True,
+                            "gmail_token_expires_at": None})
