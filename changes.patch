index 0000000000000000000000000000000000000000..1779d5ed48096f0237122cb9469ae95e8e4161fb
--- /dev/null
+++ b/local_app/web_v3/whatsapp_sandbox.js
@@ -0,0 +1,26 @@
+'use strict';
+let sandboxContext=null, sandboxRevision=0;
+function sandboxConfig(integrations){return integrations?.public_config?.whatsapp_sandbox||{};}
+function sandboxReady(integrations){const c=sandboxConfig(integrations);return c.enabled===true&&c.credential_present===true&&!!c.recipient_id;}
+function sandboxLabel(config){return (config.recipient_kind==='bsuid'?'本人 BSUID · 末四位 ':'本人号码 · 尾号 ')+(config.recipient_id||'').slice(-4);}
+function sandboxFill(integrations){const c=sandboxConfig(integrations);$('sandbox-enabled').checked=!!c.enabled;$('sandbox-recipient-kind').value=c.recipient_kind||'phone';$('sandbox-recipient-id').value=c.recipient_id||'';$('sandbox-setting-badge').textContent=sandboxReady(integrations)?'已配置 · 未验证':'待配置';invalidateSandbox();}
+function sandboxFields(){const data={whatsapp_sandbox_enabled:$('sandbox-enabled').checked,whatsapp_sandbox_recipient_kind:$('sandbox-recipient-kind').value,whatsapp_sandbox_recipient_id:$('sandbox-recipient-id').value.trim(),clear_whatsapp_sandbox_api_key:$('sandbox-clear-key').checked};if($('sandbox-api-key').value.trim())data.whatsapp_sandbox_api_key=$('sandbox-api-key').value.trim();if(data.clear_whatsapp_sandbox_api_key&&data.whatsapp_sandbox_api_key)throw Error('请勿同时清除和替换沙盒 Key。');return data;}
+function sandboxStorageKey(draftId){return 'cafe-sandbox-pending:'+draftId;}
+function sandboxLocalState(draftId){try{return sessionStorage.getItem(sandboxStorageKey(draftId));}catch(e){return null;}}
+function sandboxRemember(draftId,status){try{if(status)sessionStorage.setItem(sandboxStorageKey(draftId),status);else sessionStorage.removeItem(sandboxStorageKey(draftId));}catch(e){}}
+function sandboxRecord(integrations,draftId){return (integrations?.whatsapp_sandbox_messages||[]).find(record=>record.draft_id===draftId&&['accepted','unknown','submitting'].includes(record.status))||(integrations?.whatsapp_sandbox_messages||[]).find(record=>record.draft_id===draftId);}
+function sandboxLocked(draftId){const record=sandboxRecord(current?.integrations,draftId);return ['accepted','unknown','submitting'].includes(record?.status)||!!sandboxLocalState(draftId);}
+function sandboxResult(text,error=false){const box=$('sandbox-result');box.textContent=text;box.className=error?'warning':'callout';box.hidden=!text;}
+function sandboxAddDraft(card,actions,draft,integrations){const record=sandboxRecord(integrations,draft.id),locked=['accepted','unknown','submitting'].includes(record?.status)||!!sandboxLocalState(draft.id);const b=button(record?.status==='accepted'?'本人沙盒 · API 已接受':locked?'本人沙盒 · 结果待核对':'本人沙盒演示',()=>openSandbox(draft));b.disabled=!sandboxReady(integrations)||locked;b.title=!sandboxReady(integrations)?'请先在接口设置配置本人 360dialog 沙盒':'';actions.append(b);if(record||locked)card.append(el('div',record?.status==='accepted'?'本人沙盒：API 已接受，尚无可验证送达回执；请在本人手机核对。非正式下单。':locked?'本人沙盒：发送结果未知，已禁止重复操作，请先核对本人手机。':record.message||'沙盒未接受本次请求。',record?.status==='accepted'?'callout':'warning'));}
+function sandboxOrderStamp(draftId){const order=localBomController?.getState()?.orders?.find(order=>(order.drafts||[]).some(d=>d.id===draftId))||current?.orders?.find(order=>(order.drafts||[]).some(d=>d.id===draftId));return order?JSON.stringify(order):null;}
+function invalidateSandbox(){sandboxRevision++;if(sandboxContext)sandboxContext.preview=null;const confirm=document.getElementById('sandbox-confirm');if(confirm)confirm.checked=false;const send=document.getElementById('sandbox-send');if(send)send.disabled=true;const panel=document.getElementById('sandbox-preview-panel');if(panel)panel.hidden=true;}
+function openSandbox(draft){if(!sandboxReady(current?.integrations)){notice('请先在本机接口设置配置本人 360dialog 沙盒。',true);return;}if(sandboxLocked(draft.id)){notice('本人沙盒已有接受或未知记录，请先在手机核对，不能重复发送。',true);return;}sandboxContext={draftId:draft.id,preview:null};invalidateSandbox();$('sandbox-recipient-label').textContent=sandboxLabel(sandboxConfig(current.integrations))+' · 只能发送至此固定本人标识';$('sandbox-opt-in').checked=false;$('sandbox-window').checked=false;$('sandbox-contact-at').value='';inlineError('sandbox-error');sandboxResult('');$('sandbox-dialog').showModal();}
+function sandboxInput(){if(!$('sandbox-opt-in').checked||!$('sandbox-window').checked)throw Error('请确认本人同意，并声明已在 24 小时内主动联系沙盒。');const raw=$('sandbox-contact-at').value;if(!raw)throw Error('请填写最近一次本人主动联系沙盒的实际时间。');const instant=new Date(raw);if(!Number.isFinite(instant.getTime()))throw Error('联系时间无效。');return {opt_in:true,window_confirmed:true,contact_at:instant.toISOString()};}
+async function prepareSandbox(){const context=sandboxContext;if(!context||busy)return;await task($('sandbox-preview'),async()=>{inlineError('sandbox-error');invalidateSandbox();if(sandboxLocked(context.draftId))throw Error('此本人沙盒消息已接受或结果未知，不能重复发送。');const input=sandboxInput(),revision=sandboxRevision,order=sandboxOrderStamp(context.draftId),config=JSON.stringify(sandboxConfig(current?.integrations));const result=await api('/api/drafts/'+encodeURIComponent(context.draftId)+'/whatsapp-sandbox/preview',input);if(sandboxContext!==context||revision!==sandboxRevision||JSON.stringify(input)!==JSON.stringify(sandboxInput())||order!==sandboxOrderStamp(context.draftId)||config!==JSON.stringify(sandboxConfig(current?.integrations)))throw Error('采购、接口设置或联系时间改变，请重新预览。');if(!result.preview_id||!result.body||!result.recipient_label||result.contact_at!==input.contact_at.replace('Z','+00:00')){if(!result.preview_id||!result.body||!result.recipient_label||new Date(result.contact_at).getTime()!==new Date(input.contact_at).getTime())throw Error('本人沙盒完整预览无效。');}context.preview={...result,input,revision,order,config};$('sandbox-body').textContent=result.body;$('sandbox-recipient-label').textContent=result.recipient_label+' · 本人声明的窗口尚未由平台回执验证';$('sandbox-preview-panel').hidden=false;$('sandbox-confirm').checked=false;$('sandbox-send').disabled=true;sandboxResult('尚未发送。请核对完整正文，再单独确认发送一次。');},'sandbox-error');}
+async function sendSandbox(){const context=sandboxContext,preview=context?.preview;if(busy||!preview||!$('sandbox-confirm').checked)return;await task($('sandbox-send'),async()=>{inlineError('sandbox-error');if(sandboxLocked(context.draftId))throw Error('此本人沙盒消息已接受或结果未知，不能重复发送。');if(preview.revision!==sandboxRevision||JSON.stringify(sandboxInput())!==JSON.stringify(preview.input)||preview.order!==sandboxOrderStamp(context.draftId)||preview.config!==JSON.stringify(sandboxConfig(current?.integrations)))throw Error('预览资料已改变，请重新预览。');sandboxRemember(context.draftId,'unknown');let result;try{result=await api('/api/drafts/'+encodeURIComponent(context.draftId)+'/whatsapp-sandbox/send',{...preview.input,preview_id:preview.preview_id,confirmed:true});if(!['accepted','failed','unknown'].includes(result.status))result={status:'unknown'};}catch(e){result={status:'unknown'};}sandboxRemember(context.draftId,result.status==='failed'?null:result.status);invalidateSandbox();sandboxResult(result.status==='accepted'?'360dialog 沙盒 API 已接受。尚无可验证送达回执，请在本人手机核对；非正式下单，也不代表 Meta 账户解锁。':result.status==='failed'?(result.message||'沙盒未接受请求；请核对本人收件标识和窗口，再重新预览。'):'发送结果未知，系统禁止重发，请先核对本人手机。',result.status!=='accepted');await refresh(true);},'sandbox-error');$('sandbox-send').disabled=true;}
+for(const id of ['sandbox-opt-in','sandbox-window','sandbox-contact-at'])document.getElementById(id).addEventListener('change',invalidateSandbox);
+document.getElementById('sandbox-contact-at').addEventListener('input',invalidateSandbox);
+document.getElementById('sandbox-confirm').addEventListener('change',()=>{$('sandbox-send').disabled=busy||!sandboxContext?.preview||!$('sandbox-confirm').checked;});
+document.getElementById('sandbox-preview').addEventListener('click',prepareSandbox);
+document.getElementById('sandbox-send').addEventListener('click',sendSandbox);
+document.getElementById('sandbox-dialog').addEventListener('close',()=>{invalidateSandbox();sandboxContext=null;});
