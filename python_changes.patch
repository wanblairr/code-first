+        self.service.check_integration.return_value = {"connected": True, "message": "已连接"}
+        self.service.start_runpod_review.return_value = {"id": "job-1", "status": "queued"}
+        self.service.runpod_job.return_value = {"id": "job-1", "status": "completed"}
